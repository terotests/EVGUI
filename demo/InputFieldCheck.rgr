; SPDX-License-Identifier: AGPL-3.0-or-later
; A text field in a host, on Node: `ui:input:field`.
;
; What a person sees in a field: the caret where the text is (and visible),
; the selection band over exactly the selected glyphs, a double click taking
; a word, a triple click all of it, a drag selecting, Ctrl+A. InputCtl places
; the caret and the band itself from the laid-out run (`placeText`), so these
; hold for every host that puts an InputCtl in a UiHost.
Import "../src/UiHost.rgr"
Import "../src/ChatCtl.rgr"

class InputFieldCheck {
    def fails:int 0
    def passes:int 0
    ; the field the last hostWith made
    def cur:InputCtl (new InputCtl())

    fn ok:void (cond:boolean what:string) {
        if cond {
            passes = (passes + 1)
        } {
            fails = (fails + 1)
            print ("[FAIL] " + what)
        }
    }

    sfn near:boolean (a:double b:double) {
        def d:double (a - b)
        if (d < 0.0) {
            d = (0.0 - d)
        }
        return (d < 0.6)
    }

    ; A field styled by a sheet that differs from InputCtl's defaults on
    ; purpose: 16px text (InputCtl starts at 14) and a 1px caret.
    fn hostWith:UiHost (value:string clearable:boolean) {
        def h (new UiHost())
        h.setPageSize(400.0 200.0)
        h.addStyleSheet(".ui-input { display: flex; flex-direction: row; align-items: center; width: 200px; height: 30px; padding: 0 10px; border: 1px solid #000000; } .ui-input-text { font-size: 16px; } .ui-input-caret { width: 1px; background-color: #000000; } .ui-input-selection { background-color: #bfdbfe; } .ui-input-clear { width: 18px; height: 18px; margin-left: 6px; }")
        def c:InputCtl (h.addInput("f" "Field"))
        c.clearable = clearable
        c.setValue(value)
        c.moveTo((strlen value) false)
        c.build()
        cur = c
        return h
    }

    fn el:EVGElement (h:UiHost id:string) {
        def page:EVGElement (unwrap h.lastPage)
        def hit@(optional):EVGElement (h.findEl(page id))
        if (null? hit) {
            print ("[FAIL] no element " + id)
            return (EVGElement.createDiv())
        }
        return (unwrap hit)
    }

    fn width:double (h:UiHost c:InputCtl s:string) {
        def lay (new EVGLayout())
        def eng:EVGTextEngine (lay.getTextEngine())
        def m:EVGTextMetrics (eng.measureRun(s c.fontFamily c.fontSize))
        return m.width
    }

    ; The font is the sheet's, and Ctrl+A puts the band over the whole run:
    ; from where the text starts to where it ends. The bug: the band started
    ; and ended 16px early because the host said the box was 80px wide.
    fn bandOverText:void () {
        def h:UiHost (this.hostWith("{page} / {pages}" true))
        h.focus("f")
        h.keyWith("a" false true)
        h.layout()
        def c:InputCtl cur
        this.ok((c.fontSize == 16.0) ("the field measures in the sheet's size: " + (to_string c.fontSize)))
        this.ok((((c.selStart()) == 0) && ((c.selEnd()) == 16)) "Ctrl+A selects all of it")
        def txt:EVGElement (this.el(h "f-text"))
        def band:EVGElement (this.el(h "f-sel"))
        def car:EVGElement (this.el(h "f-caret"))
        def w:double (this.width(h c c.value))
        this.ok((InputFieldCheck.near(band.calculatedX txt.calculatedX)) ("the band starts at the text: " + (to_string band.calculatedX) + " vs " + (to_string txt.calculatedX)))
        this.ok((InputFieldCheck.near(band.calculatedWidth w)) ("the band is as wide as the text: " + (to_string band.calculatedWidth) + " vs " + (to_string w)))
        this.ok((band.calculatedHeight > 0.0) "the band has a height")
        this.ok((car.calculatedWidth == 0.0) "no caret over a selection")
        def v:EVGElement (this.el(h "f-view"))
        this.ok((txt.calculatedX >= v.calculatedX) "a short text is not scrolled")
    }

    ; A collapsed caret is drawn, as wide as the sheet says, where the
    ; text ends; and not drawn in a field without focus.
    fn caretShows:void () {
        def h:UiHost (this.hostWith("asdf" false))
        h.focus("f")
        h.layout()
        def c:InputCtl cur
        def txt:EVGElement (this.el(h "f-text"))
        def car:EVGElement (this.el(h "f-caret"))
        def w:double (this.width(h c "asdf"))
        this.ok((car.calculatedWidth == 1.0) ("the caret has the sheet's width: " + (to_string car.calculatedWidth)))
        this.ok((car.calculatedHeight > 0.0) "the caret has a height")
        this.ok((InputFieldCheck.near(car.calculatedX (txt.calculatedX + w))) ("the caret is after the text: " + (to_string car.calculatedX) + " vs " + (to_string (txt.calculatedX + w))))
        h.blur()
        h.layout()
        def car2:EVGElement (this.el(h "f-caret"))
        this.ok((car2.calculatedWidth == 0.0) "no caret without focus")
        ; laid out twice, placed twice: the same place
        h.focus("f")
        h.layout()
        def lay (new EVGLayout())
        c.placeText((lay.getTextEngine()))
        def car3:EVGElement (this.el(h "f-caret"))
        this.ok((InputFieldCheck.near(car3.calculatedX (txt.calculatedX + w))) "placing again does not move it")
    }

    ; Text wider than the field scrolls so the caret stays inside it, and
    ; the text moves with it.
    fn longTextScrolls:void () {
        def h:UiHost (this.hostWith("The quick brown fox jumps over the lazy dog again and again" false))
        h.focus("f")
        h.layout()
        def c:InputCtl cur
        def v:EVGElement (this.el(h "f-view"))
        def txt:EVGElement (this.el(h "f-text"))
        def car:EVGElement (this.el(h "f-caret"))
        this.ok((c.scrollX > 0.0) "the text is scrolled")
        this.ok(((car.calculatedX >= v.calculatedX) && ((car.calculatedX + car.calculatedWidth) <= ((v.calculatedX + v.calculatedWidth) + 0.5))) ("the caret is inside the field: " + (to_string car.calculatedX)))
        this.ok((txt.calculatedX < v.calculatedX) "the text moved left with the scroll")
        h.keyWith("Home" false false)
        h.layout()
        def car2:EVGElement (this.el(h "f-caret"))
        def txt2:EVGElement (this.el(h "f-text"))
        this.ok((c.scrollX == 0.0) "Home scrolls back")
        this.ok((InputFieldCheck.near(car2.calculatedX txt2.calculatedX)) "the caret at the start")
    }

    ; The pointer, through the host: a press puts the caret, a drag
    ; selects, a double click takes a word, a drag after it grows by words,
    ; a triple click takes all of it, Shift+press extends.
    fn pointer:void () {
        def h:UiHost (this.hostWith("alpha beta gamma" false))
        h.layout()
        def c:InputCtl cur
        def txt:EVGElement (this.el(h "f-text"))
        def y:double (txt.calculatedY + 4.0)
        def x0:double txt.calculatedX
        def inBeta:double (x0 + (this.width(h c "alpha be")))
        def inGamma:double (x0 + (this.width(h c "alpha beta ga")))
        h.pressAtWith(inBeta y 1 false)
        this.ok((h.focusId == "f") "a press focuses the field")
        this.ok(c.focused "…and the field knows")
        this.ok(((c.caret == 8) && ((c.hasSelection()) == false)) ("a press puts the caret where it lands: " + (to_string c.caret)))
        h.pointerMove(inGamma y)
        this.ok((((c.selStart()) == 8) && ((c.selEnd()) == 13)) ("a drag selects: " + (to_string (c.selStart())) + "-" + (to_string (c.selEnd()))))
        h.pointerUp()
        h.pressAtWith(inBeta y 2 false)
        this.ok((((c.selStart()) == 6) && ((c.selEnd()) == 10)) ("a double click takes the word: " + (to_string (c.selStart())) + "-" + (to_string (c.selEnd()))))
        h.pointerMove(inGamma y)
        this.ok((((c.selStart()) == 6) && ((c.selEnd()) == 16)) ("a drag after it grows by words: " + (to_string (c.selStart())) + "-" + (to_string (c.selEnd()))))
        h.pointerMove((x0 + 2.0) y)
        this.ok((((c.selStart()) == 0) && ((c.selEnd()) == 10)) ("…both ways, keeping the word: " + (to_string (c.selStart())) + "-" + (to_string (c.selEnd()))))
        h.pointerUp()
        h.pressAtWith(inBeta y 3 false)
        this.ok((((c.selStart()) == 0) && ((c.selEnd()) == 16)) "a triple click takes all of it")
        h.pointerUp()
        h.pressAtWith((x0 + 2.0) y 1 false)
        h.pointerUp()
        h.pressAtWith(inGamma y 1 true)
        this.ok((((c.selStart()) == 0) && ((c.selEnd()) == 13)) "Shift+press extends")
        h.pointerUp()
        ; a drag after the button is let go selects nothing
        h.pressAtWith(inBeta y 1 false)
        h.pointerUp()
        h.pointerMove(inGamma y)
        this.ok(((c.hasSelection()) == false) "moving without the button selects nothing")
        h.layout()
        def band:EVGElement (this.el(h "f-sel"))
        this.ok((band.calculatedWidth == 0.0) "no band without a selection")
    }

    ; The clear button empties the field.
    fn clears:void () {
        def h:UiHost (this.hostWith("abc" true))
        h.focus("f")
        h.layout()
        def clr:EVGElement (this.el(h "f-clear"))
        h.pressAtWith((clr.calculatedX + 4.0) (clr.calculatedY + 4.0) 1 false)
        def c:InputCtl cur
        this.ok((c.value == "") ("the clear button empties it: " + c.value))
    }

    ; An emoji is one character to Backspace, Delete and the arrows.
    fn emoji:void () {
        def h:UiHost (this.hostWith("a👍🏽b" false))
        def c:InputCtl cur
        h.focus("f")
        h.keyWith("ArrowLeft" false false)
        h.keyWith("ArrowLeft" false false)
        this.ok((c.caret == 1) ("ArrowLeft steps over the emoji: " + (to_string c.caret)))
        h.keyWith("ArrowRight" false false)
        this.ok((c.caret == 5) ("ArrowRight steps over it: " + (to_string c.caret)))
        h.keyWith("Backspace" false false)
        this.ok((c.value == "ab") ("Backspace takes it whole: " + c.value))
        c.setValue("x🇫🇮")
        c.moveTo(1 false)
        h.keyWith("Delete" false false)
        this.ok((c.value == "x") ("Delete takes a flag whole: " + c.value))
    }

    ; The chat's composer is an InputCtl: its caret is drawn too.
    fn chatField:void () {
        def h (new UiHost())
        h.setPageSize(320.0 440.0)
        ; the theme's own rules for the composer (theme/base.css): the field
        ; is `width: 0` and grows into the row beside Send
        h.addStyleSheet(".ui-input { display: flex; width: 220px; height: 34px; padding: 0 10px; } .chat-panel { display: flex; flex-direction: column; width: 300px; } .chat-composer { display: flex; flex-direction: row; align-items: center; gap: 6px; padding: 8px 10px; } .chat-field { display: flex; align-items: center; flex-grow: 1; flex-shrink: 1; width: 0px; min-width: 0px; height: 30px; padding: 0 8px; } .chat-send { height: 30px; padding: 0 12px; font-size: 13px; } .ui-input-text { font-size: 13px; }")
        def ch (new ChatCtl())
        ch.setup("ch" "Chat")
        ch.typeChar("" "hello")
        ch.build()
        h.add(ch)
        h.focus("ch-field")
        h.layout()
        def fld:EVGElement (this.el(h "ch-field"))
        this.ok((fld.calculatedWidth > 150.0) ("the chat field fills the row beside Send: " + (to_string fld.calculatedWidth)))
        def car:EVGElement (this.el(h "ch-field-caret"))
        this.ok((car.calculatedWidth > 0.0) "the chat field draws its caret when focused")
        h.keyWith("a" false true)
        this.ok((((ch.input.selStart()) == 0) && ((ch.input.selEnd()) == 5)) "Ctrl+A in the chat field selects its text")
    }

    ; The comment box on a dark panel (Sliqtly's review mode): the hint must
    ; read as a hint, go when the field is focused, and the caret must show.
    ; The bugs: `.chat-draft`'s white, declared after `.ui-input-placeholder`,
    ; coloured the hint like typed text; the hint stayed on focus; and the
    ; theme's dark caret vanished on the dark field.
    fn placeholder:void () {
        def h (new UiHost())
        h.setPageSize(320.0 440.0)
        h.addStyleSheet(".ui-input { display: flex; width: 220px; height: 34px; padding: 0 10px; } .chat-panel { display: flex; flex-direction: column; width: 300px; } .chat-composer { display: flex; flex-direction: row; align-items: center; gap: 6px; padding: 8px 10px; } .chat-field { display: flex; align-items: center; flex-grow: 1; flex-shrink: 1; width: 0px; min-width: 0px; height: 30px; padding: 0 8px; } .chat-send { height: 30px; padding: 0 12px; font-size: 13px; } .ui-input-text { font-size: 13px; } .ui-input-placeholder { color: #808080; } .chat-draft { color: #ffffff; font-size: 15px; } .chat-placeholder { font-size: 15px; }")
        def ch (new ChatCtl())
        ch.setup("ch" "Chat")
        ch.placeholder = "Write a comment…"
        ch.build()
        h.add(ch)
        h.layout()
        def txt:EVGElement (this.el(h "ch-field-text"))
        this.ok((txt.textContent == "Write a comment…") ("an empty field shows its hint: " + txt.textContent))
        this.ok(((txt.color.r < 150.0) && (txt.color.r > 100.0)) ("the hint has the placeholder colour, not the text's: " + (to_string txt.color.r)))
        this.ok((txt.inheritedFontSize == 15.0) ("the hint has the text's size: " + (to_string txt.inheritedFontSize)))
        h.focus("ch-field")
        h.layout()
        def txt2:EVGElement (this.el(h "ch-field-text"))
        this.ok((txt2.textContent == "") ("focusing the field hides the hint: " + txt2.textContent))
        def car:EVGElement (this.el(h "ch-field-caret"))
        this.ok((car.calculatedWidth > 0.0) "the caret shows in the focused empty field")
        this.ok((car.calculatedHeight > 8.0) ("the caret has a height: " + (to_string car.calculatedHeight)))
        def fld:EVGElement (this.el(h "ch-field"))
        this.ok(((car.calculatedY > fld.calculatedY) && ((car.calculatedY + car.calculatedHeight) < (fld.calculatedY + fld.calculatedHeight))) ("the caret sits inside the field: " + (to_string car.calculatedY) + " in " + (to_string fld.calculatedY)))
        this.ok((car.backgroundColor.isSet && (car.backgroundColor.r > 230.0)) "a caret the sheet does not colour takes the text's colour")
        h.keyWith("h" false false)
        h.layout()
        def txt3:EVGElement (this.el(h "ch-field-text"))
        this.ok((txt3.color.r > 230.0) "typed text has the text colour")
        h.blur()
        ch.input.setValue("")
        ch.build()
        h.layout()
        def txt4:EVGElement (this.el(h "ch-field-text"))
        this.ok((txt4.textContent == "Write a comment…") "the hint comes back on blur")
    }

    ; A long comment is read whole while it is written: the draft wraps, the
    ; box grows a line at a time up to five, then scrolls with the caret.
    fn multiline:void () {
        def h (new UiHost())
        h.setPageSize(320.0 440.0)
        h.addStyleSheet(".ui-input { display: flex; width: 220px; height: 34px; padding: 0 10px; } .chat-panel { display: flex; flex-direction: column; width: 300px; } .chat-composer { display: flex; flex-direction: row; align-items: center; gap: 6px; padding: 8px 10px; } .chat-field { display: flex; align-items: center; flex-grow: 1; flex-shrink: 1; width: 0px; min-width: 0px; height: 30px; padding: 0 8px; } .chat-send { height: 30px; padding: 0 12px; font-size: 13px; } .ui-input-text { font-size: 13px; height: 18px; } .ui-input-caret { width: 1px; }")
        def ch (new ChatCtl())
        ch.setup("ch" "Chat")
        ch.build()
        h.add(ch)
        h.focus("ch-field")
        h.layout()
        def fld:EVGElement (this.el(h "ch-field"))
        def one:double fld.calculatedHeight
        this.ok((InputFieldCheck.near(one 30.0)) ("one line: the sheet's height: " + (to_string one)))
        ch.typeChar("" "one two three four five six seven eight nine ten eleven twelve")
        ch.build()
        h.layout()
        def fld2:EVGElement (this.el(h "ch-field"))
        def lb:double ch.input.lineBox
        def p:UiTextLines (unwrap ch.input.placed)
        this.ok(((p.count()) >= 2) ("long text wraps: " + (to_string (p.count()))))
        this.ok((InputFieldCheck.near(fld2.calculatedHeight (one + ((to_double ((p.count()) - 1)) * lb)))) ("the box grows by a line per line: " + (to_string fld2.calculatedHeight)))
        ; every line in sight: the view is as tall as the lines (it stayed
        ; one line high and cut the others) and the lines sit in it
        def vw:EVGElement (this.el(h "ch-field-view"))
        this.ok(((vw.calculatedHeight + 0.5) >= ((to_double (p.count())) * lb)) ("the view is as tall as its lines: " + (to_string vw.calculatedHeight) + " for " + (to_string (p.count())) + " × " + (to_string lb)))
        def l0:UiTextLine (itemAt p.lines 0)
        def ln:UiTextLine (itemAt p.lines ((p.count()) - 1))
        this.ok(((l0.y >= (vw.calculatedY - 0.5)) && ((ln.y + lb) <= ((vw.calculatedY + vw.calculatedHeight) + 0.5))) ("the lines are inside the view: " + (to_string l0.y) + "…" + (to_string (ln.y + lb)) + " in " + (to_string vw.calculatedY) + "+" + (to_string vw.calculatedHeight)))
        this.ok(((ch.input.linesChanged()) == false) "placed as tall as it was built")
        def car:EVGElement (this.el(h "ch-field-caret"))
        def last:UiTextLine (itemAt p.lines ((p.count()) - 1))
        this.ok(((car.calculatedWidth > 0.0) && (InputFieldCheck.near(car.calculatedY last.y))) "the caret is on the last line")
        this.ok(((car.calculatedX + car.calculatedWidth) <= ((fld2.calculatedX + fld2.calculatedWidth) + 0.5)) "the caret stays inside the box")
        def endAt:int ch.input.caret
        h.keyWith("ArrowUp" false false)
        this.ok((ch.input.caret < endAt) ("ArrowUp goes to the line above: " + (to_string ch.input.caret)))
        h.keyWith("End" true false)
        h.keyWith("Enter" true false)
        this.ok(((indexOf ch.input.value "\n") >= 0) "Shift+Enter breaks the line")
        this.ok(((strlen ch.sent) == 0) "…and does not send")
        h.keyWith("End" false true)
        ch.typeChar("" " and on and on and on and on and on and on and on and on and on and on and on and on and on and on and on and on and on")
        ch.build()
        h.layout()
        h.layout()
        def fld3:EVGElement (this.el(h "ch-field"))
        this.ok((InputFieldCheck.near(fld3.calculatedHeight (one + (4.0 * lb)))) ("at most five lines high: " + (to_string fld3.calculatedHeight)))
        def car3:EVGElement (this.el(h "ch-field-caret"))
        this.ok(((car3.calculatedY >= fld3.calculatedY) && ((car3.calculatedY + car3.calculatedHeight) <= ((fld3.calculatedY + fld3.calculatedHeight) + 0.5))) ("scrolled: the caret's line is in the box: " + (to_string car3.calculatedY) + " in " + (to_string fld3.calculatedY)))
        h.keyWith("Enter" false false)
        ch.build()
        h.layout()
        def fld4:EVGElement (this.el(h "ch-field"))
        this.ok(((strlen ch.sent) > 0) "Enter sends")
        this.ok((InputFieldCheck.near(fld4.calculatedHeight one)) ("sent: the box is one line again: " + (to_string fld4.calculatedHeight)))
    }

    ; Text put in before the field was ever placed: it is built one line
    ; high, and says so once placed, so the host builds it again.
    fn pastedFirst:void () {
        def h (new UiHost())
        h.setPageSize(320.0 440.0)
        h.addStyleSheet(".chat-panel { display: flex; flex-direction: column; width: 300px; } .chat-composer { display: flex; flex-direction: row; align-items: center; padding: 8px 10px; } .chat-field { display: flex; align-items: center; flex-grow: 1; width: 0px; min-width: 0px; height: 30px; padding: 0 8px; } .ui-input-text { font-size: 13px; }")
        def ch (new ChatCtl())
        ch.setup("cp" "Chat")
        ch.input.setValue("one two three four five six seven eight nine ten eleven twelve thirteen")
        ch.build()
        h.add(ch)
        h.layout()
        this.ok((ch.input.linesChanged()) "pasted before it was placed: it asks to be built again")
        ch.build()
        h.layout()
        this.ok(((ch.input.linesChanged()) == false) "built again: as tall as its lines")
    }

    ; A comment's words as a chat writes them (ChatCtl markup): **bold**,
    ; `code` and a link are drawn as such, words alone stay a selectable run,
    ; a press selects a formatted message whole and copies it without the
    ; markers, a press on its link asks the host to open it.
    fn chatMarkup:void () {
        def h (new UiHost())
        h.setPageSize(400.0 400.0)
        h.addStyleSheet(".chat-panel { display: flex; flex-direction: column; width: 360px; } .chat-log { display: flex; flex-direction: column; } .chat-msg { display: flex; flex-direction: column; } .chat-rich { display: flex; flex-direction: column; } .ch-line { display: flex; flex-direction: row; } .ch-words { display: flex; flex-direction: row; flex-wrap: wrap; flex-grow: 1; width: 0px; } .ch-w { font-size: 14px; white-space: nowrap; } .ch-b { font-weight: bold; }")
        def ch (new ChatCtl())
        ch.setup("ch" "Comment")
        ch.add("a" "u1" "Ada" "#336699" "just words" "" false)
        ch.add("b" "u1" "Ada" "#336699" "**Fix** the `title`, see https://sliqtly.com/help" "" false)
        ch.build()
        h.add(ch)
        h.layout()
        def run0:EVGElement (this.el(h "ch-m-0-text"))
        this.ok((run0.id == "ch-m-0-text") "a message of words stays a selectable run")
        def bold:EVGElement (this.el(h "ch-m-1-b0-s0"))
        this.ok(((bold.textContent == "Fix") && ((indexOf bold.className "ch-b") >= 0)) ("**Fix** is drawn bold without its stars: " + bold.textContent + " " + bold.className))
        def code:EVGElement (this.el(h "ch-m-1-b0-s2"))
        this.ok(((code.textContent == "title") && ((indexOf code.className "ch-icode") >= 0)) ("`title` is inline code: " + code.textContent + " " + code.className))
        this.ok((ch.owns("ch-m-1-rich")) "the formatted message is the chat's to press")
        def lks:[string] (ch.linkTids(1))
        this.ok(((array_length lks) == 1) ("one link word: " + (to_string (array_length lks))))
        ch.textPointerDownAt("ch-m-1-rich" 10.0 10.0 1 false)
        this.ok(((ch.selectedText()) == "Fix the title, see https://sliqtly.com/help") ("a press selects it whole, copied without markers: " + (ch.selectedText())))
        ch.build()
        def h2 (new UiHost())
        h2.setPageSize(400.0 400.0)
        h2.add(ch)
        h2.layout()
        def selBox:EVGElement (this.el(h2 "ch-m-1-rich"))
        this.ok(((indexOf selBox.className "chat-rich-sel") >= 0) "the selected message shows it")
        ch.dropSelection()
        this.ok(((ch.selectedText()) == "") "a press elsewhere lets it go")
        ch.textPointerDownAt((itemAt lks 0) 10.0 10.0 1 false)
        this.ok(((ch.takeLink()) == "https://sliqtly.com/help") "a press on the link asks for it")
        this.ok(((ch.takeLink()) == "") "taken once")
        ch.markup = false
        ch.build()
        def h3 (new UiHost())
        h3.setPageSize(400.0 400.0)
        h3.add(ch)
        h3.layout()
        def asTyped:EVGElement (this.el(h3 "ch-m-1-text-text"))
        this.ok((asTyped.textContent == "**Fix** the `title`, see https://sliqtly.com/help") "markup off: the words as typed")
    }

    sfn main:void () {
        def c (new InputFieldCheck())
        c.bandOverText()
        c.caretShows()
        c.longTextScrolls()
        c.pointer()
        c.clears()
        c.emoji()
        c.chatField()
        c.placeholder()
        c.multiline()
        c.pastedFirst()
        c.chatMarkup()
        print ((to_string c.passes) + " passed, " + (to_string c.fails) + " failed")
        if (c.fails > 0) {
            print "RESULT FAIL"
        }
    }
}
