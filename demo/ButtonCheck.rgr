; ButtonCtl's icon, on Node: `ui:button:check`.
Import "../src/ButtonCtl.rgr"

class ButtonCheck {
    def fails:int 0
    def passes:int 0

    fn ok:void (cond:boolean what:string) {
        if cond {
            passes = (passes + 1)
        } {
            fails = (fails + 1)
            print ("[FAIL] " + what)
        }
    }

    fn button:ButtonCtl (icon:string only:boolean) {
        def b (new ButtonCtl())
        b.tid = "b"
        b.name = "Close"
        b.variant = "ghost"
        b.icon = icon
        b.iconOnly = only
        b.build()
        return b
    }

    fn run:void () {
        def pb:ButtonCtl (this.button("" false))
        def plain:EVGElement (unwrap pb.rootEl)
        this.ok(((plain.getChildCount()) == 1) "no icon: the words alone")
        def both:ButtonCtl (this.button("M15 6l-6 6 6 6" false))
        def el:EVGElement (unwrap both.rootEl)
        this.ok(((el.getChildCount()) == 2) "an icon, then the words")
        def ic:EVGElement (el.getChild(0))
        this.ok(((indexOf ic.className "ui-button-icon") == 0) ("icon class: " + ic.className))
        this.ok(((indexOf ic.className "ui-button-icon-ui-button-ghost") > 0) ("the variant's pen: " + ic.className))
        this.ok((ic.elementType == 3) "the icon is a path")
        this.ok((ic.svgPath == "M15 6l-6 6 6 6") "its path")
        this.ok((ic.id == "b-icon") ("its id: " + ic.id))
        ; pressing builds the button again: the icon stays
        both.press(true)
        this.ok(((el.getChildCount()) == 2) "a press keeps the icon")
        both.press(false)
        def ob:ButtonCtl (new ButtonCtl())
        ob.tid = "o"
        ob.name = "Add"
        ob.icon = "M12 5v14M5 12h14"
        ob.iconOnly = true
        ob.iconClass = "my-add"
        ob.build()
        def only:EVGElement (unwrap ob.rootEl)
        this.ok(((only.getChildCount()) == 1) "iconOnly: the icon alone")
        this.ok(((indexOf only.className "ui-button-icononly") >= 0) "iconOnly class")
        def oic:EVGElement (only.getChild(0))
        this.ok(((indexOf oic.className "my-add") > 0) "the screen's own icon class")
        ; a picture: a tile, the picture over the words, kept through a press
        def tb (new ButtonCtl())
        tb.tid = "t"
        tb.name = "pearl"
        tb.picture = "/__theme/pearl"
        tb.picW = 192.0
        tb.picH = 108.0
        tb.build()
        def tile:EVGElement (unwrap tb.rootEl)
        this.ok(((tile.getChildCount()) == 2) "a picture, then the words")
        this.ok(((indexOf tile.className "ui-button-tile") >= 0) ("tile class: " + tile.className))
        def pic:EVGElement (tile.getChild(0))
        this.ok((pic.src == "/__theme/pearl") ("the picture's source: " + pic.src))
        this.ok((pic.id == "t-picture") ("its id: " + pic.id))
        this.ok(pic.a11yHidden "the picture is not read out; the name is")
        tb.press(true)
        this.ok(((tile.getChildCount()) == 2) "a press keeps the picture")
        def rows:[UiRow] ((this.button("M12 5v14" true)).rows())
        this.ok(((array_length rows) == 1) "a reader still gets the button")
        this.ok(((itemAt rows 0).name == "Close") "named by its name")
        ; busy: a spinner and the message, no press, a reader hears the message
        def sb (new ButtonCtl())
        sb.tid = "s"
        sb.name = "Save"
        sb.variant = "primary"
        sb.icon = "M5 12l5 5L20 7"
        sb.build()
        def save:EVGElement (unwrap sb.rootEl)
        this.ok(((sb.activate("s")) == "s") "idle: a press is taken")
        sb.startBusy("Saving changes...")
        this.ok(((indexOf save.className "ui-button-busy") >= 0) ("busy class: " + save.className))
        this.ok(((save.getChildCount()) == 2) "busy: a spinner, then the message")
        def spn:EVGElement (save.getChild(0))
        this.ok((spn.id == "s-spinner") ("spinner id: " + spn.id))
        this.ok(((indexOf spn.className "ui-button-spinner-ui-button-primary") > 0) ("the variant's pen: " + spn.className))
        this.ok(spn.a11yHidden "the spinner is not read out")
        this.ok(((save.getChild(1)).textContent == "Saving changes...") "the message replaces the words")
        this.ok(((sb.activate("s")) == "") "busy: a second press is not taken")
        sb.press(true)
        this.ok((sb.held == false) "busy: not held by a press")
        def br:UiRow (itemAt (sb.rows()) 0)
        this.ok((br.name == "Saving changes...") ("a reader hears the message: " + br.name))
        this.ok(br.disabled "reported disabled while busy")
        this.ok((br.state == "busy") ("state busy: " + br.state))
        this.ok(br.focusable "the focus stays on it")
        this.ok((sb.tick(250.0)) "tick moves the spinner")
        this.ok(((spn.rotate > 89.9) && (spn.rotate < 90.1)) ("a quarter turn in 250 ms: " + (to_string spn.rotate)))
        this.ok(((save.getChild(0)) == spn) "tick does not rebuild")
        sb.tick(800.0)
        this.ok(((spn.rotate > 17.9) && (spn.rotate < 18.1)) ("wraps past a turn: " + (to_string spn.rotate)))
        sb.stopBusy()
        this.ok(((save.getChildCount()) == 2) "done: the icon and the words again")
        this.ok(((save.getChild(1)).textContent == "Save") "the words are back")
        this.ok(((sb.activate("s")) == "s") "done: a press is taken again")
        this.ok(((sb.tick(16.0)) == false) "idle: tick asks for nothing")
        this.ok(((itemAt (sb.rows()) 0).name == "Save") "named by its name again")
    }

    sfn main@(main):void () {
        def c (new ButtonCheck())
        c.run()
        print ((to_string c.passes) + " passed, " + (to_string c.fails) + " failed")
        if (c.fails > 0) {
            print "RESULT FAIL"
        }
    }
}
