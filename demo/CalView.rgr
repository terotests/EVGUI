; SPDX-License-Identifier: AGPL-3.0-or-later

; =============================================================================
; CalView — the calendar CARD, drawn once for every page that shows one
; =============================================================================
; The calendar demo draws it always-on beside its date field; the profile demo
; draws the same card inside a popover under its date fields. Written once
; here so the two cannot drift: the same tags, the same `cd-*` classes (a page
; that shows the card carries the card's rules in its stylesheet), the same
; year panel and the same day labels.
;
; Nothing in here decides anything. `CalendarCtl` owns the month, the focus
; day, the selection and the year panel; this turns that state into a tree.
; The only state a page keeps of its own is where the year panel is scrolled
; to, which is handed in.
; =============================================================================

Import "../src/CalendarCtl.rgr"
Import "../src/UiDate.rgr"
Import "pkg:evg/EVGElement.rgr"
Import "pkg:evg/EVGA11yTree.rgr"

treefactory Cal {
    child addChild
    text  textContent

    tag Page      EVGElement (props (className "cd-page"))
    tag Field     EVGElement (props (className "cd-field"))
    tag FieldLbl  EVGElement (props (className "cd-field-label") (elementType 1))
    tag Card      EVGElement (props (className "cd-card"))
    tag Nav       EVGElement (props (className "cd-nav") (role "navigation") (a11yLabel "Navigation bar"))
    tag NavBtn    EVGElement (props (className "cd-navbtn") (role "button"))
    tag NavGlyph  EVGElement (props (className "cd-navglyph") (elementType 1) (a11yHidden true))
    ; The caption keeps `role="status"` — arrowing into another month has to be
    ; announced — but it is no longer a text run: it holds the month and the
    ; year, and its accessible name is still the two of them read together.
    tag Caption   EVGElement (props (className "cd-caption") (role "status"))
    ; The caption is TWO things: a month, and a year you can press. It used to
    ; be one text run — which is why the only way to 2019 was forty-eight
    ; presses of the arrow beside it.
    tag MonthTxt  EVGElement (props (className "cd-monthtxt") (elementType 1))
    tag YearBtn   EVGElement (props (className "cd-yearbtn") (role "button") (a11yHasPopup "listbox"))
    tag YearTxt   EVGElement (props (className "cd-yeartxt") (elementType 1) (a11yHidden true))
    ; The panel, hung off the year as an overlay so it draws OVER the grid
    ; instead of pushing it down: a calendar that changes height when you
    ; reach for a year moves the thing you were about to click.
    tag YearPanel EVGElement (props (className "cd-yearpanel") (isOverlay true) (overlaySide "bottom") (overlayAlign "start") (role "listbox") (a11yLabel "Year"))
    tag YearOpt   EVGElement (props (className "cd-yearopt") (role "option") (a11yFocusable true))
    tag YearOptOn EVGElement (props (className "cd-yearopt cd-yearopt-on") (role "option") (a11yFocusable true))
    tag YearOptTx EVGElement (props (className "cd-yearopttx") (elementType 1) (a11yHidden true))
    ; The chosen year's number gets its own token rather than a descendant
    ; selector: EVGStyleSheet matches ONE token per selector, so
    ; `.cd-yearopt-on .cd-yearopttx` would never have matched anything.
    tag YearOptTxOn EVGElement (props (className "cd-yearopttx cd-yearopttx-on") (elementType 1) (a11yHidden true))
    tag Spacer    EVGElement (props (className "cd-spacer"))
    tag Grid      EVGElement (props (className "cd-grid") (role "grid"))
    tag HeadRow   EVGElement (props (className "cd-headrow"))
    ; The weekday strip is decoration: every day already carries its weekday in
    ; its own label, so a column header would say "Wednesday" twice per cell.
    ; The reference marks its <thead> aria-hidden for the same reason.
    tag Weekday   EVGElement (props (className "cd-weekday") (elementType 1) (a11yHidden true))
    tag Week      EVGElement (props (className "cd-week") (role "row"))
    tag Day       EVGElement (props (className "cd-day") (role "gridcell"))
    tag DayNum    EVGElement (props (className "cd-daynum") (elementType 1) (a11yHidden true))
    tag Note      EVGElement (props (className "cd-note") (elementType 1))
}

class CalView {

    sfn byId:EVGElement (el:EVGElement want:string) {
        if (el.id == want) {
            return el
        }
        def i:int 0
        while (i < (el.getChildCount())) {
            def kid:EVGElement (CalView.byId((el.getChild(i)) want))
            if (kid.id == want) {
                return kid
            }
            i = (i + 1)
        }
        return el
    }

    ; --- the look ------------------------------------------------------------

    ; The classes a day carries. Order matters to the cascade and not to the
    ; meaning: `EVGStyleSheet` matches one token per selector, so a variant is
    ; its own token on the same element rather than a compound rule.
    sfn dayClass:string (model:CalendarCtl day:int) {
        def cls:string "cd-day"
        if (model.isOutside(day)) {
            cls = (cls + " cd-day-outside")
        }
        if (model.isDisabledDay(day)) {
            cls = (cls + " cd-day-disabled")
        }
        if model.hasToday {
            if (day == model.todayDay) {
                cls = (cls + " cd-day-today")
            }
        }
        if model.hasSelection {
            if (day == model.selectedDay) {
                cls = (cls + " cd-day-selected")
            }
        }
        return cls
    }

    ; The day NUMBER's classes. It needs its own, because EVGStyleSheet has no
    ; descendant selectors: the number cannot inherit "I am inside a selected
    ; day" from its parent, and a white-on-white or black-on-black day is what
    ; you get for assuming it can.
    sfn numClass:string (model:CalendarCtl day:int) {
        def cls:string "cd-daynum"
        if (model.isOutside(day)) {
            cls = (cls + " cd-daynum-outside")
        }
        if model.hasSelection {
            if (day == model.selectedDay) {
                cls = (cls + " cd-daynum-selected")
            }
        }
        return cls
    }

    ; "Year, 2026, choose a year". The number is IN the name because the
    ; visible glyphs are hidden from the trace — a button whose accessible name
    ; is "choose a year" tells a reader which control it is and not what it
    ; currently says.
    sfn yearBtnLabel:string (model:CalendarCtl) {
        return (("Year, " + (to_string model.viewYear)) + ", choose a year")
    }

    ; --- the year panel's scroll ---------------------------------------------

    ; One row's pitch and the panel's own height, from the stylesheet in one
    ; place so the open-centred arithmetic and the wheel clamp cannot drift.
    sfn yearRowH:double () {
        return 26.0
    }

    sfn yearPanelH:double () {
        return 200.0
    }

    sfn yearContentH:double (model:CalendarCtl) {
        return ((to_double (model.yearCount())) * (CalView.yearRowH()))
    }

    sfn clampYearScroll:double (model:CalendarCtl v:double) {
        def max:double ((CalView.yearContentH(model)) - (CalView.yearPanelH()))
        if (max < 0.0) {
            max = 0.0
        }
        if (v < 0.0) {
            return 0.0
        }
        if (v > max) {
            return max
        }
        return v
    }

    ; The whole point of the panel: opening it should not leave you eleven
    ; scrolls from the year you are on. Centred on the current year, clamped
    ; to the ends so the first and last years are reachable without an
    ; overscroll that shows nothing.
    sfn centredYearScroll:double (model:CalendarCtl) {
        def i:double (to_double (model.indexOfYear(model.viewYear)))
        def want:double (((i * (CalView.yearRowH())) + ((CalView.yearRowH()) / 2.0)) - ((CalView.yearPanelH()) / 2.0))
        return (CalView.clampYearScroll(model want))
    }

    ; One row per year in the bounds. The reference uses a native `<select>`,
    ; which a canvas kit does not have; this is the scrollable panel the
    ; request described, and no measurement is claimed for it. What choosing a
    ; year DOES is measured — see `ui:calendar:check`.
    sfn yearPanel:EVGElement (model:CalendarCtl yearScroll:double) {
        def panel (tree Cal (YearPanel (props (id (model.yearPanelTid())))))
        panel.scrollTop = yearScroll
        def i:int 0
        while (i < (model.yearCount())) {
            def y:int (model.yearAt(i))
            def label:string (to_string y)
            def opt (tree Cal (YearOpt (props (id (model.yearOptTid(y))) (a11yLabel label))))
            if (y == model.viewYear) {
                opt = (tree Cal (YearOptOn (props (id (model.yearOptTid(y))) (a11yLabel label))))
                opt.a11ySelected = (EVGA11yTri.yes())
                opt.addChild((tree Cal (YearOptTxOn label)))
            } {
                opt.addChild((tree Cal (YearOptTx label)))
            }
            panel.addChild(opt)
            i = (i + 1)
        }
        return panel
    }

    ; --- the card ------------------------------------------------------------

    sfn card:EVGElement (model:CalendarCtl yearScroll:double) {
        def card (tree Cal (Card))
        def nav (tree Cal
            (Nav
                ; A real typographic chevron. This said ASCII was
                ; deliberate, because the atlas supposedly stops at code 126
                ; and a chevron drew as an empty box. That reason was WRONG:
                ; re-measured by rendering the characters, the painter draws
                ; U+2039, U+203A, the euro sign, an a-umlaut and colour emoji
                ; perfectly well. The empty box came from the SOURCE — the
                ; file contained the six characters backslash-u-2039, because
                ; Ranger does not interpret \u escapes and the tool that
                ; wrote the line did not either.
                ;
                ; What IS true, and is the narrower thing: the measurer falls
                ; back to half an em for anything outside 32-126, so a RUN
                ; containing non-ASCII is spaced wrong. One glyph alone in a
                ; centred box is unaffected, which is what this is.
                (NavBtn (props (id (model.prevTid())) (a11yLabel "Go to the Previous Month"))
                    (NavGlyph "‹"))
                (Caption (props (id (model.captionTid())))
                    (MonthTxt (UiDate.monthName(model.viewMonth))))
                (NavBtn (props (id (model.nextTid())) (a11yLabel "Go to the Next Month"))
                    (NavGlyph "›"))))
        ; The year goes INSIDE the caption, beside the month. Not after it:
        ; the caption is the live region a reader hears when the month
        ; changes, and a year drawn outside it would leave the announcement
        ; saying "May" with no year in it.
        def cap:EVGElement (CalView.byId(nav (model.captionTid())))
        ; A named intermediate rather than `(YearTxt (to_string ...))`: a
        ; computed child in text position is read as a TAG NAME by the tree
        ; factory, and the error says `to_string is not a tag of Cal`.
        def yearNum:string (to_string model.viewYear)
        def yearBtn (tree Cal
            (YearBtn (props (id (model.yearTid()))
                (a11yLabel (CalView.yearBtnLabel(model))))
                (YearTxt yearNum)))
        yearBtn.a11yExpanded = (EVGA11yTri.no())
        cap.addChild(yearBtn)
        ; The panel is the anchor's SIBLING, not its child. As a child it
        ; placed at the anchor's own origin and drew over the year instead of
        ; under it — the overlay layer positions against the PRECEDING
        ; anchor, which is how the profile demo's select list is built too.
        if model.yearPanelOpen {
            yearBtn.a11yExpanded = (EVGA11yTri.yes())
            yearBtn.isOverlayAnchor = true
            cap.addChild((CalView.yearPanel(model yearScroll)))
        }
        card.addChild(nav)

        def grid (tree Cal
            (Grid (props (id (model.gridTid())) (a11yLabel (model.monthLabel())))))

        def head (tree Cal (HeadRow))
        def c:int 0
        while (c < 7) {
            head.addChild((tree Cal (Weekday (UiDate.dayAbbr(c)))))
            c = (c + 1)
        }
        grid.addChild(head)

        def start:int (model.gridStart())
        def weeks:int (model.weekCount())
        def r:int 0
        while (r < weeks) {
            def week (tree Cal (Week))
            def i:int 0
            while (i < 7) {
                def day:int ((start + (r * 7)) + i)
                def p:[int] ([] _:int ( 0 0 0 ))
                UiDate.fromDays(day p)
                ; The label is the CONTROLLER's, affixes and all — "Today, "
                ; and ", selected" are how the reference announces state, and
                ; a second opinion about it here would be a second source of
                ; truth for what a reader hears.
                def cell (tree Cal
                    (Day (props (id (model.dayTid(day)))
                                (className (CalView.dayClass(model day)))
                                (a11yLabel (model.dayLabel(day))))
                        (DayNum (props (className (CalView.numClass(model day))))
                                ("" + (itemAt p 2)))))
                week.addChild(cell)
                i = (i + 1)
            }
            grid.addChild(week)
            r = (r + 1)
        }
        card.addChild(grid)
        return card
    }
}
