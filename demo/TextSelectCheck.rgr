; SPDX-License-Identifier: AGPL-3.0-or-later
; Selectable text, on Node: `ui:text:select`.
;
; The selection rules over indices (UiTextSel) with no page at all, which
; part of the string each broken line is (UiTextLines.offsetsOf), that the
; lines TextCtl selects over are where the display list draws them, and a
; TextCtl in a host: a press, a drag across lines, a double and a triple
; click, the band over the selected glyphs, what Ctrl+C copies and a press
; elsewhere letting it go.
Import "../src/UiHost.rgr"

class TextSelectCheck {
    def fails:int 0
    def passes:int 0

    fn ok:void (cond:boolean what:string) {
        if cond {
            passes = (passes + 1)
        } {
            fails = (fails + 1)
            print ("[FAIL] " + what)
        }
    }

    sfn near:boolean (a:double b:double) {
        def d:double (a - b)
        if (d < 0.0) {
            d = (0.0 - d)
        }
        return (d < 0.6)
    }

    ; --- the model ---------------------------------------------------------------

    fn model:void () {
        def s (new UiTextSel())
        s.setText("Build e22e565d1e (2026-10-04)")
        s.pointerDown(8 2 false)
        this.ok(((s.selectedText()) == "e22e565d1e") ("a double click takes the build hash: " + (s.selectedText())))
        s.pointerUp()
        s.pointerDown(0 1 false)
        s.pointerDrag(5)
        this.ok(((s.selectedText()) == "Build") ("a drag selects: " + (s.selectedText())))
        s.pointerUp()
        s.pointerDown(16 1 true)
        this.ok(((s.selectedText()) == "Build e22e565d1e") ("Shift+press extends from the anchor: " + (s.selectedText())))
        s.pointerUp()
        ; dragging back past the word a double click took keeps the word
        s.pointerDown(8 2 false)
        s.pointerDrag(1)
        this.ok(((s.selectedText()) == "Build e22e565d1e") ("a word drag backwards keeps the clicked word: " + (s.selectedText())))
        s.pointerUp()
        s.setText("Build e22e565d1e (2026-10-04)")
        this.ok((s.hasSelection()) "the same text keeps the selection")
        s.setText("other")
        this.ok(((s.hasSelection()) == false) "new text drops it")

        def p (new UiTextSel())
        p.setText("first line\nsecond line\nthird")
        p.pointerDown(14 3 false)
        this.ok(((p.selectedText()) == "second line") ("a triple click takes the paragraph: " + (p.selectedText())))
        p.pointerDrag(25)
        this.ok(((p.selectedText()) == "second line\nthird") ("a paragraph drag takes whole paragraphs: " + (p.selectedText())))
        p.pointerUp()
        p.clear()
        this.ok(((p.selectedText()) == "") "clear lets it go")
        p.selectAll()
        this.ok(((p.selectedText()) == p.text) "select all")

        ; a number with a point in it whole; letters are not joined
        this.ok((((UiWords.wordFrom("1250.00" 5)) == 0) && ((UiWords.wordTo("1250.00" 5)) == 7)) "a double click takes a number whole")
        this.ok((((UiWords.wordFrom("ada.example.com" 1)) == 0) && ((UiWords.wordTo("ada.example.com" 1)) == 3)) "but not words joined by a point")
        this.ok((((UiWords.wordFrom("v1.2b x" 2)) == 0) && ((UiWords.wordTo("v1.2b x" 2)) == 5)) "a number takes the letters it touches")
        ; a cluster is never split by a press inside it
        def e (new UiTextSel())
        e.setText("a👍🏽b")
        this.ok(((UiWords.snapStop(e.text 2)) == 1) "an index inside an emoji snaps to its start")
    }

    fn offsets:void () {
        def a:[string]
        push a "alpha beta"
        push a "gamma"
        def o:[int] (UiTextLines.offsetsOf("alpha beta gamma" a))
        this.ok((((itemAt o 0) == 0) && ((itemAt o 1) == 11)) "a wrap takes one space between lines")
        def b:[string]
        push b "one"
        push b ""
        push b "two  three"
        def o2:[int] (UiTextLines.offsetsOf("one\n\ntwo  three" b))
        this.ok(((((itemAt o2 0) == 0) && ((itemAt o2 1) == 4)) && ((itemAt o2 2) == 5)) "newlines and an empty paragraph")
    }

    ; --- on a page ---------------------------------------------------------------

    fn hostWith:UiHost (text:string align:string) {
        def h (new UiHost())
        h.setPageSize(400.0 300.0)
        h.addStyleSheet((".ui-text { width: 160px; padding: 6px; border: 1px solid #000000; } .msg { font-size: 16px; text-align: " + align + "; } .ui-text-selection { background-color: #bfdbfe; } .other { width: 40px; height: 20px; }"))
        h.addText("t" text "msg")
        h.addButton("b" "Other" "default")
        return h
    }

    fn el:EVGElement (h:UiHost id:string) {
        def page:EVGElement (unwrap h.lastPage)
        def hit@(optional):EVGElement (h.findEl(page id))
        if (null? hit) {
            print ("[FAIL] no element " + id)
            return (EVGElement.createDiv())
        }
        return (unwrap hit)
    }

    fn ctl:TextCtl (h:UiHost) {
        def c:TextCtl (new TextCtl())
        def maybe@(optional):UiCtl (h.ctlFor("t"))
        if (!null? maybe) {
            def u:UiCtl (unwrap maybe)
            if (u.tid == "t") {
                c = (cast u to:TextCtl)
            }
        }
        return c
    }

    ; The lines a selection is measured against are the lines drawn: same
    ; strings, same x (text-align included) and y.
    fn linesAreDrawn:void (align:string) {
        def h:UiHost (this.hostWith("Something went wrong while saving the presentation to the server" align))
        def dl:EVGDisplayList (h.displayList())
        def c:TextCtl (this.ctl(h))
        if (null? c.placed) {
            this.ok(false "placeText measured the run")
            return
        }
        def p:UiTextLines (unwrap c.placed)
        this.ok(((p.count()) > 2) ("the message wraps: " + (to_string (p.count()))))
        def k:int 0
        def i:int 0
        while (i < (array_length dl.cmds)) {
            def cmd:EVGDrawCmd (itemAt dl.cmds i)
            if ((cmd.kind == 3) && (k < (p.count()))) {
                def ln:UiTextLine (itemAt p.lines k)
                def s:string (substring p.text ln.start ln.end)
                this.ok((s == cmd.text) ((align + ": line text " + s) + " | " + cmd.text))
                this.ok((TextSelectCheck.near(ln.x cmd.x)) ((align + ": line x " + (to_string ln.x)) + " drawn at " + (to_string cmd.x)))
                this.ok((TextSelectCheck.near(ln.y cmd.y)) ((align + ": line y " + (to_string ln.y)) + " drawn at " + (to_string cmd.y)))
                k = (k + 1)
            }
            i = (i + 1)
        }
        this.ok((k == (p.count())) ("every line is a drawn line: " + (to_string k)))
    }

    fn pointer:void () {
        def text:string "Something went wrong while saving the presentation to the server"
        def h:UiHost (this.hostWith(text "left"))
        h.layout()
        def c:TextCtl (this.ctl(h))
        def p:UiTextLines (unwrap c.placed)
        def l0:UiTextLine (itemAt p.lines 0)
        def l1:UiTextLine (itemAt p.lines 1)
        ; a press before the first glyph, a drag to the middle of line 2
        h.pressAtWith((l0.x + 0.5) (l0.y + 4.0) 1 false)
        def midX:double (p.xAt((l1.start + 3)))
        h.pointerMove((midX + 0.5) (l1.y + 4.0))
        h.pointerUp()
        this.ok(((c.sel.selStart()) == 0) ("the drag starts where it was pressed: " + (to_string (c.sel.selStart()))))
        this.ok(((c.sel.selEnd()) == (l1.start + 3)) ("and ends on the next line where the pointer is: " + (to_string (c.sel.selEnd()))))
        this.ok(((h.copyText()) == (substring text 0 (l1.start + 3))) ("Ctrl+C copies across the line break: " + (h.copyText())))
        h.layout()
        def b0:EVGElement (this.el(h "t-sel0"))
        def b2:EVGElement (this.el(h "t-sel2"))
        this.ok((TextSelectCheck.near(b0.calculatedX l0.x)) "the band starts at the first glyph")
        this.ok((TextSelectCheck.near((b0.calculatedX + b0.calculatedWidth) p.right)) "and runs to the box's edge on a line it continues from")
        this.ok((TextSelectCheck.near((b2.calculatedX + b2.calculatedWidth) midX)) "the last band ends where the selection does")
        this.ok((TextSelectCheck.near(b2.calculatedY l1.y)) "on the line below")

        ; a double click on "wrong"
        def at:double ((p.xAt(16)) + 2.0)
        def lw:UiTextLine (itemAt p.lines (p.lineOf(16)))
        def y0:double (lw.y + 4.0)
        h.pressAtWith(at y0 2 false)
        h.pointerUp()
        this.ok(((h.copyText()) == "wrong") ("a double click takes a word: " + (h.copyText())))
        h.pressAtWith(at y0 3 false)
        h.pointerUp()
        this.ok(((h.copyText()) == text) "a triple click takes the paragraph")

        ; a press somewhere else lets it go
        h.layout()
        def btn:EVGElement (this.el(h "b"))
        h.pressAtWith((btn.calculatedX + 2.0) (btn.calculatedY + 2.0) 1 false)
        h.pointerUp()
        this.ok(((h.copyText()) == "") "a press elsewhere drops the selection")
        h.layout()
        this.ok(((this.el(h "t-sel0")).calculatedWidth == 0.0) "and its band")
    }

    ; Not selectable: a press does nothing to it and nothing is copied.
    fn optIn:void () {
        def h (new UiHost())
        h.setPageSize(300.0 100.0)
        def c:TextCtl (TextCtl.make("t" "Just a label" ""))
        h.add(c)
        h.layout()
        def run:EVGElement (this.el(h "t-text"))
        h.pressAtWith((run.calculatedX + 2.0) (run.calculatedY + 4.0) 2 false)
        this.ok(((h.copyText()) == "") "a text that is not selectable copies nothing")
        c.selectAll()
        this.ok(((c.selectedText()) == "") "and selects nothing")
    }

    ; A field's selection is what Ctrl+C copies while it has focus; never a
    ; password's.
    fn fieldCopy:void () {
        def h (new UiHost())
        h.setPageSize(300.0 100.0)
        def f:InputCtl (h.addInput("f" "Field"))
        f.setValue("hello world")
        f.build()
        h.layout()
        h.focus("f")
        h.keyWith("a" false true)
        this.ok(((h.copyText()) == "hello world") ("Ctrl+C in a field copies its selection: " + (h.copyText())))
        f.kind = "password"
        this.ok(((h.copyText()) == "") "a password copies nothing")
    }

    sfn main:void () {
        def c (new TextSelectCheck())
        c.model()
        c.offsets()
        c.linesAreDrawn("left")
        c.linesAreDrawn("center")
        c.pointer()
        c.optIn()
        c.fieldCopy()
        print ((to_string c.passes) + " passed, " + (to_string c.fails) + " failed")
        if (c.fails > 0) {
            print "RESULT FAIL"
        }
    }
}
