; SPDX-License-Identifier: AGPL-3.0-or-later
; A room's chat as models, on Node: `ui:chatmodel:check`.
;
; What a message says (UiChatText: blocks, spans, shortcodes, folding), the
; retro avatars (UiPixelAvatar: every sprite on its grid, the colours made
; from one base colour, the drawing), and the feed (UiChatFeed: order, who
; wrote what in a row, the days, threads, reactions, the window and "Latest
; messages").
Import "../src/UiChatText.rgr"
Import "../src/UiPixelAvatar.rgr"
Import "../src/UiChatFeed.rgr"

class ChatModelCheck {
    def fails:int 0
    def passes:int 0

    fn ok:void (cond:boolean what:string) {
        if cond {
            passes = (passes + 1)
        } {
            fails = (fails + 1)
            print ("[FAIL] " + what)
        }
    }

    ; the spans of one line as "kind:text[flags]" joined by |
    fn spans:string (t:UiChatText src:string) {
        def blocks:[UiChatBlock] (t.parse(src))
        if ((array_length blocks) == 0) {
            return "(none)"
        }
        def b:UiChatBlock (itemAt blocks 0)
        def out:string ""
        for b.spans s:UiChatSpan i {
            if (i > 0) {
                out = (out + "|")
            }
            def flags:string ""
            if s.bold {
                flags = (flags + "B")
            }
            if s.italic {
                flags = (flags + "I")
            }
            if s.strike {
                flags = (flags + "S")
            }
            out = (out + s.kind + ":" + s.text)
            if ((strlen flags) > 0) {
                out = (out + "[" + flags + "]")
            }
            if ((strlen s.href) > 0) {
                out = (out + "<" + s.href + ">")
            }
        }
        return out
    }

    fn kinds:string (t:UiChatText src:string) {
        def blocks:[UiChatBlock] (t.parse(src))
        def out:string ""
        for blocks b:UiChatBlock i {
            if (i > 0) {
                out = (out + ",")
            }
            out = (out + b.kind)
        }
        return out
    }

    fn eqs:void (got:string want:string what:string) {
        this.ok((got == want) (what + ": got " + got + " want " + want))
    }

    fn text:void () {
        def t (new UiChatText())
        this.eqs((this.spans(t "plain words")) "text:plain words" "plain")
        this.eqs((this.spans(t "a *bold* b")) "text:a |text:bold[B]|text: b" "star bold")
        this.eqs((this.spans(t "a **bold** b")) "text:a |text:bold[B]|text: b" "double star")
        this.eqs((this.spans(t "_it_ and ~gone~ and ~~gone2~~")) "text:it[I]|text: and |text:gone[S]|text: and |text:gone2[S]" "italic, strike")
        this.eqs((this.spans(t "*bold _both_*")) "text:bold [B]|text:both[BI]" "nested")
        this.eqs((this.spans(t "snake_case_name stays")) "text:snake_case_name stays" "_ in a word is a letter")
        this.eqs((this.spans(t "2 * 3 * 4")) "text:2 * 3 * 4" "lone stars")
        this.eqs((this.spans(t "run `rm *a*` now")) "text:run |code:rm *a*|text: now" "code is literal")
        this.eqs((this.spans(t "a ` b")) "text:a ` b" "a lone backtick")
        this.eqs((this.spans(t "\\*not bold\\*")) "text:*not bold*" "escaped")
        this.eqs((this.spans(t "see https://x.fi/a?b=1.")) "text:see |link:https://x.fi/a?b=1<https://x.fi/a?b=1>|text:." "bare link, full stop out")
        this.eqs((this.spans(t "(https://en.wikipedia.org/wiki/Foo_(bar))")) "text:(|link:https://en.wikipedia.org/wiki/Foo_(bar)<https://en.wikipedia.org/wiki/Foo_(bar)>|text:)" "link with brackets")
        this.eqs((this.spans(t "[the deck](https://sliqtly.com/s/abc123)")) "link:the deck<https://sliqtly.com/s/abc123>" "markdown link")
        this.eqs((this.spans(t "<https://x.fi|X site>")) "link:X site<https://x.fi>" "slack link")
        this.eqs((this.spans(t "[not](a link)")) "text:[not](a link)" "not a url")
        this.eqs((this.spans(t "hi @Ada_L, see #pay-817.")) "text:hi |mention:Ada_L|text:, see |channel:pay-817|text:." "mention and channel")
        this.eqs((this.spans(t "mail ada@x.fi")) "text:mail ada@x.fi" "an address is no mention")
        this.eqs((this.spans(t "issue #42")) "text:issue #42" "a number is no channel")
        def thumbs:string (t.emoji("thumbs_up"))
        this.ok(((indexOf thumbs "👍") == 0) ("a catalogue name: " + thumbs))
        this.ok(((t.emoji("+1")) == thumbs) "Slack's +1 is the catalogue's thumbs up")
        this.eqs((this.spans(t "ok :+1: :tada: :nope:")) ("text:ok |emoji:" + thumbs + "<+1>|text: |emoji:🎉<tada>|text: :nope:") "shortcodes")
        this.ok(((t.emoji("Fire")) == "🔥") "shortcodes ignore case")
        this.ok(((t.codeFor("🎉")) == "tada") "an emoji's shortcode")
        def sug:[string] (t.suggest("thu" 5))
        this.ok(((array_length sug) > 0) "suggestions for thu")
        this.ok(((itemAt sug 0) == ("thumbsup\t" + thumbs)) ("aliases first: " + (itemAt sug 0)))
        def up:[string] (t.suggest("rocket" 3))
        this.ok(((itemAt up 0) == "rocket\t🚀") "rocket")

        this.eqs((this.kinds(t "one\n\n> quoted\n- item\n* item2\n1. first\n12. twelfth")) "p,gap,quote,li,li,ol,ol" "line kinds")
        def ol:[UiChatBlock] (t.parse("12. twelfth"))
        this.ok(((itemAt ol 0).num == 12) "ol number")
        this.eqs((this.spans(t "> *quoted*")) "text:quoted[B]" "quote spans")
        this.eqs((this.kinds(t "\n\nbody\n\n")) "p" "empty lines at the ends")
        def code:[UiChatBlock] (t.parse("before\n```js\nlet a = *b*;\n  indented\n```\nafter"))
        this.eqs((this.kinds(t "before\n```js\nlet a = *b*;\n  indented\n```\nafter")) "p,code,p" "fence")
        def cb:UiChatBlock (itemAt code 1)
        this.ok((cb.lang == "js") ("lang: " + cb.lang))
        this.ok((cb.text == "let a = *b*;\n  indented") ("code kept as typed: " + cb.text))
        def one:[UiChatBlock] (t.parse("```npm run build```"))
        this.ok((((itemAt one 0).kind == "code") && ((itemAt one 0).text == "npm run build")) "fence on one line")
        def open:[UiChatBlock] (t.parse("```\nnever closed"))
        this.ok(((itemAt open 0).text == "never closed") "a fence never closed runs to the end")

        def em:[UiChatBlock] (t.parse("[[slides:AbC123xyz#3]]"))
        def e0:UiChatBlock (itemAt em 0)
        this.ok((((e0.kind == "embed") && (e0.deck == "AbC123xyz")) && (e0.slide == 3)) "slides embed")
        def ul:[UiChatBlock] (t.parse("https://sliqtly.com/s/AbC123xyz"))
        this.ok((((itemAt ul 0).kind == "embed") && ((itemAt ul 0).deck == "AbC123xyz")) "a share link alone embeds")
        this.eqs((this.kinds(t "see https://sliqtly.com/s/AbC123xyz")) "p" "a share link in words is a link")
        this.eqs((this.kinds(t "https://sliqtly.com/s/AbC123xyz?slides=1,2")) "p" "a picked view is a link")
        this.eqs((this.kinds(t "[[slides:no]]")) "p" "a bad deck id")

        def long:string ""
        def k:int 0
        while (k < 20) {
            long = (long + "line " + (to_string k) + "\n")
            k = (k + 1)
        }
        this.ok((t.isLong(long)) "20 lines fold")
        this.ok(((t.isLong("short")) == false) "short does not")
        def cl:string (t.clip(long))
        this.ok(((UiChatText.lineCount(cl)) == 8) ("clipped to 8 lines: " + (to_string (UiChatText.lineCount(cl)))))
        def fenced:string ("```\n" + long + "```")
        def cf:string (t.clip(fenced))
        this.ok((UiChatText.endsWithStr(cf "\n```")) "a fence cut open is closed")
        this.eqs((this.kinds(t cf)) "code" "the clipped fence is still one block")
        def oneLong:string ""
        k = 0
        while (k < 300) {
            oneLong = (oneLong + "word ")
            k = (k + 1)
        }
        def ol2:string (t.clip(oneLong))
        this.ok((((strlen ol2) <= 702) && (UiChatText.endsWithStr(ol2 "…"))) ("one long line cut at a space: " + (to_string (strlen ol2))))

        def ms:[string] (t.mentions("@Claude do it, @Ada and @Claude again"))
        this.ok(((join ms ",") == "Claude,Ada") ("mentions: " + (join ms ",")))
        this.ok(((t.preview("> *hi* @Ada\nmore" 40)) == "hi @Ada") ("preview: " + (t.preview("> *hi* @Ada\nmore" 40))))
    }

    fn avatars:void () {
        def names:[string] (UiPixelAvatar.names())
        this.ok(((array_length names) >= 10) "ten characters at least")
        for names nm:string i {
            def grid:[string] (UiPixelAvatar.grid(nm))
            this.ok(((array_length grid) == 12) (nm + ": 12 rows"))
            for grid row:string r {
                this.ok(((strlen row) == 12) (nm + " row " + (to_string r) + ": 12 wide"))
                this.ok((UiPixelAvatar.knownChars(row)) (nm + " row " + (to_string r) + ": known colours only"))
            }
        }
        this.ok(((array_length (UiPixelAvatar.grid("robot"))) == 12) "the robot is there")
        this.ok(((UiPixelAvatar.has("nope")) == false) "an unknown name")
        this.ok(((UiPixelAvatar.pick("nope" "p-ada")) != "nope") "an unknown name gets one of the characters")
        this.ok(((UiPixelAvatar.pick("" "p-ada")) == (UiPixelAvatar.pick("" "p-ada"))) "the same person, the same character")
        this.ok(((UiPixelAvatar.pick("ghost" "p-ada")) == "ghost") "a chosen one is kept")
        this.ok(((UiPixelAvatar.shade("#808080" 0.5)) == "#c0c0c0") ("lighter: " + (UiPixelAvatar.shade("#808080" 0.5))))
        this.ok(((UiPixelAvatar.shade("#808080" -0.5)) == "#404040") ("darker: " + (UiPixelAvatar.shade("#808080" -0.5))))
        this.ok(((UiPixelAvatar.shade("bad" 0.5)) == (UiPixelAvatar.shade((UiPixelAvatar.defaultColor()) 0.5))) "a bad colour is the default")
        def svg:string (UiPixelAvatar.svg("knight" "#2563eb"))
        this.ok(((indexOf svg "<svg") == 0) "an svg document")
        this.ok(((indexOf svg "viewBox=\"0 0 12 12\"") > 0) "on the 12 grid")
        this.ok(((indexOf svg "#2563eb") > 0) "in its base colour")
        this.ok(((indexOf svg (UiPixelAvatar.shade("#2563eb" -0.55))) > 0) "with its outline shade")
        this.ok(((UiPixelAvatar.svg("knight" "#2563eb")) == svg) "drawn the same each time")
        this.ok(((UiPixelAvatar.runs("..bb.bbb....")) == "M2 0h2v1h-2zM5 0h3v1h-3z") ("runs: " + (UiPixelAvatar.runs("..bb.bbb...."))))
        this.ok(((array_length (UiPixelAvatar.palette())) >= 10) "colours to choose from")
    }

    ; a message for the feed
    fn msg:UiFeedMsg (id:string seq:int who:string at:double text:string) {
        def m (new UiFeedMsg())
        m.id = id
        m.seq = seq
        m.who = who
        m.name = who
        m.at = at
        m.text = text
        return m
    }

    fn feed:void () {
        def f (new UiChatFeed())
        f.me = "ann"
        ; times in the host's local clock: ms; the host gives the day of each
        def day:double 86400000.0
        def t0:double (20000.0 * day)
        f.put((this.msg("c" 3 "bob" (t0 + 120000.0) "third")))
        f.put((this.msg("a" 1 "ann" (t0 + 1000.0) "first")))
        f.put((this.msg("b" 2 "ann" (t0 + 60000.0) "second")))
        this.ok(((f.count()) == 3) "three")
        this.ok((((f.at(0)).id == "a") && ((f.at(2)).id == "c")) "kept in seq order")
        this.ok(((f.lastSeq()) == 3) "last seq")
        ; the same id again is a change, not a new one
        def edit:UiFeedMsg (this.msg("b" 2 "ann" (t0 + 60000.0) "second, edited"))
        edit.edited = true
        f.put(edit)
        this.ok((((f.count()) == 3) && ((f.at(1)).text == "second, edited")) "a change replaces")
        ; who wrote in a row: the head only where the writer or the day changes, or 5 minutes pass
        f.put((this.msg("d" 4 "bob" (t0 + 720000.0) "ten minutes on")))
        f.put((this.msg("e" 5 "bob" (t0 + day + 1000.0) "next day")))
        def rows:[UiFeedRow] (f.layout(0 0))
        def shape:string ""
        for rows r:UiFeedRow i {
            if (i > 0) {
                shape = (shape + ",")
            }
            shape = (shape + r.kind)
            if (r.kind == "msg") {
                if r.head {
                    shape = (shape + "+")
                }
                shape = (shape + (f.at(r.index)).id)
            }
        }
        this.eqs(shape "day,msg+a,msgb,msg+c,msg+d,day,msg+e" "heads and days")
        def dayRow:UiFeedRow (itemAt rows 0)
        this.ok((dayRow.day == 20000) ("the day of the first: " + (to_string dayRow.day)))
        ; a thread's root counts; replies are not in the top level
        def root:UiFeedMsg (f.at(0))
        root.replies = 2
        push root.repliers "bob"
        this.ok((((f.find("a")).replies) == 2) "found by id")
        def reply:UiFeedMsg (this.msg("r" 6 "bob" (t0 + day + 2000.0) "in the thread"))
        reply.thread = "a"
        this.ok(((f.put(reply)) == false) "a reply is not a top-level message")
        this.ok(((f.count()) == 5) "still five")
        ; reactions
        def m:UiFeedMsg (f.at(4))
        m.setReactions("👍\tann,bob\n🎉\tbob" "ann")
        this.ok(((array_length m.reactEmoji) == 2) "two reactions")
        this.ok((((itemAt m.reactCount 0) == 2) && (itemAt m.reactMine 0)) "two thumbs, one mine")
        this.ok(((itemAt m.reactMine 1) == false) "the party is not mine")
        ; the window: the reader at the end follows; scrolled up, new ones count
        def g (new UiChatFeed())
        g.me = "ann"
        def k:int 1
        while (k <= 30) {
            g.put((this.msg(("m" + (to_string k)) k "bob" (t0 + ((to_double k) * 1000.0)) "x")))
            k = (k + 1)
        }
        this.ok(g.atEnd "at the end at first")
        g.scrolled(false)
        g.put((this.msg("m31" 31 "bob" (t0 + 31000.0) "new")))
        this.ok(((g.unseen) == 1) "one new below the reader")
        this.ok(((g.latestLabel("Latest messages")) == "Latest messages") "the jump button shows")
        g.put((this.msg("m32" 32 "ann" (t0 + 32000.0) "mine")))
        this.ok(((g.unseen) == 1) "one's own does not count")
        g.toEnd()
        this.ok((g.atEnd && ((g.unseen) == 0)) "back at the end")
        this.ok(((g.latestLabel("Latest messages")) == "") "no jump at the end")
        ; a gap in seq: what to ask for
        this.ok(((g.missingAfter(35)) == 32) "a message numbered 35 after 32: ask after 32")
        this.ok(((g.missingAfter(33)) == -1) "33 follows 32")
        ; the unread line: messages after the one last read
        g.readUpTo = 30
        def r2:[UiFeedRow] (g.layout(0 0))
        def unreadAt:int -1
        for r2 rr:UiFeedRow ri {
            if (rr.kind == "new") {
                unreadAt = ri
            }
        }
        this.ok((unreadAt > 0) "a New line")
        def after:UiFeedRow (itemAt r2 (unreadAt + 1))
        this.ok(((g.at(after.index)).seq == 31) "before the first unread")
        ; older pages come first
        def h (new UiChatFeed())
        h.put((this.msg("x" 10 "bob" t0 "ten")))
        h.put((this.msg("y" 9 "bob" t0 "nine")))
        this.ok(((h.firstSeq()) == 9) "first seq")
        ; labels
        this.ok(((UiChatFeed.dayLabel(20000 20000 "Today" "Yesterday")) == "Today") "today")
        this.ok(((UiChatFeed.dayLabel(19999 20000 "Today" "Yesterday")) == "Yesterday") "yesterday")
        this.ok(((UiChatFeed.dayLabel(19000 20000 "Today" "Yesterday")) == (UiDate.longLabel(2022 1 8))) ("a long label: " + (UiChatFeed.dayLabel(19000 20000 "Today" "Yesterday"))))
        this.ok(((UiChatFeed.clock(((15.0 * 3600000.0) + (9.0 * 60000.0)) true)) == "15:09") "24 h")
        this.ok(((UiChatFeed.clock(((15.0 * 3600000.0) + (9.0 * 60000.0)) false)) == "3:09 PM") "12 h")
        this.ok(((UiChatFeed.clock((9.0 * 60000.0) false)) == "12:09 AM") "after midnight")
        this.ok(((UiChatFeed.ago(90000.0)) == "1 minute ago") ("ago: " + (UiChatFeed.ago(90000.0))))
        this.ok(((UiChatFeed.ago((3.0 * day))) == "3 days ago") "days ago")
    }

    sfn main:void () {
        def c (new ChatModelCheck())
        c.text()
        c.avatars()
        c.feed()
        print ((to_string c.passes) + " passed, " + (to_string c.fails) + " failed")
        if (c.fails > 0) {
            print "RESULT FAIL"
        }
    }
}
