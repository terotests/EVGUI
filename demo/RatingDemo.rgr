; SPDX-License-Identifier: AGPL-3.0-or-later

; =============================================================================
; RatingDemo — ReUI's Rating, one card per pattern
; =============================================================================
; The reference is ReUI's Rating page (reui.io/components/rating) and the two
; screenshots of it kept with the brief. Six cards:
;
;   1. sizes            rating 4 at sm, default and lg, stacked and centred
;   2. review summary   "4.6", a partial fifth star (60%), "Based on 200
;                       reviews", a rule, and five rows of label / yellow
;                       progress bar / count
;   3. interactive      hover previews, a click sets, the arrows step, and
;                       the value label ("4.0") follows
;   4. half stars       the same at precision 0.5: each star is two targets
;   5. read-only        a read-only rating (a picture, role="img") next to an
;                       editable one (a slider)
;   6. ten stars        maxRating 10
;
; THE ARITHMETIC IS NOT HERE. Every row of stars is a `RatingCtl`, which owns
; the value, the preview, the precision, the keys and what the row is to a
; reader; this file only draws what `fillAt(i)` says and routes the pointer
; and the keyboard to the controller that owns the target.
;
; The pointer and the keyboard are handlers in the tree: `(on press …)` on a
; star's hit target, `(on key …)` and `(on leave …)` on the row. UiApp finds
; the handler from the hit element outwards, runs it, and rebuilds the tree
; and folds it into the live one (`EVGReconcile`, keyed by id) — the page
; neither routes an id to its owner nor calls a rebuild itself.
; =============================================================================

Import "../src/RatingCtl.rgr"
Import "../src/UiApp.rgr"
Import "../src/UiCtl.rgr"
Import "../src/UiTree.rgr"
Import "pkg:evg/EVGElement.rgr"
Import "pkg:evg/EVGUnit.rgr"
Import "pkg:evg/EVGLayout.rgr"
Import "pkg:evg/EVGDisplayList.rgr"
Import "pkg:evg/EVGStyleSheet.rgr"
Import "pkg:evg/EVGTransition.rgr"
Import "pkg:evg/EVGA11yTree.rgr"
Import "pkg:evg/EVGA11yFromTree.rgr"
Import "pkg:evg/EVGHitTest.rgr"
Import "pkg:evg/EVGReconcile.rgr"

treefactory Rt {
    child addChild
    text  textContent
    on    events.bind
    ; the page's own pieces, written as tags: each is a method of the demo
    component StarRow  this.stars
    component Rated    this.withValue
    component DistLine this.distRow
    component Example  this.card

    tag Page     EVGElement (props (className "rt-page"))
    tag Card     EVGElement (props (className "rt-card"))
    tag Caption  EVGElement (props (className "rt-caption") (elementType 1) (role "heading") (a11yLevel 2))
    tag CapRule  EVGElement (props (className "rt-caption-rule") (a11yHidden true))
    tag Stage    EVGElement (props (className "rt-stage"))
    tag Col      EVGElement (props (className "rt-col"))
    tag Row      EVGElement (props (className "rt-row"))
    ; The row of stars. RatingCtl.applyTo gives it its role and values.
    tag Stars    EVGElement (props (className "rt-stars"))
    tag Star     EVGElement (props (className "rt-star") (a11yHidden true))
    ; Lucide's star, twice: the outline, and the filled one inside the clip.
    tag Outline  EVGElement (props (className "rt-star-empty") (tagName "path") (elementType 3) (viewBox "0 0 24 24") (svgPath "M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z") (a11yHidden true))
    tag Clip     EVGElement (props (className "rt-star-clip") (a11yHidden true))
    tag Filled   EVGElement (props (className "rt-star-full") (tagName "path") (elementType 3) (viewBox "0 0 24 24") (svgPath "M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z") (a11yHidden true))
    tag Hit      EVGElement (props (className "rt-hit") (a11yHidden true))
    ; showValue. Hidden from the mirror: the slider's valuetext says it.
    tag Value    EVGElement (props (className "rt-value") (elementType 1) (a11yHidden true))
    tag Big      EVGElement (props (className "rt-big") (elementType 1) (role "text"))
    tag Muted    EVGElement (props (className "rt-muted") (elementType 1) (role "text"))
    tag Hint     EVGElement (props (className "rt-hint") (elementType 1) (role "text"))
    tag PairLbl  EVGElement (props (className "rt-pair-label") (elementType 1) (role "text"))
    tag Rule     EVGElement (props (className "rt-rule") (role "separator"))
    tag Dist     EVGElement (props (className "rt-dist"))
    tag DistRow  EVGElement (props (className "rt-dist-row"))
    tag DistLbl  EVGElement (props (className "rt-dist-label") (elementType 1) (a11yHidden true))
    tag DistCnt  EVGElement (props (className "rt-dist-count") (elementType 1) (a11yHidden true))
    tag Bar      EVGElement (props (className "rt-bar") (role "progressbar"))
    tag BarFill  EVGElement (props (className "rt-bar-fill") (a11yHidden true))
}

; One bar of the review summary's distribution.
class RtDist {
    def stars:int 0
    def percent:int 0
    def count:int 0
    Constructor (s:int p:int c:int) {
        stars = s
        percent = p
        count = c
    }
}

class RatingDemo extends UiApp {
    ; the summary's distribution, five stars first
    def dists:[RtDist]

    ; 1. sizes — read-only, rating 4.
    def sizeSm:RatingCtl (new RatingCtl())
    def sizeMd:RatingCtl (new RatingCtl())
    def sizeLg:RatingCtl (new RatingCtl())
    ; 2. the summary's 4.6.
    def summary:RatingCtl (new RatingCtl())
    ; 3. interactive.
    def rate:RatingCtl (new RatingCtl())
    ; 4. half stars.
    def half:RatingCtl (new RatingCtl())
    ; 5. read-only next to editable.
    def fixed:RatingCtl (new RatingCtl())
    def edit:RatingCtl (new RatingCtl())
    ; 6. ten stars.
    def ten:RatingCtl (new RatingCtl())

    def sheet@(optional):EVGStyleSheet
    def transitions:EVGTransition (new EVGTransition())
    def layout@(optional):EVGLayout
    def hovered:string ""
    def pressed:string ""
    def focused:string ""
    def pageW:double 900.0
    def pageH:double 800.0

    Constructor () {
    }

    fn init:void (css:string) {
        def s (new EVGStyleSheet())
        s.parse(css)
        sheet = s
        sizeSm.setup("rt-size-sm" "Small" 4.0 5 true)
        sizeMd.setup("rt-size-md" "Default" 4.0 5 true)
        sizeLg.setup("rt-size-lg" "Large" 4.0 5 true)
        summary.setup("rt-summary-stars" "Average rating" 4.6 5 true)
        rate.setup("rt-rate" "Your rating" 4.0 5 false)
        half.setup("rt-half" "Half-star rating" 3.5 5 false)
        fixed.setup("rt-fixed" "Read-only rating" 3.5 5 true)
        edit.setup("rt-edit" "Editable rating" 3.0 5 false)
        ten.setup("rt-ten" "Rating out of ten" 7.0 10 false)
        half.precision = 0.5
        push dists (new RtDist(5 62 124))
        push dists (new RtDist(4 22 45))
        push dists (new RtDist(3 9 18))
        push dists (new RtDist(2 4 8))
        push dists (new RtDist(1 3 5))
        this.build()
        this.laidOut()
    }

    fn ctls:[RatingCtl] () {
        def a:[RatingCtl]
        push a sizeSm
        push a sizeMd
        push a sizeLg
        push a summary
        push a rate
        push a half
        push a fixed
        push a edit
        push a ten
        return a
    }

    ; --- the look ---------------------------------------------------------------

    sfn px:string (v:double) {
        def hundredths:int (to_int ((v * 100.0) + 0.5))
        def whole:int (idiv hundredths 100)
        def frac:int (hundredths - (whole * 100))
        if (frac == 0) {
            return ((to_string whole) + "px")
        }
        def f:string (to_string frac)
        if (frac < 10) {
            f = ("0" + f)
        }
        return ((to_string whole) + "." + f + "px")
    }

    sfn sizePx:double (size:string) {
        if (size == "sm") {
            return 14.0
        }
        if (size == "lg") {
            return 22.0
        }
        return 18.0
    }

    ; One row of stars, as RatingCtl says it is filled.
    fn stars:EVGElement (c:RatingCtl size:string) {
        def row (tree Rt (Stars (props (id c.tid))
            (on key (fn:void (e:UiEvent) {
                if (c.takesKey(e.key)) {
                    c.keyDown(c.tid e.key)
                } {
                    e.handled = false
                }
            }))
            ; the pointer left a star of this row (or the row)
            (on leave (fn:void (e:UiEvent) {
                def before:double c.hoverValue
                c.unhover()
                e.handled = (c.hoverValue != before)
            }))))
        c.applyTo(row)
        def w:double (RatingDemo.sizePx(size))
        def starCls:string "rt-star"
        def fullCls:string "rt-star-full"
        if (size != "") {
            starCls = ("rt-star rt-star-" + size)
            fullCls = ("rt-star-full rt-star-full-" + size)
        }
        def i:int 0
        while (i < c.maxRating) {
            def sid:string (c.starTid(i))
            def star (tree Rt (Star (props (id sid) (className starCls))
                (Outline (props (id (sid + "-outline"))))))
            def f:double (c.fillAt(i))
            if (f > 0.0) {
                def clip (tree Rt (Clip (props (id (sid + "-clip")))
                    (Filled (props (id (sid + "-full")) (className fullCls)))))
                UiTree.inline(clip "width" (RatingDemo.px((f * w))))
                star.addChild(clip)
            }
            if (c.editable()) {
                if (c.halves()) {
                    star.addChild((this.hit(c (c.hitTid(i 0)) "rt-hit rt-hit-left")))
                    star.addChild((this.hit(c (c.hitTid(i 1)) "rt-hit rt-hit-right")))
                } {
                    star.addChild((this.hit(c (c.hitTid(i 1)) "rt-hit")))
                }
            }
            row.addChild(star)
            i = (i + 1)
        }
        return row
    }

    ; One hit target: a hover previews its value, a press sets it and puts
    ; the focus on the row.
    fn hit:EVGElement (c:RatingCtl hid:string cls:string) {
        return (tree Rt (Hit (props (id hid) (className cls))
            (on hover (fn:void (e:UiEvent) {
                def before:double c.hoverValue
                c.hover(e.target)
                e.handled = (c.hoverValue != before)
            }))
            (on press (fn:void (e:UiEvent) {
                def f:string (c.activate(e.target))
                if ((strlen f) == 0) {
                    e.handled = false
                } {
                    focused = f
                }
            }))))
    }

    ; The stars and ReUI's showValue label after them.
    fn withValue:EVGElement (c:RatingCtl size:string) {
        def r (tree Rt (Row (props (id (c.tid + "-row")))))
        r.addChild((this.stars(c size)))
        def lbl:string (c.label())
        r.addChild((tree Rt (Value (props (id (c.tid + "-value"))) lbl)))
        return r
    }

    fn card:EVGElement (id:string caption:string example:EVGElement) {
        def cls:string "rt-card"
        if ((id == "rt-card-sizes") || (id == "rt-card-summary")) {
            cls = "rt-card rt-card-tall"
        }
        def c (tree Rt (Card (props (id id) (className cls))
            (Caption (props (id (id + "-caption"))) caption)
            (CapRule)))
        def stage (tree Rt (Stage (props (id (id + "-stage")))))
        stage.addChild(example)
        c.addChild(stage)
        return c
    }

    fn distRow:EVGElement (d:RtDist) {
        def stars:int d.stars
        def percent:int d.percent
        def count:int d.count
        def k:string (to_string stars)
        def bar (tree Rt (Bar (props (id ("rt-dist-bar-" + k)))))
        def noun:string " stars, "
        if (stars == 1) {
            noun = " star, "
        }
        bar.a11yLabel = (k + noun + (to_string count) + " reviews")
        bar.a11yHasValue = true
        bar.a11yValueNow = percent
        bar.a11yHasRange = true
        bar.a11yValueMin = 0
        bar.a11yValueMax = 100
        def fill (tree Rt (BarFill (props (id ("rt-dist-fill-" + k)))))
        UiTree.inline(fill "width" ((to_string percent) + "%"))
        bar.addChild(fill)
        def row (tree Rt (DistRow (props (id ("rt-dist-row-" + k)))
            (DistLbl (props (id ("rt-dist-label-" + k))) k)))
        row.addChild(bar)
        def cnt:string (to_string count)
        row.addChild((tree Rt (DistCnt (props (id ("rt-dist-count-" + k))) cnt)))
        return row
    }

    fn page:EVGElement () {
        ; 1. Sizes.
        def ex1 (tree Rt (Col (props (id "rt-sizes") (className "rt-col rt-sizes"))
            (StarRow sizeSm "sm")
            (StarRow sizeMd "")
            (StarRow sizeLg "lg")))

        ; 2. The review summary.
        def score:string (RatingCtl.oneDecimal(summary.value))
        def ex2 (tree Rt (Col (props (id "rt-summary") (className "rt-summary"))
            (Col (props (id "rt-summary-head") (className "rt-col rt-summary-head"))
                (Big (props (id "rt-summary-score")) score)
                (StarRow summary "sm")
                (Muted (props (id "rt-summary-count")) "Based on 200 reviews"))
            (Rule (props (id "rt-summary-rule")))
            (Dist (props (id "rt-dist"))
                (each dists d:RtDist (DistLine d)))))

        ; 3. Interactive.
        def ex3 (tree Rt (Col (props (id "rt-interactive") (className "rt-col rt-interactive"))
            (Rated rate "lg")
            (Hint (props (id "rt-rate-hint")) "Hover to preview, click or use the arrow keys")))

        ; 4. Half stars.
        def ex4 (tree Rt (Col (props (id "rt-halfstars") (className "rt-col rt-interactive"))
            (Rated half "lg")
            (Hint (props (id "rt-half-hint")) "Each star is two halves: steps of 0.5")))

        ; 5. Read-only next to editable.
        def ex5 (tree Rt (Col (props (id "rt-pairs") (className "rt-col rt-pairs"))
            (Row (props (id "rt-pair-fixed"))
                (PairLbl (props (id "rt-pair-fixed-label")) "Read-only")
                (Rated fixed ""))
            (Row (props (id "rt-pair-edit"))
                (PairLbl (props (id "rt-pair-edit-label")) "Editable")
                (Rated edit ""))))

        ; 6. Ten stars.
        def ex6 (tree Rt (Col (props (id "rt-tenstars") (className "rt-col rt-interactive"))
            (Rated ten "sm")))

        return (tree Rt (Page (props (id "rt-page"))
            (Example "rt-card-sizes" "Sizes: sm, default and lg" ex1)
            (Example "rt-card-summary" "Review summary" ex2)
            (Example "rt-card-interactive" "Interactive with value" ex3)
            (Example "rt-card-half" "Half-star precision" ex4)
            (Example "rt-card-readonly" "Read-only and editable" ex5)
            (Example "rt-card-ten" "Custom max: 10 stars" ex6)))
    }

    fn view:EVGElement () {
        return (this.page())
    }

    ; --- the host ----------------------------------------------------------------

    ; The controller that owns a target, or -1.
    fn ownerIndex:int (target:string) {
        if ((strlen target) == 0) {
            return -1
        }
        def all:[RatingCtl] (this.ctls())
        def i:int 0
        while (i < (array_length all)) {
            def c:RatingCtl (itemAt all i)
            if (c.owns(target)) {
                return i
            }
            i = (i + 1)
        }
        return -1
    }

    fn ctlAt:RatingCtl (i:int) {
        def all:[RatingCtl] (this.ctls())
        return (itemAt all i)
    }

    fn press:boolean (target:string) {
        return (this.dispatch("press" target))
    }

    fn key:boolean (k:string) {
        return (this.dispatchKey(focused k))
    }

    fn ownsKey:boolean (k:string) {
        def i:int (this.ownerIndex(focused))
        if (i < 0) {
            return false
        }
        def c:RatingCtl (this.ctlAt(i))
        return (c.takesKey(k))
    }

    ; The pointer moved onto `id`: `leave` for the row it was over, `hover`
    ; for the star it is over now. True when any preview changed.
    fn setHover:boolean (id:string) {
        hovered = id
        return (this.pointerOver(id))
    }

    fn setPressed:void (id:string) {
        pressed = id
    }

    fn setFocus:void (id:string) {
        focused = id
    }

    ; A pointer over a star that takes a click.
    fn cursorAt:string (px:double py:double) {
        def id:string (this.hitId(px py))
        def k:int (this.ownerIndex(id))
        if (k < 0) {
            return ""
        }
        def c:RatingCtl (this.ctlAt(k))
        if ((c.editable()) && ((c.valueFor(id)) >= 0.0)) {
            return "pointer"
        }
        return ""
    }

    ; For checks: the value, the preview and the label, per controller.
    fn stateJson:string () {
        def out:string "{"
        def all:[RatingCtl] (this.ctls())
        def i:int 0
        while (i < (array_length all)) {
            def c:RatingCtl (itemAt all i)
            if (i > 0) {
                out = (out + ",")
            }
            def hv:string "-1"
            if (c.hoverValue >= 0.0) {
                hv = (RatingCtl.short(c.hoverValue))
            }
            out = (out + "\"" + c.tid + "\":{\"value\":" + (RatingCtl.short(c.value)) + ",\"hover\":" + hv + ",\"label\":\"" + (c.label()) + "\",\"text\":\"" + (c.valueText()) + "\",\"editable\":" + (to_string (c.editable())) + "}")
            i = (i + 1)
        }
        return (out + "}")
    }

    fn markStates:void (el:EVGElement) {
        el.isHovered = false
        el.isPressed = false
        el.isFocused = false
        if ((strlen el.id) > 0) {
            if (el.id == hovered) {
                el.isHovered = true
            }
            if (el.id == pressed) {
                el.isPressed = true
            }
            if (el.id == focused) {
                el.isFocused = true
            }
        }
        def i:int 0
        while (i < (array_length el.children)) {
            def kid:EVGElement (itemAt el.children i)
            this.markStates(kid)
            i = (i + 1)
        }
    }

    fn contentBottom:double () {
        def r:EVGElement (unwrap root)
        def bottom:double 0.0
        def i:int 0
        while (i < (r.getChildCount())) {
            def c:EVGElement (r.getChild(i))
            def b:double (c.calculatedY + c.calculatedHeight)
            if (b > bottom) {
                bottom = b
            }
            i = (i + 1)
        }
        def pad:double 0.0
        if (!null? r.box) {
            def bx:EVGBox r.box
            def pb:EVGUnit bx.paddingBottom
            if (!null? pb) {
                if pb.isSet {
                    pad = pb.pixels
                }
            }
        }
        return (bottom + pad)
    }

    fn fitHeight:void (lay:EVGLayout) {
        def want:double (to_double (to_int ((this.contentBottom()) + 0.999)))
        def diff:double (want - pageH)
        if ((diff > 0.5) || (diff < -0.5)) {
            pageH = want
            def s:EVGStyleSheet (unwrap sheet)
            def r:EVGElement (unwrap root)
            UiTree.inline(r "height" ((to_string (to_int pageH)) + "px"))
            s.setViewport(pageW pageH false)
            s.applyTree(r "")
            lay.setPageSize(pageW pageH)
            lay.layout(r)
        }
    }

    fn laidOut:EVGLayout () {
        def r:EVGElement (unwrap root)
        def s:EVGStyleSheet (unwrap sheet)
        UiTree.inline(r "height" ((to_string (to_int pageH)) + "px"))
        s.setViewport(pageW pageH false)
        this.markStates(r)
        s.applyTree(r "")
        def t:EVGTransition transitions
        t.reconcileTree(r)
        if layout {
            def lay:EVGLayout (unwrap layout)
            if ((s.layoutClean()) == false) {
                lay.setPageSize(pageW pageH)
                lay.layout(r)
                this.fitHeight(lay)
            }
            return lay
        }
        ; A FRESH layout means the host gave the page a new size, and EVGLayout
        ; reads some of its last answers back as inputs (a flex-grown height,
        ; a stretched row's old inner size) — the cards kept their desktop
        ; height under the phone's `height: auto`. Forgotten first, as
        ; SeparatorDemo does.
        RatingDemo.forgetFlex(r)
        def fresh (new EVGLayout())
        fresh.setPageSize(pageW pageH)
        layout = fresh
        fresh.layout(r)
        this.fitHeight(fresh)
        return fresh
    }

    sfn forgetFlex:void (el:EVGElement) {
        el.calculatedFlexHeight = 0.0
        el.calculatedHeight = 0.0
        el.calculatedWidth = 0.0
        el.calculatedInnerHeight = 0.0
        el.calculatedInnerWidth = 0.0
        el.hasDefiniteHeight = false
        el.layoutClean = false
        def i:int 0
        while (i < (array_length el.children)) {
            RatingDemo.forgetFlex((itemAt el.children i))
            i = (i + 1)
        }
    }

    fn tick:boolean (dtMs:double) {
        def r:EVGElement (unwrap root)
        def t:EVGTransition transitions
        t.advanceTree(r dtMs)
        return (t.busy(r))
    }

    fn busyNow:boolean () {
        def r:EVGElement (unwrap root)
        def t:EVGTransition transitions
        return (t.busy(r))
    }

    fn displayListJson:string () {
        def lay:EVGLayout (this.laidOut())
        def r:EVGElement (unwrap root)
        def dl (new EVGDisplayList())
        dl.setTextEngine((lay.getTextEngine()))
        dl.build(r)
        return (dl.toJson())
    }

    fn hitId:string (px:double py:double) {
        this.laidOut()
        def r:EVGElement (unwrap root)
        def hit (new EVGHitTest())
        return (hit.idAt(r px py))
    }

    fn a11yJson:string (generation:int focusId:string) {
        this.laidOut()
        def r:EVGElement (unwrap root)
        def b (new EVGA11yFromTree())
        def t:EVGA11yTree (b.build(r "Rating demo" generation focusId))
        return (t.toJson())
    }

    fn a11yProblems:[string] () {
        this.laidOut()
        def r:EVGElement (unwrap root)
        def b (new EVGA11yFromTree())
        def t:EVGA11yTree (b.build(r "Rating demo" 1 ""))
        def out:[string] (t.lint())
        def i:int 0
        while (i < (array_length t.notes)) {
            push out (itemAt t.notes i)
            i = (i + 1)
        }
        return out
    }

    fn styleErrorCount:int () {
        def s:EVGStyleSheet (unwrap sheet)
        return (s.getErrorCount())
    }

    fn styleErrorAt:string (i:int) {
        def s:EVGStyleSheet (unwrap sheet)
        return (s.getError(i))
    }

    fn heightPx:double () {
        this.laidOut()
        return pageH
    }

    fn widthPx:double () {
        return pageW
    }
}
