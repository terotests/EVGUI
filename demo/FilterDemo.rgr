; SPDX-License-Identifier: AGPL-3.0-or-later

; =============================================================================
; FilterDemo — the filter bar, drawn, clickable, and filtering something
; =============================================================================
; `FilterCtl` owns the predicates, the rule tree and the chip text, and is
; measured against @tanstack/table-core in `conformance/oracle/filters_check.mjs`
; — 121 assertions. Nothing about any of that is decided again here.
;
; WHAT THIS FILE IS FOR. A controller nobody can click is the exact failure the
; input work was pulled up on: logic written and never wired to a surface, so
; the half that is missing looks identical from outside to the half that works.
; So this demo does not stop at drawing chips. IT SHOWS THE ROWS THAT SURVIVE.
; A filter bar whose result list never changes is a picture of a filter bar,
; and the only way to tell those apart is to put the answer on the screen next
; to the question.
;
; The chips are the ones in the reference screenshot: an assignee chip reading
; "has any of" over four people, and a priority chip reading "is Urgent". The
; four-value assignee chip is there because it is the one that collapses —
; three names and a "+1" — and a demo that never overflows never shows it.
; =============================================================================

Import "../src/FilterCtl.rgr"
Import "../src/MenuCtl.rgr"
Import "../src/UiCtl.rgr"
Import "pkg:evg/EVGElement.rgr"
Import "pkg:evg/EVGLayout.rgr"
Import "pkg:evg/EVGDisplayList.rgr"
Import "pkg:evg/EVGStyleSheet.rgr"
Import "pkg:evg/EVGTransition.rgr"
Import "pkg:evg/EVGA11yTree.rgr"
Import "pkg:evg/EVGA11yFromTree.rgr"
Import "pkg:evg/EVGHitTest.rgr"

treefactory Flt {
    child addChild
    text  textContent

    tag Page     EVGElement (props (className "fd-page"))
    tag Title    EVGElement (props (className "fd-title") (elementType 1))
    tag Bar      EVGElement (props (className "fd-bar") (role "toolbar") (a11yLabel "Filters"))
    tag Chip     EVGElement (props (className "fd-chip") (role "group"))
    tag Part     EVGElement (props (className "fd-part") (role "button"))
    tag PartTxt  EVGElement (props (className "fd-part-text") (elementType 1) (a11yHidden true))
    tag OpTxt    EVGElement (props (className "fd-op-text") (elementType 1) (a11yHidden true))
    tag ValTxt   EVGElement (props (className "fd-val-text") (elementType 1) (a11yHidden true))
    ; The chip's actions button. An overlay ANCHOR, because the menu it opens
    ; is a surface placed against it — the dropdown demo's trigger, one size
    ; smaller.
    tag Menu     EVGElement (props (className "fd-menu") (isOverlayAnchor true) (role "button") (a11yFocusable true) (a11yHasPopup "menu"))
    tag MenuTxt  EVGElement (props (className "fd-menu-text") (elementType 1) (a11yHidden true))
    ; The actions menu itself. Drawn here, driven by MenuCtl — the controller
    ; the dropdown demo uses and five conformance specs measure against
    ; @radix-ui/react-dropdown-menu — so the keyboard is not written twice.
    tag MContent EVGElement (props (className "fd-mcontent") (isOverlay true) (overlaySide "bottom") (overlayAlign "end") (role "menu"))
    tag MSub     EVGElement (props (className "fd-mcontent fd-msub") (isOverlay true) (overlaySide "right") (overlayAlign "start") (role "menu"))
    tag MItem    EVGElement (props (className "fd-mitem") (role "menuitem") (a11yFocusable true))
    tag MSubItem EVGElement (props (className "fd-mitem") (isOverlayAnchor true) (role "menuitem") (a11yFocusable true) (a11yHasPopup "menu"))
    tag MRadio   EVGElement (props (className "fd-mitem") (role "menuitemradio") (a11yFocusable true))
    tag MLabel   EVGElement (props (className "fd-mlabel") (elementType 1))
    tag MHint    EVGElement (props (className "fd-mhint") (elementType 1) (a11yHidden true))
    tag MSep     EVGElement (props (className "fd-msep") (role "separator"))
    tag Add      EVGElement (props (className "fd-add") (role "button"))
    tag AddTxt   EVGElement (props (className "fd-add-text") (elementType 1) (a11yHidden true))
    tag List     EVGElement (props (className "fd-list") (role "listbox") (isOverlay true) (overlaySide "bottom") (overlayAlign "start"))
    tag Opt      EVGElement (props (className "fd-opt") (role "option"))
    tag OptTxt   EVGElement (props (className "fd-opt-text") (elementType 1) (a11yHidden true))
    tag Results  EVGElement (props (className "fd-results") (role "list") (a11yLabel "Matching tasks"))
    tag Row      EVGElement (props (className "fd-row") (role "listitem"))
    tag RowTxt   EVGElement (props (className "fd-row-text") (elementType 1) (a11yHidden true))
    tag Count    EVGElement (props (className "fd-count") (role "status") (elementType 1))
    tag Note     EVGElement (props (className "fd-note") (elementType 1))
}

class FilterDemo {
    def model:FilterCtl (new FilterCtl())
    def root@(optional):EVGElement
    def sheet@(optional):EVGStyleSheet
    def transitions:EVGTransition (new EVGTransition())
    def layout@(optional):EVGLayout
    def hovered:string ""
    def pressed:string ""
    def focused:string ""
    ; The chip actions menu. ONE controller, rebuilt for whichever chip's
    ; button opened it, because the rows it offers depend on that chip's field
    ; (a multi-select field has "has all of", an option field "is not").
    ; `menuRule` is that chip; "" when no menu is open.
    def menu:MenuCtl (new MenuCtl())
    def menuRule:string ""
    def pageW:double 900.0
    def pageH:double 460.0
    ; The titles, parallel to the controller's record keys, so a result row can
    ; say something a person recognises. Held here rather than in FilterCtl
    ; because a filter does not need to know what a row is called.
    def rowKeys:[string]
    def rowTitles:[string]

    Constructor () {
        def a:[string]
        def b:[string]
        rowKeys = a
        rowTitles = b
    }

    fn init:void (css:string) {
        def s (new EVGStyleSheet())
        s.parse(css)
        sheet = s

        model.tid = "filters"
        model.name = "Filters"

        model.addField("assignee" "Assignee" "multi")
        model.addOption("assignee" "ada" "Ada")
        model.addOption("assignee" "grace" "Grace")
        model.addOption("assignee" "alan" "Alan")
        model.addOption("assignee" "katherine" "Katherine")

        model.addField("priority" "Priority" "option")
        model.addOption("priority" "urgent" "Urgent")
        model.addOption("priority" "high" "High")
        model.addOption("priority" "medium" "Medium")
        model.addOption("priority" "low" "Low")

        ; The same six rows the oracle measured against, so what is on the
        ; screen and what the gate checks are the same data.
        this.addRow("r1" "Ship the parser" "ada" "urgent")
        this.addRow("r2" "Fix the lexer" "grace" "high")
        this.addRow("r3" "Write the docs" "" "low")
        this.addRow("r4" "Ship the linker" "alan" "urgent")
        this.addRow("r5" "Audit the tests" "katherine" "medium")
        this.addRow("r6" "Trim the atlas" "ada" "low")

        ; The two chips from the screenshot, with the assignee one holding four
        ; values so the "+1" overflow is on the page rather than only in a gate.
        model.addRule("seed-1" "" "assignee" "has_any_of")
        model.setValues("seed-1" ([] _:string ( "ada" "grace" "alan" "katherine" )))
        model.addRule("seed-2" "" "priority" "is")
        model.setValues("seed-2" ([] _:string ( "urgent" )))

        root = (this.page())
    }

    fn addRow:void (key:string title:string who:string priority:string) {
        model.addRecord(key)
        def people:[string]
        if ((strlen who) > 0) {
            push people who
        }
        model.setCell(key "assignee" people)
        model.setCell(key "priority" ([] _:string ( priority )))
        push rowKeys key
        push rowTitles title
    }

    fn titleOf:string (key:string) {
        def i:int 0
        while (i < (array_length rowKeys)) {
            if ((itemAt rowKeys i) == key) {
                return (itemAt rowTitles i)
            }
            i = (i + 1)
        }
        return key
    }

    ; --- the look ------------------------------------------------------------

    fn chipClass:string (id:string) {
        def cls:string "fd-chip"
        if (model.isOpen(id)) {
            cls = (cls + " fd-chip-open")
        }
        if (model.activeId == id) {
            cls = (cls + " fd-chip-active")
        }
        return cls
    }

    fn optClass:string (ruleId:string value:string) {
        if (model.isChosen(ruleId value)) {
            return "fd-opt fd-opt-chosen"
        }
        return "fd-opt"
    }

    fn optTextClass:string (ruleId:string value:string) {
        ; Its own token: EVGStyleSheet has no descendant selectors, so the
        ; label cannot inherit "I am inside a chosen option" from its parent.
        if (model.isChosen(ruleId value)) {
            return "fd-opt-text fd-opt-text-chosen"
        }
        return "fd-opt-text"
    }

    fn page:EVGElement () {
        def page (tree Flt (Page))
        page.addChild((tree Flt (Title "Tasks")))

        def bar (tree Flt (Bar (props (id "fd-bar"))))
        def rootNode:FilterNode (model.node("root"))
        def i:int 0
        while (i < (array_length rootNode.kids)) {
            def id:string (itemAt rootNode.kids i)
            def rule:FilterNode (model.node(id))
            def f:FilterField (model.field(rule.path))

            def chip (tree Flt
                (Chip (props (id id)
                             (className (this.chipClass(id)))
                             (a11yLabel (model.chipText(id))))))

            chip.addChild((tree Flt
                (Part (props (id (id + "-field")) (a11yLabel f.label) (a11yHasPopup "menu"))
                    (PartTxt f.label))))
            chip.addChild((tree Flt
                (Part (props (id (id + "-op")) (a11yLabel (FilterCtl.operatorLabel(rule.operator))) (a11yHasPopup "menu"))
                    (OpTxt (FilterCtl.operatorLabel(rule.operator))))))
            def valuePart (tree Flt
                (Part (props (id (id + "-value")) (a11yLabel (model.valueText(id))) (a11yHasPopup "listbox"))
                    (ValTxt (model.valueText(id)))))
            chip.addChild(valuePart)
            ; A vertical ellipsis, one glyph alone in its own box. The measurer
            ; falls back to half an em outside 32-126, which spaces a RUN
            ; wrongly; a single centred glyph is unaffected, which is what this
            ; is — the same reasoning the calendar's chevrons are under.
            ;
            ; It OPENS A MENU. It used to delete the chip outright, which is
            ; not what three dots promise: the reference's button opens the
            ; chip's actions, and removing is one of them.
            def menuOpen:boolean (this.menuOpenFor(id))
            def menuCls:string "fd-menu"
            def menuExp:int (EVGA11yTri.no())
            if menuOpen {
                menuCls = "fd-menu fd-menu-open"
                menuExp = (EVGA11yTri.yes())
            }
            chip.addChild((tree Flt
                (Menu (props (id (FilterDemo.triggerIdFor(id))) (className menuCls)
                             (a11yLabel (f.label + " filter actions")) (a11yExpanded menuExp))
                    (MenuTxt "⋮"))))
            ; The surface is the trigger's SIBLING, which is the arrangement
            ; the overlay pass's anchor search expects. Out of flow, so the
            ; chip does not grow to hold it.
            if menuOpen {
                chip.addChild((this.menuSurface(id)))
            }
            bar.addChild(chip)

            if (model.isOpen(id)) {
                def list (tree Flt (List (props (id (id + "-list")) (a11yLabel f.label))))
                ; `aria-multiselectable` is NOT published here, and that is a
                ; recorded gap rather than an oversight: `EVGElement` has no
                ; field for it, so the element path — the one every demo uses —
                ; cannot say it. `UiRow` can, and the filters gate checks it
                ; there. Writing something else onto this listbox to fill the
                ; hole would be the half-wiring this whole demo exists to
                ; avoid: the only honest options are to carry it properly
                ; through EVGElement or to say plainly that it is missing.
                def oi:int 0
                while (oi < (array_length f.options)) {
                    def o:FilterOption (itemAt f.options oi)
                    def opt (tree Flt
                        (Opt (props (id (id + "-opt-" + o.value))
                                    (className (this.optClass(id o.value)))
                                    (a11yLabel o.label))
                            (OptTxt (props (className (this.optTextClass(id o.value)))) o.label)))
                    if (model.isChosen(id o.value)) {
                        opt.a11ySelected = (EVGA11yTri.yes())
                    } {
                        opt.a11ySelected = (EVGA11yTri.no())
                    }
                    list.addChild(opt)
                    oi = (oi + 1)
                }
                ; A surface under the value it edits, not a box in the bar's
                ; row: in flow, it was centred on the 40px bar and grew it
                ; both ways, pushing the chips down over the count.
                list.overlayAnchor = valuePart
                chip.addChild(list)
            }
            i = (i + 1)
        }

        bar.addChild((tree Flt
            (Add (props (id "add") (a11yLabel "Add filter") (a11yHasPopup "menu"))
                (AddTxt "+"))))
        page.addChild(bar)

        ; THE ANSWER, on the screen next to the question. Without this the page
        ; is a picture of a filter bar and a broken predicate looks exactly
        ; like a working one.
        def kept:[string] (model.survivors())
        def count (tree Flt
            (Count ((to_string (array_length kept)) + " of "
                + (to_string (array_length rowKeys)) + " tasks")))
        page.addChild(count)

        def results (tree Flt (Results (props (id "fd-results"))))
        def k:int 0
        while (k < (array_length kept)) {
            def key:string (itemAt kept k)
            results.addChild((tree Flt
                (Row (props (id ("row-" + key)) (a11yLabel (this.titleOf(key))))
                    (RowTxt (this.titleOf(key))))))
            k = (k + 1)
        }
        page.addChild(results)

        page.addChild((tree Flt (Note
            "Click a value to open its list, or the three dots for the chip's actions. Arrow keys move between chips; Backspace removes the focused one.")))
        return page
    }

    ; --- the chip actions menu ------------------------------------------------
    ; MenuCtl's tids nest off `tid`: with tid `seed-2-menu` the button is
    ; `seed-2-menu-trigger`, the surface `seed-2-menu-content`, a row
    ; `seed-2-menu-item-remove`, and the operator submenu's rows
    ; `seed-2-menu-item-operator-item-is_not`.

    sfn triggerIdFor:string (ruleId:string) {
        return (ruleId + "-menu-trigger")
    }

    fn menuOpenFor:boolean (ruleId:string) {
        if (menu.open == false) {
            return false
        }
        return (menuRule == ruleId)
    }

    ; The rule whose trigger `target` is, or "".
    fn ruleOfTrigger:string (target:string) {
        def rootNode:FilterNode (model.node("root"))
        def i:int 0
        while (i < (array_length rootNode.kids)) {
            def id:string (itemAt rootNode.kids i)
            if (target == (FilterDemo.triggerIdFor(id))) {
                return id
            }
            i = (i + 1)
        }
        return ""
    }

    ; A fresh controller for this chip, opened. Returns where focus goes: the
    ; surface, as MenuCtl says Radix does — the first arrow then enters it.
    fn openMenuFor:string (ruleId:string) {
        model.close()
        model.activeId = ruleId
        def r:FilterNode (model.node(ruleId))
        def f:FilterField (model.field(r.path))
        def m (new MenuCtl())
        m.tid = (ruleId + "-menu")
        m.name = (f.label + " filter actions")
        def opSub:UiItem (m.addSub("operator" "Change operator" false))
        def ops:[string] (FilterCtl.operatorsFor(f.kind))
        def i:int 0
        while (i < (array_length ops)) {
            def op:string (itemAt ops i)
            MenuCtl.addKid(opSub op (FilterCtl.operatorLabel(op)) false)
            i = (i + 1)
        }
        m.addItem("edit" "Edit value" false)
        ; Nothing to clear is a disabled row, not a missing one: the menu keeps
        ; its shape, and the arrows skip it the way Radix skips a disabled item.
        m.addItem("clear" "Clear value" ((array_length r.vals) == 0))
        m.addItem("remove" "Remove filter" false)
        menu = m
        menuRule = ruleId
        return (m.activate((m.triggerTid())))
    }

    ; What choosing a leaf row DOES. Called after MenuCtl has closed the menu,
    ; so the rule is passed in rather than read from `menuRule`. Returns where
    ; focus goes, or "" to leave it where MenuCtl put it (on the button).
    fn runAction:string (ruleId:string rowTid:string) {
        def base:string (ruleId + "-menu")
        if (rowTid == (MenuCtl.itemTidUnder(base "remove"))) {
            ; Backspace's rule: focus moves on to the next stop first, so it
            ; lands on something that still exists.
            model.activeId = ruleId
            model.moveFocus(1)
            model.removeNode(ruleId)
            return model.activeId
        }
        if (rowTid == (MenuCtl.itemTidUnder(base "clear"))) {
            def none:[string]
            model.setValues(ruleId none)
            return ""
        }
        if (rowTid == (MenuCtl.itemTidUnder(base "edit"))) {
            model.open(ruleId)
            return (ruleId + "-value")
        }
        def subTid:string (MenuCtl.itemTidUnder(base "operator"))
        def r:FilterNode (model.node(ruleId))
        def f:FilterField (model.field(r.path))
        def ops:[string] (FilterCtl.operatorsFor(f.kind))
        def i:int 0
        while (i < (array_length ops)) {
            def op:string (itemAt ops i)
            if (rowTid == (MenuCtl.itemTidUnder(subTid op))) {
                model.setOperator(ruleId op)
                return ""
            }
            i = (i + 1)
        }
        return ""
    }

    ; A press or Enter on a row of the open menu. A sub-trigger opens its
    ; submenu; a leaf closes the menu and then does its thing.
    fn chooseRow:boolean (target:string) {
        def idx:int (menu.rowIndexOf(target))
        if (idx < 0) {
            return false
        }
        if (itemAt menu.rowDisabled idx) {
            return true
        }
        if (itemAt menu.rowIsSub idx) {
            def into:string (menu.activate(target))
            if ((strlen into) > 0) {
                focused = into
            }
            this.rebuild()
            return true
        }
        def rule:string menuRule
        def back:string (menu.activate(target))
        menuRule = ""
        focused = back
        def moved:string (this.runAction(rule target))
        if ((strlen moved) > 0) {
            focused = moved
        }
        this.rebuild()
        return true
    }

    fn menuRow:EVGElement (value:string label:string disabled:boolean) {
        def rowTid:string (menu.itemTid(value))
        def cls:string "fd-mitem"
        def labelCls:string "fd-mlabel"
        if (value == "remove") {
            cls = "fd-mitem fd-mitem-danger"
            labelCls = "fd-mlabel fd-mlabel-danger"
        }
        if disabled {
            cls = "fd-mitem fd-mitem-disabled"
            labelCls = "fd-mlabel fd-mlabel-disabled"
        }
        def row (tree Flt
            (MItem (props (id rowTid) (className cls) (a11yLabel label))
                (MLabel (props (className labelCls)) label)))
        row.a11yDisabled = disabled
        return row
    }

    fn operatorRow:EVGElement (ruleId:string) {
        def rowTid:string (menu.itemTid("operator"))
        def isOpen:boolean (menu.isOpenSub(rowTid))
        def cls:string "fd-mitem"
        def expanded:int (EVGA11yTri.no())
        if isOpen {
            cls = "fd-mitem fd-mitem-open"
            expanded = (EVGA11yTri.yes())
        }
        def row (tree Flt
            (MSubItem (props (id rowTid) (className cls) (a11yLabel "Change operator") (a11yExpanded expanded))
                (MLabel "Change operator")
                (MHint ">")))
        if isOpen {
            def r:FilterNode (model.node(ruleId))
            def f:FilterField (model.field(r.path))
            def sub (tree Flt (MSub (props (id (MenuCtl.subContentTid(rowTid))) (a11yLabel "Operator"))))
            def ops:[string] (FilterCtl.operatorsFor(f.kind))
            def i:int 0
            while (i < (array_length ops)) {
                def op:string (itemAt ops i)
                def on:int (EVGA11yTri.no())
                def tick:string " "
                if (r.operator == op) {
                    on = (EVGA11yTri.yes())
                    tick = "✓"
                }
                sub.addChild((tree Flt
                    (MRadio (props (id (MenuCtl.itemTidUnder(rowTid op))) (a11yLabel (FilterCtl.operatorLabel(op))) (a11yChecked on))
                        (MLabel (props (className "fd-mlabel fd-mlabel-sub")) (FilterCtl.operatorLabel(op)))
                        (MHint tick))))
                i = (i + 1)
            }
            ; Named outright: the surface is the row's CHILD, and the sibling
            ; search would find nothing to stand against.
            sub.overlayAnchor = row
            row.addChild(sub)
        }
        return row
    }

    fn menuSurface:EVGElement (ruleId:string) {
        def surf (tree Flt (MContent (props (id (menu.contentTid())) (a11yLabel menu.name))))
        def i:int 0
        while (i < (array_length menu.items)) {
            def it:UiItem (itemAt menu.items i)
            if (it.value == "operator") {
                surf.addChild((this.operatorRow(ruleId)))
            } {
                if (it.value == "remove") {
                    surf.addChild((tree Flt (MSep)))
                }
                surf.addChild((this.menuRow(it.value it.name it.disabled)))
            }
            i = (i + 1)
        }
        return surf
    }

    ; --- events --------------------------------------------------------------

    fn press:boolean (target:string) {
        ; An open menu is modal, as Radix's is: a press inside it is the
        ; menu's, and a press anywhere else only dismisses it — the click does
        ; not also land on whatever was underneath.
        if menu.open {
            if (this.chooseRow(target)) {
                return true
            }
            if (target == (menu.triggerTid())) {
                focused = (menu.activate(target))
                menuRule = ""
                this.rebuild()
                return true
            }
            if (target == (menu.contentTid())) {
                return true
            }
            if ((menu.rowIndexOf(target)) < 0) {
                def n:int (array_length menu.openPath)
                def k:int 0
                while (k < n) {
                    if (target == (MenuCtl.subContentTid((itemAt menu.openPath k)))) {
                        return true
                    }
                    k = (k + 1)
                }
            }
            menu.closeMenu()
            menuRule = ""
            focused = ""
            this.rebuild()
            return true
        }
        if (target == "") {
            return false
        }
        def menuOf:string (this.ruleOfTrigger(target))
        if ((strlen menuOf) > 0) {
            focused = (this.openMenuFor(menuOf))
            this.rebuild()
            return true
        }
        focused = target
        ; An option inside an open list. Checked FIRST, because an option id
        ; starts with its rule's id and a prefix test the other way round would
        ; read every option as a click on the chip that owns it.
        def rootNode:FilterNode (model.node("root"))
        def i:int 0
        while (i < (array_length rootNode.kids)) {
            def id:string (itemAt rootNode.kids i)
            ; Named rather than chained: Ranger has no field access on a call
            ; result, so `(model.node(id)).path` is a compile error and not a
            ; style preference.
            def ruleNode:FilterNode (model.node(id))
            def f:FilterField (model.field(ruleNode.path))
            def oi:int 0
            while (oi < (array_length f.options)) {
                def o:FilterOption (itemAt f.options oi)
                if (target == (id + "-opt-" + o.value)) {
                    model.toggleValue(id o.value)
                    model.activeId = id
                    this.rebuild()
                    return true
                }
                oi = (oi + 1)
            }
            if (target == (id + "-value")) {
                if (model.isOpen(id)) {
                    model.close()
                } {
                    model.open(id)
                }
                this.rebuild()
                return true
            }
            if (target == (id + "-field")) {
                model.activeId = id
                this.rebuild()
                return true
            }
            if (target == (id + "-op")) {
                model.activeId = id
                this.rebuild()
                return true
            }
            if (target == id) {
                model.activeId = id
                this.rebuild()
                return true
            }
            i = (i + 1)
        }
        if (target == "add") {
            model.activeId = "add"
            this.rebuild()
            return true
        }
        return false
    }

    fn key:boolean (k:string) {
        ; The open menu takes every key: MenuCtl answers the arrows, Escape
        ; and the submenu keys, and a row's activation is the demo's to act on.
        if menu.open {
            if (UiCtl.activatesOn(k)) {
                if ((menu.rowIndexOf(focused)) >= 0) {
                    return (this.chooseRow(focused))
                }
                return true
            }
            def next:string (menu.keyDown(focused k))
            if ((strlen next) > 0) {
                focused = next
            }
            if (menu.open == false) {
                menuRule = ""
            }
            this.rebuild()
            return true
        }
        ; On a chip's actions button — reached by the pointer or the mirror —
        ; Enter, Space and ArrowDown open its menu, as they open Radix's.
        ; On the chip itself (the toolbar stop the arrows walk) Enter and Space
        ; do the same: the chip's one command is "what can I do with this".
        def onTrigger:string (this.ruleOfTrigger(focused))
        def opener:string onTrigger
        if ((strlen opener) == 0) {
            if ((strlen focused) > 0) {
                if (focused == model.activeId) {
                    if (model.has(focused)) {
                        opener = focused
                    }
                }
            }
        }
        if ((strlen opener) > 0) {
            def opens:boolean (UiCtl.activatesOn(k))
            if ((k == "ArrowDown") && ((strlen onTrigger) > 0)) {
                opens = true
            }
            if opens {
                focused = (this.openMenuFor(opener))
                this.rebuild()
                return true
            }
        }
        ; Nothing else on this page takes a key, so an unfocused bar arms its
        ; first stop rather than swallowing the press — the same rule the
        ; calendar is under, and for the same reason: otherwise the first
        ; arrow key does nothing and the second one works.
        def handled:boolean (model.onKey(k))
        if handled {
            focused = model.activeId
            this.rebuild()
        }
        return handled
    }

    ; With the menu open the pointer highlights a row by FOCUSING it, which is
    ; how Radix does it and why the stylesheet paints the menu's highlight
    ; with `:focus` alone. Off a row, focus goes back to that row's surface so
    ; the highlight follows the pointer out instead of staying behind.
    fn setHover:void (id:string) {
        hovered = id
        if (menu.open == false) {
            return
        }
        def next:string (menu.hover(id))
        if ((strlen next) > 0) {
            focused = next
        } {
            if ((menu.rowIndexOf(focused)) >= 0) {
                focused = (menu.ownerOf(focused))
                menu.activeTid = focused
            }
        }
        this.rebuild()
    }

    fn setPressed:void (id:string) {
        pressed = id
    }

    fn setFocus:void (id:string) {
        focused = id
        if menu.open {
            menu.activeTid = id
        }
    }

    fn rebuild:void () {
        root = (this.page())
    }

    fn markStates:void (el:EVGElement) {
        el.isHovered = false
        el.isPressed = false
        el.isFocused = false
        if ((strlen el.id) > 0) {
            if (el.id == hovered) {
                el.isHovered = true
            }
            if (el.id == pressed) {
                el.isPressed = true
            }
            if (el.id == focused) {
                el.isFocused = true
            }
        }
        def i:int 0
        while (i < (el.getChildCount())) {
            this.markStates((el.getChild(i)))
            i = (i + 1)
        }
    }

    fn laidOut:EVGLayout () {
        def r:EVGElement (unwrap root)
        def s:EVGStyleSheet (unwrap sheet)
        s.setViewport(pageW pageH false)
        this.markStates(r)
        s.applyTree(r "")
        def t:EVGTransition transitions
        t.reconcileTree(r)
        if layout {
            def lay:EVGLayout (unwrap layout)
            if ((s.layoutClean()) == false) {
                lay.layout(r)
            }
            return lay
        }
        def fresh (new EVGLayout())
        fresh.setPageSize(pageW pageH)
        layout = fresh
        fresh.layout(r)
        return fresh
    }

    fn displayListJson:string () {
        def lay:EVGLayout (this.laidOut())
        def r:EVGElement (unwrap root)
        def dl (new EVGDisplayList())
        dl.setTextEngine((lay.getTextEngine()))
        dl.build(r)
        return (dl.toJson())
    }

    fn hitId:string (px:double py:double) {
        this.laidOut()
        def r:EVGElement (unwrap root)
        def hit (new EVGHitTest())
        return (hit.idAt(r px py))
    }

    fn a11yJson:string (generation:int focusId:string) {
        this.laidOut()
        def r:EVGElement (unwrap root)
        def b (new EVGA11yFromTree())
        def t:EVGA11yTree (b.build(r "Filters demo" generation focusId))
        return (t.toJson())
    }

    fn a11yProblems:[string] () {
        this.laidOut()
        def r:EVGElement (unwrap root)
        def b (new EVGA11yFromTree())
        def t:EVGA11yTree (b.build(r "Filters demo" 1 ""))
        return (t.lint())
    }

    fn styleErrorCount:int () {
        def s:EVGStyleSheet (unwrap sheet)
        return (s.getErrorCount())
    }

    fn styleErrorAt:string (i:int) {
        def s:EVGStyleSheet (unwrap sheet)
        return (s.getError(i))
    }

    ; The menu's clock first — a submenu the pointer has rested on for 100ms
    ; opens here — then the stylesheet's.
    fn tick:boolean (dtMs:double) {
        if menu.open {
            def opened:string (menu.tickCtl(dtMs))
            if ((strlen opened) > 0) {
                focused = opened
                this.rebuild()
            }
        }
        def r:EVGElement (unwrap root)
        def t:EVGTransition transitions
        t.advanceTree(r dtMs)
        if (t.busy(r)) {
            return true
        }
        return ((strlen menu.pendingTid) > 0)
    }

    fn busyNow:boolean () {
        def r:EVGElement (unwrap root)
        def t:EVGTransition transitions
        if (t.busy(r)) {
            return true
        }
        return ((strlen menu.pendingTid) > 0)
    }

    fn heightPx:double () {
        return pageH
    }
}
