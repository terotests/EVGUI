; =============================================================================
; CalendarDemo — a date field, and the calendar that fills it in
; =============================================================================
; The reference is shadcn's Calendar, which is react-day-picker with a class
; map over it, used exactly as its documentation shows it:
;
;   <Calendar mode="single" selected={date} onSelect={setDate}
;             className="rounded-lg border" />
;
; So the calendar here is always on the page rather than inside a popover —
; that snippet is the always-visible one, and a popover would be answering a
; question nobody asked.
;
; THE STATE IS NOT REBUILT HERE. `CalendarCtl` owns the grid arithmetic, the
; roving tab stop, the eight keys and the toggling selection, and it is
; measured against react-day-picker in `conformance/oracle/calendar_check.mjs`
; — 108 behaviours, plus two recorded divergences. Writing the month
; arithmetic again for a demo would be writing an untested second copy of the
; only part of a calendar that is hard, and a calendar with two date
; arithmetics disagrees with itself one month in twelve.
;
; So this file is the other half: the controller decides what is true, the
; tree literal decides what it looks like.
;
; THE FIELD ABOVE THE GRID is the reason this demo exists rather than a bare
; calendar. A calendar is an INPUT, and an input has to say what it holds: the
; field shows the chosen date, shows a placeholder when there is none, and is
; the thing a form would actually read. Clearing the selection — clicking the
; chosen day again, which is what the reference does — has to be visible
; somewhere, and an empty field is where.
;
; TODAY IS PINNED to the oracle's day. A demo whose picture changes overnight
; cannot be snapshotted, and today is drawn differently from every other day.
; =============================================================================

Import "../src/CalendarCtl.rgr"
Import "../src/DateFieldCtl.rgr"
Import "../src/UiDate.rgr"
Import "CalView.rgr"
Import "pkg:evg/EVGElement.rgr"
Import "pkg:evg/EVGUnit.rgr"
Import "pkg:evg/EVGLayout.rgr"
Import "pkg:evg/EVGDisplayList.rgr"
Import "pkg:evg/EVGStyleSheet.rgr"
Import "pkg:evg/EVGTransition.rgr"
Import "pkg:evg/EVGA11yTree.rgr"
Import "pkg:evg/EVGA11yFromTree.rgr"
Import "pkg:evg/EVGHitTest.rgr"

; The tags (`treefactory Cal`) and the card itself live in `CalView.rgr`,
; shared with the profile demo's date popover.

class CalendarDemo {

    def model:CalendarCtl (new CalendarCtl())
    ; The `mm/dd/yyyy` editor above the grid. Measured against Chromium's own
    ; <input type="date"> in `ui:datefield:check`; this page only wires it to
    ; the calendar, both ways.
    def field:DateFieldCtl (new DateFieldCtl())
    ; The selection the field was last told about, so a calendar click that
    ; changes nothing does not wipe a half-typed date.
    def fieldSelDay:int 0
    def fieldHasSel:boolean false
    def root@(optional):EVGElement
    def sheet@(optional):EVGStyleSheet
    def transitions:EVGTransition (new EVGTransition())
    def layout@(optional):EVGLayout
    def hovered:string ""
    def pressed:string ""
    def focused:string ""
    def pageW:double 900.0
    def pageH:double 520.0

    Constructor () {
    }

    fn init:void (css:string) {
        def s (new EVGStyleSheet())
        s.parse(css)
        sheet = s

        model.tid = "cal"
        model.name = "Date"
        model.setMonth(2026 5)
        model.setToday(2026 5 14)
        ; The bounds are the HOST's decision. The reference with none given
        ; runs a hundred years back from the current year and stops there, so
        ; out of the box it cannot reach next year at all — recorded in
        ; `calendar.json` as a default not worth copying. A date field for an
        ; invoice wants a decade either side.
        model.startYear = 2016
        model.endYear = 2036
        ; Newest first, so the years near today are the ones you land on.
        model.reverseYears = true
        model.build()

        field.tid = "cd-box"
        field.name = "Date"
        field.todayYear = 2026
        this.fieldFromModel()

        root = (this.page())
    }

    ; --- the field and the grid, kept in step ------------------------------------

    ; The calendar chose (or un-chose) a day: the segments show it. Only when
    ; the selection actually changed, so pressing a month arrow while the year
    ; is half typed leaves the typing alone.
    fn fieldFromModel:void () {
        if ((model.hasSelection == fieldHasSel) && (model.selectedDay == fieldSelDay)) {
            return
        }
        fieldHasSel = model.hasSelection
        fieldSelDay = model.selectedDay
        if model.hasSelection {
            def p:[int] ([] _:int ( 0 0 0 ))
            UiDate.fromDays(model.selectedDay p)
            field.setDate((itemAt p 0) (itemAt p 1) (itemAt p 2))
        } {
            field.clear()
        }
    }

    ; The field changed: a complete date is the calendar's selection and the
    ; grid turns to its month; an incomplete one is no date, as the native
    ; control's `value` is "" until all three segments hold something possible.
    fn modelFromField:void () {
        if (field.isComplete()) {
            model.setSelected(field.year field.month field.day)
            model.setMonth(field.year field.month)
            model.focusDay = model.selectedDay
            model.hasFocusDay = true
        } {
            model.clearSelected()
        }
        fieldHasSel = model.hasSelection
        fieldSelDay = model.selectedDay
        model.build()
    }

    fn inField:boolean (target:string) {
        if (target == field.tid) {
            return true
        }
        return ((field.segOf(target)) >= 0)
    }

    ; The field's own element, dressed for this page: the segments and slashes
    ; are the controller's, the box and the roles are the page's.
    fn fieldBox:EVGElement () {
        field.build()
        def box:EVGElement (unwrap field.rootEl)
        box.className = "cd-box"
        box.role = "group"
        box.a11yLabel = "Date"
        box.a11yRoleDescription = "Date field"
        def i:int 0
        while (i < 3) {
            def seg:EVGElement (itemAt field.segEls i)
            seg.role = "textbox"
            seg.a11yLabel = (field.segName(i))
            seg.a11yRoleDescription = "spinbutton"
            seg.a11yFocusable = true
            seg.a11yValue = (field.shown(i))
            i = (i + 1)
        }
        def k:int 0
        while (k < (box.getChildCount())) {
            def kid:EVGElement (box.getChild(k))
            if (kid.className == "ui-datefield-sep") {
                kid.a11yHidden = true
            }
            k = (k + 1)
        }
        return box
    }

    ; --- the look ------------------------------------------------------------
    ;
    ; The card is `CalView.card`; what it looks like is `calendar.css`. The
    ; only state this page keeps for it is where the year panel is scrolled.
    def yearScroll:double 0.0

    fn centreOnCurrentYear:void () {
        yearScroll = (CalView.centredYearScroll(model))
    }

    ; The wheel. The page hands every demo `scroll(dy)` and takes a `false`
    ; as "not mine, let the page scroll" — so this must not claim the wheel
    ; while the panel is shut.
    fn scrollBy:boolean (dy:double) {
        if (model.yearPanelOpen == false) {
            return false
        }
        def next:double (CalView.clampYearScroll(model (yearScroll + dy)))
        if (next == yearScroll) {
            return false
        }
        yearScroll = next
        this.rebuild()
        return true
    }

    fn page:EVGElement () {
        def page (tree Cal (Page))

        def fieldWrap (tree Cal (Field (FieldLbl "Date")))
        fieldWrap.addChild((this.fieldBox()))
        page.addChild(fieldWrap)

        page.addChild((CalView.card(model yearScroll)))

        def note:string ("Arrow keys move a day, Home and End move within the week, "
            + "PageUp and PageDown move a month. Enter chooses; Enter on the "
            + "chosen day clears it.")
        page.addChild((tree Cal (Note note)))
        return page
    }

    ; --- events --------------------------------------------------------------

    fn press:boolean (target:string) {
        if (this.inField(target)) {
            focused = (field.activate(target))
            this.rebuild()
            return true
        }
        if (this.inField(focused)) {
            field.blur()
        }
        def wasOpen:boolean model.yearPanelOpen
        model.activate(target)
        this.fieldFromModel()
        ; Opening the panel parks it on the year you are on. Without this it
        ; opens at the top — which with `reverseYears` is a year twenty out,
        ; and the control that exists to save you scrolling starts by making
        ; you scroll.
        if (model.yearPanelOpen) {
            if (wasOpen == false) {
                this.centreOnCurrentYear()
            }
        }
        focused = target
        this.rebuild()
        return true
    }

    fn key:boolean (k:string) {
        return (this.keyWith(k false false))
    }

    fn keyWith:boolean (k:string shift:boolean ctrl:boolean) {
        ; The field first: a segment under focus takes digits, arrows,
        ; Backspace and Tab, and the rules are the browser's own date input's.
        if (this.inField(focused)) {
            if (k == "Tab") {
                def next:string (field.tabFrom(focused shift))
                ; Off either end of the field the Tab is the page's: it walks
                ; on to the month buttons and the grid (or out of the demo)
                ; in the order the accessible tree has them.
                if (next == "") {
                    return false
                }
                focused = next
                this.rebuild()
                return true
            }
            if ((strlen k) == 1) {
                field.typeChar(focused k)
                focused = (field.focusTid())
                this.modelFromField()
                this.rebuild()
                return true
            }
            def to:string (field.keyDownWith(focused k shift ctrl))
            if (to != "") {
                focused = to
            }
            this.modelFromField()
            this.rebuild()
            return true
        }
        ; Tab outside the field is the page's — see above.
        if (k == "Tab") {
            return false
        }
        ; The month buttons and the year are buttons: Enter and Space press
        ; them, and every other key is not theirs.
        if (((focused == (model.prevTid())) || (focused == (model.nextTid()))) || (focused == (model.yearTid()))) {
            if (UiCtl.activatesOn(k)) {
                return (this.press(focused))
            }
            return false
        }
        ; A key belongs to the day that has focus. Nothing else on this page
        ; takes one, so an unfocused page arms the resting day rather than
        ; swallowing the press — otherwise the first arrow key does nothing
        ; and the second one works, which reads as a dropped keystroke.
        def target:string focused
        if (target == "") {
            target = (model.dayTid((model.currentFocusDay())))
        }
        def landed:string (model.keyDown(target k))
        if (landed != "") {
            focused = landed
        }
        this.fieldFromModel()
        this.rebuild()
        return true
    }

    fn setHover:void (id:string) {
        hovered = id
    }

    fn setPressed:void (id:string) {
        pressed = id
    }

    fn setFocus:void (id:string) {
        ; Leaving the field by the keyboard ends its edit, as a click away does.
        if (this.inField(focused)) {
            if ((this.inField(id)) == false) {
                field.blur()
            }
        }
        focused = id
    }

    ; A press or a key changes the DATA, so the tree is rebuilt rather than
    ; reconciled. The kept layout survives: a freshly built tree has no element
    ; the sheet has ever written to, so it reports itself layout-dirty on the
    ; first pass and lays out without being asked to — see `laidOut`.
    fn rebuild:void () {
        root = (this.page())
    }

    fn markStates:void (el:EVGElement) {
        el.isHovered = false
        el.isPressed = false
        el.isFocused = false
        if ((strlen el.id) > 0) {
            if (el.id == hovered) {
                el.isHovered = true
            }
            if (el.id == pressed) {
                el.isPressed = true
            }
            if (el.id == focused) {
                el.isFocused = true
            }
        }
        def i:int 0
        while (i < (el.getChildCount())) {
            this.markStates((el.getChild(i)))
            i = (i + 1)
        }
    }

    fn laidOut:EVGLayout () {
        def r:EVGElement (unwrap root)
        def s:EVGStyleSheet (unwrap sheet)
        s.setViewport(pageW pageH false)
        this.markStates(r)
        s.applyTree(r "")
        def t:EVGTransition transitions
        t.reconcileTree(r)
        if layout {
            def lay:EVGLayout (unwrap layout)
            if ((s.layoutClean()) == false) {
                lay.layout(r)
            }
            return lay
        }
        def fresh (new EVGLayout())
        fresh.setPageSize(pageW pageH)
        layout = fresh
        fresh.layout(r)
        return fresh
    }

    fn displayListJson:string () {
        def lay:EVGLayout (this.laidOut())
        def r:EVGElement (unwrap root)
        def dl (new EVGDisplayList())
        dl.setTextEngine((lay.getTextEngine()))
        dl.build(r)
        return (dl.toJson())
    }

    fn hitId:string (px:double py:double) {
        this.laidOut()
        def r:EVGElement (unwrap root)
        def hit (new EVGHitTest())
        return (hit.idAt(r px py))
    }

    fn a11yJson:string (generation:int focusId:string) {
        this.laidOut()
        def r:EVGElement (unwrap root)
        def b (new EVGA11yFromTree())
        def t:EVGA11yTree (b.build(r "Calendar demo" generation focusId))
        return (t.toJson())
    }

    fn a11yProblems:[string] () {
        this.laidOut()
        def r:EVGElement (unwrap root)
        def b (new EVGA11yFromTree())
        def t:EVGA11yTree (b.build(r "Calendar demo" 1 ""))
        return (t.lint())
    }

    fn styleErrorCount:int () {
        def s:EVGStyleSheet (unwrap sheet)
        return (s.getErrorCount())
    }

    fn styleErrorAt:string (i:int) {
        def s:EVGStyleSheet (unwrap sheet)
        return (s.getError(i))
    }

    fn tick:boolean (dtMs:double) {
        def r:EVGElement (unwrap root)
        def t:EVGTransition transitions
        t.advanceTree(r dtMs)
        return (t.busy(r))
    }

    fn busyNow:boolean () {
        def r:EVGElement (unwrap root)
        def t:EVGTransition transitions
        return (t.busy(r))
    }

    fn heightPx:double () {
        return pageH
    }
}
