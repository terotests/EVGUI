; SPDX-License-Identifier: AGPL-3.0-or-later

; =============================================================================
; EventCalDemo — a week of events, drawn where the measurement says they go
; =============================================================================
; `EventCalCtl` owns the layout and is measured against a rendered
; @schedule-x/calendar in `conformance/oracle/eventcal_check.mjs` — 84
; assertions. Nothing about where an event sits is decided again here.
;
; WHY THIS FILE EXISTS. The overlap rule is the one part of a calendar that is
; INVISIBLE UNTIL IT IS DRAWN. "Column 1 of 3, left 33.33%, width 66.67%" is a
; row in a gate; three boxes fanning out to the right with the narrowest on top
; is the thing a person can look at and say is wrong. A controller that is
; right and a page that never shows it are indistinguishable from outside,
; which is the failure the input work was pulled up on.
;
; THE GEOMETRY IS A FRACTION, so this file multiplies. `EventCalCtl` reports
; top, height, left and width as fractions of the day and of the column, and
; the pixel arithmetic here is the only place they become sizes. That keeps the
; measured half free of any page's dimensions — the same numbers hold at any
; height, which is what made them comparable to the reference at all.
;
; ReUI's own chrome is NOT drawn here. reui.io is refused by the egress proxy,
; so its view switcher, its colours and its labels were never seen, and a
; guess at them dressed up as a reference implementation would be worse than
; the plain grid below.
; =============================================================================

Import "../src/EventCalCtl.rgr"
Import "EventCalBoard.rgr"
Import "../src/UiTree.rgr"
Import "../src/UiDate.rgr"
Import "../src/UiText.rgr"
Import "pkg:evg/EVGTextEngine.rgr"
Import "pkg:evg/EVGElement.rgr"
Import "pkg:evg/EVGLayout.rgr"
Import "pkg:evg/EVGDisplayList.rgr"
Import "pkg:evg/EVGStyleSheet.rgr"
Import "pkg:evg/EVGTransition.rgr"
Import "pkg:evg/EVGA11yTree.rgr"
Import "pkg:evg/EVGA11yFromTree.rgr"
Import "pkg:evg/EVGHitTest.rgr"

treefactory Ec {
    child addChild
    text  textContent

    tag Shell    EVGElement (props (className "ec-shell"))
    tag Cap      EVGElement (props (className "ec-cap") (elementType 1))
    tag Page     EVGElement (props (className "ec-page"))
    tag Head     EVGElement (props (className "ec-head"))
    tag NavBtn   EVGElement (props (className "ec-navbtn") (role "button") (a11yFocusable true))
    tag NavGlyph EVGElement (props (className "ec-navglyph") (elementType 1) (a11yHidden true))
    tag Caption  EVGElement (props (className "ec-caption") (role "status") (elementType 1))
    tag ViewBtn  EVGElement (props (className "ec-viewbtn") (role "button") (a11yFocusable true))
    tag ViewTxt  EVGElement (props (className "ec-viewtxt") (elementType 1) (a11yHidden true))
    tag Body     EVGElement (props (className "ec-body") (role "region"))
    ; The month view's own furniture. A month cell has no time axis, so an
    ; event in it is a CHIP — measured: every event in the reference's month
    ; came back with a `grid-row` and a day span and none with a `top`.
    tag MonthGrid EVGElement (props (className "ec-monthgrid") (role "grid") (a11yLabel "Month"))
    tag MonthWeek EVGElement (props (className "ec-monthweek") (role "row"))
    tag MonthCell EVGElement (props (className "ec-monthcell") (role "gridcell"))
    tag MonthNum  EVGElement (props (className "ec-monthnum") (elementType 1) (a11yHidden true))
    tag Chip      EVGElement (props (className "ec-chip") (role "button") (a11yFocusable true))
    ; The row's cell backgrounds, drawn BEHIND the cells as one layer. A chip
    ; that spans three days overhangs into the next two cells; while each cell
    ; painted its own background, the cell after it painted over the overhang
    ; and a three-day chip read as one day plus a sliver in every gap.
    tag MonthBg   EVGElement (props (className "ec-monthbg") (a11yHidden true))
    tag MonthBgCell EVGElement (props (className "ec-monthbgcell") (a11yHidden true))
    tag ChipGap   EVGElement (props (className "ec-chipgap") (a11yHidden true))
    tag More      EVGElement (props (className "ec-more") (role "button") (a11yFocusable true))
    tag MoreTxt   EVGElement (props (className "ec-moretxt") (elementType 1) (a11yHidden true))
    tag ChipTxt   EVGElement (props (className "ec-chiptxt") (elementType 1) (a11yHidden true))
    tag DayCols  EVGElement (props (className "ec-daycols"))
    tag DayHead  EVGElement (props (className "ec-dayhead") (elementType 1) (a11yHidden true))
    tag Band     EVGElement (props (className "ec-band") (role "list") (a11yLabel "All day"))
    tag BandRow  EVGElement (props (className "ec-bandrow"))
    tag BandEv   EVGElement (props (className "ec-bandev") (role "listitem") (a11yFocusable true))
    tag BandTxt  EVGElement (props (className "ec-bandtxt") (elementType 1) (a11yHidden true))
    tag Grid     EVGElement (props (className "ec-grid") (role "list") (a11yLabel "Events"))
    tag Col      EVGElement (props (className "ec-col"))
    tag Ev       EVGElement (props (className "ec-ev") (role "listitem") (a11yFocusable true))
    tag EvTxt    EVGElement (props (className "ec-evtxt") (elementType 1) (a11yHidden true))
    tag Note     EVGElement (props (className "ec-note") (elementType 1))
}

class EventCalDemo {
    def model:EventCalCtl (new EventCalCtl())
    def root@(optional):EVGElement
    def sheet@(optional):EVGStyleSheet
    def transitions:EVGTransition (new EVGTransition())
    def layout@(optional):EVGLayout
    def hovered:string ""
    def pressed:string ""
    def focused:string ""
    def pageW:double 1000.0
    def pageH:double 2400.0
    ; ReUI's two patterns, above the measured week: A is the full calendar
    ; with its Settings popover, B the hotel's resource day.
    def boardA:EcBoard (new EcBoard())
    def boardB:EcBoard (new EcBoard())
    ; The width the tree was built for, and where the pointer last was (the
    ; wheel says how far, not where).
    def builtW:double 0.0
    def lastX:double 0.0
    def lastY:double 0.0
    ; Measures titles so a box too narrow for one ends in an ellipsis rather
    ; than a word cut in half ("Desigr"). Owns no tree; it only hands out the
    ; engine, as in FormDemo.
    def measurer:EVGLayout (new EVGLayout())

    ; The day the demo calls today, and the day the user is looking at. The
    ; cursor is kept apart from `model.weekStart` because a week view snaps
    ; to its Monday: without it, Day -> Week -> Day lost the day you were on.
    def today:int 0
    def cursor:int 0

    ; The drawn grid. Only the working day is shown, because a 24-hour column
    ; 300 pixels tall gives an hour twelve pixels and nothing in it is legible
    ; — but the FRACTIONS stay whole-day, so what is drawn is a window onto the
    ; measured geometry rather than a second geometry with its own arithmetic.
    def firstHour:int 8
    def lastHour:int 19
    def colGap:double 4.0
    ; 360, not 300: at 300 a 30-minute event was 13.6px tall and its 11px
    ; title spilled into the event under it ("Triage" over "Parser review").
    def gridH:double 360.0

    fn init:void (css:string) {
        def s (new EVGStyleSheet())
        s.parse(css)
        sheet = s

        model.tid = "eventcal"
        model.name = "Week"
        def mon:int (UiDate.toDays(2026 5 11))
        model.weekStart = mon
        today = mon
        cursor = mon

        ; The oracle's own events, so the picture and the gate are the same
        ; data. The 09:00 cluster is the one that proves the overlay: A keeps
        ; the full width, B and C sit over its right half.
        model.addTimed("a" "Standup" mon 540 600)
        model.addTimed("b" "Triage" mon 540 570)
        model.addTimed("c" "Parser review" mon 570 630)
        model.addTimed("d" "Linker sync" mon 600 660)
        model.addTimed("e" "1:1" mon 840 900)
        model.addTimed("g" "Design" mon 960 1020)
        model.addTimed("h" "Roadmap" mon 970 1030)
        model.addTimed("i" "Retro" mon 980 1040)
        model.addTimed("l" "Wrap up" mon 1080 1110)
        ; Tuesday and Thursday, so the week is not one busy column and six
        ; empty ones — a layout bug in an empty column is invisible.
        model.addTimed("m" "Interview" (mon + 1) 600 690)
        model.addTimed("n" "Planning" (mon + 3) 780 900)
        ; The midnight crossing, which the measurement says is PROMOTED to the
        ; band rather than split in two.
        model.addSpanning("j" "On call" mon 1380 (mon + 1) 60)
        model.addAllDay("f" "Release week" (mon + 1) (mon + 3))
        model.addAllDay("k" "Offsite" (mon + 2) (mon + 4))
        model.layout()

        this.useClock(2026 9 28 630 0)
    }

    ; The boards' today and now. The page passes the real clock; the checks
    ; keep the default, Monday 28 September 2026 at 10:30, UTC.
    fn useClock:void (y:int m:int d:int minute:int offset:int) {
        def day:int (UiDate.toDays(y m d))
        boardA = (new EcBoard())
        boardB = (new EcBoard())
        boardA.browserOff = offset
        boardB.browserOff = offset
        boardA.setup("ea" false day minute)
        boardB.setup("eb" true day minute)
        this.rebuild()
    }

    ; The measured week's card: as wide as it was, or the room there is.
    fn oldW:double () {
        def w:double (pageW - 40.0)
        if (w > 900.0) {
            return 900.0
        }
        return w
    }

    ; --- fractions to pixels -------------------------------------------------
    ;
    ; The ONLY place the measured geometry becomes a size. `firstHour` and
    ; `lastHour` window the day: a fraction of 1 maps to midnight, and the
    ; drawn column shows the slice between them.

    fn windowTop:double () {
        return ((to_double firstHour) / 24.0)
    }

    fn windowSpan:double () {
        return ((to_double (lastHour - firstHour)) / 24.0)
    }

    fn yOf:double (id:string) {
        def f:double (model.topOf(id))
        return (((f - (this.windowTop())) / (this.windowSpan())) * gridH)
    }

    fn hOf:double (id:string) {
        def f:double (model.heightOf(id))
        return ((f / (this.windowSpan())) * gridH)
    }

    ; As many columns as the VIEW shows, not always seven. A day view is one
    ; wide column and a month is seven narrow ones with five rows under them;
    ; hard-coding 7 here is half of why the view buttons drew the same picture
    ; whatever you pressed.
    ; Five rows of seven cells, each cell a day number and the chips that start
    ; in it. Everything here follows the measurement in `eventcal.json`'s
    ; `views.month`: 35 cells, every event a chip with a lane and a day span,
    ; and no time position on anything — a timed event is a chip like the rest.
    ;
    ; A chip is drawn in the cell it STARTS in, widened across the days it
    ; covers, which is what a span of `calc(200% - 8px)` on a grid cell means.
    ; Clipped events are drawn at their clipped width; one that begins before
    ; the grid begins is drawn from the first cell it reaches.
    fn monthCellWidth:double () {
        return ((((this.oldW()) - 120.0) - (colGap * 6.0)) / 7.0)
    }

    ; Lanes a cell has room for. The rest are counted into "+N more", which
    ; opens that day in the day view — the reference's month does the same,
    ; and ten chips in an 80-pixel cell were drawn on top of one another.
    def monthLanes:int 2

    ; The visible event in `lane` that covers `day`, or "" when there is none.
    fn laneEventOn:string (lane:int day:int) {
        def i:int 0
        while (i < (array_length model.events)) {
            def e:CalEvent (itemAt model.events i)
            if ((model.isVisible(e.id)) && (e.lane == lane) && (e.clipStart <= day) && (e.clipEnd >= day)) {
                return e.id
            }
            i = (i + 1)
        }
        return ""
    }

    fn hiddenOn:int (day:int) {
        def n:int 0
        def i:int 0
        while (i < (array_length model.events)) {
            def e:CalEvent (itemAt model.events i)
            if ((model.isVisible(e.id)) && (e.lane > monthLanes) && (e.clipStart <= day) && (e.clipEnd >= day)) {
                n = (n + 1)
            }
            i = (i + 1)
        }
        return n
    }

    fn monthGrid:EVGElement () {
        def grid (tree Ec (MonthGrid (props (id "ec-month"))))
        def start:int (model.firstDay())
        def cw:double (this.monthCellWidth())
        def row:int 0
        while (row < 5) {
            def wk (tree Ec (MonthWeek (props (id ("ec-week-" + (to_string row))))))
            def bg (tree Ec (MonthBg))
            def b:int 0
            while (b < 7) {
                def bc (tree Ec (MonthBgCell))
                UiTree.inline(bc "width" (EventCalDemo.px(cw)))
                bg.addChild(bc)
                b = (b + 1)
            }
            wk.addChild(bg)
            def c:int 0
            while (c < 7) {
                def day:int ((start + (row * 7)) + c)
                def p:[int] ([] _:int ( 0 0 0 ))
                UiDate.fromDays(day p)
                def cell (tree Ec (MonthCell (props (id ("ec-cell-" + (to_string ((row * 7) + c)))))))
                cell.a11yLabel = (UiDate.longLabel((itemAt p 0) (itemAt p 1) (itemAt p 2)))
                UiTree.inline(cell "width" (EventCalDemo.px(cw)))
                ; A NAMED INTERMEDIATE, not `(MonthNum (to_string …))`: a
                ; computed child in text position is read as a tag name by the
                ; tree factory, which fails the build with "to_string is not a
                ; tag of treefactory Ec".
                def dayNum:string (to_string (itemAt p 2))
                cell.addChild((tree Ec (MonthNum dayNum)))
                ; One slot per lane, so a chip sits at the same height in every
                ; cell it crosses. A chip is drawn in the cell it STARTS in —
                ; or at the start of a week row it continues into — widened
                ; across its days up to the row's end; a lane taken by a chip
                ; from an earlier cell gets an empty slot of the same height.
                def lane:int 1
                while (lane <= monthLanes) {
                    def eid:string (this.laneEventOn(lane day))
                    if (eid == "") {
                        cell.addChild((tree Ec (ChipGap)))
                    } {
                        def e:CalEvent (model.event(eid))
                        if ((e.clipStart == day) || (c == 0)) {
                            def span:int ((e.clipEnd - day) + 1)
                            if (span > (7 - c)) {
                                span = (7 - c)
                            }
                            def cid:string ("ec-" + e.id)
                            if (e.clipStart != day) {
                                cid = (cid + "-w" + (to_string row))
                            }
                            ; Wide enough to cover its days, gaps included, less
                            ; the cell's own padding on either side.
                            def w:double (((cw * (to_double span)) + (colGap * (to_double (span - 1)))) - 8.0)
                            def chipTitle:string (this.fitTitle(e.title (w - 12.0)))
                            def chip (tree Ec
                                (Chip (props (id cid) (a11yLabel (this.chipLabel(e))))
                                    (ChipTxt chipTitle)))
                            UiTree.inline(chip "width" (EventCalDemo.px(w)))
                            cell.addChild(chip)
                        } {
                            cell.addChild((tree Ec (ChipGap)))
                        }
                    }
                    lane = (lane + 1)
                }
                def more:int (this.hiddenOn(day))
                if (more > 0) {
                    def moreTxt:string ("+" + (to_string more) + " more")
                    def mb (tree Ec
                        (More (props (id ("ec-more-" + (to_string day)))
                                     (a11yLabel ((to_string more) + " more events on " + cell.a11yLabel + ", open the day")))
                            (MoreTxt moreTxt)))
                    cell.addChild(mb)
                }
                wk.addChild(cell)
                c = (c + 1)
            }
            grid.addChild(wk)
            row = (row + 1)
        }
        return grid
    }

    ; What a reader is told about a chip. A month cell shows no times, so the
    ; name carries them: a chip that says only its title tells somebody using a
    ; screen reader strictly less than the week view did.
    fn chipLabel:string (e:CalEvent) {
        def p:[int] ([] _:int ( 0 0 0 ))
        UiDate.fromDays(e.clipStart p)
        def when:string (UiDate.longLabel((itemAt p 0) (itemAt p 1) (itemAt p 2)))
        if e.allDay {
            def days:int (model.chipSpan(e.id))
            if (days > 1) {
                return ((((e.title + ", all day, ") + (to_string days)) + " days from ") + when)
            }
            return (((e.title + ", all day, ") + when))
        }
        return ((((e.title + ", ") + (EventCalCtl.clock(e.startMin))) + ", ") + when)
    }

    fn colCount:int () {
        if (model.view == "day") {
            return 1
        }
        return 7
    }

    fn colWidth:double () {
        def n:int (this.colCount())
        def gaps:double (colGap * (to_double (n - 1)))
        return ((((this.oldW()) - 120.0) - gaps) / (to_double n))
    }

    ; A CSS length. Rounded to two places: the fractions are thirds, and a
    ; number with seventeen digits in it is noise in every dump that ever
    ; prints this tree.
    sfn px:string (v:double) {
        def scaled:int (to_int (v * 100.0))
        def whole:int (idiv scaled 100)
        def frac:int (scaled - (whole * 100))
        if (frac < 0) {
            frac = (0 - frac)
        }
        def fs:string (to_string frac)
        if (frac < 10) {
            fs = "0" + fs
        }
        return ((to_string whole) + "." + fs + "px")
    }

    ; The title, or as much as fits in `w` pixels followed by an ellipsis.
    fn fitTitle:string (title:string w:double) {
        if (w < 8.0) {
            return ""
        }
        return (UiText.fit((measurer.getTextEngine()) title "Arial" 11.0 w))
    }

    ; --- the look ------------------------------------------------------------

    fn evClass:string (id:string) {
        def cls:string "ec-ev"
        if (focused == id) {
            cls = (cls + " ec-ev-focus")
        }
        return cls
    }

    fn viewClass:string (v:string) {
        if (model.view == v) {
            return "ec-viewbtn ec-viewbtn-on"
        }
        return "ec-viewbtn"
    }

    fn viewTxtClass:string (v:string) {
        ; Its own token: no descendant selectors, so the label cannot inherit
        ; the selected fill from the button around it.
        if (model.view == v) {
            return "ec-viewtxt ec-viewtxt-on"
        }
        return "ec-viewtxt"
    }

    ; What one step is called in the current view, for the arrows' names.
    fn unitName:string () {
        if (model.view == "day") {
            return "day"
        }
        if (model.view == "month") {
            return "month"
        }
        return "week"
    }

    fn note:EVGElement () {
        return (tree Ec (Note
            "Three overlapping events fan out to the right: the first keeps the full width and each later one overlays it. Measured, not guessed."))
    }

    ; The page: the two ReUI patterns, then the measured week.
    fn page:EVGElement () {
        builtW = pageW
        def narrow:boolean (pageW < 600.0)
        boardA.cardW = (pageW - 40.0)
        boardA.narrow = narrow
        boardB.cardW = (pageW - 40.0)
        boardB.narrow = narrow
        boardA.focused = focused
        boardA.hovered = hovered
        boardB.focused = focused
        boardB.hovered = hovered
        def shell (tree Ec (Shell))
        shell.addChild((tree Ec (Cap "Event calendar · month, week, day, N days, agenda and resource views, with Settings")))
        shell.addChild((boardA.card()))
        shell.addChild((tree Ec (Cap "Resource view · a hotel's booking board: drag to move between rooms, drag the bottom edge to resize")))
        shell.addChild((boardB.card()))
        shell.addChild((tree Ec (Cap "Overlap layout · measured against @schedule-x/calendar")))
        shell.addChild((this.oldCard()))
        return shell
    }

    fn oldCard:EVGElement () {
        def page (tree Ec (Page))
        UiTree.inline(page "width" (EventCalDemo.px((this.oldW()))))

        def unit:string (this.unitName())
        def head (tree Ec
            (Head
                (NavBtn (props (id "ec-prev") (a11yLabel ("Previous " + unit))) (NavGlyph "‹"))
                (Caption (props (id "ec-caption")) (model.label()))
                (NavBtn (props (id "ec-next") (a11yLabel ("Next " + unit))) (NavGlyph "›"))
                (ViewBtn (props (id "ec-today") (a11yLabel "Today"))
                    (ViewTxt "Today"))))
        def vi:int 0
        def views:[string] ([] _:string ( "day" "week" "month" ))
        def labels:[string] ([] _:string ( "Day" "Week" "Month" ))
        while (vi < (array_length views)) {
            def v:string (itemAt views vi)
            ; Named rather than used inline: a bare `(itemAt …)` in text
            ; position is read as a tag name by the tree factory.
            def lbl:string (itemAt labels vi)
            head.addChild((tree Ec
                (ViewBtn (props (id ("ec-view-" + v))
                                (className (this.viewClass(v)))
                                (a11yLabel lbl))
                    (ViewTxt (props (className (this.viewTxtClass(v)))) lbl))))
            vi = (vi + 1)
        }
        page.addChild(head)

        def body (tree Ec (Body (props (id "ec-body") (a11yLabel (model.label())))))

        ; The weekday strip. Decoration: each event already carries its own day
        ; in its accessible name, so a column header would say it twice.
        def cols (tree Ec (DayCols))
        def nCols:int (this.colCount())
        def d:int 0
        while (d < nCols) {
            def dow:int (UiDate.weekday(((model.firstDay()) + d)))
            def p:[int] ([] _:int ( 0 0 0 ))
            UiDate.fromDays(((model.firstDay()) + d) p)
            def head2 (tree Ec (DayHead ((UiDate.dayAbbr(dow)) + " " + (to_string (itemAt p 2)))))
            UiTree.inline(head2 "width" (EventCalDemo.px((this.colWidth()))))
            cols.addChild(head2)
            d = (d + 1)
        }
        body.addChild(cols)

        ; THE MONTH IS A DIFFERENT DRAWING, so it returns here rather than
        ; falling through into the time grid. A month cell has no time axis:
        ; the reference gives every event in it a `grid-row` and a day span and
        ; not one a `top` or a `height`, timed events included. Drawing the
        ; hour rows under it would be drawing a time axis that means nothing.
        ; It used to `return body` here — the BODY, not the page — so the
        ; month drew without its header: no arrows, no caption and no view
        ; buttons, and once in Month there was nothing to press to leave it.
        if (model.view == "month") {
            body.addChild((this.monthGrid()))
            page.addChild(body)
            return page
        }

        ; --- the all-day band, one row per lane ------------------------------
        def band (tree Ec (Band (props (id "ec-band"))))
        def bandItems:[CalEvent] (model.bandEvents())
        def maxLane:int 0
        def bi:int 0
        while (bi < (array_length bandItems)) {
            def be:CalEvent (itemAt bandItems bi)
            if ((model.isVisible(be.id)) && (be.lane > maxLane)) {
                maxLane = be.lane
            }
            bi = (bi + 1)
        }
        def lane:int 1
        while (lane <= maxLane) {
            def row (tree Ec (BandRow))
            def bj:int 0
            while (bj < (array_length bandItems)) {
                def be:CalEvent (itemAt bandItems bj)
                ; CLIPPED to the days on screen: a day view used to draw a
                ; two-day band two columns wide, off the right of the page,
                ; and a band on another day one column to the right of it.
                if ((be.lane == lane) && (model.isVisible(be.id))) {
                    def offset:int (be.clipStart - (model.firstDay()))
                    def spanDays:int ((be.clipEnd - be.clipStart) + 1)
                    def bandW:double ((((to_double spanDays) * (this.colWidth()))
                        + ((to_double (spanDays - 1)) * colGap)))
                    def bandTitle:string (this.fitTitle(be.title (bandW - 10.0)))
                    def chip (tree Ec
                        (BandEv (props (id ("ec-" + be.id)) (a11yLabel (be.title + ", all day")))
                            (BandTxt bandTitle)))
                    ; Placed by hand, because a band chip spans several day
                    ; columns and no flex row expresses "starts at column 1 and
                    ; is three columns wide". Inline is legal for exactly this:
                    ; a case the sheet cannot say.
                    UiTree.inline(chip "left" (EventCalDemo.px(((to_double offset) * ((this.colWidth()) + colGap)))))
                    UiTree.inline(chip "width" (EventCalDemo.px(bandW)))
                    row.addChild(chip)
                }
                bj = (bj + 1)
            }
            band.addChild(row)
            lane = (lane + 1)
        }
        body.addChild(band)

        ; --- the time grid ---------------------------------------------------
        def grid (tree Ec (Grid (props (id "ec-grid"))))
        def dd:int 0
        while (dd < nCols) {
            def col (tree Ec (Col (props (id ("ec-col-" + (to_string dd))))))
            UiTree.inline(col "width" (EventCalDemo.px((this.colWidth()))))
            UiTree.inline(col "height" (EventCalDemo.px(gridH)))
            def dayItems:[CalEvent] (model.timedOn((model.weekStart + dd)))
            def k:int 0
            while (k < (array_length dayItems)) {
                def e:CalEvent (itemAt dayItems k)
                ; What SHOWS of the box, not its width: a later event laid
                ; over it covers everything right of its own left edge, so
                ; the first of three overlaid boxes shows only its first third
                ; and a title fitted to the full width was cut mid-word there.
                ; Less the 6px padding, the 3px spine and a little air.
                def shown:double (model.widthOf(e.id))
                def q:int 0
                while (q < (array_length dayItems)) {
                    def f:CalEvent (itemAt dayItems q)
                    if ((f.id != e.id) && ((model.zOf(f.id)) > (model.zOf(e.id)))
                        && (f.startMin < e.endMin) && (f.endMin > e.startMin)
                        && ((model.leftOf(f.id)) > (model.leftOf(e.id)))) {
                        def gap:double ((model.leftOf(f.id)) - (model.leftOf(e.id)))
                        if (gap < shown) {
                            shown = gap
                        }
                    }
                    q = (q + 1)
                }
                def evTitle:string (this.fitTitle(e.title ((shown * (this.colWidth())) - 12.0)))
                def box (tree Ec
                    (Ev (props (id ("ec-" + e.id))
                               (className (this.evClass(e.id)))
                               (a11yLabel (e.title + ", " + (EventCalCtl.clock(e.startMin))
                                   + " to " + (EventCalCtl.clock(e.endMin)))))
                        (EvTxt evTitle)))
                ; THE MEASURED NUMBERS, become pixels. `left` and `width` are
                ; fractions of the column: column 0 of 3 is the full width,
                ; column 2 of 3 is a third of it, offset two thirds — the
                ; overlay, not an even split.
                UiTree.inline(box "top" (EventCalDemo.px((this.yOf(e.id)))))
                UiTree.inline(box "height" (EventCalDemo.px((this.hOf(e.id)))))
                UiTree.inline(box "left" (EventCalDemo.px(((model.leftOf(e.id)) * (this.colWidth())))))
                UiTree.inline(box "width" (EventCalDemo.px(((model.widthOf(e.id)) * (this.colWidth())))))
                ; And the stacking, which is what makes the overlay legible:
                ; the narrowest box is on top.
                UiTree.inline(box "z-index" (to_string (model.zOf(e.id))))
                col.addChild(box)
                k = (k + 1)
            }
            grid.addChild(col)
            dd = (dd + 1)
        }
        body.addChild(grid)
        page.addChild(body)

        page.addChild((this.note()))
        return page
    }

    ; --- events --------------------------------------------------------------

    ; --- the boards' input ------------------------------------------------------
    ; An id says whose it is: "ea-" is Pattern A, "eb-" Pattern B, and the
    ; rest is the measured week, which keeps every rule it had.

    fn boardFor:int (id:string) {
        if (boardA.owns(id)) {
            return 1
        }
        if (boardB.owns(id)) {
            return 2
        }
        return 0
    }

    fn boardAt:EcBoard (which:int) {
        if (which == 2) {
            return boardB
        }
        return boardA
    }

    ; Open lists and popovers close when the press lands anywhere else.
    fn closeOthers:boolean (except:int) {
        def did:boolean false
        if (except != 1) {
            if (boardA.closeOverlays()) {
                did = true
            }
        }
        if (except != 2) {
            if (boardB.closeOverlays()) {
                did = true
            }
        }
        return did
    }

    fn onBoard:boolean (which:int target:string) {
        def b:EcBoard (this.boardAt(which))
        this.closeOthers(which)
        b.focused = focused
        b.hovered = hovered
        def r:boolean (b.press(target))
        focused = b.focused
        model.activeId = focused
        this.rebuild()
        return r
    }

    ; The pointer, for the gestures: a press on an event, its bottom edge or
    ; an empty slot arms one; everything else is a click at once.
    fn pointerDown:boolean (id:string x:double y:double) {
        this.laidOut()
        lastX = x
        lastY = y
        def which:int (this.boardFor(id))
        if (which == 0) {
            this.closeOthers(0)
            this.press(id)
            return true
        }
        this.closeOthers(which)
        def b:EcBoard (this.boardAt(which))
        b.focused = focused
        b.hovered = hovered
        b.pointerDown(id x y)
        focused = b.focused
        this.rebuild()
        return true
    }

    fn pointerMove:boolean (x:double y:double) {
        lastX = x
        lastY = y
        def which:int 0
        if ((strlen boardA.armed) > 0) {
            which = 1
        }
        if ((strlen boardB.armed) > 0) {
            which = 2
        }
        if (which == 0) {
            return false
        }
        this.laidOut()
        def b:EcBoard (this.boardAt(which))
        if (b.pointerMove(x y)) {
            this.rebuild()
            return true
        }
        return false
    }

    fn pointerUp:boolean () {
        def which:int 0
        if ((strlen boardA.armed) > 0) {
            which = 1
        }
        if ((strlen boardB.armed) > 0) {
            which = 2
        }
        if (which == 0) {
            return false
        }
        def b:EcBoard (this.boardAt(which))
        b.focused = focused
        def r:boolean (b.pointerUp())
        focused = b.focused
        this.rebuild()
        return r
    }

    ; The wheel scrolls the time grid under the pointer.
    fn scrollBy:boolean (dy:double) {
        def which:int (this.boardFor((this.hitId(lastX lastY))))
        if (which == 0) {
            return false
        }
        def b:EcBoard (this.boardAt(which))
        if (b.scrollBy(dy)) {
            this.rebuild()
            return true
        }
        return false
    }

    fn cursorAt:string (x:double y:double) {
        lastX = x
        lastY = y
        def id:string (this.hitId(x y))
        def which:int (this.boardFor(id))
        if (which == 0) {
            return ""
        }
        def b:EcBoard (this.boardAt(which))
        return (b.cursorFor((b.refine(id x y))))
    }

    fn statusOf:string (which:int) {
        def b:EcBoard (this.boardAt(which))
        return b.status
    }

    fn press:boolean (target:string) {
        if (target == "") {
            this.closeOthers(0)
            this.rebuild()
            return false
        }
        def owner:int (this.boardFor(target))
        if (owner > 0) {
            return (this.onBoard(owner target))
        }
        this.closeOthers(0)
        if (target == "ec-prev") {
            focused = target
            return (this.go(-1))
        }
        if (target == "ec-next") {
            focused = target
            return (this.go(1))
        }
        if (target == "ec-today") {
            focused = target
            cursor = today
            this.show()
            return true
        }
        if (target == "ec-view-day") {
            focused = target
            return (this.pickView("day"))
        }
        if ((strlen target) > 8) {
            if ((substring target 0 8) == "ec-more-") {
                def parsed@(optional):int (to_int (substring target 8 (strlen target)))
                if (null? parsed) {
                    return false
                }
                def dayNo:int (unwrap parsed)
                cursor = dayNo
                ; The "+N more" button is gone once the day is open; the
                ; focus goes to the view it opened.
                focused = "ec-view-day"
                return (this.pickView("day"))
            }
        }
        if (target == "ec-view-week") {
            focused = target
            return (this.pickView("week"))
        }
        if (target == "ec-view-month") {
            focused = target
            return (this.pickView("month"))
        }
        focused = target
        model.activeId = target
        this.rebuild()
        return true
    }

    ; Point the model at the cursor, the way the current view wants it: a day
    ; and a month show the cursor's day and month, a week the Monday on or
    ; before it (the week view's columns start on Monday).
    fn applyCursor:void () {
        if (model.view == "week") {
            def dow:int (UiDate.weekday(cursor))
            model.weekStart = (cursor - ((dow + 6) % 7))
            return
        }
        model.weekStart = cursor
    }

    fn show:void () {
        this.applyCursor()
        model.layout()
        this.rebuild()
    }

    ; One step in the current view's unit. The model's `step` knows the units
    ; (a month keeps the day of the month, clamped); it is run from the cursor
    ; so a week step moves the day being looked at by seven as well.
    fn go:boolean (delta:int) {
        model.weekStart = cursor
        model.step(delta)
        cursor = model.weekStart
        this.show()
        ; An event that had the focus may not exist in the new range; the focus
        ; then goes to the arrow that moved it, not to <body>.
        if (delta > 0) {
            this.keepFocus("ec-next")
        } {
            this.keepFocus("ec-prev")
        }
        return true
    }

    ; If what has the focus was not redrawn, give it to `fallback`.
    fn keepFocus:void (fallback:string) {
        if (focused == "") {
            return
        }
        def ring:[string] (this.tabRing())
        def i:int 0
        while (i < (array_length ring)) {
            if ((itemAt ring i) == focused) {
                return
            }
            i = (i + 1)
        }
        focused = fallback
        model.activeId = fallback
        this.rebuild()
    }

    fn pickView:boolean (v:string) {
        model.setView(v)
        this.applyCursor()
        ; RE-LAY IT OUT. `setView` changes which days are shown and therefore
        ; every clip, every lane and every column; without this the new view
        ; was drawn from the old view's arithmetic. `ec-prev` and `ec-next`
        ; next door have always called it — this one never did, which was the
        ; smaller half of why the buttons did nothing.
        model.layout()
        this.rebuild()
        this.keepFocus(("ec-view-" + model.view))
        return true
    }

    ; --- the keyboard ---------------------------------------------------------
    ;
    ; The mirror is a roving tabindex: one tab stop for the canvas. So the demo
    ; owns Tab (`ownsTab` in main.js) and walks every focusable it drew, in the
    ; order it drew them — arrows, Today, the three views, then the events.
    ; Past either end the browser takes the Tab and focus leaves the calendar.
    ; Enter and Space press what has the focus; the arrow keys still step.

    fn collectFocusable:void (el:EVGElement out:[string]) {
        if (el.a11yFocusable && ((strlen el.id) > 0)) {
            push out el.id
        }
        def i:int 0
        while (i < (el.getChildCount())) {
            this.collectFocusable((el.getChild(i)) out)
            i = (i + 1)
        }
    }

    fn tabRing:[string] () {
        def out:[string]
        def r:EVGElement (unwrap root)
        this.collectFocusable(r out)
        return out
    }

    fn tab:boolean (back:boolean) {
        def ring:[string] (this.tabRing())
        def n:int (array_length ring)
        if (n == 0) {
            return false
        }
        def at:int -1
        def i:int 0
        while (i < n) {
            if ((itemAt ring i) == focused) {
                at = i
            }
            i = (i + 1)
        }
        if (at < 0) {
            if back {
                focused = (itemAt ring (n - 1))
            } {
                focused = (itemAt ring 0)
            }
        } {
            if back {
                at = (at - 1)
            } {
                at = (at + 1)
            }
            if ((at < 0) || (at >= n)) {
                return false
            }
            focused = (itemAt ring at)
        }
        model.activeId = focused
        this.rebuild()
        return true
    }

    fn keyWith:boolean (k:string shift:boolean ctrl:boolean) {
        if (k == "Tab") {
            ; An open list closes as the focus leaves it, onto its trigger.
            def which0:int (this.boardFor(focused))
            if (which0 > 0) {
                def b0:EcBoard (this.boardAt(which0))
                def back:string (b0.closeLists())
                if ((strlen back) > 0) {
                    focused = back
                }
            }
            return (this.tab(shift))
        }
        def which:int (this.boardFor(focused))
        if ((which > 0) || ((strlen boardA.armed) > 0) || ((strlen boardB.armed) > 0)) {
            if (which == 0) {
                which = 1
                if ((strlen boardB.armed) > 0) {
                    which = 2
                }
            }
            def b:EcBoard (this.boardAt(which))
            b.focused = focused
            b.hovered = hovered
            def r:boolean (b.keyWith(k shift))
            focused = b.focused
            model.activeId = focused
            this.rebuild()
            return r
        }
        if ((k == "Enter") || (k == " ")) {
            if ((strlen focused) > 0) {
                return (this.press(focused))
            }
            return false
        }
        return (this.key(k))
    }

    fn key:boolean (k:string) {
        if ((this.boardFor(focused)) > 0) {
            return (this.keyWith(k false false))
        }
        if (k == "ArrowLeft") {
            return (this.go(-1))
        }
        if (k == "ArrowRight") {
            return (this.go(1))
        }
        return false
    }

    fn setHover:void (id:string) {
        def was:string hovered
        hovered = id
        ; A tooltip follows the pointer, so a hover that starts or ends one
        ; redraws the tree.
        if (boardA.tooltips && (was != id)) {
            if ((boardA.owns(was)) || (boardA.owns(id))) {
                this.rebuild()
            }
        }
    }

    fn setPressed:void (id:string) {
        pressed = id
    }

    fn setFocus:void (id:string) {
        focused = id
    }

    fn rebuild:void () {
        root = (this.page())
    }

    fn markStates:void (el:EVGElement) {
        el.isHovered = false
        el.isPressed = false
        el.isFocused = false
        if ((strlen el.id) > 0) {
            if (el.id == hovered) {
                el.isHovered = true
            }
            if (el.id == pressed) {
                el.isPressed = true
            }
            if (el.id == focused) {
                el.isFocused = true
            }
        }
        def i:int 0
        while (i < (el.getChildCount())) {
            this.markStates((el.getChild(i)))
            i = (i + 1)
        }
    }

    fn laidOut:EVGLayout () {
        ; The page decides the width; the cards are built for one, so a new
        ; width is a new tree.
        if (pageW != builtW) {
            this.rebuild()
        }
        def r:EVGElement (unwrap root)
        def s:EVGStyleSheet (unwrap sheet)
        UiTree.inline(r "width" (EventCalDemo.px(pageW)))
        UiTree.inline(r "height" ((to_string (to_int pageH)) + "px"))
        s.setViewport(pageW pageH false)
        this.markStates(r)
        s.applyTree(r "")
        def t:EVGTransition transitions
        t.reconcileTree(r)
        if layout {
            def lay:EVGLayout (unwrap layout)
            if ((s.layoutClean()) == false) {
                lay.setPageSize(pageW pageH)
                lay.layout(r)
                this.fitHeight(lay)
            }
            return lay
        }
        def fresh (new EVGLayout())
        fresh.setPageSize(pageW pageH)
        layout = fresh
        fresh.layout(r)
        this.fitHeight(fresh)
        return fresh
    }

    ; The page is as tall as what it holds: the lowest child, and the page's
    ; own padding under it.
    fn fitHeight:void (lay:EVGLayout) {
        def r:EVGElement (unwrap root)
        def bottom:double 0.0
        def i:int 0
        while (i < (r.getChildCount())) {
            def c:EVGElement (r.getChild(i))
            def b:double (c.calculatedY + c.calculatedHeight)
            if (b > bottom) {
                bottom = b
            }
            i = (i + 1)
        }
        def want:double (to_double (to_int ((bottom + 20.0) + 0.999)))
        def diff:double (want - pageH)
        if ((diff > 0.5) || (diff < -0.5)) {
            pageH = want
            def s:EVGStyleSheet (unwrap sheet)
            UiTree.inline(r "height" ((to_string (to_int pageH)) + "px"))
            s.setViewport(pageW pageH false)
            s.applyTree(r "")
            lay.setPageSize(pageW pageH)
            lay.layout(r)
        }
    }

    fn displayListJson:string () {
        def lay:EVGLayout (this.laidOut())
        def r:EVGElement (unwrap root)
        def dl (new EVGDisplayList())
        dl.setTextEngine((lay.getTextEngine()))
        dl.build(r)
        return (dl.toJson())
    }

    fn hitId:string (px:double py:double) {
        this.laidOut()
        def r:EVGElement (unwrap root)
        def hit (new EVGHitTest())
        return (hit.idAt(r px py))
    }

    fn a11yJson:string (generation:int focusId:string) {
        this.laidOut()
        def r:EVGElement (unwrap root)
        def b (new EVGA11yFromTree())
        def t:EVGA11yTree (b.build(r "Event calendar demo" generation focusId))
        return (t.toJson())
    }

    fn a11yProblems:[string] () {
        this.laidOut()
        def r:EVGElement (unwrap root)
        def b (new EVGA11yFromTree())
        def t:EVGA11yTree (b.build(r "Event calendar demo" 1 ""))
        return (t.lint())
    }

    fn styleErrorCount:int () {
        def s:EVGStyleSheet (unwrap sheet)
        return (s.getErrorCount())
    }

    fn styleErrorAt:string (i:int) {
        def s:EVGStyleSheet (unwrap sheet)
        return (s.getError(i))
    }

    fn tick:boolean (dtMs:double) {
        def r:EVGElement (unwrap root)
        def t:EVGTransition transitions
        t.advanceTree(r dtMs)
        return (t.busy(r))
    }

    fn busyNow:boolean () {
        def r:EVGElement (unwrap root)
        def t:EVGTransition transitions
        return (t.busy(r))
    }

    fn widthPx:double () {
        return pageW
    }

    fn heightPx:double () {
        this.laidOut()
        return pageH
    }
}
