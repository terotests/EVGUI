; =============================================================================
; UiRichSel — selecting text drawn as many pieces, as a page selects it
; =============================================================================
; A formatted chat message is not one run of text: it is a word per label
; (bold, a link, `code`), a bullet, a code block's lines. A reader paints
; over it with the pointer as over any page and copies what was painted;
; TextCtl cannot do that, it is one run.
;
; Here the pieces are read in order into one string (`text`): each piece's
; words and then what stands between it and the next (a space, a newline).
; The selection is UiTextSel over that string, so a press, a drag, a double
; click (a word) and a triple click (a line) work as they do on one run, and
; the copied text is the string between the ends: words with their spaces,
; lines with their newlines, no markers.
;
; Where each piece was laid out is its UiTextLines (`place`); a pointer is
; mapped to the line nearest it, then to the piece on that line nearest it,
; then to the index inside it (`indexAt`). `ends` gives the band a host draws:
; where the selection starts and ends on the page, as UiTextRects.
;
; No element and no engine of its own: the host gives it the pieces' texts
; and their lines.
; =============================================================================

Import "UiTextSel.rgr"

class UiRichPiece {
    def text:string ""
    ; where its text starts in the whole string
    def start:int 0
    ; where it was laid out; none until placed
    def lines@(optional):UiTextLines

    Constructor () {
    }
}

class UiRichSel {
    def pieces:[UiRichPiece]
    def text:string ""
    def sel:UiTextSel (new UiTextSel())
    ; the y of the last press or drag, for a host that drags with x alone
    def lastY:double 0.0

    Constructor () {
    }

    ; Reading the pieces again: `begin`, `add` per piece, `done`. The same
    ; string as before keeps the selection.
    fn begin:void () {
        def none:[UiRichPiece]
        pieces = none
        text = ""
    }

    ; a piece and what follows it up to the next ("" nothing, " ", "\n")
    fn add:void (t:string after:string) {
        def p (new UiRichPiece())
        p.text = t
        p.start = (strlen text)
        push pieces p
        text = ((text + t) + after)
    }

    ; what follows the last piece becomes `after` (a line ends after it)
    fn endWith:void (after:string) {
        def n:int (array_length pieces)
        if (n == 0) {
            return
        }
        def last:UiRichPiece (itemAt pieces (n - 1))
        text = ((substring text 0 (last.start + (strlen last.text))) + after)
    }

    fn done:void () {
        ; nothing follows the last piece
        this.endWith("")
        sel.setText(text)
    }

    fn count:int () {
        return (array_length pieces)
    }

    fn place:void (i:int lines:UiTextLines) {
        def p:UiRichPiece (itemAt pieces i)
        p.lines = lines
    }

    ; --- the selection ---------------------------------------------------------

    fn hasSelection:boolean () {
        return (sel.hasSelection())
    }

    fn selectedText:string () {
        return (sel.selectedText())
    }

    fn clear:void () {
        sel.clear()
    }

    fn pointerDown:void (px:double py:double clicks:int shift:boolean) {
        sel.pointerDown((this.indexAt(px py)) clicks shift)
    }

    fn pointerDrag:void (px:double py:double) {
        sel.pointerDrag((this.indexAt(px py)))
    }

    fn pointerUp:void () {
        sel.pointerUp()
    }

    ; --- pieces and indexes ----------------------------------------------------

    ; The piece index `i` is in: the last that starts at or before it.
    fn pieceAt:int (i:int) {
        def best:int 0
        def k:int 0
        while (k < (array_length pieces)) {
            def p:UiRichPiece (itemAt pieces k)
            if (p.start <= i) {
                best = k
            }
            k = (k + 1)
        }
        return best
    }

    ; `i` inside its piece: past the piece's words (on the space or the
    ; newline after them) is the end of its words.
    fn localOf:int (k:int i:int) {
        def p:UiRichPiece (itemAt pieces k)
        def at:int (i - p.start)
        def n:int (strlen p.text)
        if (at > n) {
            return n
        }
        if (at < 0) {
            return 0
        }
        return at
    }

    ; The index a pointer at (px, py) lands on: the line level with it (the
    ; nearest above or below), the piece on that line nearest it across, and
    ; the character edge inside that piece.
    fn indexAt:int (px:double py:double) {
        ; the line nearest in y
        def bestDy:double -1.0
        def rowY:double 0.0
        def rowH:double 0.0
        def k:int 0
        while (k < (array_length pieces)) {
            def p:UiRichPiece (itemAt pieces k)
            if (!null? p.lines) {
                def tl:UiTextLines (unwrap p.lines)
                for tl.lines ln:UiTextLine li {
                    def dy:double 0.0
                    if (py < ln.y) {
                        dy = (ln.y - py)
                    }
                    if (py > (ln.y + ln.h)) {
                        dy = (py - (ln.y + ln.h))
                    }
                    if ((bestDy < 0.0) || (dy < bestDy)) {
                        bestDy = dy
                        rowY = ln.y
                        rowH = ln.h
                    }
                }
            }
            k = (k + 1)
        }
        if (bestDy < 0.0) {
            return 0
        }
        ; on that row (lines whose middle is inside it), the nearest across
        def hitK:int -1
        def hitY:double 0.0
        def bestDx:double -1.0
        def mid:double (rowY + (rowH / 2.0))
        k = 0
        while (k < (array_length pieces)) {
            def p:UiRichPiece (itemAt pieces k)
            if (!null? p.lines) {
                def tl:UiTextLines (unwrap p.lines)
                for tl.lines ln:UiTextLine li {
                    def m:double (ln.y + (ln.h / 2.0))
                    if ((m >= rowY) && (m <= (rowY + rowH)) && ((mid >= ln.y) && (mid <= (ln.y + ln.h)))) {
                        def x1:double (ln.x + (tl.widthIn(li (ln.end - ln.start))))
                        def dx:double 0.0
                        if (px < ln.x) {
                            dx = (ln.x - px)
                        }
                        if (px > x1) {
                            dx = (px - x1)
                        }
                        if ((bestDx < 0.0) || (dx < bestDx)) {
                            bestDx = dx
                            hitK = k
                            hitY = m
                        }
                    }
                }
            }
            k = (k + 1)
        }
        if (hitK < 0) {
            return 0
        }
        def hp:UiRichPiece (itemAt pieces hitK)
        def htl:UiTextLines (unwrap hp.lines)
        return (hp.start + (htl.indexAt(px hitY)))
    }

    ; Where index `i` is on the page: the x of its edge and the line it is on
    ; (a UiTextRect of no width); none when its piece is not placed.
    fn pointOf@(optional):UiTextRect (i:int) {
        def miss@(optional):UiTextRect
        def k:int (this.pieceAt(i))
        if (k >= (array_length pieces)) {
            return miss
        }
        def p:UiRichPiece (itemAt pieces k)
        if (null? p.lines) {
            return miss
        }
        def tl:UiTextLines (unwrap p.lines)
        if ((tl.count()) == 0) {
            return miss
        }
        def at:int (this.localOf(k i))
        def ln:UiTextLine (itemAt tl.lines (tl.lineOf(at)))
        def r (new UiTextRect())
        r.x = (tl.xAt(at))
        r.y = ln.y
        r.h = ln.h
        def hit@(optional):UiTextRect r
        return hit
    }

    ; The band over the selection, as a page paints it between `left` and
    ; `right` (the box's content edges): on one line, from the start to the
    ; end; over several, from the start to the right edge, the whole lines
    ; between, and from the left edge to the end. Empty: no selection.
    fn rects:[UiTextRect] (left:double right:double) {
        return (this.rectsIn((sel.selStart()) (sel.selEnd()) left right))
    }

    ; The selection's part in pieces [k0, k1) (a code block inside the
    ; message, say): its first and last index there; -1 -1 none.
    fn partIn:[int] (k0:int k1:int) {
        def out:[int]
        def p0:UiRichPiece (itemAt pieces k0)
        def p1:UiRichPiece (itemAt pieces (k1 - 1))
        def a:int (sel.selStart())
        def b:int (sel.selEnd())
        if (a < p0.start) {
            a = p0.start
        }
        def e1:int (p1.start + (strlen p1.text))
        if (b > e1) {
            b = e1
        }
        if (b <= a) {
            push out -1
            push out -1
            return out
        }
        push out a
        push out b
        return out
    }

    ; the band over [a0, b0), as `rects` paints it
    fn rectsIn:[UiTextRect] (a0:int b0:int left:double right:double) {
        def out:[UiTextRect]
        if (b0 <= a0) {
            return out
        }
        def a@(optional):UiTextRect (this.pointOf(a0))
        def b@(optional):UiTextRect (this.pointOf(b0))
        if ((null? a) || (null? b)) {
            return out
        }
        def s:UiTextRect (unwrap a)
        def e:UiTextRect (unwrap b)
        if ((fabs (s.y - e.y)) < 0.5) {
            if (e.x > s.x) {
                def one (new UiTextRect())
                one.x = s.x
                one.y = s.y
                one.w = (e.x - s.x)
                one.h = s.h
                push out one
            }
            return out
        }
        def first (new UiTextRect())
        first.x = s.x
        first.y = s.y
        first.w = (right - s.x)
        first.h = s.h
        push out first
        def below:double (s.y + s.h)
        if (e.y > below) {
            def mid (new UiTextRect())
            mid.x = left
            mid.y = below
            mid.w = (right - left)
            mid.h = (e.y - below)
            push out mid
        }
        if (e.x > left) {
            def last (new UiTextRect())
            last.x = left
            last.y = e.y
            last.w = (e.x - left)
            last.h = e.h
            push out last
        }
        return out
    }
}
