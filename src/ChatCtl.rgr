; SPDX-License-Identifier: AGPL-3.0-or-later

; =============================================================================
; ChatCtl — a conversation beside the work: messages, who wrote them, a line
; to write the next one, and how many came while it was closed
; =============================================================================
; After MessageDemo's transcript, made a control a host keeps open or hidden
; beside a document (Sliqtly's chat on a presentation): each message has the
; writer's name in their colour and the time, the person's own on the right,
; and the panel can be closed — while it is, every message from someone else
; counts, and `badge()` is "(4)" for the button that opens it again.
;
; STATE: `messages` (oldest first, at most `keep`), `open`, `unread`, and
; the message being written in `input` (an InputCtl; `draft()` is its text). The host adds messages as they arrive (`add`, which ignores an id
; it has); opening the panel reads them all. What the person sends is left in
; `sent` for the host to take (`takeSent`) and post; it comes back through
; `add` like everyone else's.
;
; COPYING: each message's words are a selectable TextCtl (`<msg>-text`): a
; press and drag selects (double: a word, triple: all of it), and
; `selectedText` is what the host copies: the draft's selection while it has
; one, else the message's.
;
; WINDOW: `shown` messages from `top`; the newest stay in view while the
; reader is at the end (`follow`), and a reader who scrolled up is left where
; they are with a "N new" button that jumps to the end.
;
; A THREAD (one conversation of several, such as a comment pinned to a
; slide): `subtitle` is a line under the title ("Slide 3 · resolved"),
; `addAction` puts buttons in a row under it (`<tid>-act-<value>`; a press
; leaves the value in `acted` for the host to `takeAction`), and `readOnly`
; shows `readOnlyText` where the composer was (a closed thread).
;
; KEYS (the host sends them while the composer has focus): Enter sends,
; Escape closes, PageUp/PageDown scroll; typing and every other key are the
; text field's (caret, selection, Ctrl+A, Backspace a whole emoji). POINTER:
; `<tid>-close`, `<tid>-send`, `<tid>-jump`, and presses in the field
; (UiCtl.textPointerDown). A host that keeps focus itself sets
; `input.focused` while the composer has the keyboard.
;
; TO A READER: a region named by the title; the messages a log (a live
; region), each one text "name, time: message"; the draft a text field; the
; buttons buttons.
; =============================================================================

Import "UiCtl.rgr"
Import "InputCtl.rgr"
Import "TextCtl.rgr"
Import "UiTree.rgr"
Import "pkg:evg/EVGElement.rgr"
Import "pkg:evg/EVGA11yTree.rgr"

class UiChatMessage {
    def id:string ""
    ; who wrote it: an id the host keeps for a person
    def who:string ""
    def name:string ""
    ; the writer's colour, "#rrggbb"
    def color:string "#64748b"
    def text:string ""
    ; as the host shows it ("14:05")
    def time:string ""
    def mine:boolean false

    Constructor () {
    }
}

class ChatCtl extends UiCtl {
    def title:string "Chat"
    def placeholder:string "Write a message…"
    def emptyText:string "No messages yet."
    def sendText:string "Send"
    def closeText:string "Close"
    ; "N new": the jump button, with the count in front
    def newText:string "new"
    def messages:[UiChatMessage]
    def keep:int 500
    def open:boolean false
    def unread:int 0
    ; the message being written: an ordinary text field, so its caret,
    ; selection, word moves and pointer are InputCtl's
    def input:InputCtl (new InputCtl())
    def sent:string ""
    def maxLength:int 2000
    ; the window of messages on screen
    def top:int 0
    def shown:int 6
    def follow:boolean true
    ; the panel's height in px when the host gives it one (0: the sheet's);
    ; the messages get what the title bar and the composer leave (84 px)
    def height:double 0.0
    ; arrived while the reader was scrolled up
    def unseenBelow:int 0
    ; a line under the title ("" none)
    def subtitle:string ""
    ; the buttons under the title: value, label, variant ("", "primary",
    ; "danger"); the last one pressed, until the host takes it
    def actValues:[string]
    def actLabels:[string]
    def actVariants:[string]
    def acted:string ""
    ; no composer: `readOnlyText` in its place
    def readOnly:boolean false
    def readOnlyText:string ""
    ; the messages' words as drawn (selectable), and the message ids they
    ; are, kept over rebuilds so a selection stays; `selIn` is the one a
    ; press went to last (-1 the draft or none)
    def texts:[TextCtl]
    def textIds:[string]
    def selIn:int -1

    Constructor () {
    }

    fn setup:void (id:string label:string) {
        tid = id
        name = label
        title = label
    }

    fn fieldTid:string () {
        return (tid + "-field")
    }

    ; what is written so far
    fn draft:string () {
        return input.value
    }

    ; --- messages ---------------------------------------------------------------

    fn has:boolean (id:string) {
        for messages m:UiChatMessage i {
            if (m.id == id) {
                return true
            }
        }
        return false
    }

    ; -> false when a message with that id is here already
    fn add:boolean (id:string who:string writer:string color:string text:string time:string mine:boolean) {
        if (((strlen id) > 0) && (this.has(id))) {
            return false
        }
        def m (new UiChatMessage())
        m.id = id
        m.who = who
        m.name = writer
        m.color = color
        m.text = text
        m.time = time
        m.mine = mine
        push messages m
        while ((array_length messages) > keep) {
            remove_index messages 0
            if (top > 0) {
                top = (top - 1)
            }
        }
        if ((open == false) && (mine == false)) {
            unread = (unread + 1)
        }
        if follow {
            this.toEnd()
        } {
            if (mine == false) {
                unseenBelow = (unseenBelow + 1)
            }
        }
        return true
    }

    ; a person's new name on what they wrote
    fn rename:void (who:string writer:string color:string) {
        for messages m:UiChatMessage i {
            if (m.who == who) {
                m.name = writer
                m.color = color
            }
        }
    }

    fn count:int () {
        return (array_length messages)
    }

    fn at:UiChatMessage (i:int) {
        return (itemAt messages i)
    }

    ; --- open / closed -----------------------------------------------------------

    fn setOpen:void (o:boolean) {
        open = o
        if open {
            unread = 0
            this.toEnd()
        }
    }

    fn toggle:void () {
        this.setOpen((open == false))
    }

    ; "(4)", "(99+)", or "" with nothing unread
    fn badge:string () {
        if (unread <= 0) {
            return ""
        }
        if (unread > 99) {
            return "(99+)"
        }
        return (("(" + (to_string unread)) + ")")
    }

    ; the button's text: "Chat (4)"
    fn buttonLabel:string (base:string) {
        def b:string (this.badge())
        if ((strlen b) == 0) {
            return base
        }
        return ((base + " ") + b)
    }

    ; --- the window ----------------------------------------------------------------

    fn maxTop:int () {
        def m:int ((array_length messages) - shown)
        if (m < 0) {
            return 0
        }
        return m
    }

    fn toEnd:void () {
        top = (this.maxTop())
        follow = true
        unseenBelow = 0
    }

    fn scrollBy:void (n:int) {
        top = (top + n)
        if (top < 0) {
            top = 0
        }
        if (top >= (this.maxTop())) {
            this.toEnd()
        } {
            follow = false
        }
    }

    ; --- the buttons under the title ---------------------------------------------------

    fn clearActions:void () {
        def none:[string]
        actValues = none
        def none2:[string]
        actLabels = none2
        def none3:[string]
        actVariants = none3
    }

    fn addAction:void (value:string label:string variant:string) {
        push actValues value
        push actLabels label
        push actVariants variant
    }

    fn actionTid:string (value:string) {
        return (tid + "-act-" + value)
    }

    ; the value of the button last pressed, once
    fn takeAction:string () {
        def a:string acted
        acted = ""
        return a
    }

    ; what the title bar and the composer (or the line in its place), the
    ; subtitle and the buttons leave the messages
    fn chromeH:double () {
        def used:double 84.0
        if ((strlen subtitle) > 0) {
            used = (used + 22.0)
        }
        if ((array_length actValues) > 0) {
            used = (used + 40.0)
        }
        return used
    }

    ; --- the draft -------------------------------------------------------------------

    fn typeChar:boolean (target:string ch:string) {
        if readOnly {
            return false
        }
        input.maxLength = maxLength
        input.insertText(ch)
        return true
    }

    fn backspace:void () {
        input.backspace()
    }

    ; the draft goes to `sent` (the host posts it); "" sends nothing
    fn send:boolean () {
        if readOnly {
            return false
        }
        def t:string (trim input.value)
        if ((strlen t) == 0) {
            return false
        }
        sent = t
        input.setValue("")
        input.moveTo(0 false)
        input.scrollX = 0.0
        return true
    }

    fn takeSent:string () {
        def s:string sent
        sent = ""
        return s
    }

    fn keyDown:string (target:string key:string) {
        return (this.keyDownWith(target key false false))
    }

    ; Enter sends, Escape closes, PageUp/PageDown scroll the messages; every
    ; other key is the text field's (arrows, Home/End, Ctrl+A, Backspace…).
    fn keyDownWith:string (target:string key:string shift:boolean ctrl:boolean) {
        def mine:boolean ((((key == "Enter") || (key == "Escape")) || (key == "PageUp")) || (key == "PageDown"))
        if (mine == false) {
            if (readOnly == false) {
                input.keyDownWith(input.tid key shift ctrl)
            }
            return ""
        }
        if (key == "Enter") {
            this.send()
        }
        if (key == "Escape") {
            this.setOpen(false)
        }
        if (key == "PageUp") {
            this.scrollBy((0 - shown))
        }
        if (key == "PageDown") {
            this.scrollBy(shown)
        }
        return ""
    }

    ; --- the pointer ----------------------------------------------------------------------

    fn activate:string (target:string) {
        if (target == (tid + "-close")) {
            this.setOpen(false)
            return target
        }
        if (target == (tid + "-send")) {
            this.send()
            return target
        }
        if (target == (tid + "-jump")) {
            this.toEnd()
            return target
        }
        def k:int 0
        while (k < (array_length actValues)) {
            if (target == (this.actionTid((itemAt actValues k)))) {
                acted = (itemAt actValues k)
                return target
            }
            k = (k + 1)
        }
        return ""
    }

    fn onFocus:void (target:string) {
        input.focused = (target == (this.fieldTid()))
    }

    fn onBlur:void (target:string) {
        input.focused = false
        input.pointerUp()
    }

    fn placeText:void (eng:EVGTextEngine) {
        input.placeText(eng)
        def i:int top
        while ((i < (top + shown)) && (i < (array_length messages))) {
            def t:TextCtl (this.textOf(i))
            t.placeText(eng)
            i = (i + 1)
        }
    }

    fn textPointerDown:boolean (target:string px:double clicks:int shift:boolean) {
        return (this.textPointerDownAt(target px -1.0 clicks shift))
    }

    ; a press in the draft, or in a message's words (which `py` finds the
    ; line of; -1 its last one)
    fn textPointerDownAt:boolean (target:string px:double py:double clicks:int shift:boolean) {
        if (input.owns(target)) {
            this.dropTexts(-1)
            selIn = -1
            return (input.textPointerDown(target px clicks shift))
        }
        def k:int (this.textIndexOf(target))
        if (k < 0) {
            return false
        }
        this.dropTexts(k)
        selIn = k
        def t:TextCtl (itemAt texts k)
        def y:double py
        if (y < 0.0) {
            y = t.lastY
        }
        return (t.textPointerDownAt(target px y clicks shift))
    }

    fn textPointerDrag:boolean (px:double) {
        if (selIn >= 0) {
            def t:TextCtl (itemAt texts selIn)
            return (t.textPointerDrag(px))
        }
        return (input.textPointerDrag(px))
    }

    fn textPointerDragAt:boolean (px:double py:double) {
        if (selIn >= 0) {
            def t:TextCtl (itemAt texts selIn)
            return (t.textPointerDragAt(px py))
        }
        return (input.textPointerDrag(px))
    }

    fn textPointerUp:void () {
        input.pointerUp()
        if (selIn >= 0) {
            def t:TextCtl (itemAt texts selIn)
            t.textPointerUp()
        }
    }

    fn selectedText:string () {
        def d:string (input.selectedText())
        if ((strlen d) > 0) {
            return d
        }
        if (selIn >= 0) {
            def t:TextCtl (itemAt texts selIn)
            return (t.selectedText())
        }
        return ""
    }

    fn dropSelection:void () {
        this.dropTexts(-1)
        selIn = -1
    }

    ; every message's selection but the `keep`th's
    fn dropTexts:void (keep:int) {
        def i:int 0
        while (i < (array_length texts)) {
            if (i != keep) {
                def t:TextCtl (itemAt texts i)
                t.dropSelection()
            }
            i = (i + 1)
        }
    }

    ; the message whose words `target` is in: its index in `texts`, -1 none
    fn textIndexOf:int (target:string) {
        def i:int 0
        while (i < (array_length texts)) {
            def t:TextCtl (itemAt texts i)
            if (t.owns(target)) {
                return i
            }
            i = (i + 1)
        }
        return -1
    }

    ; The `i`th message's words, made once per message id (so a selection
    ; outlives a rebuild); built for this window.
    fn textOf:TextCtl (i:int) {
        def m:UiChatMessage (itemAt messages i)
        def k:int 0
        while (k < (array_length textIds)) {
            if ((itemAt textIds k) == m.id) {
                def had:TextCtl (itemAt texts k)
                had.tid = ((this.msgTid(i)) + "-text")
                return had
            }
            k = (k + 1)
        }
        def t:TextCtl (new TextCtl())
        t.selectable = true
        t.textClass = "chat-text"
        t.boxClass = "chat-text-box"
        t.tid = ((this.msgTid(i)) + "-text")
        t.setText(m.text)
        push texts t
        push textIds m.id
        return t
    }

    ; texts of messages no longer in the window are let go
    fn keepTexts:void () {
        def i:int ((array_length textIds) - 1)
        while (i >= 0) {
            def id:string (itemAt textIds i)
            def seen:boolean false
            def j:int top
            while ((j < (top + shown)) && (j < (array_length messages))) {
                def m:UiChatMessage (itemAt messages j)
                if (m.id == id) {
                    seen = true
                }
                j = (j + 1)
            }
            if (seen == false) {
                remove_index texts i
                remove_index textIds i
                if (selIn == i) {
                    selIn = -1
                }
                if (selIn > i) {
                    selIn = (selIn - 1)
                }
            }
            i = (i - 1)
        }
    }

    fn msgTid:string (i:int) {
        return (tid + "-m-" + (to_string i))
    }

    ; --- drawing ----------------------------------------------------------------------------

    fn build:void () {
        this.keepTexts()
        def root:EVGElement (UiTree.div(tid "chat-panel"))
        def head:EVGElement (UiTree.div((tid + "-head") "chat-head"))
        head.addChild((UiTree.label((tid + "-title") "chat-title" title)))
        head.addChild((UiTree.label((tid + "-close") "chat-close" "×")))
        root.addChild(head)
        if ((strlen subtitle) > 0) {
            root.addChild((UiTree.label((tid + "-sub") "chat-sub" subtitle)))
        }
        if ((array_length actValues) > 0) {
            def acts:EVGElement (UiTree.div((tid + "-acts") "chat-acts"))
            def a:int 0
            while (a < (array_length actValues)) {
                def acls:string "chat-act"
                def av:string (itemAt actVariants a)
                if ((strlen av) > 0) {
                    acls = (acls + " chat-act-" + av)
                }
                acts.addChild((UiTree.label((this.actionTid((itemAt actValues a))) acls (itemAt actLabels a))))
                a = (a + 1)
            }
            root.addChild(acts)
        }
        def list:EVGElement (UiTree.div((tid + "-log") "chat-log"))
        if (height > 0.0) {
            UiTree.inline(root "height" ((to_string height) + "px"))
            def lh:double (height - (this.chromeH()))
            if (lh < 40.0) {
                lh = 40.0
            }
            UiTree.inline(list "height" ((to_string lh) + "px"))
        }
        if ((array_length messages) == 0) {
            list.addChild((UiTree.label((tid + "-empty") "chat-empty" emptyText)))
        }
        def i:int top
        while ((i < (top + shown)) && (i < (array_length messages))) {
            def m:UiChatMessage (itemAt messages i)
            def cls:string "chat-msg"
            if m.mine {
                cls = "chat-msg chat-msg-mine"
            }
            def box:EVGElement (UiTree.div((this.msgTid(i)) cls))
            def meta:EVGElement (UiTree.div(((this.msgTid(i)) + "-meta") "chat-meta"))
            def who:EVGElement (UiTree.label(((this.msgTid(i)) + "-name") "chat-name" m.name))
            UiTree.inline(who "color" m.color)
            meta.addChild(who)
            if ((strlen m.time) > 0) {
                meta.addChild((UiTree.label(((this.msgTid(i)) + "-time") "chat-time" m.time)))
            }
            box.addChild(meta)
            def body:TextCtl (this.textOf(i))
            if (body.text != m.text) {
                body.setText(m.text)
            }
            body.build()
            box.addChild((unwrap body.rootEl))
            list.addChild(box)
            i = (i + 1)
        }
        root.addChild(list)
        if (unseenBelow > 0) {
            root.addChild((UiTree.label((tid + "-jump") "chat-jump" (((to_string unseenBelow) + " ") + newText))))
        }
        if readOnly {
            def ro:EVGElement (UiTree.div((tid + "-composer") "chat-composer chat-readonly"))
            ro.addChild((UiTree.label((tid + "-ro") "chat-ro-text" readOnlyText)))
            root.addChild(ro)
            rootEl = root
            return
        }
        def composer:EVGElement (UiTree.div((tid + "-composer") "chat-composer"))
        input.tid = (this.fieldTid())
        input.name = placeholder
        input.placeholder = placeholder
        input.maxLength = maxLength
        input.boxClass = "chat-field"
        input.textClass = "chat-draft"
        input.build()
        def field:EVGElement (unwrap input.rootEl)
        composer.addChild(field)
        def sendCls:string "chat-send"
        if ((strlen (trim input.value)) == 0) {
            sendCls = "chat-send chat-send-off"
        }
        composer.addChild((UiTree.label((tid + "-send") sendCls sendText)))
        root.addChild(composer)
        rootEl = root
    }

    ; --- what it is, to a reader ----------------------------------------------------------------

    fn tids:[string] () {
        def a:[string]
        push a tid
        push a (tid + "-close")
        if ((strlen subtitle) > 0) {
            push a (tid + "-sub")
        }
        def b:int 0
        while (b < (array_length actValues)) {
            push a (this.actionTid((itemAt actValues b)))
            b = (b + 1)
        }
        push a (tid + "-log")
        def i:int top
        while ((i < (top + shown)) && (i < (array_length messages))) {
            push a (this.msgTid(i))
            def wt:TextCtl (this.textOf(i))
            def words:[string] (wt.tids())
            for words w:string wi {
                push a w
            }
            i = (i + 1)
        }
        if (unseenBelow > 0) {
            push a (tid + "-jump")
        }
        if readOnly {
            push a (tid + "-ro")
            return a
        }
        def inner:[string] (input.tids())
        def k:int 0
        while (k < (array_length inner)) {
            push a (itemAt inner k)
            k = (k + 1)
        }
        push a (tid + "-send")
        return a
    }

    fn isFocusable:boolean (target:string) {
        if ((indexOf target (tid + "-act-")) == 0) {
            return true
        }
        return (((target == (tid + "-field")) || (target == (tid + "-send"))) || (target == (tid + "-close")))
    }

    fn rows:[UiRow] () {
        def out:[UiRow]
        push out (UiRow.of(tid (EVGA11yRole.region()) title))
        def close:UiRow (UiRow.of((tid + "-close") (EVGA11yRole.button()) closeText))
        close.parentTid = tid
        close.focusable = true
        close.tabStop = true
        push out close
        if ((strlen subtitle) > 0) {
            def sub:UiRow (UiRow.of((tid + "-sub") (EVGA11yRole.text()) subtitle))
            sub.parentTid = tid
            push out sub
        }
        def b:int 0
        while (b < (array_length actValues)) {
            def ar:UiRow (UiRow.of((this.actionTid((itemAt actValues b))) (EVGA11yRole.button()) (itemAt actLabels b)))
            ar.parentTid = tid
            ar.focusable = true
            ar.tabStop = true
            push out ar
            b = (b + 1)
        }
        def log:UiRow (UiRow.of((tid + "-log") (EVGA11yRole.log()) title))
        log.parentTid = tid
        push out log
        def i:int top
        while ((i < (top + shown)) && (i < (array_length messages))) {
            def m:UiChatMessage (itemAt messages i)
            def said:string m.name
            if ((strlen m.time) > 0) {
                said = ((said + ", ") + m.time)
            }
            def r:UiRow (UiRow.of((this.msgTid(i)) (EVGA11yRole.text()) ((said + ": ") + m.text)))
            r.parentTid = (tid + "-log")
            push out r
            i = (i + 1)
        }
        if (unseenBelow > 0) {
            def j:UiRow (UiRow.of((tid + "-jump") (EVGA11yRole.button()) (((to_string unseenBelow) + " ") + newText)))
            j.parentTid = tid
            push out j
        }
        if readOnly {
            def ro:UiRow (UiRow.of((tid + "-ro") (EVGA11yRole.text()) readOnlyText))
            ro.parentTid = tid
            push out ro
            return out
        }
        def f:UiRow (UiRow.of((tid + "-field") (EVGA11yRole.textField()) placeholder))
        f.parentTid = tid
        f.hasText = true
        f.text = input.value
        f.hasSelection = true
        f.selStart = (input.selStart())
        f.selEnd = (input.selEnd())
        f.placeholder = placeholder
        f.focusable = true
        f.tabStop = true
        push out f
        def s:UiRow (UiRow.of((tid + "-send") (EVGA11yRole.button()) sendText))
        s.parentTid = tid
        s.disabled = ((strlen (trim input.value)) == 0)
        s.focusable = true
        push out s
        return out
    }
}
