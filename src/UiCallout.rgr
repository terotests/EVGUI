; =============================================================================
; UiCallout — where a callout box goes beside the point it is about, and its
; tail: no page, no drawing, only the numbers (CalloutCtl draws them)
; =============================================================================
; A callout is a box near a point (`ax`, `ay` on the page) with a wedge from
; the box's edge to the point, the way a slide's callout shape points at
; what it says something about.
;
; WHERE THE BOX GOES (`place`, once its size `bw` × `bh` is known): above
; and to the right of the point, `gap` away; below, left, or below-left when
; that does not fit inside the page (`pw` × `ph`, `margin` from its edges,
; below `top`);
; when none fits, the first one pushed inside. A box the person dragged
; (`dragBy`) stays where they put it, still inside the page.
;
; THE TAIL: from the box edge facing the point (where the line from the
; box's centre to the point leaves the box) to the point itself, `tailW`
; wide at the box. Its base sits on the straight part of that edge, clear of
; the `radius` corners, so both base corners touch the box (a base out at a
; rounded corner hangs in the air beside it). None while the point is under
; the box.
;
; THE SHAPE: the box and its tail are ONE outline (`shapePath`), a rounded
; box with the wedge in its edge, the way a speech bubble is drawn: one fill
; and one stroke, so there is no seam where the tail meets the box and the
; edge line runs on along the tail. It is an SVG path in its own bounding box
; (`shapeX`, `shapeY`, `shapeW` × `shapeH`), the outline `inset` inside the
; box so a stroke that wide sits where a CSS border would.
; =============================================================================

class UiCallout {
    ; the point, and the page
    def ax:double 0.0
    def ay:double 0.0
    def pw:double 0.0
    def ph:double 0.0
    ; the box's size, and where it went
    def bw:double 0.0
    def bh:double 0.0
    def x:double 0.0
    def y:double 0.0
    def gap:double 44.0
    def margin:double 8.0
    ; the top of the room it may use (a bar across the page's top it
    ; keeps clear of); `ph` is its bottom
    def top:double 0.0
    def tailW:double 22.0
    ; the box's corner radius (base.css .callout's border-radius) and how far
    ; inside the box the outline runs (half its stroke)
    def radius:double 14.0
    def inset:double 0.5
    ; put somewhere by hand: kept there (`ux`, `uy`, before clamping)
    def moved:boolean false
    def ux:double 0.0
    def uy:double 0.0
    ; the wedge: its two corners on the box edge (in the outline's order),
    ; then the point
    def hasTail:boolean false
    def tail:[double]
    ; the edge the tail is on: 0 top, 1 right, 2 bottom, 3 left
    def side:int 2
    ; the box and the tail as one outline
    def shapeX:double 0.0
    def shapeY:double 0.0
    def shapeW:double 0.0
    def shapeH:double 0.0

    fn setPoint:void (px:double py:double) {
        ax = px
        ay = py
    }

    fn setPage:void (w:double h:double) {
        pw = w
        ph = h
    }

    ; the room from `t` down to `b` (`b` the page's height when it is all)
    fn setRows:void (t:double b:double) {
        top = t
        ph = b
    }

    fn setSize:void (w:double h:double) {
        bw = w
        bh = h
    }

    ; the box at (bx, by) is inside the page
    fn fits:boolean (bx:double by:double) {
        return ((((bx >= margin) && (by >= (top + margin))) && ((bx + bw) <= (pw - margin))) && ((by + bh) <= (ph - margin)))
    }

    fn clampX:double (bx:double) {
        def v:double bx
        if ((v + bw) > (pw - margin)) {
            v = ((pw - margin) - bw)
        }
        if (v < margin) {
            v = margin
        }
        return v
    }

    fn clampY:double (by:double) {
        def v:double by
        if ((v + bh) > (ph - margin)) {
            v = ((ph - margin) - bh)
        }
        if (v < (top + margin)) {
            v = (top + margin)
        }
        return v
    }

    ; Where the box goes, and the tail to the point.
    fn place:void () {
        if moved {
            x = (this.clampX(ux))
            y = (this.clampY(uy))
        } {
            def right:double (ax + (gap * 0.5))
            def left:double ((ax - (gap * 0.5)) - bw)
            def above:double ((ay - gap) - bh)
            def below:double (ay + gap)
            def xs:[double] (([] _:double (right right left left)))
            def ys:[double] (([] _:double (above below above below)))
            x = (this.clampX(right))
            y = (this.clampY(above))
            def i:int 3
            while (i >= 0) {
                if (this.fits((itemAt xs i) (itemAt ys i))) {
                    x = (itemAt xs i)
                    y = (itemAt ys i)
                }
                i = (i - 1)
            }
        }
        this.placeTail()
        this.placeShape()
    }

    ; Dragged by (`dx`, `dy`) from where it is now.
    fn dragBy:void (dx:double dy:double) {
        moved = true
        ux = (x + dx)
        uy = (y + dy)
        this.place()
    }

    ; Back where it goes by itself.
    fn reset:void () {
        moved = false
    }

    fn placeTail:void () {
        def none:[double]
        tail = none
        hasTail = false
        if ((((ax >= x) && (ax <= (x + bw))) && (ay >= y)) && (ay <= (y + bh))) {
            return
        }
        def cx:double (x + (bw * 0.5))
        def cy:double (y + (bh * 0.5))
        def dx:double (ax - cx)
        def dy:double (ay - cy)
        ; where the line from the centre to the point leaves the box
        def t:double 1.0
        if (dx != 0.0) {
            def tx:double ((bw * 0.5) / (UiCallout.absOf(dx)))
            if (tx < t) {
                t = tx
            }
        }
        if (dy != 0.0) {
            def ty:double ((bh * 0.5) / (UiCallout.absOf(dy)))
            if (ty < t) {
                t = ty
            }
        }
        ; the edge it leaves through, and how far along it
        def horiz:boolean false
        if (dx != 0.0) {
            horiz = (((bw * 0.5) / (UiCallout.absOf(dx))) <= t)
        }
        def ex:double (cx + (dx * t))
        def ey:double (cy + (dy * t))
        def len:double (sqrt ((dx * dx) + (dy * dy)))
        if (len <= 0.0) {
            return
        }
        ; the base on the straight part of that edge, between the corners
        def lo:double 0.0
        def hi:double 0.0
        def along:double 0.0
        if horiz {
            side = (? (dx > 0.0) 1 3)
            lo = y
            hi = (y + bh)
            along = ey
        } {
            side = (? (dy > 0.0) 2 0)
            lo = x
            hi = (x + bw)
            along = ex
        }
        def r:double (this.cornerR())
        def hw:double (tailW * 0.5)
        def room:double (((hi - lo) - (r * 2.0)) * 0.5)
        if (hw > room) {
            hw = room
        }
        if (hw < 1.0) {
            return
        }
        if (along < ((lo + r) + hw)) {
            along = ((lo + r) + hw)
        }
        if (along > ((hi - r) - hw)) {
            along = ((hi - r) - hw)
        }
        ; the base's corners in the order the outline meets them (clockwise)
        if (side == 0) {
            push tail (along - hw)
            push tail (y + inset)
            push tail (along + hw)
            push tail (y + inset)
        }
        if (side == 1) {
            push tail ((x + bw) - inset)
            push tail (along - hw)
            push tail ((x + bw) - inset)
            push tail (along + hw)
        }
        if (side == 2) {
            push tail (along + hw)
            push tail ((y + bh) - inset)
            push tail (along - hw)
            push tail ((y + bh) - inset)
        }
        if (side == 3) {
            push tail (x + inset)
            push tail (along + hw)
            push tail (x + inset)
            push tail (along - hw)
        }
        push tail ax
        push tail ay
        hasTail = true
    }

    ; the outline's corner radius: `radius` less the inset, at most half the
    ; box's shorter side
    fn cornerR:double () {
        def r:double (radius - inset)
        def lim:double (((? (bw < bh) bw bh) * 0.5) - inset)
        if (r > lim) {
            r = lim
        }
        if (r < 0.0) {
            r = 0.0
        }
        return r
    }

    ; the bounding box of the box and the tail's point, a pixel round it
    fn placeShape:void () {
        def minX:double x
        def minY:double y
        def maxX:double (x + bw)
        def maxY:double (y + bh)
        if hasTail {
            if (ax < minX) {
                minX = ax
            }
            if (ax > maxX) {
                maxX = ax
            }
            if (ay < minY) {
                minY = ay
            }
            if (ay > maxY) {
                maxY = ay
            }
        }
        shapeX = ((to_double (floor minX)) - 1.0)
        shapeY = ((to_double (floor minY)) - 1.0)
        shapeW = (((to_double (ceil maxX)) + 1.0) - shapeX)
        shapeH = (((to_double (ceil maxY)) + 1.0) - shapeY)
    }

    sfn absOf:double (v:double) {
        if (v < 0.0) {
            return (0.0 - v)
        }
        return v
    }

    sfn num:string (v:double) {
        return (to_string ((to_double (to_int ((v * 10.0) + (? (v < 0.0) -0.5 0.5)))) / 10.0))
    }

    ; a point of the outline, in the shape's own box
    fn pt:string (px:double py:double) {
        return ((UiCallout.num((px - shapeX))) + " " + (UiCallout.num((py - shapeY))))
    }

    ; The box and its tail as one closed outline, clockwise from the top
    ; left corner's end; corners are quarter circles as cubic curves, and the
    ; tail is three corners in the edge it leaves from.
    fn shapePath:string () {
        def r:double (this.cornerR())
        ; a cubic's handle for a quarter circle
        def k:double (r * 0.4477)
        def x0:double (x + inset)
        def y0:double (y + inset)
        def x1:double ((x + bw) - inset)
        def y1:double ((y + bh) - inset)
        def s:string ("M" + (this.pt((x0 + r) y0)))
        s = (s + (this.wedge(0)))
        s = (s + " L" + (this.pt((x1 - r) y0)))
        s = (s + " C" + (this.pt((x1 - k) y0)) + " " + (this.pt(x1 (y0 + k))) + " " + (this.pt(x1 (y0 + r))))
        s = (s + (this.wedge(1)))
        s = (s + " L" + (this.pt(x1 (y1 - r))))
        s = (s + " C" + (this.pt(x1 (y1 - k))) + " " + (this.pt((x1 - k) y1)) + " " + (this.pt((x1 - r) y1)))
        s = (s + (this.wedge(2)))
        s = (s + " L" + (this.pt((x0 + r) y1)))
        s = (s + " C" + (this.pt((x0 + k) y1)) + " " + (this.pt(x0 (y1 - k))) + " " + (this.pt(x0 (y1 - r))))
        s = (s + (this.wedge(3)))
        s = (s + " L" + (this.pt(x0 (y0 + r))))
        s = (s + " C" + (this.pt(x0 (y0 + k))) + " " + (this.pt((x0 + k) y0)) + " " + (this.pt((x0 + r) y0)))
        return (s + " Z")
    }

    ; the tail's three corners when it is on edge `e`, else ""
    fn wedge:string (e:int) {
        if ((hasTail == false) || (side != e)) {
            return ""
        }
        return (" L" + (this.pt((itemAt tail 0) (itemAt tail 1))) + " L" + (this.pt((itemAt tail 4) (itemAt tail 5))) + " L" + (this.pt((itemAt tail 2) (itemAt tail 3))))
    }
}
