; SPDX-License-Identifier: AGPL-3.0-or-later

; =============================================================================
; CalloutCtl — a small box beside a point, with a wedge pointing at it, that
; can be dragged somewhere else by its head
; =============================================================================
; For a word about one spot on a page: a comment being written over a slide,
; a note on a picture. The box is as big as what is in it (the caller fills
; `bodyEl`; `build()` makes the frame around it and leaves its children
; alone), sits beside the point (`setPoint`) where it fits on the page, and
; a wedge runs from its edge to the point (UiCallout has the numbers).
;
; A head with a title and × is optional (`title`, `closeLabel`); it is the
; handle: `grab` on it, `dragTo` while the pointer moves, `release`. A box
; that was dragged stays where it was put, and the wedge follows the point.
;
; SIZE AND PLACE: the box's size is known only after layout, so a host lays
; the page out, calls `fit(w, h)` with the frame's laid-out size, and lays it
; out once more (the frame and its shape are free surfaces placed by
; `overlayX/Y`, so the second pass moves them and nothing else).
;
; THE SHAPE: what is seen of the box is one path, the box and its wedge in
; a single outline (UiCallout.shapePath). One fill and one stroke, so the
; wedge joins the box like a speech bubble's tail; a wedge drawn on its own
; beside a bordered box shows the border across its base. Painted in order:
; the blur (a box under the frame, only a look's `backdrop-filter`: it
; softens the page and nothing drawn after it), the shape, then the frame,
; which is see-through and holds the content, keeping its size, its radius
; and a transparent border of the outline's width.
;
; LOOK (base.css): `.callout` the frame, `.callout-shape` the box and wedge
; (a path: `fill`, `stroke`), `.callout-blur` under them, `.callout-head`/`-title`/`-close`,
; `.callout-body`. `look` is a
; word that each part also gets as `<part>-<look>` (a stylesheet has no
; descendant rules to style the parts of one look): "glass" is dark and
; see-through, the page behind it blurred. `frameClass` is the host's own.
;
; TO A READER: a group named by the title; its content as it is.
; =============================================================================

Import "UiCtl.rgr"
Import "UiTree.rgr"
Import "UiCallout.rgr"
Import "pkg:evg/EVGElement.rgr"
Import "pkg:evg/EVGUnit.rgr"
Import "pkg:evg/EVGA11yTree.rgr"

class CalloutCtl extends UiCtl {
    def geo:UiCallout (new UiCallout())
    def title:string ""
    def closeLabel:string ""
    ; "" or a look's word ("glass"), and the host's own classes on the frame
    def look:string ""
    def frameClass:string ""
    ; how wide the box is (its height is its content's)
    def width:double 300.0
    def dragging:boolean false
    def lastX:double 0.0
    def lastY:double 0.0
    def frameEl:EVGElement
    def shapeEl:EVGElement
    def blurEl:EVGElement
    def bodyEl:EVGElement
    ; the close × was pressed (the host takes it)
    def closed:boolean false

    Constructor () {
        rootEl = (EVGElement.createDiv())
        frameEl = (EVGElement.createDiv())
        shapeEl = (EVGElement.createPath())
        blurEl = (EVGElement.createDiv())
        bodyEl = (EVGElement.createDiv())
    }

    sfn make:CalloutCtl (tid:string) {
        def c (new CalloutCtl())
        c.tid = tid
        return c
    }

    fn frameTid:string () {
        return (tid + "-frame")
    }

    fn headTid:string () {
        return (tid + "-head")
    }

    fn closeTid:string () {
        return (tid + "-close")
    }

    fn bodyTid:string () {
        return (tid + "-body")
    }

    fn blurTid:string () {
        return (tid + "-blur")
    }

    fn shapeTid:string () {
        return (tid + "-shape")
    }

    fn setPoint:void (x:double y:double) {
        geo.setPoint(x y)
    }

    fn setPage:void (w:double h:double) {
        geo.setPage(w h)
    }

    ; the room it may use: from `t` down to `b` of the page (a bar above or
    ; below it stays clear)
    fn setRows:void (t:double b:double) {
        geo.setRows(t b)
    }

    ; the head (title bar) is the handle; the × is not
    fn isHandle:boolean (target:string) {
        return ((target == (this.headTid())) || (target == (tid + "-title")))
    }

    ; --- drawing -------------------------------------------------------------

    fn build:void () {
        def root:EVGElement (unwrap rootEl)
        root.id = tid
        root.className = "callout-root"
        UiTree.clearChildren(root)
        def bl:EVGElement (unwrap blurEl)
        bl.id = (this.blurTid())
        bl.className = (this.cls("callout-blur"))
        bl.a11yHidden = true
        UiTree.surface(bl "free" "start")
        root.addChild(bl)
        def sh:EVGElement (unwrap shapeEl)
        sh.id = (this.shapeTid())
        sh.className = (this.cls("callout-shape"))
        sh.a11yHidden = true
        UiTree.surface(sh "free" "start")
        root.addChild(sh)
        this.shapeTail()
        def fr:EVGElement (unwrap frameEl)
        fr.id = (this.frameTid())
        fr.className = (trim ((this.cls("callout")) + " " + frameClass))
        if dragging {
            UiTree.addClass(fr "callout-dragging")
        }
        UiTree.clearChildren(fr)
        UiTree.surface(fr "free" "start")
        fr.width = (EVGUnit.px(width))
        fr.overlayX = geo.x
        fr.overlayY = geo.y
        if (((strlen title) > 0) || ((strlen closeLabel) > 0)) {
            def head:EVGElement (UiTree.div((this.headTid()) (this.cls("callout-head"))))
            head.addChild((UiTree.label((tid + "-title") (this.cls("callout-title")) title)))
            if ((strlen closeLabel) > 0) {
                head.addChild((UiTree.label((this.closeTid()) (this.cls("callout-close")) "×")))
            }
            fr.addChild(head)
        }
        def body:EVGElement (unwrap bodyEl)
        body.id = (this.bodyTid())
        UiTree.addClass(body "callout-body")
        fr.addChild(body)
        root.addChild(fr)
    }

    ; a part's class, and its look's
    fn cls:string (base:string) {
        if ((strlen look) == 0) {
            return base
        }
        return (base + " " + base + "-" + look)
    }

    ; the shape and the blur as `geo` has them now (none until the box's size
    ; is known: the host fits and lays out again before anything is drawn)
    fn shapeTail:void () {
        def sh:EVGElement (unwrap shapeEl)
        def bl:EVGElement (unwrap blurEl)
        bl.overlayX = geo.x
        bl.overlayY = geo.y
        bl.width = (EVGUnit.px(geo.bw))
        bl.height = (EVGUnit.px(geo.bh))
        if ((geo.bw > 0.0) && (geo.bh > 0.0)) {
            sh.svgPath = (geo.shapePath())
            sh.viewBox = ("0 0 " + (to_string geo.shapeW) + " " + (to_string geo.shapeH))
            sh.width = (EVGUnit.px(geo.shapeW))
            sh.height = (EVGUnit.px(geo.shapeH))
            sh.overlayX = geo.shapeX
            sh.overlayY = geo.shapeY
        } {
            sh.svgPath = ""
            sh.width = (EVGUnit.px(0.0))
            sh.height = (EVGUnit.px(0.0))
        }
    }

    ; The frame was laid out `w` × `h`: where it goes, and the wedge; the
    ; host lays the page out again.
    fn fit:void (w:double h:double) {
        geo.setSize(w h)
        geo.place()
        def fr:EVGElement (unwrap frameEl)
        fr.overlayX = geo.x
        fr.overlayY = geo.y
        this.shapeTail()
    }

    ; --- the pointer --------------------------------------------------------------

    ; a press on the head starts a drag; -> true when it did
    fn grab:boolean (target:string px:double py:double) {
        if ((this.isHandle(target)) == false) {
            return false
        }
        dragging = true
        lastX = px
        lastY = py
        return true
    }

    fn dragTo:void (px:double py:double) {
        if (dragging == false) {
            return
        }
        geo.dragBy((px - lastX) (py - lastY))
        lastX = px
        lastY = py
        def fr:EVGElement (unwrap frameEl)
        fr.overlayX = geo.x
        fr.overlayY = geo.y
        this.shapeTail()
    }

    fn release:string () {
        dragging = false
        return ""
    }

    fn activate:string (target:string) {
        if (target == (this.closeTid())) {
            closed = true
            return target
        }
        return ""
    }

    fn isFocusable:boolean (target:string) {
        return (target == (this.closeTid()))
    }

    ; --- to a reader ---------------------------------------------------------------

    fn tids:[string] () {
        def a:[string]
        push a tid
        push a (this.frameTid())
        push a (this.blurTid())
        push a (this.shapeTid())
        if (((strlen title) > 0) || ((strlen closeLabel) > 0)) {
            push a (this.headTid())
            push a (tid + "-title")
            if ((strlen closeLabel) > 0) {
                push a (this.closeTid())
            }
        }
        push a (this.bodyTid())
        return a
    }

    fn rows:[UiRow] () {
        def out:[UiRow]
        def r:UiRow (UiRow.of(tid (EVGA11yRole.group()) title))
        push out r
        if ((strlen closeLabel) > 0) {
            def c:UiRow (UiRow.of((this.closeTid()) (EVGA11yRole.button()) closeLabel))
            c.focusable = true
            push out c
        }
        return out
    }
}
