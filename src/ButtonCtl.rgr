; =============================================================================
; ButtonCtl — the one that was missing
; =============================================================================
;
; The kit had `toggle`, which is a button that STAYS PRESSED, and nothing for
; the ordinary kind: press it, something happens, it does not remember. That
; is the commonest control on any screen, and every screen built with this kit
; drew its own — a `div` with a radius and some words in it, each one a
; slightly different shade of the same orange, none of them restyleable and
; none of them focusable. An agent asked for a button, found `chips` (a round
; icon with a label under it), and drew a pill instead.
;
; Parity contract:
;   role      button
;   state     "idle" | "pressed"   — held, not latched; `activate` does not
;                                    change it, because a button has nothing
;                                    to remember
;   disabled  never activates, is not a tab stop
;
; A VARIANT IS A CLASS, NOT A COLOUR. `primary`, `secondary`, `ghost` and
; `danger` are the four a screen actually needs, and each is one more class on
; the root — `ui-button-primary` — so the sheet decides what primary looks
; like. An orange CTA is `primary` with two rules changed, not a new control
; and not a hand-drawn box.
;
;   button.ui-button.ui-button-primary       the control, what a press lands on
;     span.ui-button-label                   the words
;
; The label is its own element rather than text on the root because a button
; with an icon beside its words is the next thing anybody asks for, and a
; sheet cannot space two things that are one text node.
;
; AN ICON IS A PATH, NOT A GLYPH. `icon` is an SVG path on a 24×24 grid,
; drawn before the words as `ui-button-icon` (stroked; the sheet sets the
; pen). A glyph such as "‹" or "+" sits where its font puts it — "‹" at the
; x-height, well under the line's middle — so a button drawn with one is never
; centred; a path is centred by its box. `iconOnly` leaves the words out of
; the drawing; `name` is still what a reader is told.
;
;     path.ui-button-icon.ui-button-icon-ui-button-ghost   the icon, when
;                                            there is one; the variant's pen
;
; BUSY. A press that starts something slow (a save, a check-in) should show
; at once that it was taken, before the work returns: `startBusy(msg)` swaps
; the button's icon and words for a spinner and `msg` ("Saving changes..."),
; and the button takes no press until `stopBusy()`. A reader is told the
; message, and the button reports disabled and state "busy", so a second press
; is not sent. The spinner turns by `tick(ms)`, which only moves the spinner
; (`rotate`, a paint transform), so a host repaints without a new layout.
; From the M-Files desktop window's saving buttons.
;
;     button.ui-button.ui-button-busy
;       path.ui-button-spinner.ui-button-spinner-ui-button-primary
;       span.ui-button-label                 the message
; =============================================================================

Import "UiCtl.rgr"
Import "UiTree.rgr"
Import "pkg:evg/EVGElement.rgr"
Import "pkg:evg/EVGA11yTree.rgr"

class ButtonCtl extends UiCtl {
    ; "primary" | "secondary" | "ghost" | "danger"
    def variant:string "secondary"
    ; Held down. A press paints it; letting go paints it back.
    def held:boolean false
    ; An SVG path on a 24×24 grid, drawn before the words; "" for none.
    def icon:string ""
    ; Only the icon is drawn; `name` stays the button's name for a reader.
    def iconOnly:boolean false
    ; One more class on the icon, for a screen sizing its own: a sheet styles
    ; an element by its own classes, not by the button it is in.
    def iconClass:string ""
    ; A picture over the words, the button a tile in a gallery of choices
    ; (themes, layouts): the picture's source, drawn picW × picH. The host
    ; resolves the source against its pictures like any image.
    def picture:string ""
    def picW:double 160.0
    def picH:double 90.0
    ; Busy: the press was taken and its work is still running.
    def busy:boolean false
    ; What the busy button says ("" keeps the name).
    def busyText:string ""
    ; The spinner's turn, in degrees, and the spinner the last build made.
    def spin:double 0.0
    def spinEl@(optional):EVGElement

    Constructor () {
        rootEl = (EVGElement.createDiv())
    }

    fn stateWord:string () {
        if busy {
            return "busy"
        }
        if held {
            return "pressed"
        }
        return "idle"
    }

    fn variantClass:string () {
        if (variant == "primary") {
            return "ui-button-primary"
        }
        if (variant == "ghost") {
            return "ui-button-ghost"
        }
        if (variant == "danger") {
            return "ui-button-danger"
        }
        return "ui-button-secondary"
    }

    fn build:void () {
        def el:EVGElement (unwrap rootEl)
        el.id = tid
        el.className = "ui-button"
        UiTree.addClass(el (this.variantClass()))
        if disabled {
            UiTree.addClass(el "ui-button-disabled")
        }
        UiTree.setState(el "ui-button" (this.stateWord()))
        UiTree.clearChildren(el)
        el.elementType = 0
        el.textContent = ""

        if busy {
            UiTree.addClass(el "ui-button-busy")
            def sp (EVGElement.createDiv())
            sp.id = (tid + "-spinner")
            sp.className = "ui-button-spinner"
            UiTree.addClass(sp ("ui-button-spinner-" + (this.variantClass())))
            sp.tagName = "path"
            sp.elementType = 3
            sp.viewBox = "0 0 24 24"
            ; three quarters of a ring
            sp.svgPath = "M12 3a9 9 0 1 0 9 9"
            sp.rotate = spin
            sp.a11yHidden = true
            el.addChild(sp)
            spinEl = sp
            def msg (EVGElement.createSpan())
            msg.className = "ui-button-label"
            msg.textContent = (this.spokenName())
            msg.elementType = 1
            msg.a11yHidden = true
            el.addChild(msg)
            return
        }

        if ((strlen icon) > 0) {
            def ic (EVGElement.createDiv())
            ic.id = (tid + "-icon")
            ic.className = "ui-button-icon"
            UiTree.addClass(ic ("ui-button-icon-" + (this.variantClass())))
            if ((strlen iconClass) > 0) {
                UiTree.addClass(ic iconClass)
            }
            ic.tagName = "path"
            ic.elementType = 3
            ic.viewBox = "0 0 24 24"
            ic.svgPath = icon
            ic.a11yHidden = true
            el.addChild(ic)
            if iconOnly {
                UiTree.addClass(el "ui-button-icononly")
                return
            }
        }

        if ((strlen picture) > 0) {
            UiTree.addClass(el "ui-button-tile")
            def im (EVGElement.createImg())
            im.id = (tid + "-picture")
            im.className = "ui-button-picture"
            im.src = picture
            im.objectFit = "fill"
            im.sourceWidth = picW
            im.sourceHeight = picH
            UiTree.inline(im "width" ((to_string (to_int (picW + 0.5))) + "px"))
            UiTree.inline(im "height" ((to_string (to_int (picH + 0.5))) + "px"))
            im.a11yHidden = true
            el.addChild(im)
        }

        def words:EVGElement (EVGElement.createSpan())
        words.className = "ui-button-label"
        words.textContent = name
        words.elementType = 1
        ; What a reader is told is the row this controller reports; the label
        ; is how the button is drawn.
        words.a11yHidden = true
        el.addChild(words)
    }

    ; A button has nothing to remember, so this reports the press and leaves
    ; the control as it was. Returning the id is what tells a host that
    ; something happened — a toggle returns "" because its change IS the state.
    fn activate:string (target:string) {
        if (disabled || busy) {
            return ""
        }
        if (target != tid) {
            return ""
        }
        return tid
    }

    fn press:void (down:boolean) {
        if (disabled || busy) {
            return
        }
        held = down
        this.build()
    }

    fn isFocusable:boolean (target:string) {
        if (target != tid) {
            return false
        }
        if disabled {
            return false
        }
        return true
    }

    ; What a reader is told: the busy message while busy, else the name.
    fn spokenName:string () {
        if (busy && ((strlen busyText) > 0)) {
            return busyText
        }
        return name
    }

    ; The press was taken; its work is running. `msg` replaces the words.
    fn startBusy:void (msg:string) {
        busy = true
        busyText = msg
        held = false
        spin = 0.0
        this.build()
    }

    fn stopBusy:void () {
        busy = false
        busyText = ""
        this.build()
    }

    ; Turns the spinner (one turn a second). True when it moved and the host
    ; should repaint; nothing is rebuilt or laid out again.
    fn tick:boolean (ms:double) {
        if (busy == false) {
            return false
        }
        spin = (spin + (ms * 0.36))
        while (spin >= 360.0) {
            spin = (spin - 360.0)
        }
        if (!null? spinEl) {
            def sp:EVGElement (unwrap spinEl)
            sp.rotate = spin
        }
        return true
    }

    fn rows:[UiRow] () {
        def out:[UiRow]
        def r:UiRow (UiRow.of(tid (EVGA11yRole.button()) (this.spokenName())))
        r.state = (this.stateWord())
        r.disabled = (disabled || busy)
        if disabled {
            r.tabStop = false
        } {
            r.tabStop = true
            r.focusable = true
        }
        push out r
        return out
    }
}
