; SPDX-License-Identifier: AGPL-3.0-or-later

; =============================================================================
; RailCtl — an app's left icon rail (Slack's, Teams', VS Code's activity bar)
; =============================================================================
; A narrow column of places: each an icon with its name under it, the one
; open now highlighted. Items go at the top (`addItem`) or the bottom
; (`addBottom`: settings, the account), with the space between them empty.
;
;   root      role navigation, named `name`
;   items     role button; the open one `aria-current="page"`; a roving tab
;             stop (the open one, else the first)
;   arrows    Up / Down move focus, skip disabled, wrap; Home / End
;   activate  makes the item the open one (`value`) and records it in
;             `pressed`, which the host reads and clears: a place that opens
;             a window rather than a view sets `value` back itself
;
; An icon is an SVG path on a 24×24 grid, stroked (`.ui-rail-icon` sets the
; stroke): the rail stays one colour per state in every theme. A badge (a
; count, or "•") sits on the icon's corner.
;
; `tone` "frame": the rail stands on a coloured app frame (Slack's window,
; the work set into it) rather than on the page's grey. Every part also
; carries `ui-rail-frame-<part>` (and its `-state-<word>`), which the theme
; draws light on the frame's colour; "" keeps the plain look.
;
; Element ids: `<tid>-<value>` an item, `<tid>-<value>-icon` its icon,
; `<tid>-<value>-label` its name, `<tid>-<value>-badge` its badge.
;
; MORE THAN FITS. With `room` set (the rail's height, px) and more top items
; than fit in it, the last place that fits becomes a "More" button
; (`<tid>--more`, a kebab) and the items past it go into its menu
; (`<tid>--menu`, role menu; `<tid>--m-<value>` each, role menuitem). The open
; place is always kept on the rail: when it would fall into the menu it takes
; the last place on the rail instead. Bottom items always show. `itemH` is one
; item with its gap; `measure()` takes it from the last layout. From the
; M-Files desktop window's dashboard tab rail.
; =============================================================================

Import "UiCtl.rgr"
Import "UiTree.rgr"
Import "pkg:evg/EVGElement.rgr"
Import "pkg:evg/EVGA11yTree.rgr"

class RailItem {
    def value:string ""
    def name:string ""
    def icon:string ""
    def badge:string ""
    def bottom:boolean false
    def disabled:boolean false
}

class RailCtl extends UiCtl {
    def items:[RailItem]
    ; the open place
    def value:string ""
    ; the last item activated, "" once the host has read it (`takePressed`)
    def pressed:string ""
    def rovingValue:string ""
    ; "" on the page, "frame" on a coloured frame (see the header)
    def tone:string ""
    ; the items' elements as the last build made them, in `items`' order
    ; (the ones on the rail; an item in the More menu has none)
    def itemEls:[EVGElement]
    ; The rail's height, px; 0: every item shows.
    def room:double 0.0
    ; One item and the gap after it, px (`measure` reads it from a layout).
    def itemH:double 59.0
    ; The rail's own padding, top and bottom together.
    def padH:double 16.0
    def moreLabel:string "More"
    def moreOpen:boolean false
    ; More was focused last (its roving tab stop)
    def rovingMore:boolean false
    ; The top items on the rail and in the More menu, as the last build split them.
    def onRail:[RailItem]
    def inMenu:[RailItem]

    Constructor () {
        rootEl = (EVGElement.createDiv())
        def empty:[RailItem]
        items = empty
        def e:[EVGElement]
        itemEls = e
        def a:[RailItem]
        onRail = a
        def b:[RailItem]
        inMenu = b
    }

    fn moreTid:string () {
        return (tid + "--more")
    }

    fn menuTid:string () {
        return (tid + "--menu")
    }

    fn menuItemTid:string (itemValue:string) {
        return (tid + "--m-" + itemValue)
    }

    ; The item a menu row stands for, "" when `hit` is not one.
    fn menuValueOf:string (hit:string) {
        def i:int 0
        while (i < (array_length inMenu)) {
            def it:RailItem (itemAt inMenu i)
            def t:string (this.menuItemTid(it.value))
            if ((hit == t) || ((indexOf hit (t + "-")) == 0)) {
                return it.value
            }
            i = (i + 1)
        }
        return ""
    }

    ; The item height from the last layout: one item's box and the gap to the next.
    fn measure:void () {
        if ((array_length itemEls) < 2) {
            if ((array_length itemEls) == 1) {
                def only:EVGElement (itemAt itemEls 0)
                if (only.calculatedHeight > 0.0) {
                    itemH = (only.calculatedHeight + 4.0)
                }
            }
            return
        }
        def a:EVGElement (itemAt itemEls 0)
        def b:EVGElement (itemAt itemEls 1)
        def d:double (b.calculatedY - a.calculatedY)
        if (d > 0.0) {
            itemH = d
        }
    }

    ; Splits the top items between the rail and the More menu.
    fn split:void () {
        def top:[RailItem]
        def bottoms:int 0
        def i:int 0
        while (i < (array_length items)) {
            def it:RailItem (itemAt items i)
            if it.bottom {
                bottoms = (bottoms + 1)
            } {
                push top it
            }
            i = (i + 1)
        }
        def rail:[RailItem]
        def menu:[RailItem]
        def n:int (array_length top)
        def fit:int n
        if ((room > 0.0) && (itemH > 0.0)) {
            fit = (to_int (((room - padH) - ((to_double bottoms) * itemH)) / itemH))
        }
        if (fit >= n) {
            onRail = top
            inMenu = menu
            moreOpen = false
            return
        }
        ; one place goes to the More button
        def keep:int (fit - 1)
        if (keep < 0) {
            keep = 0
        }
        def openAt:int -1
        def j:int 0
        while (j < n) {
            def it2:RailItem (itemAt top j)
            if (it2.value == value) {
                openAt = j
            }
            j = (j + 1)
        }
        def k:int 0
        while (k < n) {
            def it3:RailItem (itemAt top k)
            def shownHere:boolean (k < keep)
            if ((openAt >= keep) && (keep > 0)) {
                ; the open place takes the last spot; the item there moves to the menu
                if (k == (keep - 1)) {
                    shownHere = false
                }
                if (k == openAt) {
                    shownHere = true
                }
            }
            if ((keep == 0) && (k == openAt)) {
                shownHere = true
            }
            if shownHere {
                push rail it3
            } {
                push menu it3
            }
            k = (k + 1)
        }
        onRail = rail
        inMenu = menu
    }

    fn moreEl:EVGElement () {
        def t:string (this.moreTid())
        def el (EVGElement.createDiv())
        el.id = t
        el.className = "ui-rail-item ui-rail-more"
        def word:string "inactive"
        if moreOpen {
            word = "active"
        }
        UiTree.setState(el "ui-rail-item" word)
        this.toned(el "item" word)
        def pad (EVGElement.createDiv())
        pad.id = (t + "-pad")
        pad.className = "ui-rail-pad"
        UiTree.setState(pad "ui-rail-pad" word)
        this.toned(pad "pad" word)
        ; a kebab: three dots
        def ic:EVGElement (RailCtl.iconEl((t + "-icon") "M12 5.5v.01M12 12v.01M12 18.5v.01"))
        UiTree.addClass(ic "ui-rail-more-icon")
        UiTree.setState(ic "ui-rail-icon" word)
        this.toned(ic "icon" word)
        pad.addChild(ic)
        el.addChild(pad)
        def lb:EVGElement (UiTree.label((t + "-label") "ui-rail-label" moreLabel))
        UiTree.setState(lb "ui-rail-label" word)
        this.toned(lb "label" word)
        el.addChild(lb)
        return el
    }

    fn menuEl:EVGElement () {
        def m (EVGElement.createDiv())
        m.id = (this.menuTid())
        m.className = "ui-rail-menu"
        UiTree.surface(m "right" "end")
        def i:int 0
        while (i < (array_length inMenu)) {
            def it:RailItem (itemAt inMenu i)
            def row (EVGElement.createDiv())
            row.id = (this.menuItemTid(it.value))
            row.className = "ui-rail-menu-item"
            if it.disabled {
                UiTree.addClass(row "ui-rail-menu-item-disabled")
            }
            row.addChild((RailCtl.iconEl((row.id + "-icon") it.icon)))
            def nm:string it.name
            if ((strlen it.badge) > 0) {
                nm = (nm + " " + it.badge)
            }
            row.addChild((UiTree.label((row.id + "-label") "ui-rail-menu-label" nm)))
            m.addChild(row)
            i = (i + 1)
        }
        return m
    }

    fn add:RailItem (itemValue:string itemName:string iconPath:string) {
        def it (new RailItem())
        it.value = itemValue
        it.name = itemName
        it.icon = iconPath
        push items it
        return it
    }

    fn addItem:void (itemValue:string itemName:string iconPath:string) {
        this.add(itemValue itemName iconPath)
    }

    ; An item kept at the bottom of the rail.
    fn addBottom:void (itemValue:string itemName:string iconPath:string) {
        def it:RailItem (this.add(itemValue itemName iconPath))
        it.bottom = true
    }

    fn itemFor@(optional):RailItem (itemValue:string) {
        def found@(optional):RailItem
        def i:int 0
        while (i < (array_length items)) {
            def it:RailItem (itemAt items i)
            if (it.value == itemValue) {
                found = it
            }
            i = (i + 1)
        }
        return found
    }

    ; A count or a dot on an item's icon; "" takes it off.
    fn setBadge:void (itemValue:string words:string) {
        def m@(optional):RailItem (this.itemFor(itemValue))
        if (!null? m) {
            def it:RailItem (unwrap m)
            it.badge = words
        }
    }

    fn setDisabled:void (itemValue:string off:boolean) {
        def m@(optional):RailItem (this.itemFor(itemValue))
        if (!null? m) {
            def it:RailItem (unwrap m)
            it.disabled = off
        }
    }

    ; The item activated since the last call, "" for none.
    fn takePressed:string () {
        def p:string pressed
        pressed = ""
        return p
    }

    fn itemTid:string (itemValue:string) {
        return (tid + "-" + itemValue)
    }

    ; The item whose element is (or holds) `hit`, "" for none.
    fn valueOf:string (hit:string) {
        def i:int 0
        while (i < (array_length items)) {
            def it:RailItem (itemAt items i)
            def t:string (this.itemTid(it.value))
            if ((hit == t) || ((indexOf hit (t + "-")) == 0)) {
                return it.value
            }
            i = (i + 1)
        }
        return ""
    }

    sfn iconEl:EVGElement (id:string path:string) {
        def m (EVGElement.createDiv())
        m.id = id
        m.className = "ui-rail-icon"
        m.tagName = "path"
        m.elementType = 3
        m.viewBox = "0 0 24 24"
        m.svgPath = path
        m.a11yHidden = true
        return m
    }

    ; A part's look on the frame, beside its own class and state.
    fn toned:void (el:EVGElement part:string word:string) {
        if (tone != "frame") {
            return
        }
        def cls:string ("ui-rail-frame-" + part)
        UiTree.addClass(el cls)
        if ((strlen word) > 0) {
            UiTree.setState(el cls word)
        }
    }

    fn itemEl:EVGElement (it:RailItem) {
        def el (EVGElement.createDiv())
        def t:string (this.itemTid(it.value))
        el.id = t
        el.className = "ui-rail-item"
        def word:string "inactive"
        if (it.value == value) {
            word = "active"
        }
        UiTree.setState(el "ui-rail-item" word)
        this.toned(el "item" word)
        if it.disabled {
            UiTree.addClass(el "ui-rail-item-disabled")
        }
        def pad (EVGElement.createDiv())
        pad.id = (t + "-pad")
        pad.className = "ui-rail-pad"
        UiTree.setState(pad "ui-rail-pad" word)
        this.toned(pad "pad" word)
        def ic:EVGElement (RailCtl.iconEl((t + "-icon") it.icon))
        UiTree.setState(ic "ui-rail-icon" word)
        this.toned(ic "icon" word)
        pad.addChild(ic)
        if ((strlen it.badge) > 0) {
            def b:EVGElement (UiTree.label((t + "-badge") "ui-rail-badge" it.badge))
            b.a11yHidden = true
            this.toned(b "badge" "")
            pad.addChild(b)
        }
        el.addChild(pad)
        def lb:EVGElement (UiTree.label((t + "-label") "ui-rail-label" it.name))
        UiTree.setState(lb "ui-rail-label" word)
        this.toned(lb "label" word)
        el.addChild(lb)
        return el
    }

    fn build:void () {
        def root:EVGElement (unwrap rootEl)
        root.id = tid
        root.className = "ui-rail"
        UiTree.clearChildren(root)
        ; two groups, the root spreading them apart: the top places and,
        ; at the foot, the bottom ones
        def head (EVGElement.createDiv())
        head.id = (tid + "-head")
        head.className = "ui-rail-group"
        def foot (EVGElement.createDiv())
        foot.id = (tid + "-foot")
        foot.className = "ui-rail-group"
        this.split()
        def els:[EVGElement]
        def i:int 0
        while (i < (array_length onRail)) {
            def el:EVGElement (this.itemEl((itemAt onRail i)))
            push els el
            head.addChild(el)
            i = (i + 1)
        }
        if ((array_length inMenu) > 0) {
            def more:EVGElement (this.moreEl())
            if moreOpen {
                more.addChild((this.menuEl()))
            }
            head.addChild(more)
        }
        def j:int 0
        while (j < (array_length items)) {
            def it:RailItem (itemAt items j)
            if it.bottom {
                def el2:EVGElement (this.itemEl(it))
                push els el2
                foot.addChild(el2)
            }
            j = (j + 1)
        }
        root.addChild(head)
        root.addChild(foot)
        itemEls = els
    }

    fn hitFocusId:string (hit:string) {
        if ((indexOf hit (this.moreTid())) == 0) {
            return (this.moreTid())
        }
        def mv:string (this.menuValueOf(hit))
        if ((strlen mv) > 0) {
            return (this.menuItemTid(mv))
        }
        def v:string (this.valueOf(hit))
        if ((strlen v) == 0) {
            return ""
        }
        return (this.itemTid(v))
    }

    fn activate:string (target:string) {
        if disabled {
            return ""
        }
        if ((indexOf target (this.moreTid())) == 0) {
            moreOpen = (moreOpen == false)
            this.build()
            return ""
        }
        def mv:string (this.menuValueOf(target))
        if ((strlen mv) > 0) {
            def mm@(optional):RailItem (this.itemFor(mv))
            if (null? mm) {
                return ""
            }
            def mit:RailItem (unwrap mm)
            if mit.disabled {
                return ""
            }
            value = mv
            pressed = mv
            rovingValue = mv
            rovingMore = false
            moreOpen = false
            this.build()
            return ""
        }
        def v:string (this.valueOf(target))
        def m@(optional):RailItem (this.itemFor(v))
        if (null? m) {
            return ""
        }
        def it:RailItem (unwrap m)
        if it.disabled {
            return ""
        }
        value = v
        pressed = v
        rovingValue = v
        rovingMore = false
        moreOpen = false
        this.build()
        return ""
    }

    ; Items in the order the rail shows them: the top ones, then the bottom.
    fn shown:[RailItem] () {
        def out:[RailItem]
        def i:int 0
        while (i < (array_length onRail)) {
            push out (itemAt onRail i)
            i = (i + 1)
        }
        def j:int 0
        while (j < (array_length items)) {
            def it2:RailItem (itemAt items j)
            if it2.bottom {
                push out it2
            }
            j = (j + 1)
        }
        return out
    }

    ; From `from` (an index into `shown`), `delta` steps over enabled items,
    ; wrapping; -1 when none is enabled.
    sfn stepShown:int (list:[RailItem] from:int delta:int) {
        def n:int (array_length list)
        if (n == 0) {
            return -1
        }
        def k:int from
        def tries:int 0
        while (tries < n) {
            k = (k + delta)
            if (k < 0) {
                k = (n - 1)
            }
            if (k >= n) {
                k = 0
            }
            def it:RailItem (itemAt list k)
            if (it.disabled == false) {
                return k
            }
            tries = (tries + 1)
        }
        return -1
    }

    ; The places the arrows stop at on the rail, in order: the enabled top
    ; items shown, More, the enabled bottom items.
    fn stops:[string] () {
        def out:[string]
        def i:int 0
        while (i < (array_length onRail)) {
            def it:RailItem (itemAt onRail i)
            if (it.disabled == false) {
                push out (this.itemTid(it.value))
            }
            i = (i + 1)
        }
        if ((array_length inMenu) > 0) {
            push out (this.moreTid())
        }
        def j:int 0
        while (j < (array_length items)) {
            def it2:RailItem (itemAt items j)
            if (it2.bottom && (it2.disabled == false)) {
                push out (this.itemTid(it2.value))
            }
            j = (j + 1)
        }
        return out
    }

    ; The enabled rows of the More menu.
    fn menuStops:[string] () {
        def out:[string]
        def i:int 0
        while (i < (array_length inMenu)) {
            def it:RailItem (itemAt inMenu i)
            if (it.disabled == false) {
                push out (this.menuItemTid(it.value))
            }
            i = (i + 1)
        }
        return out
    }

    ; Where Up / Down (wrapping) and Home / End go from `at` in `list`; ""
    ; for another key or when `at` is not in it.
    sfn stepTids:string (list:[string] at:string key:string) {
        def n:int (array_length list)
        if (n == 0) {
            return ""
        }
        if (key == "Home") {
            return (itemAt list 0)
        }
        if (key == "End") {
            return (itemAt list (n - 1))
        }
        def from:int -1
        def i:int 0
        while (i < n) {
            if ((itemAt list i) == at) {
                from = i
            }
            i = (i + 1)
        }
        if (from < 0) {
            return ""
        }
        if (key == "ArrowDown") {
            if ((from + 1) >= n) {
                return (itemAt list 0)
            }
            return (itemAt list (from + 1))
        }
        if (key == "ArrowUp") {
            if (from == 0) {
                return (itemAt list (n - 1))
            }
            return (itemAt list (from - 1))
        }
        return ""
    }

    sfn has:boolean (list:[string] x:string) {
        def i:int 0
        while (i < (array_length list)) {
            if ((itemAt list i) == x) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    fn openMenu:string () {
        moreOpen = true
        this.build()
        def ms:[string] (this.menuStops())
        if ((array_length ms) == 0) {
            return ""
        }
        return (itemAt ms 0)
    }

    fn keyDown:string (target:string key:string) {
        if disabled {
            return ""
        }
        def more:string (this.moreTid())
        ; in the More menu: Up / Down / Home / End move, Escape (or Left)
        ; closes it back to More, Enter / Space open the place
        def mv:string (this.menuValueOf(target))
        if ((strlen mv) > 0) {
            if ((key == "Escape") || (key == "ArrowLeft")) {
                moreOpen = false
                this.build()
                return more
            }
            def mto:string (RailCtl.stepTids((this.menuStops()) target key))
            if ((strlen mto) > 0) {
                return mto
            }
            if (UiCtl.activatesOn(key)) {
                this.activate(target)
                if (value == mv) {
                    return (this.itemTid(mv))
                }
            }
            return ""
        }
        if (target == more) {
            if (key == "Escape") {
                if moreOpen {
                    moreOpen = false
                    this.build()
                }
                return ""
            }
            if ((UiCtl.activatesOn(key)) || (key == "ArrowRight")) {
                if (moreOpen && (key != "ArrowRight")) {
                    moreOpen = false
                    this.build()
                    return ""
                }
                return (this.openMenu())
            }
        } {
            if ((strlen (this.valueOf(target))) == 0) {
                return ""
            }
        }
        def to:string (RailCtl.stepTids((this.stops()) target key))
        if ((strlen to) > 0) {
            this.onFocus(to)
            return to
        }
        if ((target != more) && (UiCtl.activatesOn(key))) {
            this.activate(target)
        }
        return ""
    }

    fn tids:[string] () {
        def a:[string]
        push a tid
        def i:int 0
        while (i < (array_length items)) {
            def it:RailItem (itemAt items i)
            push a (this.itemTid(it.value))
            i = (i + 1)
        }
        if ((array_length inMenu) > 0) {
            push a (this.moreTid())
            push a (this.menuTid())
            def j:int 0
            while (j < (array_length inMenu)) {
                def it2:RailItem (itemAt inMenu j)
                push a (this.menuItemTid(it2.value))
                j = (j + 1)
            }
        }
        return a
    }

    fn isFocusable:boolean (target:string) {
        if disabled {
            return false
        }
        if (target == (this.moreTid())) {
            return ((array_length inMenu) > 0)
        }
        def mv:string (this.menuValueOf(target))
        if ((strlen mv) > 0) {
            return (moreOpen && (RailCtl.has((this.menuStops()) target)))
        }
        return (RailCtl.has((this.stops()) target))
    }

    fn onFocus:void (target:string) {
        if (target == (this.moreTid())) {
            rovingMore = true
            return
        }
        if ((strlen (this.menuValueOf(target))) > 0) {
            return
        }
        def v:string (this.valueOf(target))
        if ((strlen v) > 0) {
            rovingValue = v
            rovingMore = false
        }
    }

    ; The roving tab stop: the one focused last, else the open one, else the
    ; first enabled.
    fn stopValue:string () {
        if (!null? (this.itemFor(rovingValue))) {
            return rovingValue
        }
        if (!null? (this.itemFor(value))) {
            return value
        }
        def list:[RailItem] (this.shown())
        def k:int (RailCtl.stepShown(list -1 1))
        if (k < 0) {
            return ""
        }
        def it:RailItem (itemAt list k)
        return it.value
    }

    fn rows:[UiRow] () {
        def out:[UiRow]
        def rootRow:UiRow (UiRow.of(tid (EVGA11yRole.navigation()) name))
        rootRow.orientation = "vertical"
        push out rootRow
        def stop:string (this.stopValue())
        def list:[RailItem] (this.shown())
        def i:int 0
        while (i < (array_length list)) {
            def it:RailItem (itemAt list i)
            def label:string it.name
            if ((strlen it.badge) > 0) {
                label = (label + " (" + it.badge + ")")
            }
            def row:UiRow (UiRow.of((this.itemTid(it.value)) (EVGA11yRole.button()) label))
            row.parentTid = tid
            if (it.value == value) {
                row.current = "page"
                row.state = "active"
            } {
                row.state = "inactive"
            }
            row.disabled = it.disabled
            row.focusable = (it.disabled == false)
            row.tabStop = ((it.value == stop) && (it.disabled == false) && ((this.moreStop()) == false))
            push out row
            i = (i + 1)
            if ((i == (array_length onRail)) && ((array_length inMenu) > 0)) {
                this.moreRows(out)
            }
        }
        if (((array_length onRail) == 0) && ((array_length inMenu) > 0)) {
            this.moreRows(out)
        }
        return out
    }

    ; More holds the tab stop when it was focused last and no place on the
    ; rail is the open one.
    fn moreStop:boolean () {
        if ((array_length inMenu) == 0) {
            return false
        }
        return rovingMore
    }

    fn moreRows:void (out:[UiRow]) {
        def more:UiRow (UiRow.of((this.moreTid()) (EVGA11yRole.button()) moreLabel))
        more.parentTid = tid
        more.hasPopup = "menu"
        if moreOpen {
            more.expanded = (EVGA11yTri.yes())
        } {
            more.expanded = (EVGA11yTri.no())
        }
        more.focusable = true
        more.tabStop = (this.moreStop())
        push out more
        if (moreOpen == false) {
            return
        }
        def menu:UiRow (UiRow.of((this.menuTid()) (EVGA11yRole.menu()) moreLabel))
        menu.parentTid = (this.moreTid())
        menu.orientation = "vertical"
        push out menu
        def i:int 0
        while (i < (array_length inMenu)) {
            def it:RailItem (itemAt inMenu i)
            def label:string it.name
            if ((strlen it.badge) > 0) {
                label = (label + " (" + it.badge + ")")
            }
            def r:UiRow (UiRow.of((this.menuItemTid(it.value)) (EVGA11yRole.menuItem()) label))
            r.parentTid = (this.menuTid())
            r.disabled = it.disabled
            r.focusable = (it.disabled == false)
            push out r
            i = (i + 1)
        }
    }
}
