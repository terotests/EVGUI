; =============================================================================
; DrawToolsCtl — the palette of a drawing tool: tools, colours, line sizes
; =============================================================================
; A small floating bar beside what is drawn on (a slide being edited): one
; tool is on at a time (select, pen, arrow, …), one colour, one size, and a
; button that puts the palette away. What each tool does is the host's; this
; keeps which one is chosen and says what was pressed.
;
;   ┌───┐
;   │ ↖ │  tools: the one on is filled
;   │ ✎ │
;   │ T │
;   ├───┤
;   │ ● │  colours: the one on has a ring
;   │ ● │
;   ├───┤
;   │ · │  sizes, small to large
;   ├───┤
;   │ ✓ │  done
;   └───┘
;
; Or `compact`: a small pill of three round buttons, for a bar at the foot
; of what is drawn on, with the choices in a discreet menu that opens
; upward from the button pressed:
;
;   ┌─────────────┐
;   │ ✎ Pen       │   menu "tool": the tools, the one on marked
;   │ ↗ Arrow     │
;   └─────────────┘
;   ( ✎ │ ↗ │ ● )     the pen (drawing on or off), the tool, the colour
;
; The colour menu holds the swatches and the sizes. The host places the
; menu (`menuTid`) above the pill once its height is known.
;
; `activate` answers "tool:<value>", "color:<value>", "size:<n>" or "done",
; and compact also "toggle" (drawing on or off, `active`), "menu:tool",
; "menu:color" (that menu opened or closed, `menu`);
; and has already made the tool, colour or size the chosen one. The host
; places the bar (`x`, `y`, the top left) and lays it out `vertical` or not.
;
; TO A READER: a toolbar; the tools and the colours are radio buttons
; ("Pen", checked), the sizes too ("Size 2"), and Done a button.
; =============================================================================

Import "UiCtl.rgr"
Import "UiTree.rgr"
Import "pkg:evg/EVGElement.rgr"
Import "pkg:evg/EVGA11yTree.rgr"

class DrawToolsCtl extends UiCtl {
    ; the top left of the bar, on the page
    def x:double 0.0
    def y:double 0.0
    def vertical:boolean true
    ; the tools: value, what is drawn on it, what a reader is told
    def toolValues:[string]
    def toolGlyphs:[string]
    def toolNames:[string]
    def tool:string ""
    ; the colours (CSS colours), and their names for a reader
    def colors:[string]
    def colorNames:[string]
    def color:string ""
    ; how many sizes (1…sizes), and the one on
    def sizes:int 3
    def size:int 2
    def doneName:string "Done"
    ; the pill with menus, and in it: drawing on or not, the menu open
    ; ("", "tool", "color")
    def compact:boolean false
    def active:boolean false
    def menu:string ""
    def menuX:double 0.0
    def menuY:double 0.0
    def penName:string "Draw"
    def toolMenuName:string "Tool"
    def colorMenuName:string "Colour"

    Constructor () {
        def a:[string]
        toolValues = a
        def b:[string]
        toolGlyphs = b
        def c:[string]
        toolNames = c
        def d:[string]
        colors = d
        def e:[string]
        colorNames = e
    }

    sfn make:DrawToolsCtl (tid:string) {
        def p (new DrawToolsCtl())
        p.tid = tid
        return p
    }

    fn addTool:void (value:string glyph:string name:string) {
        push toolValues value
        push toolGlyphs glyph
        push toolNames name
        if ((strlen tool) == 0) {
            tool = value
        }
    }

    fn addColor:void (value:string name:string) {
        push colors value
        push colorNames name
        if ((strlen color) == 0) {
            color = value
        }
    }

    ; --- the ids of the parts -------------------------------------------------------

    fn toolTid:string (value:string) {
        return (tid + "-tool-" + value)
    }

    fn colorTid:string (i:int) {
        return (tid + "-color-" + (to_string i))
    }

    fn sizeTid:string (n:int) {
        return (tid + "-size-" + (to_string n))
    }

    fn doneTid:string () {
        return (tid + "-done")
    }

    fn toggleTid:string () {
        return (tid + "-pen")
    }

    fn kindTid:string () {
        return (tid + "-kind")
    }

    fn hueTid:string () {
        return (tid + "-hue")
    }

    fn menuTid:string () {
        return (tid + "-menu")
    }

    ; the glyph of the tool on
    fn toolGlyph:string () {
        def i:int (indexOf toolValues tool)
        if (i < 0) {
            return ""
        }
        return (itemAt toolGlyphs i)
    }

    ; --- choosing ----------------------------------------------------------------------

    fn setTool:boolean (value:string) {
        if ((indexOf toolValues value) < 0) {
            return false
        }
        tool = value
        return true
    }

    fn setColor:boolean (value:string) {
        if ((indexOf colors value) < 0) {
            return false
        }
        color = value
        return true
    }

    fn setSize:boolean (n:int) {
        if ((n < 1) || (n > sizes)) {
            return false
        }
        size = n
        return true
    }

    ; --- the tree -------------------------------------------------------------------------

    fn build:void () {
        if compact {
            this.buildCompact()
            return
        }
        def root:EVGElement (UiTree.div(tid (? vertical "drawtools" "drawtools drawtools-row")))
        UiTree.surface(root "free" "start")
        root.overlayX = x
        root.overlayY = y
        ; the sheet has no descendant selectors: a row's separators and the
        ; chosen size's dot carry classes of their own
        def sep:string (? vertical "drawtools-sep" "drawtools-sep drawtools-sep-row")
        def i:int 0
        while (i < (array_length toolValues)) {
            def v:string (itemAt toolValues i)
            def cls:string "drawtools-tool"
            if (v == tool) {
                cls = (cls + " drawtools-on")
            }
            root.addChild((UiTree.label((this.toolTid(v)) cls (itemAt toolGlyphs i))))
            i = (i + 1)
        }
        if ((array_length colors) > 0) {
            root.addChild((UiTree.div((tid + "-sep1") sep)))
            def k:int 0
            while (k < (array_length colors)) {
                def sw:EVGElement (UiTree.div((this.colorTid(k)) (? ((itemAt colors k) == color) "drawtools-swatch drawtools-swatch-on" "drawtools-swatch")))
                def dot:EVGElement (UiTree.div((this.colorTid(k) + "-dot") "drawtools-dot"))
                UiTree.inline(dot "background-color" (itemAt colors k))
                sw.addChild(dot)
                root.addChild(sw)
                k = (k + 1)
            }
        }
        if (sizes > 1) {
            root.addChild((UiTree.div((tid + "-sep2") sep)))
            def n:int 1
            while (n <= sizes) {
                def sz:EVGElement (UiTree.div((this.sizeTid(n)) (? (n == size) "drawtools-size drawtools-on" "drawtools-size")))
                sz.addChild((UiTree.div((this.sizeTid(n) + "-dot") ((? (n == size) "drawtools-size-dot drawtools-size-dot-on" "drawtools-size-dot") + " drawtools-size-" + (to_string n)))))
                root.addChild(sz)
                n = (n + 1)
            }
        }
        root.addChild((UiTree.div((tid + "-sep3") sep)))
        root.addChild((UiTree.label((this.doneTid()) "drawtools-tool drawtools-done" "✓")))
        rootEl = root
    }

    ; The pill, and the open menu as a surface of its own (placed by the
    ; host above the pill: `menuX`, `menuY`).
    fn buildCompact:void () {
        def root:EVGElement (UiTree.div(tid "drawtools-pill"))
        UiTree.surface(root "free" "start")
        root.overlayX = x
        root.overlayY = y
        def pen:EVGElement (UiTree.label((this.toggleTid()) (? active "drawtools-btn drawtools-btn-on" "drawtools-btn") "✎"))
        root.addChild(pen)
        def kind:EVGElement (UiTree.label((this.kindTid()) (? (menu == "tool") "drawtools-btn drawtools-btn-open" "drawtools-btn") (this.toolGlyph())))
        root.addChild(kind)
        def hue:EVGElement (UiTree.div((this.hueTid()) (? (menu == "color") "drawtools-btn drawtools-hue drawtools-btn-open" "drawtools-btn drawtools-hue")))
        def dot:EVGElement (UiTree.div((this.hueTid() + "-dot") ("drawtools-hue-dot drawtools-hue-" + (to_string size))))
        UiTree.inline(dot "background-color" color)
        hue.addChild(dot)
        root.addChild(hue)
        if (menu == "tool") {
            def m:EVGElement (UiTree.div((this.menuTid()) "drawtools-menu"))
            UiTree.surface(m "free" "start")
            m.overlayX = menuX
            m.overlayY = menuY
            def i:int 0
            while (i < (array_length toolValues)) {
                def v:string (itemAt toolValues i)
                def row:EVGElement (UiTree.div((this.toolTid(v)) (? (v == tool) "drawtools-item drawtools-item-on" "drawtools-item")))
                ; the sheet has no descendant selectors: the chosen line's
                ; words carry their own class
                row.addChild((UiTree.label("" (? (v == tool) "drawtools-glyph drawtools-glyph-on" "drawtools-glyph") (itemAt toolGlyphs i))))
                row.addChild((UiTree.label("" (? (v == tool) "drawtools-name drawtools-name-on" "drawtools-name") (itemAt toolNames i))))
                m.addChild(row)
                i = (i + 1)
            }
            root.addChild(m)
        }
        if (menu == "color") {
            def mc:EVGElement (UiTree.div((this.menuTid()) "drawtools-menu"))
            UiTree.surface(mc "free" "start")
            mc.overlayX = menuX
            mc.overlayY = menuY
            def sw:EVGElement (UiTree.div((tid + "-swatches") "drawtools-menu-row"))
            def k:int 0
            while (k < (array_length colors)) {
                def one:EVGElement (UiTree.div((this.colorTid(k)) (? ((itemAt colors k) == color) "drawtools-swatch drawtools-swatch-on" "drawtools-swatch")))
                def d:EVGElement (UiTree.div((this.colorTid(k) + "-dot") "drawtools-dot"))
                UiTree.inline(d "background-color" (itemAt colors k))
                one.addChild(d)
                sw.addChild(one)
                k = (k + 1)
            }
            mc.addChild(sw)
            def sz:EVGElement (UiTree.div((tid + "-sizes") "drawtools-menu-row"))
            def n:int 1
            while (n <= sizes) {
                def b:EVGElement (UiTree.div((this.sizeTid(n)) (? (n == size) "drawtools-size drawtools-size-chosen" "drawtools-size")))
                b.addChild((UiTree.div((this.sizeTid(n) + "-dot") ((? (n == size) "drawtools-size-dot drawtools-size-dot-chosen" "drawtools-size-dot drawtools-size-dot-menu") + " drawtools-size-" + (to_string n)))))
                sz.addChild(b)
                n = (n + 1)
            }
            mc.addChild(sz)
            root.addChild(mc)
        }
        rootEl = root
    }

    ; What the part `target` (or one inside it) is: "tool:<value>",
    ; "color:<value>", "size:<n>", "done", or "" for none of them.
    fn partOf:string (target:string) {
        def i:int 0
        while (i < (array_length toolValues)) {
            def v:string (itemAt toolValues i)
            if (target == (this.toolTid(v))) {
                return ("tool:" + v)
            }
            i = (i + 1)
        }
        def k:int 0
        while (k < (array_length colors)) {
            def ct:string (this.colorTid(k))
            if ((target == ct) || (target == (ct + "-dot"))) {
                return ("color:" + (itemAt colors k))
            }
            k = (k + 1)
        }
        def n:int 1
        while (n <= sizes) {
            def st:string (this.sizeTid(n))
            if ((target == st) || (target == (st + "-dot"))) {
                return ("size:" + (to_string n))
            }
            n = (n + 1)
        }
        if (target == (this.doneTid())) {
            return "done"
        }
        if compact {
            if (target == (this.toggleTid())) {
                return "toggle"
            }
            if (target == (this.kindTid())) {
                return "menu:tool"
            }
            if ((target == (this.hueTid())) || (target == ((this.hueTid()) + "-dot"))) {
                return "menu:color"
            }
        }
        return ""
    }

    ; A press on `target`: what it means, with the tool, colour or size it
    ; names chosen already.
    ; Compact: the pen turns drawing on or off; a menu button opens its menu
    ; (or closes it); a tool chosen turns drawing on; any choice closes the
    ; menu.
    fn activate:string (target:string) {
        def what:string (this.partOf(target))
        if compact {
            if (what == "toggle") {
                active = (active == false)
                menu = ""
            }
            if (what == "menu:tool") {
                menu = (? (menu == "tool") "" "tool")
            }
            if (what == "menu:color") {
                menu = (? (menu == "color") "" "color")
            }
            if ((indexOf what "tool:") == 0) {
                active = true
            }
            if ((((indexOf what "tool:") == 0) || ((indexOf what "color:") == 0)) || ((indexOf what "size:") == 0)) {
                menu = ""
            }
        }
        if ((indexOf what "tool:") == 0) {
            tool = (substring what 5 (strlen what))
        }
        if ((indexOf what "color:") == 0) {
            color = (substring what 6 (strlen what))
        }
        if ((indexOf what "size:") == 0) {
            size = (?? (str2int (substring what 5 (strlen what))) size)
        }
        return what
    }

    fn isFocusable:boolean (target:string) {
        return ((strlen (this.partOf(target))) > 0)
    }

    ; Every part a press can land on, the bar first (UiHost hit-tests by
    ; these).
    fn tids:[string] () {
        if compact {
            return (this.compactTids())
        }
        def out:[string]
        push out tid
        def i:int 0
        while (i < (array_length toolValues)) {
            push out (this.toolTid((itemAt toolValues i)))
            i = (i + 1)
        }
        def k:int 0
        while (k < (array_length colors)) {
            push out (this.colorTid(k))
            push out ((this.colorTid(k)) + "-dot")
            k = (k + 1)
        }
        def n:int 1
        while (n <= sizes) {
            push out (this.sizeTid(n))
            push out ((this.sizeTid(n)) + "-dot")
            n = (n + 1)
        }
        push out (this.doneTid())
        return out
    }

    ; The pill's buttons, then the open menu's choices.
    fn compactTids:[string] () {
        def out:[string]
        push out tid
        push out (this.toggleTid())
        push out (this.kindTid())
        push out (this.hueTid())
        push out ((this.hueTid()) + "-dot")
        if ((strlen menu) > 0) {
            push out (this.menuTid())
        }
        if (menu == "tool") {
            def i:int 0
            while (i < (array_length toolValues)) {
                push out (this.toolTid((itemAt toolValues i)))
                i = (i + 1)
            }
        }
        if (menu == "color") {
            def k:int 0
            while (k < (array_length colors)) {
                push out (this.colorTid(k))
                push out ((this.colorTid(k)) + "-dot")
                k = (k + 1)
            }
            def n:int 1
            while (n <= sizes) {
                push out (this.sizeTid(n))
                push out ((this.sizeTid(n)) + "-dot")
                n = (n + 1)
            }
        }
        return out
    }

    fn rows:[UiRow] () {
        if compact {
            return (this.compactRows())
        }
        def out:[UiRow]
        def bar:UiRow (UiRow.of(tid (EVGA11yRole.toolbar()) name))
        bar.orientation = (? vertical "vertical" "horizontal")
        push out bar
        def i:int 0
        while (i < (array_length toolValues)) {
            def v:string (itemAt toolValues i)
            def r:UiRow (UiRow.of((this.toolTid(v)) (EVGA11yRole.radio()) (itemAt toolNames i)))
            r.parentTid = tid
            r.checked = (? (v == tool) 1 0)
            r.focusable = true
            r.tabStop = (v == tool)
            push out r
            i = (i + 1)
        }
        def k:int 0
        while (k < (array_length colors)) {
            def cr:UiRow (UiRow.of((this.colorTid(k)) (EVGA11yRole.radio()) (itemAt colorNames k)))
            cr.parentTid = tid
            cr.checked = (? ((itemAt colors k) == color) 1 0)
            cr.focusable = true
            push out cr
            k = (k + 1)
        }
        def n:int 1
        while (n <= sizes) {
            def sr:UiRow (UiRow.of((this.sizeTid(n)) (EVGA11yRole.radio()) ("Size " + (to_string n))))
            sr.parentTid = tid
            sr.checked = (? (n == size) 1 0)
            sr.focusable = true
            push out sr
            n = (n + 1)
        }
        def d:UiRow (UiRow.of((this.doneTid()) (EVGA11yRole.button()) doneName))
        d.parentTid = tid
        d.focusable = true
        push out d
        return out
    }

    ; A toolbar of three buttons; the pen pressed or not, the two others
    ; opening a menu, and the open menu's choices as radio buttons.
    fn compactRows:[UiRow] () {
        def out:[UiRow]
        def bar:UiRow (UiRow.of(tid (EVGA11yRole.toolbar()) name))
        bar.orientation = "horizontal"
        push out bar
        def pen:UiRow (UiRow.of((this.toggleTid()) (EVGA11yRole.button()) penName))
        pen.parentTid = tid
        pen.pressed = (? active 1 0)
        pen.focusable = true
        pen.tabStop = true
        push out pen
        def kind:UiRow (UiRow.of((this.kindTid()) (EVGA11yRole.button()) toolMenuName))
        kind.parentTid = tid
        kind.expanded = (? (menu == "tool") 1 0)
        kind.focusable = true
        push out kind
        def hue:UiRow (UiRow.of((this.hueTid()) (EVGA11yRole.button()) colorMenuName))
        hue.parentTid = tid
        hue.expanded = (? (menu == "color") 1 0)
        hue.focusable = true
        push out hue
        if (menu == "tool") {
            def i:int 0
            while (i < (array_length toolValues)) {
                def v:string (itemAt toolValues i)
                def r:UiRow (UiRow.of((this.toolTid(v)) (EVGA11yRole.radio()) (itemAt toolNames i)))
                r.parentTid = tid
                r.checked = (? (v == tool) 1 0)
                r.focusable = true
                push out r
                i = (i + 1)
            }
        }
        if (menu == "color") {
            def k:int 0
            while (k < (array_length colors)) {
                def cr:UiRow (UiRow.of((this.colorTid(k)) (EVGA11yRole.radio()) (itemAt colorNames k)))
                cr.parentTid = tid
                cr.checked = (? ((itemAt colors k) == color) 1 0)
                cr.focusable = true
                push out cr
                k = (k + 1)
            }
            def n:int 1
            while (n <= sizes) {
                def sr:UiRow (UiRow.of((this.sizeTid(n)) (EVGA11yRole.radio()) ("Size " + (to_string n))))
                sr.parentTid = tid
                sr.checked = (? (n == size) 1 0)
                sr.focusable = true
                push out sr
                n = (n + 1)
            }
        }
        return out
    }
}
