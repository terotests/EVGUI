; =============================================================================
; DrawToolsCtl — the palette of a drawing tool: tools, colours, line sizes
; =============================================================================
; A small floating bar beside what is drawn on (a slide being edited): one
; tool is on at a time (select, pen, arrow, …), one colour, one size, and a
; button that puts the palette away. What each tool does is the host's; this
; keeps which one is chosen and says what was pressed.
;
;   ┌───┐
;   │ ↖ │  tools: the one on is filled
;   │ ✎ │
;   │ T │
;   ├───┤
;   │ ● │  colours: the one on has a ring
;   │ ● │
;   ├───┤
;   │ · │  sizes, small to large
;   ├───┤
;   │ ✓ │  done
;   └───┘
;
; `activate` answers "tool:<value>", "color:<value>", "size:<n>" or "done",
; and has already made the tool, colour or size the chosen one. The host
; places the bar (`x`, `y`, the top left) and lays it out `vertical` or not.
;
; TO A READER: a toolbar; the tools and the colours are radio buttons
; ("Pen", checked), the sizes too ("Size 2"), and Done a button.
; =============================================================================

Import "UiCtl.rgr"
Import "UiTree.rgr"
Import "pkg:evg/EVGElement.rgr"
Import "pkg:evg/EVGA11yTree.rgr"

class DrawToolsCtl extends UiCtl {
    ; the top left of the bar, on the page
    def x:double 0.0
    def y:double 0.0
    def vertical:boolean true
    ; the tools: value, what is drawn on it, what a reader is told
    def toolValues:[string]
    def toolGlyphs:[string]
    def toolNames:[string]
    def tool:string ""
    ; the colours (CSS colours), and their names for a reader
    def colors:[string]
    def colorNames:[string]
    def color:string ""
    ; how many sizes (1…sizes), and the one on
    def sizes:int 3
    def size:int 2
    def doneName:string "Done"

    Constructor () {
        def a:[string]
        toolValues = a
        def b:[string]
        toolGlyphs = b
        def c:[string]
        toolNames = c
        def d:[string]
        colors = d
        def e:[string]
        colorNames = e
    }

    sfn make:DrawToolsCtl (tid:string) {
        def p (new DrawToolsCtl())
        p.tid = tid
        return p
    }

    fn addTool:void (value:string glyph:string name:string) {
        push toolValues value
        push toolGlyphs glyph
        push toolNames name
        if ((strlen tool) == 0) {
            tool = value
        }
    }

    fn addColor:void (value:string name:string) {
        push colors value
        push colorNames name
        if ((strlen color) == 0) {
            color = value
        }
    }

    ; --- the ids of the parts -------------------------------------------------------

    fn toolTid:string (value:string) {
        return (tid + "-tool-" + value)
    }

    fn colorTid:string (i:int) {
        return (tid + "-color-" + (to_string i))
    }

    fn sizeTid:string (n:int) {
        return (tid + "-size-" + (to_string n))
    }

    fn doneTid:string () {
        return (tid + "-done")
    }

    ; --- choosing ----------------------------------------------------------------------

    fn setTool:boolean (value:string) {
        if ((indexOf toolValues value) < 0) {
            return false
        }
        tool = value
        return true
    }

    fn setColor:boolean (value:string) {
        if ((indexOf colors value) < 0) {
            return false
        }
        color = value
        return true
    }

    fn setSize:boolean (n:int) {
        if ((n < 1) || (n > sizes)) {
            return false
        }
        size = n
        return true
    }

    ; --- the tree -------------------------------------------------------------------------

    fn build:void () {
        def root:EVGElement (UiTree.div(tid (? vertical "drawtools" "drawtools drawtools-row")))
        UiTree.surface(root "free" "start")
        root.overlayX = x
        root.overlayY = y
        def i:int 0
        while (i < (array_length toolValues)) {
            def v:string (itemAt toolValues i)
            def cls:string "drawtools-tool"
            if (v == tool) {
                cls = (cls + " drawtools-on")
            }
            root.addChild((UiTree.label((this.toolTid(v)) cls (itemAt toolGlyphs i))))
            i = (i + 1)
        }
        if ((array_length colors) > 0) {
            root.addChild((UiTree.div((tid + "-sep1") "drawtools-sep")))
            def k:int 0
            while (k < (array_length colors)) {
                def sw:EVGElement (UiTree.div((this.colorTid(k)) (? ((itemAt colors k) == color) "drawtools-swatch drawtools-swatch-on" "drawtools-swatch")))
                def dot:EVGElement (UiTree.div((this.colorTid(k) + "-dot") "drawtools-dot"))
                UiTree.inline(dot "background-color" (itemAt colors k))
                sw.addChild(dot)
                root.addChild(sw)
                k = (k + 1)
            }
        }
        if (sizes > 1) {
            root.addChild((UiTree.div((tid + "-sep2") "drawtools-sep")))
            def n:int 1
            while (n <= sizes) {
                def sz:EVGElement (UiTree.div((this.sizeTid(n)) (? (n == size) "drawtools-size drawtools-on" "drawtools-size")))
                sz.addChild((UiTree.div((this.sizeTid(n) + "-dot") ("drawtools-size-dot drawtools-size-" + (to_string n)))))
                root.addChild(sz)
                n = (n + 1)
            }
        }
        root.addChild((UiTree.div((tid + "-sep3") "drawtools-sep")))
        root.addChild((UiTree.label((this.doneTid()) "drawtools-tool drawtools-done" "✓")))
        rootEl = root
    }

    ; What the part `target` (or one inside it) is: "tool:<value>",
    ; "color:<value>", "size:<n>", "done", or "" for none of them.
    fn partOf:string (target:string) {
        def i:int 0
        while (i < (array_length toolValues)) {
            def v:string (itemAt toolValues i)
            if (target == (this.toolTid(v))) {
                return ("tool:" + v)
            }
            i = (i + 1)
        }
        def k:int 0
        while (k < (array_length colors)) {
            def ct:string (this.colorTid(k))
            if ((target == ct) || (target == (ct + "-dot"))) {
                return ("color:" + (itemAt colors k))
            }
            k = (k + 1)
        }
        def n:int 1
        while (n <= sizes) {
            def st:string (this.sizeTid(n))
            if ((target == st) || (target == (st + "-dot"))) {
                return ("size:" + (to_string n))
            }
            n = (n + 1)
        }
        if (target == (this.doneTid())) {
            return "done"
        }
        return ""
    }

    ; A press on `target`: what it means, with the tool, colour or size it
    ; names chosen already.
    fn activate:string (target:string) {
        def what:string (this.partOf(target))
        if ((indexOf what "tool:") == 0) {
            tool = (substring what 5 (strlen what))
        }
        if ((indexOf what "color:") == 0) {
            color = (substring what 6 (strlen what))
        }
        if ((indexOf what "size:") == 0) {
            size = (?? (str2int (substring what 5 (strlen what))) size)
        }
        return what
    }

    fn isFocusable:boolean (target:string) {
        return ((strlen (this.partOf(target))) > 0)
    }

    ; Every part a press can land on, the bar first (UiHost hit-tests by
    ; these).
    fn tids:[string] () {
        def out:[string]
        push out tid
        def i:int 0
        while (i < (array_length toolValues)) {
            push out (this.toolTid((itemAt toolValues i)))
            i = (i + 1)
        }
        def k:int 0
        while (k < (array_length colors)) {
            push out (this.colorTid(k))
            push out ((this.colorTid(k)) + "-dot")
            k = (k + 1)
        }
        def n:int 1
        while (n <= sizes) {
            push out (this.sizeTid(n))
            push out ((this.sizeTid(n)) + "-dot")
            n = (n + 1)
        }
        push out (this.doneTid())
        return out
    }

    fn rows:[UiRow] () {
        def out:[UiRow]
        def bar:UiRow (UiRow.of(tid (EVGA11yRole.toolbar()) name))
        bar.orientation = (? vertical "vertical" "horizontal")
        push out bar
        def i:int 0
        while (i < (array_length toolValues)) {
            def v:string (itemAt toolValues i)
            def r:UiRow (UiRow.of((this.toolTid(v)) (EVGA11yRole.radio()) (itemAt toolNames i)))
            r.parentTid = tid
            r.checked = (? (v == tool) 1 0)
            r.focusable = true
            r.tabStop = (v == tool)
            push out r
            i = (i + 1)
        }
        def k:int 0
        while (k < (array_length colors)) {
            def cr:UiRow (UiRow.of((this.colorTid(k)) (EVGA11yRole.radio()) (itemAt colorNames k)))
            cr.parentTid = tid
            cr.checked = (? ((itemAt colors k) == color) 1 0)
            cr.focusable = true
            push out cr
            k = (k + 1)
        }
        def n:int 1
        while (n <= sizes) {
            def sr:UiRow (UiRow.of((this.sizeTid(n)) (EVGA11yRole.radio()) ("Size " + (to_string n))))
            sr.parentTid = tid
            sr.checked = (? (n == size) 1 0)
            sr.focusable = true
            push out sr
            n = (n + 1)
        }
        def d:UiRow (UiRow.of((this.doneTid()) (EVGA11yRole.button()) doneName))
        d.parentTid = tid
        d.focusable = true
        push out d
        return out
    }
}
