; SPDX-License-Identifier: AGPL-3.0-or-later

; =============================================================================
; WindowCtl — a window you can move, with anything you like inside it
; =============================================================================
; Two things at once, because they are one thing with a flag:
;
;   MODAL      a dialog. It takes the page: everything outside it goes out of
;              the accessibility tree, Escape closes it, and the scrim behind
;              it can dim, blur, or both. Measured against
;              @radix-ui/react-dialog by `DialogCtl`, whose contract this one
;              keeps — see the note on `modal` below.
;   MOVABLE    a window. It does not take the page: what is behind it stays
;              reachable, by pointer and by reader, and you can push it out of
;              the way by its title bar. Often the better answer, and the one
;              a modal cannot give: a dialog you cannot move is a dialog that
;              covers the thing you opened it to look at.
;
; --- WHY NOT EVGWindow --------------------------------------------------------
; `gallery/evg_window/EVGWindow.rgr` is the older layer and it has a fixed vocabulary:
; `addLabel`, `addButton`, `addRadio`, `addCheckbox`, `addSwatch`, and one
; `content` rectangle whose pixels the OWNER paints by hand. Anything it does
; not have a method for cannot go in the window at all — a table, a chart with
; a legend, a form with a select in it, another window's worth of controls.
;
; Here the window owns a FRAME and nothing else. `bodyEl` is an ordinary
; EVGElement; the caller fills it with whatever tree it likes, from a literal,
; from another controller's `build()`, from a loop. `build()` re-makes the
; chrome around it and never touches its children. That is the whole design,
; and it is why this can hold the table demo where EVGWindow could hold a
; column of radio buttons.
;
; --- WHAT IS MEASURED AND WHAT IS NOT -----------------------------------------
; The ARIA is Radix's dialog, which the harness already measures: role, the
; label, the modal masking, Escape, focus on open and focus back on close.
; Those are not re-derived here.
;
; The DRAGGING has no reference — nothing in Radix moves a dialog, and the
; sortable's oracle is about reordering a list. So it is specified rather than
; measured, and the specification is the small one: the title bar is the
; handle, the window moves by the pointer's delta, and it is kept far enough on
; screen to be grabbed again. `WindowCtl` tests state those as behaviour, and
; where a browser has an opinion (Escape, focus) the browser is still the
; authority via DialogCtl.
; =============================================================================

Import "UiCtl.rgr"
Import "UiTree.rgr"
Import "UiScroll.rgr"
Import "pkg:evg/EVGElement.rgr"
Import "pkg:evg/EVGUnit.rgr"
Import "pkg:evg/EVGA11yTree.rgr"

class WindowCtl extends UiCtl {
    def open:boolean false
    ; Takes the page, or shares it. The difference is one flag and four
    ; observable consequences: the scrim exists, everything outside is hidden,
    ; the window cannot be moved, and closing restores focus to the trigger.
    def isModal:boolean false
    def title:string ""
    def closeLabel:string "Close"
    ; Shown under the title. Radix's dialog has one and names the content by
    ; it, so a reader hears what the dialog is for before its first control.
    def description:string ""

    ; Where it sits, in page pixels. Only meaningful when it is movable — a
    ; modal is centred by the overlay layer and these are ignored.
    def x:double 0.0
    def y:double 0.0
    def pageW:double 900.0
    def pageH:double 560.0
    ; How much of the window must stay on the page. Enough to grab: a window
    ; dragged entirely off the bottom is a window nobody can get back.
    def keepOnScreen:double 48.0
    ; The gap the frame keeps from the page's edges. The frame is never wider
    ; than the page less this on both sides, and never taller than what is
    ; left below its top less this; what does not fit then scrolls in the
    ; body (`bodyScroll`). A window whose content is taller than a phone, or
    ; than a low desktop window, otherwise ran off the bottom with its buttons
    ; and nothing could bring them back.
    def margin:double 8.0
    ; What the frame holds besides the body, down: the title bar, the
    ; description, the frame's own border and padding. The body's bound is
    ; the frame's less this. Measured after a layout (`settle`); before the
    ; first one it is a title bar's worth.
    def chromeH:double 46.0

    def dragging:boolean false

    ; How far the body is scrolled, and a finger on it (`UiScroll`): the
    ; wheel (`scrollBody`) or a finger (`beginPan`). Back to the top when the
    ; window opens. An owner that makes a new window for an open one hands
    ; this over, and the new one stays where the old one was scrolled.
    def scroll:UiScroll (new UiScroll())

    ; --- the desktop layer (all optional; a window that sets none of these is
    ; the window it always was) ----------------------------------------------
    ;
    ; The frame's size, in page pixels, when the OWNER sizes the window rather
    ; than letting its content do it. Zero means "whatever the layout made":
    ; `moveBy` then reads the frame's laid-out box, as it always did.
    def w:double 0.0
    def h:double 0.0
    ; The smallest a resize may make it. A window resized to nothing is a
    ; window whose title bar nobody can find.
    def minW:double 200.0
    def minH:double 120.0
    ; A modal that can still be moved by its title bar. It keeps everything
    ; else a modal is — the scrim, the masking, Escape, the focus return — and
    ; gives back the one thing a modal usually takes: getting it out of the way
    ; of the thing it asks about.
    def movableModal:boolean false
    ; The title bar carries minimize and maximize buttons as well as close.
    def hasMinMax:boolean false

    def minimized:boolean false
    def maximized:boolean false
    ; "left" or "right" while the window fills that half of the page.
    def snapped:string ""
    ; The geometry to go back to from maximized or snapped.
    def restX:double 0.0
    def restY:double 0.0
    def restW:double 0.0
    def restH:double 0.0

    ; A resize in progress: the edge ("n", "se", ...) and where it started.
    def resizeEdge:string ""
    def startX:double 0.0
    def startY:double 0.0
    def startW:double 0.0
    def startH:double 0.0

    ; A geometry jump (maximize, restore, snap) eased over `animMs`. The
    ; LOGICAL geometry (x, y, w, h) is the destination the moment the jump
    ; happens; `shownX()` and friends are where it is drawn on the way there.
    def animMs:double 160.0
    def animT:double 1.0
    def fromX:double 0.0
    def fromY:double 0.0
    def fromW:double 0.0
    def fromH:double 0.0

    def triggerEl:EVGElement
    def scrimEl:EVGElement
    def frameEl:EVGElement
    def headEl:EVGElement
    def barEl:EVGElement
    def titleEl:EVGElement
    def descEl:EVGElement
    def closeEl:EVGElement
    ; The composition point. Everything the caller puts here is the window's
    ; content, and `build()` leaves it alone.
    def bodyEl:EVGElement

    Constructor () {
        rootEl = (EVGElement.createDiv())
        triggerEl = (EVGElement.createDiv())
        scrimEl = (EVGElement.createDiv())
        frameEl = (EVGElement.createDiv())
        headEl = (EVGElement.createDiv())
        barEl = (EVGElement.createDiv())
        titleEl = (EVGElement.createDiv())
        descEl = (EVGElement.createDiv())
        closeEl = (EVGElement.createDiv())
        bodyEl = (EVGElement.createDiv())
    }

    ; --- the parts ---------------------------------------------------------------

    fn triggerTid:string ()  { return (tid + "-trigger") }
    fn scrimTid:string ()    { return (tid + "-scrim") }
    fn frameTid:string ()    { return (tid + "-content") }
    ; The strip across the top, which is a container and not a control — and
    ; the handle inside it, which is. They are two elements because a button
    ; may not contain another one: with the close button inside the handle,
    ; axe calls it `nested-interactive` and is right. The handle still fills
    ; everything left of the close button, so the whole bar is grabbable.
    fn headTid:string ()     { return (tid + "-head") }
    fn barTid:string ()      { return (tid + "-titlebar") }
    fn titleTid:string ()    { return (tid + "-title") }
    fn descTid:string ()     { return (tid + "-description") }
    fn closeTid:string ()    { return (tid + "-close") }
    fn bodyTid:string ()     { return (tid + "-body") }

    ; The handle is the title bar AND its label, because the label fills the bar
    ; and a hit test returns the innermost thing under the pointer. Without
    ; this, pressing the middle of a title bar reports the title — and the
    ; window does not move, which is exactly what the first live drag did.
    ; The close button sits in the same bar and is deliberately not here.
    fn isHandle:boolean (target:string) {
        if (target == (this.barTid())) {
            return true
        }
        return (target == (this.titleTid()))
    }

    ; A modal's title bar is a heading, not a control — unless the modal was
    ; made movable, when it is the handle a movable window's is.
    fn barIsLabel:boolean () {
        return (isModal && (movableModal == false))
    }

    ; The maximize button says what it will do: maximize, or put it back.
    fn maxLabel:string () {
        if (maximized || ((strlen snapped) > 0)) {
            return "Restore"
        }
        return "Maximize"
    }

    fn baseClass:string () {
        if isModal {
            return "ui-dialog"
        }
        return "ui-window"
    }

    fn stateWord:string () {
        if open {
            return "open"
        }
        return "closed"
    }

    ; --- building ----------------------------------------------------------------
    ; The frame, and only the frame. `bodyEl` keeps whatever the caller put in
    ; it, which is the entire reason this class exists.

    ; ONE description of the window, read two ways.
    ;
    ; `rows()` below is what the conformance host publishes; `EVGA11yFromTree`
    ; walks the ELEMENTS instead, and that is what a page using this controller
    ; directly publishes — the demo, and any real application. Writing the ARIA
    ; only into `rows()` left the second path with no dialog at all: the form
    ; fields were there, the table was there, and the thing containing them was
    ; invisible. The audit did not catch it, because a node that is missing
    ; cannot fail a rule about its name.
    ;
    ; So `build()` puts the same facts on the elements, and the two paths agree
    ; by construction rather than by anyone remembering.
    fn markAria:void () {
        def trig:EVGElement (unwrap triggerEl)
        trig.role = "button"
        trig.a11yLabel = name
        trig.a11yFocusable = (disabled == false)
        if open {
            trig.a11yExpanded = (EVGA11yTri.yes())
        } {
            trig.a11yExpanded = (EVGA11yTri.no())
        }

        def frame:EVGElement (unwrap frameEl)
        frame.role = "dialog"
        frame.a11yLabel = title
        ; `aria-modal`, on the element path as well as in `rows()`: the page's
        ; mirror hides everything outside a modal node from a reader, and
        ; without the flag it had no modal node to keep.
        frame.a11yModal = isModal

        def head2:EVGElement (unwrap headEl)
        head2.role = ""
        def bar:EVGElement (unwrap barEl)
        if (this.barIsLabel()) {
            ; A heading over the dialog it names, and nothing a reader should
            ; be offered as a control.
            bar.role = ""
            bar.a11yLabel = ""
            bar.a11yRoleDescription = ""
            bar.a11yFocusable = false
        } {
            bar.role = "button"
            bar.a11yLabel = (title + ", move window")
            ; What a reader says INSTEAD of "button": this one is dragged, not
            ; pressed, and the label alone does not say that.
            bar.a11yRoleDescription = "draggable"
            bar.a11yFocusable = true
        }
        ; The title is the bar's label in words and must not announce again as
        ; a node of its own; the same for the close glyph.
        def titleEl3:EVGElement (unwrap titleEl)
        titleEl3.a11yHidden = ((this.barIsLabel()) == false)

        def close:EVGElement (unwrap closeEl)
        close.role = "button"
        close.a11yLabel = closeLabel
        close.a11yFocusable = true
    }

    fn build:void () {
        def base:string (this.baseClass())
        def word:string (this.stateWord())
        def root:EVGElement (unwrap rootEl)
        root.id = tid
        root.className = base
        UiTree.clearChildren(root)

        def trig:EVGElement (unwrap triggerEl)
        trig.id = (this.triggerTid())
        trig.className = (base + "-trigger")
        UiTree.setState(trig (base + "-trigger") word)
        UiTree.leafText(trig name)
        UiTree.anchor(trig)
        root.addChild(trig)

        if (open == false) {
            ; Still marked: a closed window's trigger has to say it is
            ; collapsed. Returning before `markAria` left it announcing
            ; `aria-expanded="true"` after every close.
            this.markAria()
            return
        }

        ; The scrim, for a modal only. It is a sibling of the frame and painted
        ; first, so the frame sits over it; `backdrop-filter` on it is what
        ; softens the page underneath, and the stylesheet decides whether it
        ; dims, blurs or both.
        if isModal {
            def scrim:EVGElement (unwrap scrimEl)
            scrim.id = (this.scrimTid())
            scrim.className = (base + "-scrim")
            UiTree.setState(scrim (base + "-scrim") word)
            UiTree.backdrop(scrim)
            UiTree.clearChildren(scrim)
            root.addChild(scrim)
        }

        def frame:EVGElement (unwrap frameEl)
        frame.id = (this.frameTid())
        frame.className = (base + "-content")
        UiTree.setState(frame (base + "-content") word)
        UiTree.clearChildren(frame)
        ; A modal is centred and a window sits where it was left. Both are
        ; overlays; only the side differs, which is the whole geometric
        ; difference between the two.
        if isModal {
            UiTree.surface(frame "center" "center")
        } {
            UiTree.surface(frame "free" "start")
            frame.overlayX = x
            frame.overlayY = y
        }
        this.fitFrame()

        ; The title bar: the label, and the handle. A modal has the same bar
        ; and it simply is not a handle — `dragsFreely` is what says so, not a
        ; different tree, because a dialog that grows a title bar when you make
        ; it movable is two components pretending to be one.
        def head:EVGElement (unwrap headEl)
        head.id = (this.headTid())
        head.className = (base + "-titlebar")
        UiTree.clearChildren(head)

        def bar:EVGElement (unwrap barEl)
        bar.id = (this.barTid())
        bar.className = (base + "-handle")
        UiTree.clearChildren(bar)
        if dragging {
            UiTree.addClass(bar (base + "-handle-dragging"))
        }

        def titleEl2:EVGElement (unwrap titleEl)
        titleEl2.id = (this.titleTid())
        titleEl2.className = (base + "-title")
        UiTree.leafText(titleEl2 title)
        bar.addChild(titleEl2)
        head.addChild(bar)

        if hasMinMax {
            def mn (EVGElement.createDiv())
            mn.id = (this.minTid())
            mn.className = (base + "-minimize")
            mn.role = "button"
            mn.a11yLabel = "Minimize"
            mn.a11yFocusable = true
            UiTree.leafText(mn "–")
            head.addChild(mn)
            def mx (EVGElement.createDiv())
            mx.id = (this.maxTid())
            mx.className = (base + "-maximize")
            mx.role = "button"
            mx.a11yLabel = (this.maxLabel())
            mx.a11yFocusable = true
            UiTree.leafText(mx "□")
            head.addChild(mx)
        }
        def close:EVGElement (unwrap closeEl)
        close.id = (this.closeTid())
        close.className = (base + "-close")
        UiTree.leafText(close "×")
        head.addChild(close)
        frame.addChild(head)

        if ((strlen description) > 0) {
            def desc:EVGElement (unwrap descEl)
            desc.id = (this.descTid())
            desc.className = (base + "-description")
            UiTree.leafText(desc description)
            frame.addChild(desc)
        }

        ; And the caller's tree, untouched.
        ;
        ; The body's own BOX is the frame's business, though, so its class goes
        ; on unconditionally and ADDS to whatever the caller put there. The
        ; first version only set it when the caller had left the class empty,
        ; and the demo — which names its body so it can style it — silently
        ; lost the frame's padding: the title was indented fourteen pixels and
        ; every row underneath sat flush against the window's border.
        ;
        ; Additive is also what lets a caller override it: `EVGStyleSheet`
        ; takes the later rule, so a class declared after this one in the sheet
        ; still wins. What it cannot do any more is take the padding away by
        ; accident.
        def body:EVGElement (unwrap bodyEl)
        body.id = (this.bodyTid())
        UiTree.addClass(body (base + "-body"))
        ; The body is what gives way when the frame meets the page's bottom:
        ; it shrinks below its content and scrolls, so the title bar and its
        ; close button stay put. Inline, because it is the frame's geometry
        ; and not a look a theme should be able to take away.
        UiTree.inline(body "overflow-y" "auto")
        this.fitBody()
        body.scrollTop = scroll.top
        frame.addChild(body)

        root.addChild(frame)
        this.markAria()
    }

    ; --- opening and closing -------------------------------------------------------

    fn openWindow:string () {
        open = true
        dragging = false
        scroll.reset()
        this.build()
        ; Focus lands on the close button, which is what Radix's dialog does
        ; and what `DialogCtl` is measured doing: it is the one control every
        ; dialog has, so it is the one place focus can always go.
        return (this.closeTid())
    }

    fn closeWindow:string () {
        open = false
        dragging = false
        this.build()
        return (this.triggerTid())
    }

    ; --- input -----------------------------------------------------------------------

    fn activate:string (target:string) {
        if disabled {
            return ""
        }
        if (target == (this.triggerTid())) {
            if open {
                return (this.closeWindow())
            }
            return (this.openWindow())
        }
        if (open == false) {
            return ""
        }
        if (target == (this.closeTid())) {
            return (this.closeWindow())
        }
        if hasMinMax {
            if (target == (this.minTid())) {
                this.minimize()
                return (this.triggerTid())
            }
            if (target == (this.maxTid())) {
                this.toggleMaximize()
                return target
            }
        }
        ; Pressing the handle focuses the HANDLE, whichever part of it was
        ; actually hit. A click lands on the label — it fills the bar — and
        ; leaving focus there would put it on something that answers no keys,
        ; so the arrows would stop working the moment you clicked the window.
        if (this.isHandle(target)) {
            if ((this.barIsLabel()) == false) {
                return (this.barTid())
            }
        }
        return ""
    }

    fn keyDown:string (target:string key:string) {
        if disabled {
            return ""
        }
        if (key == "Escape") {
            if open {
                return (this.closeWindow())
            }
            return ""
        }
        if (UiCtl.activatesOn(key)) {
            return (this.activate(target))
        }
        ; A movable window can be nudged with the arrows while its title bar
        ; holds focus. Not decoration: dragging is a pointer gesture, and
        ; without this a keyboard cannot move the window at all — which is the
        ; same argument the sortable makes for its own arrow keys.
        if (open == false) {
            return ""
        }
        if (this.barIsLabel()) {
            return ""
        }
        if ((this.isHandle(target)) == false) {
            return ""
        }
        def step:double 16.0
        if (key == "ArrowLeft") {
            this.moveBy((0.0 - step) 0.0)
            return target
        }
        if (key == "ArrowRight") {
            this.moveBy(step 0.0)
            return target
        }
        if (key == "ArrowUp") {
            this.moveBy(0.0 (0.0 - step))
            return target
        }
        if (key == "ArrowDown") {
            this.moveBy(0.0 step)
            return target
        }
        return ""
    }

    ; --- moving ------------------------------------------------------------------------

    fn dragsFreely:boolean () {
        if (isModal && (movableModal == false)) {
            return false
        }
        return open
    }

    fn press:string (target:string) {
        if (open == false) {
            return ""
        }
        if (isModal && (movableModal == false)) {
            return ""
        }
        if ((this.isHandle(target)) == false) {
            return ""
        }
        dragging = true
        this.build()
        ; The bar, not whatever was hit: focus belongs on the control, and the
        ; label is not one. Without this the arrow keys stop working the moment
        ; a window has been picked up by its title.
        return (this.barTid())
    }

    fn dragBy:string (dx:double dy:double) {
        if (dragging == false) {
            return ""
        }
        this.moveBy(dx dy)
        return ""
    }

    fn release:string () {
        if (dragging == false) {
            return ""
        }
        dragging = false
        this.build()
        return ""
    }

    ; Move, then keep enough of the window on the page to grab again. Clamping
    ; the TOP-LEFT to the page would be wrong in both directions: it would stop
    ; the window sliding off to the right long before it needed to, and it
    ; would happily let it go off the bottom.
    fn moveBy:void (dx:double dy:double) {
        x = (x + dx)
        y = (y + dy)
        def fw:double (this.frameW())
        def fh:double (this.frameH())
        ; Before the first layout there is no width to reason about, and a
        ; clamp against zero would pin the window to the corner.
        if (fw > 0.0) {
            def minX:double (keepOnScreen - fw)
            def maxX:double (pageW - keepOnScreen)
            if (x < minX) {
                x = minX
            }
            if (x > maxX) {
                x = maxX
            }
        }
        if (fh > 0.0) {
            ; The title bar must stay reachable, so the top never goes above
            ; the page: a window whose handle is off the top cannot be pulled
            ; back down.
            if (y < 0.0) {
                y = 0.0
            }
            def maxY:double (pageH - keepOnScreen)
            if (y > maxY) {
                y = maxY
            }
        }
        def frame:EVGElement (unwrap frameEl)
        frame.overlayX = x
        frame.overlayY = y
        this.fitFrame()
    }

    ; --- fitting the page ----------------------------------------------------------------
    ;
    ; The most a frame may take: the page less `margin` on each side across,
    ; and what is left below its top less `margin` down. A modal is centred,
    ; so it has the whole height less a margin at each end. A maximized or
    ; snapped window is the page's size on purpose and keeps no margin.
    ;
    ; Never less than `minH` down: a window dragged nearly off the bottom
    ; keeps a body to scroll rather than collapsing to its title bar, and the
    ; rest of it is below the page as before, to be pulled back up.

    fn fills:boolean () {
        return (maximized || ((strlen snapped) > 0))
    }

    fn fitW:double () {
        if (this.fills()) {
            return pageW
        }
        def m:double (pageW - (margin * 2.0))
        if (m < 0.0) {
            return pageW
        }
        return m
    }

    fn fitH:double () {
        if (this.fills()) {
            return pageH
        }
        def m:double (pageH - (margin * 2.0))
        if (isModal == false) {
            def top:double y
            if (top < margin) {
                top = margin
            }
            m = ((pageH - top) - margin)
        }
        if (m < minH) {
            m = minH
        }
        return m
    }

    ; Written on the frame and the body on every build and every move: the
    ; bound follows the window down the page as it is dragged.
    ;
    ; The body carries its own `max-height` rather than shrinking inside a
    ; bounded frame, because EVG's column flex does not shrink an auto-height
    ; item against its container's `max-height` the way CSS does: the frame
    ; stopped at the page and its body ran on out of it.
    fn fitFrame:void () {
        def frame:EVGElement (unwrap frameEl)
        UiTree.inline(frame "max-width" ((to_string (to_int (this.fitW()))) + "px"))
        this.fitBody()
    }

    fn bodyMaxH:double () {
        def m:double ((this.fitH()) - chromeH)
        if (m < 40.0) {
            m = 40.0
        }
        return m
    }

    fn fitBody:void () {
        def body:EVGElement (unwrap bodyEl)
        UiTree.inline(body "max-height" ((to_string (to_int (this.bodyMaxH()))) + "px"))
    }

    ; After a layout: measure what the frame holds besides its body. True
    ; when that changed the body's bound, and the owner lays out again — once,
    ; since the chrome does not depend on the body's height.
    fn settle:boolean () {
        if (open == false) {
            return false
        }
        def f:EVGElement (unwrap frameEl)
        def b:EVGElement (unwrap bodyEl)
        if (f.calculatedHeight <= 0.0) {
            return false
        }
        def m:double (((b.calculatedY - f.calculatedY) + f.box.borderWidthPx) + f.box.paddingBottomPx)
        if (m < 0.0) {
            return false
        }
        def d:double (m - chromeH)
        if ((d * d) < 0.25) {
            return false
        }
        chromeH = m
        this.fitBody()
        return true
    }

    ; --- scrolling the body --------------------------------------------------------------
    ;
    ; What there is to scroll, from the last layout: zero when it all fits.
    fn bodyScrollMax:double () {
        return bodyEl.maxScrollTop()
    }

    ; Over the body (as last laid out): where a wheel or a finger scrolls it.
    fn overBody:boolean (px:double py:double) {
        if (open == false) {
            return false
        }
        return (UiScroll.has((unwrap bodyEl) px py))
    }

    ; Scroll by `dy` (down positive). True when it moved, so a wheel that has
    ; reached the end can be left to whatever is under the window.
    fn scrollBody:boolean (dy:double) {
        return (scroll.scrollBy((unwrap bodyEl) dy))
    }

    ; Bring a band of the body (page pixels, as laid out) into sight: a field
    ; focused by Tab below the fold.
    fn revealBody:boolean (top:double bottom:double) {
        return (scroll.reveal((unwrap bodyEl) top bottom))
    }

    ; A finger on the body: `beginPan` where it went down, `panTo` as it
    ; moves (the content follows it), `endPan` when it lifts, true for a tap
    ; to be pressed at `scroll.downX`, `scroll.downY`.
    fn beginPan:void (px:double py:double clicks:int shift:boolean) {
        scroll.beginPan(px py clicks shift)
    }

    fn panTo:boolean (py:double) {
        return (scroll.panTo((unwrap bodyEl) py))
    }

    fn endPan:boolean () {
        return (scroll.endPan())
    }

    fn panning:boolean () {
        return scroll.panning
    }

    ; --- the desktop layer: size, resize, minimize, maximize, snap -----------------------
    ;
    ; Everything below is additive. A window whose owner never sets `w` / `h`
    ; and never calls these is the movable window above, unchanged; the demo
    ; desktop (`demo/WindowDemo.rgr`) is the owner that does.

    fn minTid:string ()      { return (tid + "-minimize") }
    fn maxTid:string ()      { return (tid + "-maximize") }
    ; One thin strip per edge and a square per corner: "n", "s", "e", "w",
    ; "ne", "nw", "se", "sw".
    fn resizeTid:string (edge:string) {
        return (tid + "-resize-" + edge)
    }

    ; The edge a resize-handle id names, or "" when it is not one of this
    ; window's handles.
    fn edgeOf:string (target:string) {
        def pre:string (tid + "-resize-")
        def n:int (strlen pre)
        if ((strlen target) <= n) {
            return ""
        }
        if ((substring target 0 n) != pre) {
            return ""
        }
        return (substring target n (strlen target))
    }

    sfn edges:[string] () {
        return ([] _:string ("n" "s" "e" "w" "ne" "nw" "se" "sw"))
    }

    ; The frame's size: the owner's when it set one, the layout's otherwise.
    fn frameW:double () {
        if (w > 0.0) {
            return w
        }
        return frameEl.calculatedWidth
    }

    fn frameH:double () {
        if (h > 0.0) {
            return h
        }
        return frameEl.calculatedHeight
    }

    ; Can it be resized now? Not while it fills the page or a half of it, and
    ; not while it is off the page in the dock.
    fn resizable:boolean () {
        if (open == false) {
            return false
        }
        if (isModal && (movableModal == false)) {
            return false
        }
        if (minimized || maximized) {
            return false
        }
        return ((strlen snapped) == 0)
    }

    ; Move to a place, rather than by a distance, and keep it grabbable. A
    ; pointer drag is written this way: the window's place is where it started
    ; plus how far the pointer has gone, so a clamp on one frame does not pull
    ; the window out from under the pointer on the next.
    fn moveTo:void (nx:double ny:double) {
        x = nx
        y = ny
        this.moveBy(0.0 0.0)
    }

    ; The page changed size (the desktop was laid out narrower, a phone turned).
    ; A maximized or snapped window follows it; any other is made to fit and
    ; kept grabbable.
    fn fitPage:void (pw:double ph:double) {
        pageW = pw
        pageH = ph
        if maximized {
            x = 0.0
            y = 0.0
            w = pw
            h = ph
            return
        }
        if (snapped == "left") {
            this.snapGeometry("left")
            return
        }
        if (snapped == "right") {
            this.snapGeometry("right")
            return
        }
        if (w > pw) {
            w = pw
        }
        if (h > ph) {
            h = ph
        }
        if (restW > pw) {
            restW = pw
        }
        if (restH > ph) {
            restH = ph
        }
        this.moveBy(0.0 0.0)
    }

    ; --- resizing ---

    fn beginResize:boolean (edge:string) {
        if ((this.resizable()) == false) {
            return false
        }
        if ((strlen edge) == 0) {
            return false
        }
        resizeEdge = edge
        startX = x
        startY = y
        startW = (this.frameW())
        startH = (this.frameH())
        return true
    }

    fn resizing:boolean () {
        return ((strlen resizeEdge) > 0)
    }

    sfn has:boolean (edge:string c:string) {
        def i:int 0
        while (i < (strlen edge)) {
            if ((substring edge i (i + 1)) == c) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    ; The pointer has gone (dx, dy) since `beginResize`. Each edge that is
    ; moving goes with it, down to the minimum size and no further out than
    ; the page — or than the window already was, so a window that was hanging
    ; off an edge does not jump the moment you touch it.
    fn resizeTo:boolean (dx:double dy:double) {
        if ((strlen resizeEdge) == 0) {
            return false
        }
        def nx:double startX
        def ny:double startY
        def nw:double startW
        def nh:double startH
        def right:double (startX + startW)
        def bottom:double (startY + startH)
        if (WindowCtl.has(resizeEdge "e")) {
            def maxR:double pageW
            if (right > maxR) {
                maxR = right
            }
            nw = (startW + dx)
            if ((startX + nw) > maxR) {
                nw = (maxR - startX)
            }
            if (nw < minW) {
                nw = minW
            }
        }
        if (WindowCtl.has(resizeEdge "w")) {
            def minL:double 0.0
            if (startX < minL) {
                minL = startX
            }
            nx = (startX + dx)
            if (nx < minL) {
                nx = minL
            }
            if ((right - nx) < minW) {
                nx = (right - minW)
            }
            nw = (right - nx)
        }
        if (WindowCtl.has(resizeEdge "s")) {
            def maxB:double pageH
            if (bottom > maxB) {
                maxB = bottom
            }
            nh = (startH + dy)
            if ((startY + nh) > maxB) {
                nh = (maxB - startY)
            }
            if (nh < minH) {
                nh = minH
            }
        }
        if (WindowCtl.has(resizeEdge "n")) {
            ; The top never goes above the page: the title bar is up there.
            ny = (startY + dy)
            if (ny < 0.0) {
                ny = 0.0
            }
            if ((bottom - ny) < minH) {
                ny = (bottom - minH)
            }
            nh = (bottom - ny)
        }
        def changed:boolean ((((nx != x) || (ny != y)) || (nw != w)) || (nh != h))
        x = nx
        y = ny
        w = nw
        h = nh
        return changed
    }

    fn endResize:boolean () {
        if ((strlen resizeEdge) == 0) {
            return false
        }
        resizeEdge = ""
        return true
    }

    ; The keyboard's resize: the right and bottom edges move, as Windows' own
    ; Size command does once an arrow has picked them. Same limits as a drag.
    fn resizeBy:boolean (dw:double dh:double) {
        if ((this.resizable()) == false) {
            return false
        }
        def ow:double (this.frameW())
        def oh:double (this.frameH())
        def nw:double (ow + dw)
        def nh:double (oh + dh)
        def maxW:double (pageW - x)
        if (maxW < ow) {
            maxW = ow
        }
        def maxH:double (pageH - y)
        if (maxH < oh) {
            maxH = oh
        }
        if (nw > maxW) {
            nw = maxW
        }
        if (nh > maxH) {
            nh = maxH
        }
        if (nw < minW) {
            nw = minW
        }
        if (nh < minH) {
            nh = minH
        }
        if ((nw == ow) && (nh == oh)) {
            return false
        }
        w = nw
        h = nh
        return true
    }

    ; The keyboard's move: the arrows, `step` pixels at a time. True when the
    ; window actually went somewhere (a clamp can refuse).
    fn nudge:boolean (dx:double dy:double) {
        if ((this.dragsFreely()) == false) {
            return false
        }
        if (minimized || maximized) {
            return false
        }
        def ox:double x
        def oy:double y
        if ((strlen snapped) > 0) {
            snapped = ""
            w = restW
            h = restH
        }
        this.moveBy(dx dy)
        return ((ox != x) || (oy != y))
    }

    ; --- minimize, maximize, restore, snap ---

    fn saveRest:void () {
        restX = x
        restY = y
        restW = (this.frameW())
        restH = (this.frameH())
    }

    fn startAnim:void (ox:double oy:double ow:double oh:double) {
        fromX = ox
        fromY = oy
        fromW = ow
        fromH = oh
        if (animMs > 0.0) {
            animT = 0.0
        } {
            animT = 1.0
        }
    }

    fn minimize:boolean () {
        if ((open == false) || minimized) {
            return false
        }
        if isModal {
            return false
        }
        minimized = true
        dragging = false
        resizeEdge = ""
        animT = 1.0
        return true
    }

    fn maximize:boolean () {
        if ((open == false) || maximized) {
            return false
        }
        if isModal {
            return false
        }
        def ox:double x
        def oy:double y
        def ow:double (this.frameW())
        def oh:double (this.frameH())
        if ((strlen snapped) == 0) {
            this.saveRest()
        }
        snapped = ""
        minimized = false
        maximized = true
        x = 0.0
        y = 0.0
        w = pageW
        h = pageH
        this.startAnim(ox oy ow oh)
        return true
    }

    ; Back one step: out of the dock first, then out of maximized or snapped.
    fn restore:boolean () {
        if (open == false) {
            return false
        }
        if minimized {
            minimized = false
            return true
        }
        if ((maximized == false) && ((strlen snapped) == 0)) {
            return false
        }
        def ox:double x
        def oy:double y
        def ow:double (this.frameW())
        def oh:double (this.frameH())
        maximized = false
        snapped = ""
        x = restX
        y = restY
        w = restW
        h = restH
        if (w > pageW) {
            w = pageW
        }
        if (h > pageH) {
            h = pageH
        }
        this.moveBy(0.0 0.0)
        this.startAnim(ox oy ow oh)
        return true
    }

    fn toggleMaximize:boolean () {
        if maximized {
            return (this.restore())
        }
        return (this.maximize())
    }

    fn snapGeometry:void (side:string) {
        def half:double ((to_double (to_int (pageW / 2.0))))
        y = 0.0
        h = pageH
        w = half
        if (side == "left") {
            x = 0.0
        } {
            x = (pageW - half)
        }
    }

    ; Fill the left or the right half of the page — what dropping a window on
    ; that edge does. Restoring puts back the size it had before.
    fn snapTo:boolean (side:string) {
        if ((open == false) || isModal) {
            return false
        }
        if ((side != "left") && (side != "right")) {
            return false
        }
        if ((snapped == side) && (maximized == false)) {
            return false
        }
        def ox:double x
        def oy:double y
        def ow:double (this.frameW())
        def oh:double (this.frameH())
        if (((strlen snapped) == 0) && (maximized == false)) {
            this.saveRest()
        }
        maximized = false
        snapped = side
        this.snapGeometry(side)
        this.startAnim(ox oy ow oh)
        return true
    }

    ; Picked up by the title bar while it fills the page (or a half): it comes
    ; back to its own size UNDER THE POINTER, at the same fraction across the
    ; bar — what every desktop does, and the only way a drag of a maximized
    ; window can mean anything. `px` is the pointer, `frac` how far across
    ; the bar it was (0..1).
    fn unsnapUnder:void (px:double frac:double) {
        maximized = false
        snapped = ""
        def nw:double restW
        if (nw > pageW) {
            nw = pageW
        }
        if (nw < minW) {
            nw = minW
        }
        def nh:double restH
        if (nh > pageH) {
            nh = pageH
        }
        if (nh < minH) {
            nh = minH
        }
        w = nw
        h = nh
        x = (px - (frac * nw))
        animT = 1.0
        this.moveBy(0.0 0.0)
    }

    ; --- the clock ---

    fn animating:boolean () {
        return (animT < 1.0)
    }

    ; Returns "" like UiCtl.tickCtl: the animation never moves focus.
    fn tickCtl:string (dtMs:double) {
        if (animT >= 1.0) {
            return ""
        }
        if (animMs <= 0.0) {
            animT = 1.0
            return ""
        }
        animT = (animT + (dtMs / animMs))
        if (animT > 1.0) {
            animT = 1.0
        }
        return ""
    }

    ; ease-out: fast away, gentle arrival.
    fn eased:double () {
        def t:double animT
        if (t >= 1.0) {
            return 1.0
        }
        def u:double (1.0 - t)
        return (1.0 - ((u * u) * u))
    }

    fn shownX:double () {
        return (fromX + ((x - fromX) * (this.eased())))
    }

    fn shownY:double () {
        return (fromY + ((y - fromY) * (this.eased())))
    }

    fn shownW:double () {
        return (fromW + (((this.frameW()) - fromW) * (this.eased())))
    }

    fn shownH:double () {
        return (fromH + (((this.frameH()) - fromH) * (this.eased())))
    }

    ; What a reader is told after a move or a resize, in whole pixels.
    fn placeText:string () {
        return ((to_string (to_int x)) + ", " + (to_string (to_int y)))
    }

    fn sizeText:string () {
        return ((to_string (to_int (this.frameW()))) + " by " + (to_string (to_int (this.frameH()))))
    }

    ; --- what the host and the reader see ------------------------------------------------

    fn tids:[string] () {
        def a:[string]
        push a tid
        push a (this.triggerTid())
        if open {
            if isModal {
                push a (this.scrimTid())
            }
            push a (this.frameTid())
            push a (this.headTid())
            push a (this.barTid())
            push a (this.titleTid())
            if ((strlen description) > 0) {
                push a (this.descTid())
            }
            if hasMinMax {
                push a (this.minTid())
                push a (this.maxTid())
            }
            push a (this.closeTid())
            push a (this.bodyTid())
        }
        return a
    }

    fn isFocusable:boolean (target:string) {
        if disabled {
            return false
        }
        if (target == (this.triggerTid())) {
            return true
        }
        if (open == false) {
            return false
        }
        if (target == (this.closeTid())) {
            return true
        }
        if hasMinMax {
            if ((target == (this.minTid())) || (target == (this.maxTid()))) {
                return true
            }
        }
        ; The bar takes focus only when it is a handle. A modal's bar is a
        ; label, and a tab stop that does nothing is worse than no tab stop.
        ; The title counts as the bar here for the same reason it does in
        ; `isHandle`: it is what a click actually lands on.
        if (this.isHandle(target)) {
            return ((this.barIsLabel()) == false)
        }
        return false
    }

    fn rows:[UiRow] () {
        def out:[UiRow]
        def word:string (this.stateWord())

        def trigRow:UiRow (UiRow.of((this.triggerTid()) (EVGA11yRole.button()) name))
        trigRow.state = word
        trigRow.hasPopup = "dialog"
        trigRow.disabled = disabled
        if open {
            trigRow.expanded = (EVGA11yTri.yes())
        } {
            trigRow.expanded = (EVGA11yTri.no())
        }
        if (disabled == false) {
            trigRow.tabStop = true
            trigRow.focusable = true
        }
        push out trigRow

        if (open == false) {
            return out
        }

        if isModal {
            ; No role, like Radix's overlay: it is a surface, not something a
            ; reader should be offered.
            def scrimRow:UiRow (UiRow.of((this.scrimTid()) (EVGA11yRole.none()) ""))
            scrimRow.state = word
            push out scrimRow
        }

        def frameRow:UiRow (UiRow.of((this.frameTid()) (EVGA11yRole.dialog()) title))
        frameRow.state = word
        ; The one flag that makes a modal modal, as far as a reader is
        ; concerned: UiHost hides everything that is not inside it. A movable
        ; window raises nothing, so the page behind it stays readable — which
        ; is the point of a movable window.
        frameRow.modal = isModal
        push out frameRow

        ; The title bar. A handle is a real control and says so; a modal's bar
        ; is a heading over the dialog it names.
        def barRole:int (EVGA11yRole.none())
        def barName:string ""
        if ((this.barIsLabel()) == false) {
            barRole = (EVGA11yRole.button())
            barName = (title + ", move window")
        }
        def headRow:UiRow (UiRow.of((this.headTid()) (EVGA11yRole.none()) ""))
        headRow.parentTid = (this.frameTid())
        push out headRow

        def barRow:UiRow (UiRow.of((this.barTid()) barRole barName))
        barRow.parentTid = (this.headTid())
        if ((this.barIsLabel()) == false) {
            barRow.focusable = true
            barRow.tabStop = true
            ; What a reader says instead of "button": this one is not pressed,
            ; it is dragged, and "move window" alone would not say that.
            barRow.roleDescription = "draggable"
        }
        push out barRow

        if ((strlen description) > 0) {
            def descRow:UiRow (UiRow.of((this.descTid()) (EVGA11yRole.none()) description))
            descRow.parentTid = (this.frameTid())
            push out descRow
        }

        if hasMinMax {
            def minRow:UiRow (UiRow.of((this.minTid()) (EVGA11yRole.button()) "Minimize"))
            minRow.parentTid = (this.headTid())
            minRow.focusable = true
            minRow.tabStop = true
            push out minRow
            def maxRow:UiRow (UiRow.of((this.maxTid()) (EVGA11yRole.button()) (this.maxLabel())))
            maxRow.parentTid = (this.headTid())
            maxRow.focusable = true
            maxRow.tabStop = true
            push out maxRow
        }
        def closeRow:UiRow (UiRow.of((this.closeTid()) (EVGA11yRole.button()) closeLabel))
        closeRow.parentTid = (this.headTid())
        closeRow.focusable = true
        closeRow.tabStop = true
        push out closeRow

        ; The body is a container and nothing else. What is IN it belongs to
        ; whoever composed it — a controller with its own rows, or a tree the
        ; page walks with EVGA11yFromTree — and this deliberately does not
        ; invent nodes for children it does not own.
        def bodyRow:UiRow (UiRow.of((this.bodyTid()) (EVGA11yRole.none()) ""))
        bodyRow.parentTid = (this.frameTid())
        push out bodyRow

        return out
    }
}
