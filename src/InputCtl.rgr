; SPDX-License-Identifier: AGPL-3.0-or-later

; =============================================================================
; InputCtl — measured against a real <input type="text">
; =============================================================================
; The hardest component in this gallery and the one with the easiest oracle.
; Everything a text field does is observable from the DOM without a bespoke
; capture: `value`, `selectionStart` and `selectionEnd` are properties of the
; element, so a spec that types and arrows around is ordinary conformance.
;
; Which is the whole reason `value`, `selstart` and `selend` had to join the
; observed fields BEFORE this file existed. A trace that carries none of them
; sees a text field type "hello" and reports the same node it reported when the
; box was empty: role textbox, named, focused, one tab stop. Every keystroke in
; this file is invisible without those three, and the slider taught that lesson
; once already.
;
; Caret geometry needs no new metric. `EVGTextEngine.measureRun(text, family,
; size)` measures a whole string, so the caret's x for index i is
; `measureRun(value[0..i])` — exact by construction, because it is the same
; measurement the painter will use. A click maps back the other way by
; bisecting over prefix widths: O(log n) measurements and no per-glyph advance
; table to keep in step with the font.
;
; INDEXES ARE UTF-16 CODE UNITS, because that is what `selectionStart` counts
; and parity is the point. On the JS backend `charAt` and `substring` agree
; with that; on the C++ backend they count BYTES.
;
; That used to be an assertion in this comment and is now a measurement —
; `ui:offset:check` compiles the same source to both backends and diffs them:
;
;   strlen   "abc" 3 / 3     "héllo" 5 / 6     "aä" 2 / 3     "a<emoji>b" 4 / 6
;   charAt   JS gives UTF-16 units, surrogate halves and all;
;            C++ gives raw UTF-8 bytes.
;
; Within ONE backend the indices are self-consistent, so most of this class is
; fine either way. The divergence bites at exactly two seams, and it is worth
; naming them rather than saying "non-ASCII breaks":
;
;   `selStart`/`selEnd` are pinned to UTF-16 by the DOM and by the harness
;   that compares against a real <input>; on a native host they would mean
;   bytes and the same number would name a different place.
;
;   `caretXAt(i)` measures `substring(0 i)`. On C++, `caret - 1` after a
;   Backspace can land INSIDE a multi-byte character — measured:
;   `substring(0 2)` of "aä" is "a" plus one orphaned continuation byte — and
;   the width of a broken string is not the width of anything.
;
; Stated rather than solved, deliberately. The web host's backend is
; JavaScript, which is already UTF-16, and since the text bridge landed the
; browser owns grapheme deletion anyway; a conversion layer here would be
; untested code for a host that does not exist yet. The gate is so that the
; day one does, this is a known quantity rather than a comment somebody wrote.
;
; Parity contract (see conformance/SPEC.md):
;   root      role textbox, named by its label, the tab stop, and where value,
;             selstart and selend live.
;   password  the VALUE is the text and the GLYPHS are bullets. Those two are
;             never the same string: `value` is what the trace reports and
;             `glyphText` is what gets drawn, and nothing joins them.
;   keys      printable characters insert; Backspace and Delete remove;
;             Arrows move; Shift+Arrow extends; Home/End; Ctrl+A selects all;
;             Ctrl+Arrow moves by word.
;   pointer   a press puts the caret where it lands, Shift+press extends,
;             a drag selects, a double-click takes a word (and a drag after
;             it extends by words), a triple-click takes all of it.
;
; THE FIELD DRAWS ITS OWN CARET AND SELECTION. `build` makes the whole field:
; a clipping view with the selection band, the text and the caret in it, and
; the clear button beside the view. After the page is laid out the host calls
; `placeText(eng)` (UiHost does it for every control), and the field reads
; what layout and the stylesheet decided — the view's width, the run's own
; font, size and letter spacing, where the run starts — and places the band
; and the caret from that, scrolled so the caret is in view. Nothing about the
; geometry is the host's to supply or to get wrong: a host used to set the
; font and the box width by hand and draw the caret itself, and every one of
; them drifted from what was painted in a different way (a caret with no
; width, a band 16px short of the text because the "box width" was 80).
;
; Explicitly NOT in scope, each a real thing being declined: IME composition,
; RTL and bidi caret movement, the clipboard itself (`selectedText` is
; what the host puts on it), an undo stack, spellcheck,
; autofill.
; =============================================================================

Import "UiCtl.rgr"
Import "UiTree.rgr"
Import "pkg:evg/EVGElement.rgr"
Import "pkg:evg/EVGA11yTree.rgr"
Import "pkg:evg/EVGTextEngine.rgr"
Import "UiWords.rgr"
Import "UiTextSel.rgr"

class InputCtl extends UiCtl {
    ; What the field holds. For a password this is the TEXT, never the bullets.
    def value:string ""
    ; Drawn when the value is empty. Drawn text, not a value: it must never
    ; reach `value` and it must never be what the trace reports.
    def placeholder:string ""
    ; "text" | "password" | "email" | "search" | "number". Only "password"
    ; changes behaviour here; the rest are for the trace and the demo.
    def kind:string "text"
    def readOnly:boolean false
    def required:boolean false
    def invalid:boolean false
    ; 0 means no limit, matching `maxlength`'s absence rather than a made-up
    ; ceiling.
    def maxLength:int 0
    ; A clear button (×) at the end of the box while it holds text, as a
    ; search field has. Off unless asked for: the conformance specs compare
    ; against a plain <input type="text">, which has none. A press on it
    ; empties the field (`textPointerDown`, or `isClearHit` then
    ; `clearValue` for a host that routes presses itself). It is not a tab
    ; stop and not a row of its own, like the clear button of a native
    ; search field: Ctrl+A and Backspace empty the field from the keyboard.
    def clearable:boolean false
    def clearLabel:string "Clear"

    ; The caret, and the other end of the selection. `selstart`/`selend` are
    ; DERIVED from these two and never stored, because storing both a caret and
    ; a start/end pair means two places to be wrong about which end is moving —
    ; and which end is moving is exactly what Shift+Arrow needs to know.
    def caret:int 0
    def anchor:int 0

    ; Painting. The box's inner width and the run's font, which the host sets
    ; from the resolved style so the measurement and the drawing agree.
    def boxWidth:double 180.0
    def fontFamily:string "Arial"
    def fontSize:double 14.0
    ; How far the text is scrolled left inside the box, once it is wider than
    ; the box. Kept here rather than derived, because it is history: where the
    ; text sits depends on where the caret has BEEN, not only where it is.
    def scrollX:double 0.0

    def letterSpacing:double 0.0

    ; Whether the field has the keyboard: only then are the caret and the
    ; selection drawn. UiHost keeps it through onFocus/onBlur; a host that
    ; owns focus itself sets it.
    def focused:boolean false
    ; The host's own classes for the box (space-separated), kept by every
    ; build: a field rebuilds itself on each key, and a class added to the
    ; root from outside would be gone after the first one.
    def boxClass:string ""
    ; A class of the host's on the text run as well as `ui-input-text`, so a
    ; theme can colour this field's text (a dark search line) on its own.
    def textClass:string ""
    ; The host's class on the run while it shows the placeholder, in place of
    ; `textClass`. Not both: a theme writes the field's text colour on
    ; `textClass`, and with both on the run that colour won over
    ; `.ui-input-placeholder` wherever the sheet declared it later — the hint
    ; read as text already typed. A host whose text class sets the size gives
    ; this class the same size, so the run does not jump on the first key.
    def placeholderClass:string ""
    ; The placeholder goes when the field takes the keyboard, so focusing an
    ; empty field visibly changes it and the caret stands alone at the start.
    ; A field that always has the keys (a picker's search line) turns this off,
    ; or its placeholder would never show.
    def placeholderHidesOnFocus:boolean true
    ; The caret's width when the stylesheet gives `.ui-input-caret` none.
    def caretWidth:double 2.0
    ; The caret took the text's colour because the sheet gave it none
    ; (`caret-color: auto`). Remembered so the next build hands the caret back
    ; to the sheet unpainted, and a theme change re-tints it.
    def caretFromText:boolean false

    ; A field that wraps, as a <textarea> does: long text breaks onto more
    ; lines and the box grows by a line at a time up to `maxLines`, then
    ; scrolls so the caret's line stays in view. Enter (or Shift+Enter, where
    ; a host keeps Enter for itself) puts in a line break; ArrowUp/ArrowDown
    ; go between lines, Home/End to the ends of the caret's line.
    def multiline:boolean false
    def maxLines:int 5
    ; Where the lines were laid out (the last `placeText`), and what the box's
    ; growth is worked out from: the box's height with one line, a line's
    ; height, the width the run breaks at, and how many lines the box was
    ; last sized for.
    def placed@(optional):UiTextLines
    def oneLineHeight:double 0.0
    def lineBox:double 0.0
    def wrapW:double 0.0
    def sizedLines:int 1
    ; How far the lines are scrolled up, once there are more than the box
    ; shows. History, like `scrollX`.
    def scrollY:double 0.0
    ; The y of the last press, for a host that drags with x alone.
    def lastY:double 0.0

    ; What the last `placeText` found: the engine the page was measured with
    ; and the page x where the text run starts unscrolled. The pointer maps
    ; through both, so a press measures against the run that is on screen.
    def measuredBy@(optional):EVGTextEngine
    def textX:double 0.0

    ; A drag after a press: 0 by characters, 1 by words (after a double
    ; click), 2 the whole text (after a triple click). The word the double
    ; click took is [dragFrom, dragTo).
    def dragging:boolean false
    def dragUnit:int 0
    def dragFrom:int 0
    def dragTo:int 0

    def viewEl:EVGElement
    def selEl:EVGElement
    def textEl:EVGElement
    def caretEl:EVGElement
    def clearEl:EVGElement
    ; a selection over several lines is a band per line: the first, the
    ; whole lines between as one block, the last
    def selEl1:EVGElement
    def selEl2:EVGElement

    Constructor () {
        rootEl = (EVGElement.createDiv())
        viewEl = (EVGElement.createDiv())
        selEl = (EVGElement.createDiv())
        textEl = (EVGElement.createDiv())
        caretEl = (EVGElement.createDiv())
        clearEl = (EVGElement.createDiv())
        selEl1 = (EVGElement.createDiv())
        selEl2 = (EVGElement.createDiv())
    }

    ; --- names ----------------------------------------------------------------

    fn textTid:string () {
        return (tid + "-text")
    }

    fn caretTid:string () {
        return (tid + "-caret")
    }

    fn clearTid:string () {
        return (tid + "-clear")
    }

    fn viewTid:string () {
        return (tid + "-view")
    }

    fn selTid:string () {
        return (tid + "-sel")
    }

    ; --- the clear button -----------------------------------------------------

    ; Shown while there is something to clear and the field may be changed.
    fn showsClear:boolean () {
        if (clearable == false) {
            return false
        }
        if (disabled || readOnly) {
            return false
        }
        return ((strlen value) > 0)
    }

    fn isClearHit:boolean (hit:string) {
        if (hit != (this.clearTid())) {
            return false
        }
        return (this.showsClear())
    }

    ; The field emptied, the caret at its start.
    fn clearValue:void () {
        value = ""
        caret = 0
        anchor = 0
        scrollX = 0.0
        this.build()
    }

    ; --- the selection --------------------------------------------------------

    fn length:int () {
        return (strlen value)
    }

    fn selStart:int () {
        if (anchor < caret) {
            return anchor
        }
        return caret
    }

    fn selEnd:int () {
        if (anchor < caret) {
            return caret
        }
        return anchor
    }

    fn hasSelection:boolean () {
        return (anchor != caret)
    }

    fn clamp:int (i:int) {
        if (i < 0) {
            return 0
        }
        def n:int (strlen value)
        if (i > n) {
            return n
        }
        return i
    }

    ; Move the caret, and take the anchor with it unless the move is extending
    ; a selection. One place decides that, so Shift+Arrow and plain Arrow
    ; cannot drift apart.
    fn moveTo:void (i:int extend:boolean) {
        ; A READONLY field has no caret to move, and that is measured rather
        ; than assumed. `input_readonly` focuses a readonly <input readonly>
        ; holding "RO-42" and presses Home, then ArrowRight: Chromium reports
        ; selectionStart 5 throughout — the same value length an UNFOCUSED
        ; input reports, which is what a field with no selection hands back.
        ; Focus alone does not give a readonly field a caret, so there is
        ; nothing for a key to move.
        ;
        ; Scoped to what was measured, which is the KEYBOARD. The pointer is
        ; the other half and it is measured now, in `input-bench.mjs` against
        ; a readonly <input readonly> on the page: a click at 44px puts the
        ; caret at 7, a drag selects [4,10], Ctrl+A selects everything, and
        ; Home afterwards leaves the caret at 7. So a readonly field HAS a
        ; caret once a pointer has given it one; what it has not got is a key
        ; that moves it. `placeCaret` is the pointer's door and does not ask.
        if readOnly {
            return
        }
        this.placeCaret(i extend)
    }

    ; The pointer's caret. A press, a drag and a Shift+click come through here
    ; and land whether or not the field is readonly — see `moveTo`.
    fn placeCaret:void (i:int extend:boolean) {
        caret = (this.clamp(i))
        if (extend == false) {
            anchor = caret
        }
    }

    ; Readonly included: Chromium selects all of a readonly field on Ctrl+A,
    ; measured on the invoice number — the selection is the reader's, only the
    ; text is not theirs to change.
    fn selectAll:void () {
        anchor = 0
        caret = (strlen value)
    }

    ; --- editing --------------------------------------------------------------

    fn setValue:void (v:string) {
        value = v
        caret = (this.clamp(caret))
        anchor = (this.clamp(anchor))
    }

    ; The whole state at once, from a platform text-input session.
    ;
    ; This is the door the web bridge comes through, and it is deliberately
    ; the widest one in the class: a native `<input>` has ALREADY done the
    ; edit by the time we hear about it — `beforeinput` carries the old value
    ; and `input` the new one, measured — so there is nothing to replay and
    ; no inputType to interpret. Value, anchor and caret, wholesale.
    ;
    ; Which is the point. Everything the field cannot do by hand — IME, dead
    ; keys, the clipboard, undo, emoji that are four code units wide, a
    ; phone keyboard that sends no per-character keydown — arrives through
    ; here as a value that is simply different, and needs no case of its own.
    ;
    ; `anchor` first and `caret` second, both clamped: a session that reports
    ; a selection out of range (it should not, but a mirror that trusts an
    ; external number without checking is a crash waiting for an off-by-one)
    ; collapses to something drawable rather than indexing past the string.
    ; The FILTER still applies. A session reports what the platform allowed,
    ; and the platform does not know that this field is a number: `inputmode`
    ; is a keyboard hint on a phone and nothing at all on a desktop keyboard,
    ; and `type=number` cannot be used for the proxy because such an input
    ; reports `selectionStart` as null and the mirror needs it.
    ;
    ; So the model still refuses what the field will not hold, and the caller
    ; pushes the corrected value back into the session. Wiring the bridge
    ; without this quietly undid the number field's filter — every edit went
    ; round `insertText`, where the filter lives, so "Amount" took letters
    ; again.
    fn applyEdit:void (v:string selStart:int selEnd:int) {
        ; A readonly field takes the SELECTION and not the value. A readonly
        ; <input readonly> still selects — Ctrl+A, a drag, a double-click —
        ; and the session reports each one through here; refusing the whole
        ; report because the field is readonly left Ctrl+A drawn as nothing
        ; while the browser had the field selected end to end. Measured on the
        ; invoice number: Ctrl+A reads [0,13] there and read [7,7] here.
        if readOnly {
            anchor = (this.clamp(selStart))
            caret = (this.clamp(selEnd))
            return
        }
        def kept:string (this.filterText(v))
        def a:int (this.clamp(selStart))
        def b:int (this.clamp(selEnd))
        if (kept != v) {
            ; Something was refused. The caret cannot stay where the platform
            ; put it — that index counts characters that are not there — so it
            ; goes to the end of what was kept, which is where a person's next
            ; keystroke should land.
            value = kept
            anchor = (strlen kept)
            caret = (strlen kept)
            return
        }
        value = v
        anchor = (this.clamp(selStart))
        caret = (this.clamp(selEnd))
    }

    ; Replace the selection with `t`, or insert it at the caret when there is
    ; none. Every edit goes through here — Backspace and Delete included, by
    ; first making a one-character selection — so there is one place where a
    ; value is spliced and one place where the caret lands afterwards.
    ; --- what this kind of field will take ------------------------------------
    ;
    ; `kind` was set on three of the demo's fields and read in exactly one
    ; place: to decide whether to draw dots instead of letters. So a field
    ; declared `number` accepted "hello" — the kind described how the value is
    ; SHOWN and had no bearing on what it could hold, which is half of what the
    ; word means on a real input.
    ;
    ; The filter is per character and deliberately narrow. A number field takes
    ; digits, a leading minus, and one decimal separator — dot or comma,
    ; because a European keyboard offers the comma and a person typing an
    ; amount will use it. It does NOT try to parse: "1..2" and "--3" are
    ; refused character by character, but "1.2.3" typed out of order is the
    ; caller's business to validate, and validation is a different job from
    ; keeping letters out of a numeric box.
    ;
    ; Everything that is not a `number` accepts everything, including
    ; `password`: a password with a digits-only rule would be a worse password.
    fn acceptsChar:boolean (ch:string) {
        if (kind != "number") {
            return true
        }
        if ((strlen ch) != 1) {
            return true
        }
        def c:int (charAt ch 0)
        if ((c >= 48) && (c <= 57)) {
            return true
        }
        ; A minus, but only at the very front and only once.
        if (c == 45) {
            if ((this.selStart()) > 0) {
                return false
            }
            return ((indexOf value "-") < 0)
        }
        ; One separator, in either spelling.
        if ((c == 46) || (c == 44)) {
            if ((indexOf value ".") >= 0) {
                return false
            }
            return ((indexOf value ",") < 0)
        }
        return false
    }

    ; Whether `ch` may follow `sofar` in a number being assembled from scratch.
    ;
    ; The same three rules as `acceptsChar`, asked of the string BEING BUILT
    ; rather than of the field's current value. That distinction is the
    ; whole of `filterText`: a session hands over the entire new value, and
    ; "does the value already hold a separator" is the wrong question when
    ; the value being examined IS the one that holds it. Measured on the
    ; invoice's Amount: the moment the field was focused the session echoed
    ; "1250.00" back, the filter saw a dot in the current value and refused
    ; the dot in the new one, and the amount read "125000" without a key
    ; having been pressed.
    fn acceptsCharIn:boolean (ch:string sofar:string) {
        if (kind != "number") {
            return true
        }
        if ((strlen ch) != 1) {
            return true
        }
        def c:int (charAt ch 0)
        if ((c >= 48) && (c <= 57)) {
            return true
        }
        if (c == 45) {
            return ((strlen sofar) == 0)
        }
        if ((c == 46) || (c == 44)) {
            if ((indexOf sofar ".") >= 0) {
                return false
            }
            return ((indexOf sofar ",") < 0)
        }
        return false
    }

    ; The part of a string this field will take, character by character.
    fn filterText:string (t:string) {
        if (kind != "number") {
            return t
        }
        def out:string ""
        def i:int 0
        while (i < (strlen t)) {
            def ch:string (substring t i (i + 1))
            if (this.acceptsCharIn(ch out)) {
                out = (out + ch)
            }
            i = (i + 1)
        }
        return out
    }

    fn insertText:void (t:string) {
        if disabled {
            return
        }
        if readOnly {
            return
        }
        def s:int (this.selStart())
        def e:int (this.selEnd())
        def head:string (substring value 0 s)
        def tail:string (substring value e (strlen value))
        def add:string (this.filterText(t))
        ; `maxlength` counts the WHOLE value, not the insertion, so a paste
        ; into a nearly-full field is truncated to what still fits rather than
        ; rejected outright — which is what the platform does.
        if (maxLength > 0) {
            def room:int ((maxLength - (strlen head)) - (strlen tail))
            if (room <= 0) {
                add = ""
            } {
                if ((strlen add) > room) {
                    add = (substring add 0 room)
                }
            }
        }
        value = ((head + add) + tail)
        caret = (s + (strlen add))
        anchor = caret
    }

    fn deleteRange:void (s:int e:int) {
        if disabled {
            return
        }
        if readOnly {
            return
        }
        def a:int (this.clamp(s))
        def b:int (this.clamp(e))
        if (a >= b) {
            return
        }
        def head:string (substring value 0 a)
        def tail:string (substring value b (strlen value))
        value = (head + tail)
        caret = a
        anchor = a
    }

    fn backspace:void () {
        if (this.hasSelection()) {
            this.deleteRange((this.selStart()) (this.selEnd()))
            return
        }
        if (caret > 0) {
            this.deleteRange((this.prevStop(caret)) caret)
        }
    }

    fn deleteForward:void () {
        if (this.hasSelection()) {
            this.deleteRange((this.selStart()) (this.selEnd()))
            return
        }
        this.deleteRange(caret (this.nextStop(caret)))
    }

    ; --- characters, words and numbers ----------------------------------------
    ; The rules are UiWords' (shared with TextCtl, and measured against
    ; Chromium there); these ask them about `value`.

    fn stops:[int] () {
        return (UiWords.stops(value))
    }

    fn prevStop:int (i:int) {
        return (UiWords.prevStop(value i))
    }

    fn nextStop:int (i:int) {
        return (UiWords.nextStop(value i))
    }

    fn snapStop:int (i:int) {
        return (UiWords.snapStop(value i))
    }

    sfn classOf:int (c:int) {
        return (UiWords.classOf(c))
    }

    fn classAt:int (i:int) {
        return (UiWords.classAt(value i))
    }

    fn isSpaceAt:boolean (i:int) {
        return ((this.classAt(i)) == 0)
    }

    fn wordLeft:int (from:int) {
        return (UiWords.wordLeft(value from))
    }

    fn wordRight:int (from:int) {
        return (UiWords.wordRight(value from))
    }

    fn wordStartAt:int (i:int) {
        return (UiWords.wordStartAt(value i))
    }

    fn wordEndAt:int (i:int) {
        return (UiWords.wordEndAt(value i))
    }

    ; Double-click. The anchor goes to the run's start and the caret to its
    ; end, so a following Shift+Arrow extends from the far end the way it does
    ; in a browser.
    ; No `ensureCaretVisible` here: that one needs a text engine, and a
    ; selection rule should not have to be handed a measurer to answer a
    ; question about indices. The caller scrolls, because the caller is the
    ; one that already has the engine in its hand.
    fn selectWordAt:void (i:int) {
        anchor = (UiWords.wordFrom(value i))
        caret = (UiWords.wordTo(value i))
    }

    ; --- geometry -------------------------------------------------------------

    ; What gets DRAWN. Never `value` for a password, and the two are separate
    ; methods so that no caller can reach for the wrong one by accident.
    fn glyphText:string () {
        if (kind != "password") {
            return value
        }
        def out:string ""
        def i:int 0
        def n:int (strlen value)
        while (i < n) {
            out = (out + "•")
            i = (i + 1)
        }
        return out
    }

    ; Whether the box is showing the placeholder rather than a value. Its own
    ; method because three callers need the same answer and one of them is the
    ; colour.
    fn showsPlaceholder:boolean () {
        if ((strlen value) > 0) {
            return false
        }
        if (focused && placeholderHidesOnFocus) {
            return false
        }
        return ((strlen placeholder) > 0)
    }

    ; The caret's x, measured from the left of the text run — the same
    ; measurement the painter will make of the same string, which is why this
    ; cannot drift from what is drawn.
    fn caretXAt:double (eng:EVGTextEngine i:int) {
        def g:string (this.glyphText())
        def k:int i
        if (k < 0) { k = 0 }
        if (k > (strlen g)) { k = (strlen g) }
        if (k == 0) {
            return 0.0
        }
        def head:string (substring g 0 k)
        def m:EVGTextMetrics (eng.measureRunSpaced(head fontFamily fontSize letterSpacing))
        return m.width
    }

    fn textWidth:double (eng:EVGTextEngine) {
        return (this.caretXAt(eng (strlen (this.glyphText()))))
    }

    ; The index a click at `x` lands on, x measured from the left of the text
    ; run. Bisect over prefix widths — the widths are monotonic, so the last
    ; index whose prefix still fits is found in log n measurements — then take
    ; whichever of that index and the next one is NEARER, because a click on
    ; the right half of a character puts the caret after it.
    ; Which character a POINTER landed on, given the field's own box.
    ;
    ; This lives here rather than in each demo because it had been written
    ; twice already, with the box's left inset spelled as the literal `10.0`
    ; in both — a second source of truth for a number the stylesheet owns. A
    ; padding change in CSS would have moved the caret away from the pointer
    ; and nothing would have said so. The resolved border and padding are on
    ; the element after layout, so they are read rather than remembered.
    ;
    ; And the text does not always start at the inset. A prefix ("€") or a
    ; leading icon ("◷") is a sibling laid out before the run, so the run
    ; begins after it — the demos already position the caret and the band
    ; from that `lead`, and the click did not: on Amount a press three
    ; characters in landed six characters in, and on Dismissal Time the
    ; caret sat a clock's width to the right of the pointer. The run the
    ; painter drew carries the answer, so when the box holds one it is read
    ; from there rather than re-derived from the stylesheet plus whatever
    ; happens to sit in front.
    sfn indexAtPageX:int (eng:EVGTextEngine c:InputCtl box:EVGElement px:double) {
        def inset:double (box.box.borderWidthPx + box.box.paddingLeftPx)
        def origin:double ((box.calculatedX) + inset)
        def runId:string (c.tid + "-text")
        def i:int 0
        while (i < (box.getChildCount())) {
            def ch:EVGElement (box.getChild(i))
            if (ch.id == runId) {
                origin = ch.calculatedX
            }
            i = (i + 1)
        }
        def inner:double (px - origin)
        return (c.indexAtX(eng (inner + c.scrollX)))
    }

    fn indexAtX:int (eng:EVGTextEngine x:double) {
        def n:int (strlen (this.glyphText()))
        if (n == 0) {
            return 0
        }
        def lo:int 0
        def hi:int n
        while (lo < hi) {
            def mid:int (idiv ((lo + hi) + 1) 2)
            if ((this.caretXAt(eng mid)) <= x) {
                lo = mid
            } {
                hi = (mid - 1)
            }
        }
        if (lo >= n) {
            return n
        }
        def here:double (this.caretXAt(eng lo))
        def next:double (this.caretXAt(eng (lo + 1)))
        if ((x - here) > (next - x)) {
            return (lo + 1)
        }
        return lo
    }

    ; Keep the caret in view. NOT "centre it": a browser scrolls the minimum
    ; that brings the caret back inside the box, so text typed to the end stays
    ; pinned at the right edge and arrowing back left reveals one character at a
    ; time rather than jumping the run about.
    fn ensureCaretVisible:void (eng:EVGTextEngine) {
        def cx:double (this.caretXAt(eng caret))
        if ((cx - scrollX) < 0.0) {
            scrollX = cx
        }
        if ((cx - scrollX) > boxWidth) {
            scrollX = (cx - boxWidth)
        }
        ; And never past either end: a short value is never scrolled at all,
        ; whatever the caret did before it was deleted.
        def total:double (this.textWidth(eng))
        def maxScroll:double (total - boxWidth)
        if (maxScroll < 0.0) {
            maxScroll = 0.0
        }
        if (scrollX > maxScroll) {
            scrollX = maxScroll
        }
        if (scrollX < 0.0) {
            scrollX = 0.0
        }
    }

    ; --- input ----------------------------------------------------------------

    ; One printable character, or one whole typed string. The harness's `type`
    ; step feeds characters one at a time so that the trace has a row per
    ; keystroke, which is the only way a caret bug is visible at the keystroke
    ; that caused it rather than at the end of the word.
    fn typeChar:boolean (target:string ch:string) {
        if (target != tid) {
            return false
        }
        if disabled {
            return false
        }
        if readOnly {
            return false
        }
        this.insertText(ch)
        this.build()
        return true
    }

    fn keyDownWith:string (target:string key:string shift:boolean ctrl:boolean) {
        if disabled {
            return ""
        }
        if (target != tid) {
            return ""
        }

        if (key == "ArrowLeft") {
            if ctrl {
                this.moveTo((this.wordLeft(caret)) shift)
            } {
                ; A plain ArrowLeft with a selection COLLAPSES it to the left
                ; end rather than moving the caret one further. Different from
                ; Shift+ArrowLeft, which extends, and the difference is only
                ; visible once `selstart` and `selend` are both in the trace.
                if ((shift == false) && (this.hasSelection())) {
                    this.moveTo((this.selStart()) false)
                } {
                    this.moveTo((this.prevStop(caret)) shift)
                }
            }
            this.build()
            return ""
        }
        if (key == "ArrowRight") {
            if ctrl {
                this.moveTo((this.wordRight(caret)) shift)
            } {
                if ((shift == false) && (this.hasSelection())) {
                    this.moveTo((this.selEnd()) false)
                } {
                    this.moveTo((this.nextStop(caret)) shift)
                }
            }
            this.build()
            return ""
        }
        if multiline {
            if ((key == "ArrowUp") || (key == "ArrowDown")) {
                this.moveTo((this.lineStep(caret (? (key == "ArrowUp") -1 1))) shift)
                this.build()
                return ""
            }
            if (((key == "Home") || (key == "End")) && (ctrl == false)) {
                this.moveTo((this.lineEdge(caret (key == "End"))) shift)
                this.build()
                return ""
            }
            if (key == "Enter") {
                if (readOnly == false) {
                    this.insertText("\n")
                    this.build()
                }
                return ""
            }
        }
        if (key == "Home") {
            this.moveTo(0 shift)
            this.build()
            return ""
        }
        if (key == "End") {
            this.moveTo((strlen value) shift)
            this.build()
            return ""
        }
        if (key == "Backspace") {
            this.backspace()
            this.build()
            return ""
        }
        if (key == "Delete") {
            this.deleteForward()
            this.build()
            return ""
        }
        if (key == "a") {
            if ctrl {
                this.selectAll()
                this.build()
                return ""
            }
        }
        ; Anything else that is exactly one character is a printable key.
        ; Ctrl-modified keys are not: Ctrl+B is a command this field does not
        ; have, not the letter b.
        if (ctrl == false) {
            if ((strlen key) == 1) {
                this.insertText(key)
                this.build()
                return ""
            }
        }
        return ""
    }

    ; --- pointer --------------------------------------------------------------

    ; A press inside the box puts the caret where it landed, measured against
    ; the same run the painter draws and offset by the scroll — which is why
    ; the caller passes an x relative to the TEXT's left edge and not to the
    ; field's.
    fn pressAt:void (eng:EVGTextEngine x:double extend:boolean) {
        if disabled {
            return
        }
        this.placeCaret((this.indexAtX(eng (x + scrollX))) extend)
        this.ensureCaretVisible(eng)
        this.build()
    }

    ; --- the pointer, on the page ---------------------------------------------
    ; What a host with a real pointer calls: page x, the click count the page
    ; counted (1, 2, 3) and Shift. Measured against the run as `placeText`
    ; last placed it.

    ; The character a page x lands on.
    fn indexAtPage:int (px:double) {
        if (null? measuredBy) {
            return caret
        }
        def e:EVGTextEngine (unwrap measuredBy)
        def at:int (this.indexAtX(e ((px - textX) + scrollX)))
        ; never inside an emoji or a letter with its marks
        return (this.snapStop(at))
    }

    ; The character a page point lands on: in a wrapping field the line `py`
    ; is level with, else the one line.
    fn indexAtPoint:int (px:double py:double) {
        if multiline {
            if (!null? placed) {
                def p:UiTextLines (unwrap placed)
                if ((p.count()) > 0) {
                    return (this.snapStop((p.indexAt(px py))))
                }
            }
        }
        return (this.indexAtPage(px))
    }

    fn pointerDown:void (px:double clicks:int shift:boolean) {
        if disabled {
            return
        }
        def at:int (this.indexAtPoint(px lastY))
        dragging = true
        if (clicks >= 3) {
            this.selectAll()
            dragUnit = 2
            return
        }
        if ((clicks == 2) && (shift == false)) {
            this.selectWordAt(at)
            dragUnit = 1
            dragFrom = (this.selStart())
            dragTo = (this.selEnd())
            return
        }
        dragUnit = 0
        this.placeCaret(at shift)
    }

    ; The pointer moved with the button down: the caret follows it and the
    ; anchor stays. After a double click the selection grows by whole words,
    ; always keeping the word that was clicked.
    fn pointerDrag:void (px:double) {
        if (dragging == false) {
            return
        }
        if (dragUnit == 2) {
            return
        }
        def at:int (this.indexAtPoint(px lastY))
        if (dragUnit == 0) {
            this.placeCaret(at true)
            return
        }
        this.selectWordAt(at)
        def a:int (this.selStart())
        def b:int (this.selEnd())
        if (a < dragFrom) {
            anchor = dragTo
            caret = a
        } {
            anchor = dragFrom
            caret = b
            if (caret < dragTo) {
                caret = dragTo
            }
        }
    }

    fn pointerUp:void () {
        dragging = false
    }

    ; --- lines (a wrapping field) ----------------------------------------------

    ; The index on the line above (-1) or below (1) `i`, under the same x;
    ; past the first line the start, past the last the end, as a <textarea>.
    fn lineStep:int (i:int dir:int) {
        if (null? placed) {
            return (? (dir < 0) 0 (strlen value))
        }
        def p:UiTextLines (unwrap placed)
        def n:int (p.count())
        def li:int (p.lineOf(i))
        def to:int (li + dir)
        if ((n == 0) || (to < 0)) {
            return 0
        }
        if (to >= n) {
            return (strlen value)
        }
        def ln:UiTextLine (itemAt p.lines to)
        return (this.snapStop((p.indexAt((p.xAt(i)) (ln.y + (ln.h / 2.0))))))
    }

    ; The start or the end of the line `i` is on.
    fn lineEdge:int (i:int toEnd:boolean) {
        if (null? placed) {
            return (? toEnd (strlen value) 0)
        }
        def p:UiTextLines (unwrap placed)
        if ((p.count()) == 0) {
            return 0
        }
        def ln:UiTextLine (itemAt p.lines (p.lineOf(i)))
        return (? toEnd ln.end ln.start)
    }

    ; How many lines the value breaks into at the width the run had, with the
    ; engine it was measured with; 1 before the first layout.
    fn wrapCount:int () {
        if (null? measuredBy) {
            return 1
        }
        if (wrapW <= 0.0) {
            return 1
        }
        def t:string (this.glyphText())
        if (this.showsPlaceholder()) {
            t = placeholder
        }
        if ((strlen t) == 0) {
            return 1
        }
        def e:EVGTextEngine (unwrap measuredBy)
        def n:int (array_length (e.breakLinesSpaced(t fontFamily fontSize wrapW letterSpacing)))
        if (n < 1) {
            return 1
        }
        return n
    }

    fn hideBand:void (b:EVGElement) {
        b.calculatedWidth = 0.0
        b.calculatedHeight = 0.0
    }

    fn putBand:void (b:EVGElement r:UiTextRect) {
        b.calculatedX = r.x
        b.calculatedY = r.y
        b.calculatedWidth = r.w
        b.calculatedHeight = r.h
    }

    ; `placeText` for a wrapping field: learn the box's one-line height, scroll
    ; the caret's line into view once there are more lines than the box
    ; shows, then the caret and the bands from the laid-out lines.
    fn placeLines:void (e:EVGTextEngine cw:double) {
        def root:EVGElement (unwrap rootEl)
        def view:EVGElement (unwrap viewEl)
        def txt:EVGElement (unwrap textEl)
        def car:EVGElement (unwrap caretEl)
        def b0:EVGElement (unwrap selEl)
        def b1:EVGElement (unwrap selEl1)
        def b2:EVGElement (unwrap selEl2)
        this.hideBand(b0)
        this.hideBand(b1)
        this.hideBand(b2)
        car.calculatedWidth = 0.0
        def lb:double (txt.lineBoxFor(fontSize (e.lineHeightFor(fontFamily fontSize))))
        if (lb <= 0.0) {
            lb = (fontSize * 1.2)
        }
        lineBox = lb
        wrapW = (txt.wrapWidth((txt.box.getInnerWidth(txt.calculatedWidth))))
        ; the sheet's height, read while the box holds one line
        if ((sizedLines <= 1) || (oneLineHeight <= 0.0)) {
            oneLineHeight = (root.calculatedHeight - ((to_double (sizedLines - 1)) * lb))
        }
        textX = txt.calculatedX
        def p:UiTextLines (UiTextLines.of(e txt))
        def n:int (p.count())
        def shown:int sizedLines
        if (shown < 1) {
            shown = 1
        }
        if (n > shown) {
            ; more lines than the box: the run from the top of the shown
            ; lines, scrolled so the caret's line is in them
            def room:double ((to_double shown) * lb)
            def top:double (view.calculatedY + ((view.calculatedHeight - room) / 2.0))
            def ct:double ((to_double (p.lineOf(caret))) * lb)
            if ((ct - scrollY) < 0.0) {
                scrollY = ct
            }
            if (((ct + lb) - scrollY) > room) {
                scrollY = ((ct + lb) - room)
            }
            def most:double (((to_double n) * lb) - room)
            if (scrollY > most) {
                scrollY = most
            }
            if (scrollY < 0.0) {
                scrollY = 0.0
            }
            txt.calculatedY = (top - scrollY)
            p = (UiTextLines.of(e txt))
        } {
            scrollY = 0.0
        }
        placed = p
        if ((focused == false) || disabled) {
            return
        }
        if (this.hasSelection()) {
            def rs:[UiTextRect] (p.rects((this.selStart()) (this.selEnd())))
            def k:int (array_length rs)
            if (k == 0) {
                return
            }
            this.putBand(b0 (itemAt rs 0))
            if (k == 1) {
                return
            }
            def lastR:UiTextRect (itemAt rs (k - 1))
            this.putBand(b2 lastR)
            if (k > 2) {
                def first:UiTextRect (itemAt rs 1)
                def mid (new UiTextRect())
                mid.x = p.left
                mid.y = first.y
                mid.w = (p.right - p.left)
                mid.h = (lastR.y - first.y)
                this.putBand(b1 mid)
            }
            return
        }
        if ((n == 0) || ((strlen value) == 0)) {
            ; empty: a line's height centred in the view (an empty run lays
            ; out with no height of its own)
            car.calculatedX = textX
            car.calculatedY = (view.calculatedY + ((view.calculatedHeight - lb) / 2.0))
            car.calculatedHeight = lb
        } {
            def ln:UiTextLine (itemAt p.lines (p.lineOf(caret)))
            car.calculatedX = (p.xAt(caret))
            car.calculatedY = ln.y
            car.calculatedHeight = ln.h
        }
        car.calculatedWidth = cw
    }

    ; --- placing it on the page -----------------------------------------------

    ; Called after the page holding the field has been laid out, with the
    ; engine it was measured with. Reads the run's font from the element the
    ; stylesheet styled (the same values the painter uses), takes the box
    ; width from the view, scrolls the caret into view and places the text,
    ; the band and the caret. Safe to call again on the same layout: every
    ; position is set from the view, not moved from where it was.
    fn placeText:void (e:EVGTextEngine) {
        measuredBy = e
        def view:EVGElement (unwrap viewEl)
        def txt:EVGElement (unwrap textEl)
        def car:EVGElement (unwrap caretEl)
        def sel:EVGElement (unwrap selEl)
        fontFamily = (txt.effectiveFontFamily())
        def fs:double txt.inheritedFontSize
        if txt.fontSize.isSet {
            fs = txt.fontSize.pixels
        }
        if (fs <= 0.0) {
            fs = 14.0
        }
        fontSize = fs
        letterSpacing = txt.letterSpacing
        ; A caret the sheet did not colour is drawn in the text's colour, as a
        ; browser's is: one theme colour for the caret was invisible on the
        ; same field in a dark panel.
        if (car.backgroundColor.isSet == false) {
            if txt.color.isSet {
                car.backgroundColor = txt.color
                caretFromText = true
            }
        }
        def cw:double caretWidth
        if car.width.isSet {
            if (car.width.pixels > 0.0) {
                cw = car.width.pixels
            }
        }
        if multiline {
            this.placeLines(e cw)
            return
        }
        def inset:double (view.box.borderWidthPx + view.box.paddingLeftPx)
        textX = ((view.calculatedX + inset) + txt.box.marginLeftPx)
        def inner:double (((view.calculatedWidth - (inset * 2.0)) - txt.box.marginLeftPx) - cw)
        if (inner < 0.0) {
            inner = 0.0
        }
        boxWidth = inner
        this.ensureCaretVisible(e)
        txt.calculatedX = (textX - scrollX)
        def y:double txt.calculatedY
        def h:double txt.calculatedHeight
        ; An empty run lays out with no height (unless the sheet gives the run
        ; one), and the caret took that height: a focused empty field showed
        ; no caret at all. It is a line of the run's font, centred in the view
        ; (the empty run itself lays out at the view's top).
        if (h < 1.0) {
            def lm:EVGTextMetrics (e.measureRun("Hg" fontFamily fontSize))
            def lh:double lm.height
            if (lh < 1.0) {
                lh = (fontSize * 1.2)
            }
            y = (view.calculatedY + ((view.calculatedHeight - lh) / 2.0))
            h = lh
        }
        car.calculatedY = y
        car.calculatedHeight = h
        car.calculatedWidth = 0.0
        car.calculatedX = textX
        sel.calculatedY = y
        sel.calculatedHeight = h
        sel.calculatedWidth = 0.0
        sel.calculatedX = textX
        if ((focused == false) || disabled) {
            return
        }
        if (this.hasSelection()) {
            def sx:double (this.caretXAt(e (this.selStart())))
            def ex:double (this.caretXAt(e (this.selEnd())))
            sel.calculatedX = ((textX + sx) - scrollX)
            sel.calculatedWidth = (ex - sx)
            return
        }
        car.calculatedX = ((textX + (this.caretXAt(e caret))) - scrollX)
        car.calculatedWidth = cw
    }

    ; --- what the host routes here (see UiCtl) --------------------------------

    ; Focus changes what the field draws (the focused class, and the
    ; placeholder that goes on focus), so a change rebuilds the field in place
    ; once it has been built. Hosts that keep focus themselves call this rather
    ; than setting `focused`, or the hint stays until the next key.
    fn setFocused:void (on:boolean) {
        if (focused == on) {
            return
        }
        focused = on
        def root:EVGElement (unwrap rootEl)
        if ((strlen tid) > 0) {
            if (root.id == tid) {
                this.build()
            }
        }
    }

    fn onFocus:void (target:string) {
        this.setFocused(true)
    }

    fn onBlur:void (target:string) {
        this.setFocused(false)
        dragging = false
    }

    fn textPointerDown:boolean (target:string px:double clicks:int shift:boolean) {
        if ((this.owns(target)) == false) {
            return false
        }
        if disabled {
            return false
        }
        this.setFocused(true)
        ; the clear button: emptied, and no drag follows
        if (this.isClearHit(target)) {
            this.clearValue()
            return true
        }
        this.pointerDown(px clicks shift)
        return true
    }

    fn textPointerDrag:boolean (px:double) {
        if (dragging == false) {
            return false
        }
        this.pointerDrag(px)
        return true
    }

    ; With the pointer's y: which line of a wrapping field it is on.
    fn textPointerDownAt:boolean (target:string px:double py:double clicks:int shift:boolean) {
        if (py >= 0.0) {
            lastY = py
        }
        return (this.textPointerDown(target px clicks shift))
    }

    fn textPointerDragAt:boolean (px:double py:double) {
        if (py >= 0.0) {
            lastY = py
        }
        return (this.textPointerDrag(px))
    }

    fn textPointerUp:void () {
        this.pointerUp()
    }

    ; What Ctrl+C copies: the selected part of the value. Never a password's,
    ; as an <input type="password"> will not copy either.
    fn selectedText:string () {
        if (kind == "password") {
            return ""
        }
        if ((this.hasSelection()) == false) {
            return ""
        }
        return (substring value (this.selStart()) (this.selEnd()))
    }

    ; --- the tree -------------------------------------------------------------

    ; The field: [view [band, text, caret], clear?]. The view takes the room
    ; the clear button leaves and clips what is scrolled out of it; the band
    ; and the caret are absolute, placed by `placeText`. Those structural
    ; properties are inline, so no stylesheet can leave them out; the colours
    ; are the theme's (.ui-input-selection, .ui-input-caret, .ui-input-text).
    fn build:void () {
        def root:EVGElement (unwrap rootEl)
        root.id = tid
        root.className = "ui-input"
        if disabled {
            UiTree.addClass(root "ui-input-disabled")
        }
        if invalid {
            UiTree.addClass(root "ui-input-invalid")
        }
        if clearable {
            UiTree.addClass(root "ui-input-clearable")
        }
        if focused {
            UiTree.addClass(root "ui-input-focused")
        }
        if ((strlen boxClass) > 0) {
            root.className = ((root.className + " ") + boxClass)
        }
        UiTree.clearChildren(root)
        ; [view, clear] side by side whatever the sheet says: a sheet that left
        ; the box a column shrank an empty view to the caret's width
        UiTree.inline(root "display" "flex")
        UiTree.inline(root "flex-direction" "row")
        ; a wrapping field is as tall as its lines, up to `maxLines`: the
        ; one-line height the sheet gave it plus a line box per further line
        if (multiline && (oneLineHeight > 0.0)) {
            def want:int (this.wrapCount())
            if (want > maxLines) {
                want = maxLines
            }
            if (want < 1) {
                want = 1
            }
            sizedLines = want
            ; a minimum over the sheet's height, so the sheet keeps saying
            ; how tall one line is (a theme may change it)
            def grow:double 0.0
            if (want > 1) {
                grow = (oneLineHeight + ((to_double (want - 1)) * lineBox))
            }
            UiTree.inline(root "min-height" ((to_string grow) + "px"))
        }

        def view:EVGElement (unwrap viewEl)
        view.id = (this.viewTid())
        view.className = "ui-input-view"
        UiTree.clearChildren(view)
        UiTree.inline(view "position" "relative")
        UiTree.inline(view "overflow" "hidden")
        UiTree.inline(view "flex-grow" "1")
        UiTree.inline(view "flex-shrink" "1")
        UiTree.inline(view "min-width" "0px")
        UiTree.inline(view "display" "flex")
        UiTree.inline(view "flex-direction" "row")
        UiTree.inline(view "align-items" "center")
        if multiline {
            ; grown from nothing to the room there is, whatever it holds: an
            ; empty run would leave it as narrow as the caret, and the lines
            ; are broken at its width
            UiTree.inline(view "width" "0px")
        }
        root.addChild(view)

        def sel:EVGElement (unwrap selEl)
        sel.id = (this.selTid())
        sel.className = "ui-input-selection"
        UiTree.clearChildren(sel)
        UiTree.inline(sel "position" "absolute")
        view.addChild(sel)
        if multiline {
            def bands:[EVGElement]
            push bands (unwrap selEl1)
            push bands (unwrap selEl2)
            def bi:int 0
            while (bi < 2) {
                def b:EVGElement (itemAt bands bi)
                b.id = ((this.selTid()) + "-" + (to_string (bi + 1)))
                b.className = "ui-input-selection"
                UiTree.clearChildren(b)
                UiTree.inline(b "position" "absolute")
                view.addChild(b)
                bi = (bi + 1)
            }
        }

        def txt:EVGElement (unwrap textEl)
        txt.id = (this.textTid())
        txt.className = "ui-input-text"
        if (this.showsPlaceholder()) {
            UiTree.addClass(txt "ui-input-placeholder")
            if ((strlen placeholderClass) > 0) {
                UiTree.addClass(txt placeholderClass)
            }
            txt.textContent = placeholder
        } {
            if ((strlen textClass) > 0) {
                UiTree.addClass(txt textClass)
            }
            txt.textContent = (this.glyphText())
        }
        UiTree.clearChildren(txt)
        if multiline {
            ; the run takes the view's width and breaks inside it
            UiTree.inline(txt "white-space" "normal")
            UiTree.inline(txt "flex-shrink" "1")
            UiTree.inline(txt "width" "100%")
            UiTree.inline(txt "min-width" "0px")
        } {
            UiTree.inline(txt "white-space" "nowrap")
            UiTree.inline(txt "flex-shrink" "0")
        }
        view.addChild(txt)

        def car:EVGElement (unwrap caretEl)
        car.id = (this.caretTid())
        car.className = "ui-input-caret"
        if caretFromText {
            car.backgroundColor = (EVGColor.noColor())
            caretFromText = false
        }
        UiTree.clearChildren(car)
        UiTree.inline(car "position" "absolute")
        view.addChild(car)

        if (this.showsClear()) {
            def clr:EVGElement (unwrap clearEl)
            clr.id = (this.clearTid())
            clr.className = "ui-input-clear"
            clr.textContent = "×"
            clr.a11yLabel = clearLabel
            UiTree.clearChildren(clr)
            root.addChild(clr)
        }
    }

    fn tids:[string] () {
        def a:[string]
        push a tid
        push a (this.viewTid())
        push a (this.selTid())
        if multiline {
            push a ((this.selTid()) + "-1")
            push a ((this.selTid()) + "-2")
        }
        push a (this.textTid())
        push a (this.caretTid())
        if clearable {
            push a (this.clearTid())
        }
        return a
    }

    fn hitFocusId:string (hit:string) {
        if (this.owns(hit)) {
            if disabled {
                return ""
            }
            return tid
        }
        return ""
    }

    fn isFocusable:boolean (target:string) {
        if disabled {
            return false
        }
        return (target == tid)
    }

    fn rows:[UiRow] () {
        def out:[UiRow]

        def r:UiRow (UiRow.of(tid (EVGA11yRole.textField()) name))
        r.disabled = disabled
        if (disabled == false) {
            r.tabStop = true
            r.focusable = true
        }
        ; Absent and "false" are different claims, which is the finding that
        ; put these three in the trace before this component existed. A native
        ; <input> publishes NONE of them unless the attribute is there, so
        ; neither does this.
        if required {
            r.required = "true"
        }
        if invalid {
            r.invalid = "true"
        }
        if readOnly {
            r.readOnly = "true"
        }
        ; The three fields the whole component is about. `value` is the TEXT
        ; even for a password — it is what `input.value` reports on the other
        ; side, and a trace that reported bullets would agree with nothing.
        r.description = description
        r.hasText = true
        r.text = value
        r.placeholder = placeholder
        r.hasSelection = true
        r.selStart = (this.selStart())
        r.selEnd = (this.selEnd())

        push out r
        return out
    }
}
