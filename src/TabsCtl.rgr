; =============================================================================
; TabsCtl — measured against @radix-ui/react-tabs
; =============================================================================
; Parity contract (see conformance/SPEC.md):
;   root      no ARIA role of its own, not a tab stop
;   list      role tablist, always a tab stop
;   tabs      role tab, selected no | yes, state "active" | "inactive",
;             roving tab stop (none until the list has been touched)
;   panels    role tabpanel, state mirrors its tab, ALWAYS a tab stop even
;             while hidden — a panel is where Tab goes after the tab strip,
;             and Radix keeps that true for the inactive one too
;   arrows    move the active tab and focus together, skip disabled, wrap;
;             only the arrows of the list's orientation (Left/Right for a
;             horizontal list, Up/Down for a vertical one) — Radix's roving
;             group ignores the other pair
;   Home/End  the first / last enabled tab, activated with focus
;
; A tab added with `addClosable` is an editor's tab (VS Code's open files):
; its name and a close mark, `<tid>-close-<value>` (class ui-tab-close), a
; button of its own named "Close <name>". `closeAt(x y)` says whose mark is
; under a point as the last layout placed it; what closing means is the
; host's (UiOpenTabs keeps which tab comes to the front).
;
; Only the active panel is in the display tree; the inactive one is still
; reported, so the trace can say it exists and cannot be reached.
; =============================================================================

Import "UiCtl.rgr"
Import "UiTree.rgr"
Import "pkg:evg/EVGElement.rgr"
Import "pkg:evg/EVGA11yTree.rgr"

class TabsCtl extends UiCtl {
    def items:[UiItem]
    def value:string ""
    def rovingValue:string ""
    def listEl:EVGElement
    ; "horizontal" (the default, and Radix's) or "vertical". Decides which
    ; arrow pair moves and what the list reports as `aria-orientation`.
    def orientation:string "horizontal"
    ; the values whose tabs carry a close mark (`addClosable`)
    def closable:[string]
    ; the close marks as the last build made them, in `closable`'s order
    def closeEls:[EVGElement]
    ; what a close mark is called: "Close " + the tab's name
    def closeWord:string "Close "

    Constructor () {
        rootEl = (EVGElement.createDiv())
        listEl = (EVGElement.createDiv())
        def empty:[UiItem]
        items = empty
        def c:[string]
        closable = c
        def ce:[EVGElement]
        closeEls = ce
    }

    ; A tab with a close mark: an open file's.
    fn addClosable:void (itemValue:string itemName:string) {
        this.addItem(itemValue itemName "" false)
        push closable itemValue
    }

    fn isClosable:boolean (itemValue:string) {
        def i:int 0
        while (i < (array_length closable)) {
            if ((itemAt closable i) == itemValue) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    fn closeTid:string (itemValue:string) {
        return (tid + "-close-" + itemValue)
    }

    ; The tab whose close mark is under (x, y), "" for none.
    fn closeAt:string (x:double y:double) {
        def i:int 0
        while (i < (array_length closeEls)) {
            def el:EVGElement (itemAt closeEls i)
            if ((((x >= el.calculatedX) && (x <= (el.calculatedX + el.calculatedWidth))) && (y >= el.calculatedY)) && (y <= (el.calculatedY + el.calculatedHeight))) {
                return (itemAt closable i)
            }
            i = (i + 1)
        }
        return ""
    }

    fn addItem:void (itemValue:string itemName:string itemBody:string itemDisabled:boolean) {
        def it (new UiItem())
        it.value = itemValue
        it.name = itemName
        it.body = itemBody
        it.disabled = itemDisabled
        push items it
    }

    fn listTid:string () {
        return (tid + "-list")
    }

    fn tabTid:string (itemValue:string) {
        return (tid + "-tab-" + itemValue)
    }

    fn panelTid:string (itemValue:string) {
        return (tid + "-panel-" + itemValue)
    }

    fn valueAtIndex:string (i:int) {
        if (i < 0) {
            return ""
        }
        if (i >= (array_length items)) {
            return ""
        }
        def it:UiItem (itemAt items i)
        return it.value
    }

    fn build:void () {
        def root:EVGElement (unwrap rootEl)
        root.id = tid
        root.className = "ui-tabs"
        UiTree.clearChildren(root)

        def list:EVGElement (unwrap listEl)
        list.id = (this.listTid())
        list.className = "ui-tablist"
        UiTree.clearChildren(list)

        def marks:[EVGElement]
        def i:int 0
        while (i < (array_length items)) {
            def it:UiItem (itemAt items i)
            def el:EVGElement (unwrap it.el)
            el.id = (this.tabTid(it.value))
            el.className = "ui-tab"
            if it.disabled {
                UiTree.addClass(el "ui-tab-disabled")
            }
            def word:string "inactive"
            if (it.value == value) {
                word = "active"
            }
            UiTree.setState(el "ui-tab" word)
            if (this.isClosable(it.value)) {
                ; the name and the close mark side by side, each a leaf
                UiTree.clearChildren(el)
                el.textContent = ""
                el.elementType = 0
                UiTree.addClass(el "ui-tab-closable")
                el.addChild((UiTree.label((el.id + "__name") "ui-tab-name" it.name)))
                def x:EVGElement (UiTree.label((this.closeTid(it.value)) "ui-tab-close" "×"))
                el.addChild(x)
                push marks x
            } {
                UiTree.leafText(el it.name)
            }
            list.addChild(el)
            i = (i + 1)
        }
        ; in `closable`'s order, for closeAt
        def ordered:[EVGElement]
        def c:int 0
        while (c < (array_length closable)) {
            def want:string (this.closeTid((itemAt closable c)))
            def m:int 0
            while (m < (array_length marks)) {
                def mk:EVGElement (itemAt marks m)
                if (mk.id == want) {
                    push ordered mk
                }
                m = (m + 1)
            }
            c = (c + 1)
        }
        closeEls = ordered
        root.addChild(list)

        ; Only the active panel joins the display tree.
        def j:int 0
        while (j < (array_length items)) {
            def it2:UiItem (itemAt items j)
            def panel:EVGElement (unwrap it2.contentEl)
            panel.id = (this.panelTid(it2.value))
            panel.className = "ui-tabpanel"
            def word2:string "inactive"
            if (it2.value == value) {
                word2 = "active"
            }
            UiTree.setState(panel "ui-tabpanel" word2)
            UiTree.clearChildren(panel)
            def body:EVGElement (UiTree.label((panel.id + "__label") "ui-tabpanel-body" it2.body))
            panel.addChild(body)
            if (it2.value == value) {
                root.addChild(panel)
            }
            j = (j + 1)
        }
    }

    fn activate:string (target:string) {
        if disabled {
            return ""
        }
        def i:int 0
        while (i < (array_length items)) {
            def it:UiItem (itemAt items i)
            if ((this.tabTid(it.value)) == target) {
                if (it.disabled == false) {
                    value = it.value
                    rovingValue = it.value
                    this.build()
                }
                return ""
            }
            i = (i + 1)
        }
        return ""
    }

    fn keyDown:string (target:string key:string) {
        if disabled {
            return ""
        }
        def from:int -1
        def i:int 0
        while (i < (array_length items)) {
            def it:UiItem (itemAt items i)
            if ((this.tabTid(it.value)) == target) {
                from = i
            }
            i = (i + 1)
        }
        if (from < 0) {
            return ""
        }
        ; Home and End: the first and the last ENABLED tab, the same stepping
        ; as the arrows but from outside either end.
        def n:int (array_length items)
        def back:int (0 - 1)
        if ((key == "Home") || (key == "End")) {
            def edge:int (UiCtl.stepIndex(items n back))
            if (key == "Home") {
                edge = (UiCtl.stepIndex(items back 1))
            }
            def edgeValue:string (this.valueAtIndex(edge))
            if (edgeValue == "") {
                return ""
            }
            value = edgeValue
            rovingValue = edgeValue
            this.build()
            return (this.tabTid(edgeValue))
        }
        def vertical:boolean (orientation == "vertical")
        def delta:int 0
        if (vertical) {
            if (key == "ArrowDown") {
                delta = 1
            }
            if (key == "ArrowUp") {
                delta = -1
            }
        } {
            if (key == "ArrowRight") {
                delta = 1
            }
            if (key == "ArrowLeft") {
                delta = -1
            }
        }
        if (delta == 0) {
            if (UiCtl.activatesOn(key)) {
                this.activate(target)
            }
            return ""
        }
        def landed:int (UiCtl.stepIndex(items from delta))
        def nextValue:string (this.valueAtIndex(landed))
        if (nextValue == "") {
            return ""
        }
        value = nextValue
        rovingValue = nextValue
        this.build()
        return (this.tabTid(nextValue))
    }

    fn tids:[string] () {
        def a:[string]
        push a tid
        push a (this.listTid())
        def i:int 0
        while (i < (array_length items)) {
            def it:UiItem (itemAt items i)
            push a (this.tabTid(it.value))
            if (this.isClosable(it.value)) {
                push a (this.closeTid(it.value))
            }
            i = (i + 1)
        }
        def j:int 0
        while (j < (array_length items)) {
            def it2:UiItem (itemAt items j)
            push a (this.panelTid(it2.value))
            j = (j + 1)
        }
        return a
    }

    fn isFocusable:boolean (target:string) {
        if disabled {
            return false
        }
        def i:int 0
        while (i < (array_length items)) {
            def it:UiItem (itemAt items i)
            if ((this.tabTid(it.value)) == target) {
                if it.disabled {
                    return false
                }
                return true
            }
            i = (i + 1)
        }
        return false
    }

    fn onFocus:void (target:string) {
        def i:int 0
        while (i < (array_length items)) {
            def it:UiItem (itemAt items i)
            if ((this.tabTid(it.value)) == target) {
                rovingValue = it.value
                return
            }
            i = (i + 1)
        }
    }

    fn rows:[UiRow] () {
        def out:[UiRow]
        def rootRow:UiRow (UiRow.of(tid (EVGA11yRole.none()) ""))
        push out rootRow

        def listRow:UiRow (UiRow.of((this.listTid()) (EVGA11yRole.tabList()) name))
        ; On the LIST, not on the root — the root has no role at all.
        listRow.orientation = orientation
        listRow.parentTid = tid
        listRow.tabStop = true
        push out listRow

        def i:int 0
        while (i < (array_length items)) {
            def it:UiItem (itemAt items i)
            def row:UiRow (UiRow.of((this.tabTid(it.value)) (EVGA11yRole.tab()) it.name))
            row.parentTid = (this.listTid())
            if (it.value == value) {
                row.state = "active"
                row.selected = (EVGA11yTri.yes())
            } {
                row.state = "inactive"
                row.selected = (EVGA11yTri.no())
            }
            row.disabled = it.disabled
            if (it.value == rovingValue) {
                row.tabStop = true
            }
            if it.disabled {
                row.tabStop = false
            } {
                row.focusable = true
            }
            push out row
            if (this.isClosable(it.value)) {
                def xrow:UiRow (UiRow.of((this.closeTid(it.value)) (EVGA11yRole.button()) (closeWord + it.name)))
                xrow.parentTid = (this.tabTid(it.value))
                xrow.focusable = true
                push out xrow
            }
            i = (i + 1)
        }

        def j:int 0
        while (j < (array_length items)) {
            def it2:UiItem (itemAt items j)
            def prow:UiRow (UiRow.of((this.panelTid(it2.value)) (EVGA11yRole.tabPanel()) ""))
            prow.parentTid = tid
            if (it2.value == value) {
                prow.state = "active"
            } {
                prow.state = "inactive"
            }
            prow.tabStop = true
            push out prow
            j = (j + 1)
        }
        return out
    }
}
