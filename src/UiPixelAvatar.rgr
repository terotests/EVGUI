; =============================================================================
; UiPixelAvatar — little retro game characters, for people with no picture
; =============================================================================
; A chat shows who wrote what by a face beside it. Nobody has to upload one:
; each person picks a character (a knight, a ghost, a wizard …) and a base
; colour, and the character is drawn in that colour's shades, like a sprite
; of an old console game. Assistants are robots.
;
; A character is a 12×12 grid of letters, one per pixel:
;
;   .  nothing         b  the base colour     l  lighter (+45 %)
;   o  the outline     d  darker (−25 %)      w  white
;      (base −55 %)    k  near black          s  skin
;   g  gold            r  red
;
; `svg(name, color)` is the character as an SVG document (one path per
; colour, each pixel run of a row one rectangle), which EVG draws as a
; path element's `svgSource`, crisp at any size; `grid` and `runs` are the
; parts, checked in Node (ui:chatmodel:check).
;
; `pick(name, seed)` is the character to draw: the one chosen, or for
; someone who has not chosen, one picked by their id, the same every time.
; =============================================================================

class UiPixelAvatar {
    ; The characters a person can be (the robot is the assistants').
    sfn names:[string] () {
        return ([] _:string ("knight" "ghost" "cat" "wizard" "alien" "slime" "bunny" "owl" "ninja" "mushroom"))
    }

    sfn has:boolean (name:string) {
        return ((array_length (UiPixelAvatar.grid(name))) == 12)
    }

    sfn defaultColor:string () {
        return "#64748b"
    }

    ; base colours to choose from
    sfn palette:[string] () {
        return ([] _:string ("#ef4444" "#f97316" "#eab308" "#84cc16" "#22c55e" "#14b8a6" "#0ea5e9" "#2563eb" "#7c3aed" "#c026d3" "#db2777" "#64748b"))
    }

    sfn grid:[string] (name:string) {
        if (name == "knight") {
            return ([] _:string ("...oooooo..." "..oblllbbo.." ".obllbbbbbo." ".obbbbbbbbo." ".okkkkkkkko." ".obwkbbwkbo." ".obbbbbbbbo." ".odbbbbbbdo." "..oddddddo.." "...oggggo..." "..obbbbbbo.." ".obbbbbbbbo."))
        }
        if (name == "ghost") {
            return ([] _:string ("....oooo...." "..oobbbboo.." ".obllbbbbbo." ".oblbbbbbbo." "obbwwbbwwbbo" "obbwkbbwkbbo" "obbbbbbbbbbo" "obbbbrrbbbbo" "obbbbbbbbbbo" "obbbbbbbbbbo" "obobbobbobbo" "o.o.oo.oo.o."))
        }
        if (name == "cat") {
            return ([] _:string (".o........o." "obo......obo" "obboooooobbo" "obbbbbbbbbbo" "obwkbbbbwkbo" "obbbbbbbbbbo" "olbbbrrbbblo" ".obbbbbbbbo." "..obbbbbbo.." ".obllbbllbo." ".obbbbbbbbo." ".oooooooooo."))
        }
        if (name == "wizard") {
            return ([] _:string (".....oo....." "....obbo...." "...obgbbo..." "..obbbbbbo.." ".oooooooooo." "..osssssso.." "..oskssskso." "..osssssso.." "..owwwwwwo.." "...owwwwo..." "..obbbbbbo.." ".obbbbbbbbo."))
        }
        if (name == "alien") {
            return ([] _:string ("...o....o..." "....o..o...." "..oooooooo.." ".obbbbbbbbo." "obllbbbbbbbo" "obkkbbbbkkbo" "obkwbbbbkwbo" "obbbbbbbbbbo" ".obbbrrbbbo." "..obbbbbbo.." "...oobboo..." ".....oo....."))
        }
        if (name == "slime") {
            return ([] _:string ("............" "............" "....oooo...." "...obllbo..." "..obllbbbo.." ".obbbbbbbbo." ".obwkbbwkbo." "obbbbbbbbbbo" "obbbbrrbbbbo" "obbbbbbbbbbo" "oddddddddddo" ".oooooooooo."))
        }
        if (name == "bunny") {
            return ([] _:string ("..oo....oo.." ".owo....owo." ".owo....owo." "..obo..obo.." "..obboobbo.." ".obbbbbbbbo." "obbwkbbwkbbo" "obbbbbbbbbbo" "obbbbrrbbbbo" ".obbbbbbbbo." "..oobbbboo.." "....oooo...."))
        }
        if (name == "owl") {
            return ([] _:string (".oo......oo." ".obo....obo." ".obboooobbo." "obbbbbbbbbbo" "obwwwbbwwwbo" "obwkwbbwkwbo" "obwwwggwwwbo" "obbbbggbbbbo" "oblllbblllbo" "obllllllllbo" ".obllllllbo." "..ogo..ogo.."))
        }
        if (name == "ninja") {
            return ([] _:string ("...oooooo..." "..obbbbbbo.." ".obbbbbbbbo." ".okkkkkkkko." ".okwkkkkwko." ".okkkkkkkko." ".obbbbbbbbo." "..obbbbbbo.." ".oddddddddo." "obbbbbbbbbbo" "obbbbbbbbbbo" ".oooooooooo."))
        }
        if (name == "mushroom") {
            return ([] _:string ("...oooooo..." "..obbwwbbo.." ".obwwbbbwbo." "obbbbbbbbwbo" "obwwbbbbbbbo" "oooooooooooo" "..osssssso.." "..oskssksso." "..osssssso.." "..osssssso.." "...osssso..." "....oooo...."))
        }
        if (name == "robot") {
            return ([] _:string (".....gg....." ".....oo....." ".oooooooooo." ".obbbbbbbbo." "oblwwbbwwlbo" "oblwkbbwklbo" "obbbbbbbbbbo" "obkgkgkgkgbo" "obbbbbbbbbbo" ".oooooooooo." "..obbddbbo.." ".oooooooooo."))
        }
        def none:[string]
        return none
    }

    sfn knownChars:boolean (row:string) {
        def i:int 0
        while (i < (strlen row)) {
            def c:string (substring row i (i + 1))
            if ((indexOf ".oblldwksgr" c) < 0) {
                return false
            }
            i = (i + 1)
        }
        return true
    }

    ; The character to draw: `name` when it is one, else one picked by
    ; `seed` (someone's id), the same for the same seed.
    sfn pick:string (name:string seed:string) {
        if ((name != "robot") && (UiPixelAvatar.has(name))) {
            return name
        }
        def all:[string] (UiPixelAvatar.names())
        def h:int 7
        def i:int 0
        while (i < (strlen seed)) {
            h = (((h * 31) + (charAt seed i)) % 1000003)
            i = (i + 1)
        }
        return (itemAt all (h % (array_length all)))
    }

    ; --- colours --------------------------------------------------------------

    sfn hexDigit:int (c:int) {
        if ((c >= 48) && (c <= 57)) {
            return (c - 48)
        }
        if ((c >= 97) && (c <= 102)) {
            return (c - 87)
        }
        if ((c >= 65) && (c <= 70)) {
            return (c - 55)
        }
        return -1
    }

    sfn isHex:boolean (s:string) {
        if (((strlen s) != 7) || ((indexOf s "#") != 0)) {
            return false
        }
        def i:int 1
        while (i < 7) {
            if ((UiPixelAvatar.hexDigit((charAt s i))) < 0) {
                return false
            }
            i = (i + 1)
        }
        return true
    }

    sfn channel:int (s:string at:int) {
        return (((UiPixelAvatar.hexDigit((charAt s at))) * 16) + (UiPixelAvatar.hexDigit((charAt s (at + 1)))))
    }

    sfn hex2:string (v:int) {
        def d:string "0123456789abcdef"
        def x:int v
        if (x < 0) {
            x = 0
        }
        if (x > 255) {
            x = 255
        }
        def hi:int (idiv x 16)
        def lo:int (x % 16)
        return ((substring d hi (hi + 1)) + (substring d lo (lo + 1)))
    }

    ; f > 0 towards white by f, f < 0 towards black by -f
    sfn shadeOne:int (c:int f:double) {
        def v:double (to_double c)
        if (f >= 0.0) {
            v = (v + ((255.0 - v) * f))
        } {
            v = (v * (1.0 + f))
        }
        return (to_int (v + 0.5))
    }

    sfn shade:string (color:string f:double) {
        def c:string (to_lowercase color)
        if ((UiPixelAvatar.isHex(c)) == false) {
            c = (UiPixelAvatar.defaultColor())
        }
        def r:int (UiPixelAvatar.shadeOne((UiPixelAvatar.channel(c 1)) f))
        def g:int (UiPixelAvatar.shadeOne((UiPixelAvatar.channel(c 3)) f))
        def b:int (UiPixelAvatar.shadeOne((UiPixelAvatar.channel(c 5)) f))
        return ("#" + (UiPixelAvatar.hex2(r)) + (UiPixelAvatar.hex2(g)) + (UiPixelAvatar.hex2(b)))
    }

    ; the colour of a pixel letter
    sfn colorOf:string (ch:string base:string) {
        if (ch == "b") {
            return (UiPixelAvatar.shade(base 0.0))
        }
        if (ch == "o") {
            return (UiPixelAvatar.shade(base -0.55))
        }
        if (ch == "l") {
            return (UiPixelAvatar.shade(base 0.45))
        }
        if (ch == "d") {
            return (UiPixelAvatar.shade(base -0.25))
        }
        if (ch == "w") {
            return "#ffffff"
        }
        if (ch == "k") {
            return "#1f2937"
        }
        if (ch == "s") {
            return "#f5c9a0"
        }
        if (ch == "g") {
            return "#facc15"
        }
        if (ch == "r") {
            return "#ef4444"
        }
        return ""
    }

    ; --- drawing ----------------------------------------------------------------

    ; The row's runs of `ch` ("" any pixel) as rectangles at row y.
    sfn runsOf:string (row:string y:int ch:string) {
        def out:string ""
        def i:int 0
        def n:int (strlen row)
        while (i < n) {
            def c:string (substring row i (i + 1))
            def on:boolean false
            if ((strlen ch) == 0) {
                on = (c != ".")
            } {
                on = (c == ch)
            }
            if on {
                def k:int i
                def same:boolean true
                while ((k < n) && same) {
                    def c2:string (substring row k (k + 1))
                    if ((strlen ch) == 0) {
                        same = (c2 != ".")
                    } {
                        same = (c2 == ch)
                    }
                    if same {
                        k = (k + 1)
                    }
                }
                def w:int (k - i)
                out = (out + "M" + (to_string i) + " " + (to_string y) + "h" + (to_string w) + "v1h-" + (to_string w) + "z")
                i = k
            } {
                i = (i + 1)
            }
        }
        return out
    }

    sfn runs:string (row:string) {
        return (UiPixelAvatar.runsOf(row 0 ""))
    }

    ; The character as an SVG document in the shades of `color`.
    sfn svg:string (name:string color:string) {
        def grid:[string] (UiPixelAvatar.grid(name))
        if ((array_length grid) != 12) {
            grid = (UiPixelAvatar.grid("slime"))
        }
        def out:string "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 12 12\" shape-rendering=\"crispEdges\">"
        def order:string "obldwksgr"
        def k:int 0
        while (k < (strlen order)) {
            def ch:string (substring order k (k + 1))
            def d:string ""
            def y:int 0
            while (y < 12) {
                d = (d + (UiPixelAvatar.runsOf((itemAt grid y) y ch)))
                y = (y + 1)
            }
            if ((strlen d) > 0) {
                out = (out + "<path fill=\"" + (UiPixelAvatar.colorOf(ch color)) + "\" d=\"" + d + "\"/>")
            }
            k = (k + 1)
        }
        return (out + "</svg>")
    }
}
