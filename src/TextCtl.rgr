; =============================================================================
; TextCtl — a run of text a reader can select and copy
; =============================================================================
; On a web page any text can be painted with the pointer and copied. Text an
; EVG page draws cannot, unless something does what the browser does: a
; build number, an error, a link to share are read here and needed somewhere
; else. Not every text should be (a button's word, a menu row), so it is a
; choice: `selectable` turns it on.
;
; The control is the text (`text`, styled by `textClass` like any span) in a
; box that also holds the selection band under it. A press puts the
; selection's anchor where it landed, a drag selects, a double click takes a
; word, a triple click the paragraph, Shift+press extends; `selectedText` is
; what Ctrl+C copies — the host owns the clipboard (UiHost.copyText). A press
; anywhere else drops the selection (`dropSelection`, which UiHost calls).
;
; The rules are UiTextSel (indices) and UiTextLines (where the lines are);
; `placeText` reads the laid-out run the way the display list draws it and
; places the band: one rectangle on the first line, one over the whole lines
; between, one on the last, as a browser fills a selection that runs over
; lines.
;
; Not a tab stop and not focusable: selecting text is not focusing it, as on
; a page. The band shows while there is a selection.
; =============================================================================

Import "UiCtl.rgr"
Import "UiTree.rgr"
Import "UiTextSel.rgr"
Import "pkg:evg/EVGElement.rgr"
Import "pkg:evg/EVGA11yTree.rgr"
Import "pkg:evg/EVGTextEngine.rgr"

class TextCtl extends UiCtl {
    def text:string ""
    ; Off: the text is only drawn, a press on it is the host's.
    def selectable:boolean false
    ; The host's classes for the run (the font, the colour) and for the box
    ; around it (margins, width). Kept by every build.
    def textClass:string ""
    def boxClass:string ""

    def sel:UiTextSel (new UiTextSel())
    ; Where the run was laid out, from the last `placeText`.
    def placed@(optional):UiTextLines
    ; The y of the last press, for a host that drags with x alone.
    def lastY:double 0.0

    def runEl:EVGElement
    def band0:EVGElement
    def band1:EVGElement
    def band2:EVGElement

    Constructor () {
        rootEl = (EVGElement.createDiv())
        runEl = (EVGElement.createSpan())
        band0 = (EVGElement.createDiv())
        band1 = (EVGElement.createDiv())
        band2 = (EVGElement.createDiv())
    }

    sfn make:TextCtl (tid:string text:string textClass:string) {
        def c (new TextCtl())
        c.tid = tid
        c.textClass = textClass
        c.setText(text)
        c.build()
        return c
    }

    fn textTid:string () {
        return (tid + "-text")
    }

    fn bandTid:string (k:int) {
        return ((tid + "-sel") + (to_string k))
    }

    fn setText:void (t:string) {
        text = t
        sel.setText(t)
    }

    ; --- the selection ---------------------------------------------------------

    fn hasSelection:boolean () {
        return (sel.hasSelection())
    }

    fn selectedText:string () {
        if (selectable == false) {
            return ""
        }
        return (sel.selectedText())
    }

    fn selectAll:void () {
        if selectable {
            sel.selectAll()
        }
    }

    fn dropSelection:void () {
        sel.clear()
    }

    fn indexAt:int (px:double py:double) {
        if (null? placed) {
            return sel.caret
        }
        def p:UiTextLines (unwrap placed)
        return (p.indexAt(px py))
    }

    fn textPointerDownAt:boolean (target:string px:double py:double clicks:int shift:boolean) {
        if (selectable == false) {
            return false
        }
        if ((this.owns(target)) == false) {
            return false
        }
        lastY = py
        sel.pointerDown((this.indexAt(px py)) clicks shift)
        return true
    }

    fn textPointerDown:boolean (target:string px:double clicks:int shift:boolean) {
        return (this.textPointerDownAt(target px lastY clicks shift))
    }

    fn textPointerDragAt:boolean (px:double py:double) {
        if (sel.dragging == false) {
            return false
        }
        lastY = py
        sel.pointerDrag((this.indexAt(px py)))
        return true
    }

    fn textPointerDrag:boolean (px:double) {
        return (this.textPointerDragAt(px lastY))
    }

    fn textPointerUp:void () {
        sel.pointerUp()
    }

    ; --- placing it on the page -----------------------------------------------

    fn hideBand:void (b:EVGElement) {
        b.calculatedX = 0.0
        b.calculatedY = 0.0
        b.calculatedWidth = 0.0
        b.calculatedHeight = 0.0
    }

    fn putBand:void (b:EVGElement r:UiTextRect) {
        b.calculatedX = r.x
        b.calculatedY = r.y
        b.calculatedWidth = r.w
        b.calculatedHeight = r.h
    }

    fn placeText:void (e:EVGTextEngine) {
        def b0:EVGElement (unwrap band0)
        def b1:EVGElement (unwrap band1)
        def b2:EVGElement (unwrap band2)
        this.hideBand(b0)
        this.hideBand(b1)
        this.hideBand(b2)
        if (selectable == false) {
            return
        }
        def p:UiTextLines (UiTextLines.of(e (unwrap runEl)))
        placed = p
        if ((sel.hasSelection()) == false) {
            return
        }
        def rs:[UiTextRect] (p.rects((sel.selStart()) (sel.selEnd())))
        def n:int (array_length rs)
        if (n == 0) {
            return
        }
        this.putBand(b0 (itemAt rs 0))
        if (n == 1) {
            return
        }
        def lastR:UiTextRect (itemAt rs (n - 1))
        this.putBand(b2 lastR)
        if (n > 2) {
            ; the whole lines between, as one block across the box
            def top:UiTextRect (itemAt rs 1)
            def mid (new UiTextRect())
            mid.x = p.left
            mid.y = top.y
            mid.w = (p.right - p.left)
            mid.h = (lastR.y - top.y)
            this.putBand(b1 mid)
        }
    }

    ; --- the tree -------------------------------------------------------------

    ; [band, band, band, run]: the bands first so they are drawn under the
    ; glyphs. Their place is inline (absolute in a relative box) so no
    ; stylesheet can leave it out; their colour is the theme's
    ; (.ui-text-selection).
    fn build:void () {
        def root:EVGElement (unwrap rootEl)
        root.id = tid
        root.className = "ui-text"
        if selectable {
            UiTree.addClass(root "ui-text-selectable")
        }
        if ((strlen boxClass) > 0) {
            UiTree.addClass(root boxClass)
        }
        UiTree.clearChildren(root)
        UiTree.inline(root "position" "relative")
        UiTree.inline(root "display" "flex")
        UiTree.inline(root "flex-direction" "column")
        def k:int 0
        while (k < 3) {
            def b:EVGElement (unwrap band0)
            if (k == 1) {
                b = (unwrap band1)
            }
            if (k == 2) {
                b = (unwrap band2)
            }
            b.id = (this.bandTid(k))
            b.className = "ui-text-selection"
            UiTree.clearChildren(b)
            UiTree.inline(b "position" "absolute")
            root.addChild(b)
            k = (k + 1)
        }
        def run:EVGElement (unwrap runEl)
        run.id = (this.textTid())
        run.className = "ui-text-run"
        if ((strlen textClass) > 0) {
            UiTree.addClass(run textClass)
        }
        UiTree.clearChildren(run)
        run.textContent = text
        root.addChild(run)
    }

    fn tids:[string] () {
        def a:[string]
        push a tid
        push a (this.textTid())
        push a (this.bandTid(0))
        push a (this.bandTid(1))
        push a (this.bandTid(2))
        return a
    }

    fn rows:[UiRow] () {
        def out:[UiRow]
        def r:UiRow (UiRow.of(tid (EVGA11yRole.none()) ""))
        r.hasText = true
        r.text = text
        if selectable {
            r.hasSelection = true
            r.selStart = (sel.selStart())
            r.selEnd = (sel.selEnd())
        }
        push out r
        return out
    }
}
