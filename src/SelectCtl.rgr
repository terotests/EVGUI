; =============================================================================
; SelectCtl — measured against @radix-ui/react-select
; =============================================================================
; A picker, and the vocabulary is not the one a menu uses. Measured, before it
; was written (conformance/specs/select_pointer.json):
;
;   trigger   role COMBOBOX — even though nothing can be typed into it. That is
;             what the reference reports and what every platform maps a picker
;             onto; `button` would lose the fact that it has a value.
;   value     a box with no role and no name. The chosen label is drawn in it
;             and announced through the trigger, not through this.
;   open      content role LISTBOX, items role OPTION with `aria-selected` and
;             a checked/unchecked state word.
;   focus     lands on the SELECTED option, not on the list and not on the
;             first row. A menu announces itself and waits; a select puts you
;             where you already are.
;   choose    closes, and focus returns to the trigger.
;
; The options are unnamed in the trace because `option` is not one of the roles
; whose text becomes its name in the DOM snapshot — so the label is compared
; where it is announced, on the trigger, and nowhere else.
;
; BASE UI'S SELECT, opt-in (`baseUi = true`; everything above is untouched
; while it is false). Written from Base UI's documented Select and the
; WAI-ARIA listbox pattern, not measured:
;
;   open      Enter, Space, ArrowDown or ArrowUp on the trigger, or a click.
;             The highlight starts on the chosen item; with nothing chosen
;             the keys start at the first row (ArrowUp: the last) and a click
;             highlights nothing.
;   move      the arrows (no wrap), Home and End, skipping disabled rows; the
;             pointer highlights the row it is over.
;   typeahead letters jump to the next row that starts with them; the same
;             letter again cycles; the buffer empties after `typeaheadMs`.
;             On the closed trigger of a single select it CHOOSES, as a
;             native <select> does.
;   choose    Enter, Space or a click. Single: the value, closed, focus back
;             on the trigger. `multiple`: the row toggles in `values` and the
;             list stays open.
;   selected  `aria-selected` follows what is CHOSEN (not the highlight), and
;             the list is `aria-multiselectable` when `multiple`.
; =============================================================================

Import "UiCtl.rgr"
Import "UiTree.rgr"
Import "pkg:evg/EVGElement.rgr"
Import "pkg:evg/EVGA11yTree.rgr"

class SelectCtl extends UiCtl {
    def open:boolean false
    def items:[UiItem]
    def value:string ""
    ; The option focus is on while the list is open. Not the same thing as
    ; `value`: a select highlights as you arrow and commits when you choose.
    def activeValue:string ""
    def triggerEl:EVGElement
    def valueEl:EVGElement
    def contentEl:EVGElement

    ; --- Base UI's Select (opt-in; see the header) ---
    def baseUi:boolean false
    def multiple:boolean false
    ; The chosen values of a `multiple` select, in the items' order.
    def values:[string]
    ; What has been typed for the typeahead, and how long ago.
    def typed:string ""
    def typedAge:double 0.0
    def typeaheadMs:double 750.0

    Constructor () {
        rootEl = (EVGElement.createDiv())
        triggerEl = (EVGElement.createDiv())
        valueEl = (EVGElement.createDiv())
        contentEl = (EVGElement.createDiv())
        def empty:[UiItem]
        items = empty
        def noValues:[string]
        values = noValues
    }

    ; An item under a group heading (`UiItem.group`). Items of one group are
    ; added together, in the order the groups are shown.
    fn addGroupedItem:void (itemValue:string itemName:string groupName:string) {
        this.addItem(itemValue itemName false)
        def it:UiItem (itemAt items ((array_length items) - 1))
        it.group = groupName
    }

    fn addItem:void (itemValue:string itemName:string itemDisabled:boolean) {
        def it (new UiItem())
        it.value = itemValue
        it.name = itemName
        it.disabled = itemDisabled
        push items it
    }

    fn triggerTid:string () {
        return (tid + "-trigger")
    }

    fn valueTid:string () {
        return (tid + "-value")
    }

    fn contentTid:string () {
        return (tid + "-content")
    }

    fn itemTid:string (itemValue:string) {
        return ((tid + "-item-") + itemValue)
    }

    fn indexOfValue:int (v:string) {
        def i:int 0
        while (i < (array_length items)) {
            def it:UiItem (itemAt items i)
            if (it.value == v) {
                return i
            }
            i = (i + 1)
        }
        return -1
    }

    fn valueOf:string (target:string) {
        def i:int 0
        while (i < (array_length items)) {
            def it:UiItem (itemAt items i)
            if (target == (this.itemTid(it.value))) {
                return it.value
            }
            i = (i + 1)
        }
        return ""
    }

    fn labelOf:string (v:string) {
        def i:int (this.indexOfValue(v))
        if (i < 0) {
            return ""
        }
        def it:UiItem (itemAt items i)
        return it.name
    }

    fn stateWord:string () {
        if open {
            return "open"
        }
        return "closed"
    }

    ; --- input -------------------------------------------------------------------

    fn openList:string () {
        open = true
        activeValue = value
        this.build()
        ; The selected option, not the list and not the first row.
        if ((strlen value) > 0) {
            return (this.itemTid(value))
        }
        return (this.contentTid())
    }

    fn closeList:string () {
        open = false
        activeValue = ""
        this.build()
        return (this.triggerTid())
    }

    fn activate:string (target:string) {
        if baseUi {
            return (this.baseActivate(target))
        }
        if disabled {
            return ""
        }
        if (target == (this.triggerTid())) {
            if open {
                return (this.closeList())
            }
            return (this.openList())
        }
        def v:string (this.valueOf(target))
        if ((strlen v) == 0) {
            return ""
        }
        def i:int (this.indexOfValue(v))
        def it:UiItem (itemAt items i)
        if it.disabled {
            return ""
        }
        value = v
        return (this.closeList())
    }

    fn keyDown:string (target:string key:string) {
        if baseUi {
            return (this.baseKeyDown(target key))
        }
        if disabled {
            return ""
        }
        if (key == "Escape") {
            if open {
                return (this.closeList())
            }
            return ""
        }
        if (UiCtl.activatesOn(key)) {
            return (this.activate(target))
        }
        if (open == false) {
            return ""
        }
        def step:int 0
        if (key == "ArrowDown") {
            step = 1
        }
        if (key == "ArrowUp") {
            step = -1
        }
        if (step == 0) {
            return ""
        }
        ; An arrow moves the HIGHLIGHT, not the value. Measured, and it caught
        ; the obvious wrong version: writing the value on every arrow made a
        ; select announce a new choice for each step, and the reference does
        ; not commit until Enter or a click. `activeValue` is where focus is;
        ; `value` is what has been chosen.
        def start:string activeValue
        if ((strlen start) == 0) {
            start = value
        }
        def from:int (this.indexOfValue(start))
        if (from < 0) {
            from = 0
        }
        def at:int (from + step)
        while ((at >= 0) && (at < (array_length items))) {
            def it:UiItem (itemAt items at)
            if (it.disabled == false) {
                activeValue = it.value
                this.build()
                return (this.itemTid(it.value))
            }
            at = (at + step)
        }
        return ""
    }

    ; --- Base UI's Select ---------------------------------------------------------

    fn isChosen:boolean (v:string) {
        if multiple {
            return ((indexOf values v) >= 0)
        }
        return (v == value)
    }

    fn enabledAt:boolean (i:int) {
        if ((i < 0) || (i >= (array_length items))) {
            return false
        }
        def it:UiItem (itemAt items i)
        return (it.disabled == false)
    }

    ; The first enabled row from `from` going `step`, or -1.
    fn stepFrom:int (from:int step:int) {
        def at:int from
        while ((at >= 0) && (at < (array_length items))) {
            if (this.enabledAt(at)) {
                return at
            }
            at = (at + step)
        }
        return -1
    }

    ; The first chosen row, in the items' order, or -1.
    fn firstChosen:int () {
        def i:int 0
        while (i < (array_length items)) {
            def it:UiItem (itemAt items i)
            if (this.isChosen(it.value)) {
                return i
            }
            i = (i + 1)
        }
        return -1
    }

    fn highlightAt:string (i:int) {
        if (i < 0) {
            return ""
        }
        def it:UiItem (itemAt items i)
        activeValue = it.value
        return (this.itemTid(it.value))
    }

    ; Open, the highlight on the chosen row. `key` is the key that opened it
    ; ("" for the pointer): with nothing chosen a key starts at the first row
    ; (ArrowUp at the last) and the pointer highlights nothing.
    fn openWith:string (key:string) {
        open = true
        activeValue = ""
        typed = ""
        def at:int (this.firstChosen())
        if ((this.enabledAt(at)) == false) {
            at = -1
            if (key == "ArrowUp") {
                at = (this.stepFrom(((array_length items) - 1) -1))
            } {
                if ((strlen key) > 0) {
                    at = (this.stepFrom(0 1))
                }
            }
        }
        if (at >= 0) {
            return (this.highlightAt(at))
        }
        return (this.contentTid())
    }

    ; Choose a row: single closes (focus to the trigger), multiple toggles and
    ; stays open on the row.
    fn chooseValue:string (v:string) {
        def i:int (this.indexOfValue(v))
        if ((this.enabledAt(i)) == false) {
            return ""
        }
        if multiple {
            def next:[string]
            def had:boolean (this.isChosen(v))
            def k:int 0
            while (k < (array_length items)) {
                def it:UiItem (itemAt items k)
                if (it.value == v) {
                    if (had == false) {
                        push next it.value
                    }
                } {
                    if (this.isChosen(it.value)) {
                        push next it.value
                    }
                }
                k = (k + 1)
            }
            values = next
            activeValue = v
            return (this.itemTid(v))
        }
        value = v
        return (this.closeList())
    }

    fn baseActivate:string (target:string) {
        if disabled {
            return ""
        }
        if (target == (this.triggerTid())) {
            if open {
                return (this.closeList())
            }
            return (this.openWith(""))
        }
        if (open == false) {
            return ""
        }
        def v:string (this.valueOf(target))
        if ((strlen v) == 0) {
            return ""
        }
        return (this.chooseValue(v))
    }

    fn baseKeyDown:string (target:string key:string) {
        if disabled {
            return ""
        }
        if (open == false) {
            if (target != (this.triggerTid())) {
                return ""
            }
            if ((key == "Enter") || (key == " ") || (key == "ArrowDown") || (key == "ArrowUp")) {
                return (this.openWith(key))
            }
            return ""
        }
        if ((key == "Escape") || (key == "Tab")) {
            return (this.closeList())
        }
        if (key == " ") {
            ; A space inside a word being typed is part of the word.
            if ((strlen typed) > 0) {
                return (this.typeAhead(" "))
            }
        }
        if ((key == "Enter") || (key == " ")) {
            if ((strlen activeValue) == 0) {
                return ""
            }
            return (this.chooseValue(activeValue))
        }
        def from:int (this.indexOfValue(activeValue))
        def at:int -1
        if (key == "Home") {
            at = (this.stepFrom(0 1))
        }
        if (key == "End") {
            at = (this.stepFrom(((array_length items) - 1) -1))
        }
        if (key == "ArrowDown") {
            if (from < 0) {
                at = (this.stepFrom(0 1))
            } {
                at = (this.stepFrom((from + 1) 1))
                if (at < 0) {
                    at = from
                }
            }
        }
        if (key == "ArrowUp") {
            if (from < 0) {
                at = (this.stepFrom(((array_length items) - 1) -1))
            } {
                at = (this.stepFrom((from - 1) -1))
                if (at < 0) {
                    at = from
                }
            }
        }
        if (at < 0) {
            return ""
        }
        typed = ""
        return (this.highlightAt(at))
    }

    ; Does the row's label start with `needle` (both lower case)?
    fn startsWithAt:boolean (i:int needle:string) {
        if ((this.enabledAt(i)) == false) {
            return false
        }
        def it:UiItem (itemAt items i)
        def low:string (to_lowercase it.name)
        if ((strlen low) < (strlen needle)) {
            return false
        }
        return ((substring low 0 (strlen needle)) == needle)
    }

    ; A printable key: the next row starting with what has been typed. The
    ; same letter over and over cycles through the rows starting with it.
    ; Returns where the focus lands ("" when nothing matched).
    fn typeAhead:string (ch:string) {
        if disabled {
            return ""
        }
        if ((strlen ch) != 1) {
            return ""
        }
        if ((open == false) && ((strlen typed) == 0) && (ch == " ")) {
            return ""
        }
        typed = (typed + (to_lowercase ch))
        typedAge = 0.0
        def needle:string typed
        def first:string (substring typed 0 1)
        def same:boolean true
        def k:int 1
        while (k < (strlen typed)) {
            if ((substring typed k (k + 1)) != first) {
                same = false
            }
            k = (k + 1)
        }
        if same {
            needle = first
        }
        def n:int (array_length items)
        if (n == 0) {
            return ""
        }
        def cur:int -1
        if open {
            cur = (this.indexOfValue(activeValue))
        } {
            cur = (this.firstChosen())
        }
        ; A new word starts after the current row; a longer one may stay on it.
        def start:int (cur + 1)
        if ((same == false) && (cur >= 0)) {
            start = cur
        }
        def step:int 0
        while (step < n) {
            def i:int ((start + step) % n)
            if (i < 0) {
                i = (i + n)
            }
            if (this.startsWithAt(i needle)) {
                def it:UiItem (itemAt items i)
                if open {
                    return (this.highlightAt(i))
                }
                if multiple {
                    return ""
                }
                value = it.value
                return (this.triggerTid())
            }
            step = (step + 1)
        }
        return ""
    }

    fn typeChar:boolean (target:string ch:string) {
        if (baseUi == false) {
            return false
        }
        return ((strlen (this.typeAhead(ch))) > 0)
    }

    fn typing:boolean () {
        return ((strlen typed) > 0)
    }

    fn tickCtl:string (dtMs:double) {
        if ((strlen typed) > 0) {
            typedAge = (typedAge + dtMs)
            if (typedAge >= typeaheadMs) {
                typed = ""
                typedAge = 0.0
            }
        }
        return ""
    }

    ; The pointer over a row highlights it (Base UI's highlight follows it).
    fn hover:string (target:string) {
        if ((baseUi == false) || (open == false) || disabled) {
            return ""
        }
        def v:string (this.valueOf(target))
        def i:int (this.indexOfValue(v))
        if ((this.enabledAt(i)) == false) {
            return ""
        }
        return (this.highlightAt(i))
    }

    ; --- the tree -----------------------------------------------------------------

    fn build:void () {
        def word:string (this.stateWord())
        def root:EVGElement (unwrap rootEl)
        root.id = tid
        root.className = "ui-select"
        UiTree.clearChildren(root)

        def trig:EVGElement (unwrap triggerEl)
        trig.id = (this.triggerTid())
        trig.className = "ui-select-trigger"
        if disabled {
            UiTree.addClass(trig "ui-select-trigger-disabled")
        }
        UiTree.setState(trig "ui-select-trigger" word)
        UiTree.clearChildren(trig)
        UiTree.anchor(trig)

        def val:EVGElement (unwrap valueEl)
        val.id = (this.valueTid())
        val.className = "ui-select-value"
        UiTree.leafText(val (this.labelOf(value)))
        trig.addChild(val)
        root.addChild(trig)

        if (open == false) {
            return
        }
        def content:EVGElement (unwrap contentEl)
        content.id = (this.contentTid())
        content.className = "ui-select-content"
        UiTree.setState(content "ui-select-content" word)
        UiTree.surface(content "bottom" "start")
        UiTree.clearChildren(content)
        def i:int 0
        while (i < (array_length items)) {
            def it:UiItem (itemAt items i)
            def el:EVGElement (unwrap it.el)
            el.id = (this.itemTid(it.value))
            el.className = "ui-select-item"
            if it.disabled {
                UiTree.addClass(el "ui-select-item-disabled")
            }
            def itemWord:string "unchecked"
            if (it.value == value) {
                itemWord = "checked"
            }
            UiTree.setState(el "ui-select-item" itemWord)
            UiTree.leafText(el it.name)
            content.addChild(el)
            i = (i + 1)
        }
        root.addChild(content)
    }

    fn tids:[string] () {
        def a:[string]
        push a tid
        push a (this.triggerTid())
        push a (this.valueTid())
        push a (this.contentTid())
        def i:int 0
        while (i < (array_length items)) {
            def it:UiItem (itemAt items i)
            push a (this.itemTid(it.value))
            i = (i + 1)
        }
        return a
    }

    fn hitFocusId:string (hit:string) {
        if (this.isFocusable(hit)) {
            return hit
        }
        if disabled {
            return ""
        }
        if (hit == tid) {
            return (this.triggerTid())
        }
        if (hit == (this.valueTid())) {
            return (this.triggerTid())
        }
        return ""
    }

    fn isFocusable:boolean (target:string) {
        if disabled {
            return false
        }
        if (target == (this.triggerTid())) {
            return true
        }
        if (open == false) {
            return false
        }
        def v:string (this.valueOf(target))
        if ((strlen v) == 0) {
            return false
        }
        def i:int (this.indexOfValue(v))
        def it:UiItem (itemAt items i)
        return (it.disabled == false)
    }

    fn rows:[UiRow] () {
        def out:[UiRow]
        def word:string (this.stateWord())

        def trigRow:UiRow (UiRow.of((this.triggerTid()) (EVGA11yRole.comboBox()) name))
        trigRow.state = word
        trigRow.disabled = disabled
        trigRow.focusable = (disabled == false)
        trigRow.tabStop = (disabled == false)
        if open {
            trigRow.expanded = (EVGA11yTri.yes())
        } {
            trigRow.expanded = (EVGA11yTri.no())
        }
        push out trigRow

        ; The value box carries no role and no name: what is chosen is
        ; announced through the trigger, and a second name here would have a
        ; reader say it twice.
        def valRow:UiRow (UiRow.of((this.valueTid()) (EVGA11yRole.none()) ""))
        valRow.parentTid = (this.triggerTid())
        push out valRow

        if (open == false) {
            return out
        }
        def contentRow:UiRow (UiRow.of((this.contentTid()) (EVGA11yRole.listBox()) ""))
        contentRow.state = word
        contentRow.focusable = true
        ; MODAL, and measured rather than assumed: with the list open the
        ; reference hides the trigger and its value from the accessibility
        ; tree along with the rest of the page. A picker takes the screen over
        ; while it is choosing, exactly as a dialog does — which is why this is
        ; one flag and not a second mechanism.
        contentRow.modal = true
        if multiple {
            contentRow.multiSelectable = "true"
        }
        push out contentRow

        def i:int 0
        while (i < (array_length items)) {
            def it:UiItem (itemAt items i)
            def row:UiRow (UiRow.of((this.itemTid(it.value)) (EVGA11yRole.option()) ""))
            row.parentTid = (this.contentTid())
            row.disabled = it.disabled
            row.focusable = (it.disabled == false)
            ; The state word follows the VALUE — what has been chosen — and it
            ; keeps saying so while the highlight moves.
            if (it.value == value) {
                row.state = "checked"
            } {
                row.state = "unchecked"
            }
            ; `aria-selected`, though, follows selected AND focused together.
            ; That is the reference's rule and it is a strange one: arrow off
            ; the chosen row and NOTHING is selected, because the row that is
            ; chosen is no longer the row you are on. Measured — the obvious
            ; version, where selected tracks the value, disagreed on exactly
            ; this step — and copied rather than corrected, because the
            ; harness compares what the reference does.
            def isChosen:boolean (it.value == value)
            def isFocused:boolean (it.value == activeValue)
            if (isChosen && isFocused) {
                row.selected = (EVGA11yTri.yes())
            } {
                row.selected = (EVGA11yTri.no())
            }
            ; Base UI: selected is what is chosen, wherever the highlight is.
            if baseUi {
                if (this.isChosen(it.value)) {
                    row.selected = (EVGA11yTri.yes())
                    row.state = "checked"
                } {
                    row.selected = (EVGA11yTri.no())
                    row.state = "unchecked"
                }
            }
            push out row
            i = (i + 1)
        }
        return out
    }
}
